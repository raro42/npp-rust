    let rest = s[n..].trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with("//")
        || rest.starts_with("/*");
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
