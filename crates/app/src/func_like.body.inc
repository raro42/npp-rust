fn deny_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (allow / deny / ignore / targets / …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    // `ignore = true` under [licenses.private] is a bool; array forms stay out.
    if key == "ignore" {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(
        key,
        "all-features"
            | "no-default-features"
            | "exclude-dev"
            | "git-fetch-with-cli"
            | "allow-wildcard-paths"
            | "multiple-versions-include-dev"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(
        key,
        "vulnerability"
            | "unmaintained"
            | "unsound"
            | "yanked"
            | "notice"
            | "unlicensed"
            | "copyleft"
            | "multiple-versions"
            | "wildcards"
            | "workspace-default-features"
            | "external-default-features"
            | "unknown-registry"
            | "unknown-git"
    ) {
        return bare.eq_ignore_ascii_case("deny")
            || bare.eq_ignore_ascii_case("warn")
            || bare.eq_ignore_ascii_case("allow");
    }
    if key == "allow-osi-fsf-free" {
        return bare.eq_ignore_ascii_case("both")
            || bare.eq_ignore_ascii_case("either")
            || bare.eq_ignore_ascii_case("osi")
            || bare.eq_ignore_ascii_case("fsf")
            || bare.eq_ignore_ascii_case("osi-only")
            || bare.eq_ignore_ascii_case("fsf-only")
            || bare.eq_ignore_ascii_case("neither");
    }
    if key == "highlight" {
        return bare.eq_ignore_ascii_case("all")
            || bare.eq_ignore_ascii_case("lowest-version")
            || bare.eq_ignore_ascii_case("simplest-path");
    }
    if key == "feature-depth" {
        return !bare.is_empty() && bare.chars().all(|c| c.is_ascii_digit() || c == '_');
    }
    if key == "confidence-threshold" {
        let numeric = !bare.is_empty()
            && bare
                .chars()
                .all(|c| c.is_ascii_digit() || c == '.' || c == '_');
        if !numeric {
            return false;
        }
        return bare.contains('.') || bare.parse::<u8>().is_ok_and(|n| n <= 1);
    }
    if key == "db-path" {
        // Path-ish: slash, tilde, or dotted segment.
        let pathish = bare.starts_with('~')
            || bare.starts_with('/')
            || bare.starts_with('.')
            || bare.contains('/')
            || bare.contains('\\');
        if !pathish {
            return false;
        }
    }
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'_'
                    | b'-'
                    | b':'
                    | b'@'
                    | b'+'
                    | b','
                    | b'/'
                    | b'\\'
                    | b' '
                    | b'\t'
                    | b'='
                    | b'$'
                    | b'%'
                    | b'?'
                    | b'&'
                    | b'~'
                    | b'('
                    | b')'
                    | b'"'
                    | b'\''
                    | b'>'
                    | b'<'
                    | b'!'
                    | b'^'
                    | b'*'
            )
    })
}

/// cargo-nextest `nextest.toml` / `.config/nextest.toml`: `[store]` /
/// `[profile.default]` / `[profile.ci]` / `[profile.name]` /
/// `[profile.name.junit]`, `dir = "target/nextest"`, `retries = 2`,
/// `test-threads = "num-cpus"`, `threads-required = 1`,
/// `slow-timeout = "60s"`, `leak-timeout = "100ms"`,
/// `status-level = "pass"`, `final-status-level = "fail"`,
/// `failure-output = "immediate"`, `success-output = "never"`,
/// `max-fail = 1`, `fail-fast = true`, `run-ignored = "default"`,
/// `default-filter = "all()"`, `no-run = false`,
/// `force-run-flaky = false`, `path = "junit.xml"`,
/// `report-name = "nextest"`. Exact kebab-case nextest keys. TOML
/// `key = value` with spaces around `=`. Optional `#` comment. Nested
/// maps / arrays (`retries = { … }`, `slow-timeout = { … }`) / prose /
/// wrong case / deny / clippy / rustfmt / ruff / uv / bunfig / yarn /
/// npmrc / pip / Cargo stay out.
fn is_nextest_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return nextest_toml_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    if !nextest_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    nextest_toml_value_ok(key, value)
}

fn nextest_toml_section_ok(header: &str) -> bool {
    if header == "store" {
        return true;
    }
    let Some(rest) = header.strip_prefix("profile.") else {
        return false;
    };
    if rest.is_empty() {
        return false;
    }
    // `profile.default`, `profile.ci`, `profile.default.junit`, …
    let mut parts = rest.split('.');
    let Some(name) = parts.next() else {
        return false;
    };
    if !nextest_toml_profile_name_ok(name) {
        return false;
    }
    match parts.next() {
        None => true,
        Some("junit") => parts.next().is_none(),
        Some(_) => false,
    }
}

fn nextest_toml_profile_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
}

fn nextest_toml_key_ok(key: &str) -> bool {
    const KEYS: &[&str] = &[
        // [store]
        "dir",
        // [profile.*]
        "retries",
        "test-threads",
        "threads-required",
        "slow-timeout",
        "leak-timeout",
        "status-level",
        "final-status-level",
        "failure-output",
        "success-output",
        "max-fail",
        "fail-fast",
        "run-ignored",
        "default-filter",
        "no-run",
        "force-run-flaky",
        // [profile.*.junit]
        "path",
        "report-name",
    ];
    KEYS.contains(&key)
}

fn nextest_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (retries = { … }, slow-timeout = { … }).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(key, "fail-fast" | "no-run" | "force-run-flaky") {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(key, "status-level" | "final-status-level") {
        return matches!(
            bare,
            "none" | "fail" | "retry" | "slow" | "pass" | "skip" | "leak" | "all"
        );
    }
    if matches!(key, "failure-output" | "success-output") {
        return matches!(bare, "immediate" | "final" | "immediate-final" | "never");
    }
    if key == "run-ignored" {
        return matches!(bare, "default" | "ignored-only" | "all");
    }
    if key == "max-fail" {
        if bare.eq_ignore_ascii_case("all") {
            return true;
        }
        return !bare.is_empty() && bare.chars().all(|c| c.is_ascii_digit() || c == '_');
    }
    if matches!(key, "retries" | "threads-required") {
        return !bare.is_empty() && bare.chars().all(|c| c.is_ascii_digit() || c == '_');
    }
    if key == "test-threads" {
        if bare.eq_ignore_ascii_case("num-cpus") || bare.eq_ignore_ascii_case("num-test-threads") {
            return true;
        }
        return !bare.is_empty() && bare.chars().all(|c| c.is_ascii_digit() || c == '_');
    }
    if matches!(key, "slow-timeout" | "leak-timeout") {
        // Duration string: `60s`, `100ms`, `1m`, `2h`.
        if bare.len() < 2 {
            return false;
        }
        let (num, unit) = bare.split_at(bare.len() - (if bare.ends_with("ms") { 2 } else { 1 }));
        if num.is_empty() || !num.chars().all(|c| c.is_ascii_digit()) {
            return false;
        }
        return matches!(unit, "ms" | "s" | "m" | "h");
    }
    if key == "default-filter" {
        // Filter expression cue: parentheses or nextest keywords.
        let filterish = bare.contains('(')
            || bare.contains(')')
            || bare.contains(':')
            || bare.contains('/')
            || bare.contains('=')
            || bare.contains('&')
            || bare.contains('|')
            || bare.contains('!')
            || bare.eq_ignore_ascii_case("all()")
            || bare.eq_ignore_ascii_case("none()");
        if !filterish {
            return false;
        }
    }
    if matches!(key, "dir" | "path") {
        let pathish = bare.starts_with('~')
            || bare.starts_with('/')
            || bare.starts_with('.')
            || bare.contains('/')
            || bare.contains('\\')
            || bare.contains('.')
            || bare
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'));
        if !pathish {
            return false;
        }
    }
    if key == "report-name" {
        // Report name: letters, digits, `_`, `-`, `.`.
        if bare.len() > 128 {
            return false;
        }
        let bytes = bare.as_bytes();
        if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
            return false;
        }
        if !bytes
            .iter()
            .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'))
        {
            return false;
        }
    }
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'_'
                    | b'-'
                    | b':'
                    | b'@'
                    | b'+'
                    | b','
                    | b'/'
                    | b'\\'
                    | b' '
                    | b'\t'
                    | b'='
                    | b'$'
                    | b'%'
                    | b'?'
                    | b'&'
                    | b'~'
                    | b'('
                    | b')'
                    | b'"'
                    | b'\''
                    | b'>'
                    | b'<'
                    | b'!'
                    | b'^'
                    | b'*'
                    | b'|'
            )
    })
}

