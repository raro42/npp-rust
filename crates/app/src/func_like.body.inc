fn pycodestyle_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if matches!(
        key,
        "hang-closing"
            | "statistics"
            | "count"
            | "show-source"
            | "show-pep8"
            | "first"
            | "diff"
            | "benchmark"
