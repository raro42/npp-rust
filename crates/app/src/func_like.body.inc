/// GraphQL `input UserInput {`, `scalar DateTime`, `extend type User {`,
/// `fragment UserFields on User {`, `query GetUser {`, `mutation Create(`,
/// `subscription OnMessage {`. One name. `extend` must name a schema kind.
/// A lowercase name needs `{` or `(` (`fragment` may use `on`). Prose stays out.
fn is_graphql_decl(s: &str) -> bool {
    if let Some(rest) = graphql_extend_body(s) {
        return graphql_decl_name(rest);
    }
    if let Some(rest) =
        graphql_keyword_rest(s, &["input", "scalar", "query", "mutation", "subscription"])
    {
        return graphql_decl_name(rest);
    }
    if let Some(rest) = graphql_keyword_rest(s, &["fragment"]) {
        return graphql_fragment(rest);
    }
    false
}

fn graphql_extend_body(s: &str) -> Option<&str> {
    let rest = graphql_keyword_rest(s, &["extend"])?;
    graphql_keyword_rest(
        rest,
        &["type", "interface", "enum", "union", "input", "scalar"],
    )
}

fn graphql_keyword_rest<'a>(s: &'a str, keys: &[&str]) -> Option<&'a str> {
    for key in keys {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return Some(rest.trim_start());
        }
    }
    None
}

fn graphql_fragment(s: &str) -> bool {
    let Some((name, rest)) = graphql_ident(s) else {
        return false;
    };
    let rest = rest.trim_start();
    let Some(after_on) = sql_word(rest, "on") else {
        return graphql_name_stops(name, rest);
    };
    if !after_on.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_, after_type)) = graphql_ident(after_on.trim_start()) else {
        return false;
    };
    graphql_tail_ok(after_type.trim_start())
}

fn graphql_decl_name(s: &str) -> bool {
    let Some((name, rest)) = graphql_ident(s) else {
        return false;
    };
    graphql_name_stops(name, rest.trim_start())
}

fn graphql_ident(s: &str) -> Option<(&str, &str)> {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return None;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return None;
    }
    Some((&s[..n], &s[n..]))
}

fn graphql_name_stops(name: &str, rest: &str) -> bool {
    if !graphql_tail_ok(rest) {
        return false;
    }
    let first = name.as_bytes()[0];
    if first.is_ascii_lowercase() {
        return rest.starts_with('{') || rest.starts_with('(');
    }
    true
}

/// Terraform / HCL `resource "type" "name"`, `data "type" "name"`,
/// `variable "name"`, `output "name"`, `provider "name"`, `locals {`,
/// `terraform {`. Labels are quoted identifiers. Prose and a lone keyword
/// stay out. `data class` is not a block (Kotlin still lists it as a class).
fn is_hcl_block(s: &str) -> bool {
    if let Some(rest) = hcl_keyword_rest(s, &["resource", "data"]) {
        return hcl_labeled(rest, 2);
    }
    if let Some(rest) = hcl_keyword_rest(s, &["variable", "output", "provider"]) {
        return hcl_labeled(rest, 1);
    }
    if let Some(rest) = hcl_keyword_rest(s, &["locals", "terraform"]) {
        return rest.starts_with('{');
    }
    false
}

fn hcl_keyword_rest<'a>(s: &'a str, keys: &[&str]) -> Option<&'a str> {
    for key in keys {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{') {
            return Some(rest.trim_start());
        }
    }
    None
}

fn hcl_labeled(s: &str, labels: usize) -> bool {
    let mut rest = s;
    for _ in 0..labels {
        let Some(next) = hcl_quoted(rest) else {
            return false;
        };
        rest = next;
    }
    hcl_tail_ok(rest)
}

fn hcl_quoted(s: &str) -> Option<&str> {
    let body = s.trim_start().strip_prefix('"')?;
    let end = body.find('"')?;
    if end == 0 {
        return None;
    }
    let name = &body[..end];
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return None;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-'))
    {
        return None;
    }
    Some(&body[end + 1..])
}

fn hcl_tail_ok(rest: &str) -> bool {
    let rest = rest.trim_start();
    rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('#')
        || rest.starts_with("//")
        || rest.starts_with("/*")
}

/// Objective-C `- (void)viewDidLoad`, `-(void)viewDidLoad;`,
/// `+ (instancetype)shared`, `- (NSString *)title`,
/// `- (void)initWithFrame:(NSRect)frame`. Return type is a known C / ObjC
/// type or an uppercase name. Prose `- (optional) note` and a bare
/// `- (void)` stay out.
fn is_objc_method(s: &str) -> bool {
    let s = s.trim_start();
    let mut chars = s.chars();
    let Some(sign) = chars.next() else {
        return false;
    };
    if sign != '+' && sign != '-' {
        return false;
    }
    let rest = chars.as_str();
    if rest.starts_with('+') || rest.starts_with('-') {
        return false;
    }
    let Some((ty, after)) = objc_paren_type(rest) else {
        return false;
    };
    if !objc_type_ok(ty) {
        return false;
    }
    let Some((_, tail)) = graphql_ident(after.trim_start()) else {
        return false;
    };
    objc_method_tail(tail)
}

fn objc_paren_type(s: &str) -> Option<(&str, &str)> {
    let body = s.trim_start().strip_prefix('(')?;
    let mut depth = 1i32;
    for (i, b) in body.bytes().enumerate() {
        match b {
            b'(' => depth += 1,
            b')' => {
                depth -= 1;
                if depth == 0 {
                    if i == 0 {
                        return None;
                    }
                    return Some((&body[..i], &body[i + 1..]));
                }
            }
            _ => {}
        }
    }
    None
}

fn objc_type_ok(ty: &str) -> bool {
    let mut rest = ty.trim_start();
    if rest.is_empty() {
        return false;
    }
    let mut saw_word = false;
    for _ in 0..6 {
        rest = rest.trim_start_matches(['*', '&']).trim_start();
        if rest.is_empty()
            || rest.starts_with('<')
            || rest.starts_with('^')
            || rest.starts_with('(')
        {
            return saw_word;
        }
        let Some((word, next)) = graphql_ident(rest) else {
            return false;
        };
        if word.eq_ignore_ascii_case("struct") || word.eq_ignore_ascii_case("enum") {
            let tagged = next.trim_start();
            let Some((tag, _)) = graphql_ident(tagged) else {
                return false;
            };
            return !tag.is_empty();
        }
        if objc_type_qualifier(word) {
            saw_word = true;
            rest = next;
            continue;
        }
        return objc_type_word(word);
    }
    false
}

fn objc_type_qualifier(word: &str) -> bool {
    const QUAL: &[&str] = &[
        "const", "unsigned", "signed", "long", "short", "volatile", "__kindof",
    ];
    QUAL.iter().any(|q| word.eq_ignore_ascii_case(q))
}

fn objc_type_word(word: &str) -> bool {
    const KNOWN: &[&str] = &[
        "void",
        "id",
        "instancetype",
        "bool",
        "sel",
        "class",
        "ibaction",
        "iboutlet",
        "int",
        "char",
        "float",
        "double",
        "nsinteger",
        "nsuinteger",
        "cgfloat",
        "size_t",
        "unichar",
        "imp",
    ];
    if KNOWN.iter().any(|k| word.eq_ignore_ascii_case(k)) {
        return true;
    }
    matches!(word.as_bytes().first(), Some(b'A'..=b'Z') | Some(b'_'))
}

/// Objective-C `@implementation MyClass`, `@implementation MyClass (Cat)`,
/// `@protocol MyDelegate`, `@protocol MyDelegate <NSObject>`.
/// `@interface Name` stays with `is_java_annotation_type`. Prose and bare
/// keywords stay out.
fn is_objc_type_decl(s: &str) -> bool {
    is_objc_at_named(s, "@implementation") || is_objc_at_named(s, "@protocol")
}

fn is_objc_at_named(s: &str, key: &str) -> bool {
    let Some(rest) = s.strip_prefix(key) else {
        return false;
    };
    if !rest.is_empty()
        && rest.starts_with(|c: char| c.is_ascii_alphanumeric() || c == '_' || c == '$')
    {
        return false;
    }
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if !is_fn_name(name) || is_control_word(name) {
        return false;
    }
    let mut rest = after.trim_start();
    if rest.starts_with('(') {
        let Some(after_cat) = objc_category_parens(rest) else {
            return false;
        };
        rest = after_cat.trim_start();
    }
    if rest.starts_with('<') {
        let Some(end) = skip_balanced_delim(rest.as_bytes(), 0, b'<', b'>') else {
            return false;
        };
        rest = rest[end..].trim_start();
    }
    rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with(';')
        || rest.starts_with("//")
        || rest.starts_with("/*")
}

fn objc_category_parens(s: &str) -> Option<&str> {
    let after = after_balanced_paren(s, 0)?;
    let inner_end = s.len().checked_sub(after.len() + 1)?;
    if inner_end <= 1 {
        return None;
    }
    let inner = s[1..inner_end].trim();
    let (name, rest) = graphql_ident(inner)?;
    if !rest.trim().is_empty() || !is_fn_name(name) || is_control_word(name) {
        return None;
    }
    Some(after)
}

fn objc_method_tail(tail: &str) -> bool {
    let tail = tail.trim_start();
    tail.is_empty()
        || tail.starts_with(':')
        || tail.starts_with('{')
        || tail.starts_with(';')
        || tail.starts_with("//")
        || tail.starts_with("/*")
}

/// Solidity `contract Token is IERC20 {`, `library Math {`,
/// `modifier onlyOwner()`, `error InsufficientBalance(uint256)`,
/// `constructor(uint256 x)`. Prose and a bare `constructor` stay out.
fn is_solidity_decl(s: &str) -> bool {
    if let Some(rest) = sql_word(s, "constructor") {
        if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
            return false;
        }
        let rest = rest.trim_start();
        return rest.starts_with('(') || rest.starts_with('{');
    }
    if let Some(rest) = solidity_keyword_rest(s, &["contract", "library"]) {
        return solidity_type_name(rest);
    }
    if let Some(rest) = solidity_keyword_rest(s, &["modifier", "error"]) {
        return solidity_callable_name(rest);
    }
    false
}

fn solidity_keyword_rest<'a>(s: &'a str, keys: &[&str]) -> Option<&'a str> {
    for key in keys {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return Some(rest.trim_start());
        }
    }
    None
}

fn solidity_type_name(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with("//")
        || rest.starts_with("/*")
        || solidity_is_clause(rest);
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.starts_with('{') || rest.starts_with('(') || solidity_is_clause(rest);
    }
    true
}

fn solidity_callable_name(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.starts_with('(')
        || rest.starts_with('{')
        || rest.starts_with("//")
        || rest.starts_with("/*");
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.starts_with('(') || rest.starts_with('{');
    }
    true
}

fn solidity_is_clause(rest: &str) -> bool {
    let Some(after) = sql_word(rest, "is") else {
        return false;
    };
    after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('{')
}

/// MATLAB / Octave `classdef MyClass`, `classdef MyClass < handle`,
/// `classdef (Sealed) MyClass`, `classdef (Sealed = true) Foo < handle`.
/// Optional attributes in `(…)`. One class name. Inheritance via `<` is fine.
/// `%` line comments after the name count. Prose and a bare `classdef` stay out.
fn is_matlab_classdef(s: &str) -> bool {
    let Some(rest) = sql_word(s, "classdef") else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let mut rest = rest.trim_start();
    if rest.starts_with('(') {
        let Some(after) = after_balanced_paren(rest, 0) else {
            return false;
        };
        rest = after.trim_start();
    }
    let Some((_, after)) = graphql_ident(rest) else {
        return false;
    };
    let rest = after.trim_start();
    rest.is_empty()
        || rest.starts_with('<')
        || rest.starts_with('%')
        || rest.starts_with("//")
        || rest.starts_with("/*")
}

/// CMake `function(name)` / `macro(name)`, plus target / project calls with a
/// same-line first name: `add_executable(app …)`, `add_library(lib …)`,
/// `add_custom_target(docs …)`, `add_test(NAME t …)` / `add_test(t …)`,
/// `project(MyApp)`. Optional `Foo::Bar` ALIAS-style names. Spaced forms like
/// `function name` stay with `FUNC_LIKE_KEYS`. Prose and bare keywords stay out.
/// Meson / GN / Bazel keep their own shapes.
fn is_cmake_decl(s: &str) -> bool {
    for key in [
        "add_custom_target",
        "add_executable",
        "add_library",
        "add_test",
        "function",
        "macro",
        "project",
    ] {
        if cmake_named_call(s, key) {
            return true;
        }
    }
    false
}

fn cmake_named_call(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let mut inner = inner.trim_start();
    // `add_test(NAME MyTest COMMAND …)` — skip the NAME keyword when present.
    // Bare `add_test(NAME)` / `add_test(NAME)` with no test id stay out.
    if key.eq_ignore_ascii_case("add_test") {
        if let Some(after_name) = sql_word(inner, "NAME") {
            if after_name.starts_with(char::is_whitespace) {
                inner = after_name.trim_start();
            } else {
                return false;
            }
        }
    }
    let Some(after) = cmake_after_target_name(inner) else {
        return false;
    };
    // Keep leading whitespace: `function(name arg)` / `add_library(lib SHARED …)`.
    after.is_empty()
        || after.starts_with(')')
        || after.starts_with(',')
        || after.starts_with(char::is_whitespace)
        || after.starts_with('#')
}

fn cmake_after_target_name(s: &str) -> Option<&str> {
    let (first, mut rest) = graphql_ident(s)?;
    if first.eq_ignore_ascii_case("the") || is_control_word(first) {
        return None;
    }
    // `add_library(Foo::Bar ALIAS Foo)` — namespaced ALIAS targets.
    while let Some(after_colons) = rest.strip_prefix("::") {
        let (seg, after) = graphql_ident(after_colons)?;
        if seg.eq_ignore_ascii_case("the") || is_control_word(seg) {
            return None;
        }
        rest = after;
    }
    Some(rest)
}

/// VHDL `entity Foo is`, `architecture RTL of Foo is`, `component Bar is`,
/// `package Utils is`, `package body Utils is`. `--` comments after `is` count.
/// Prose and bare keywords stay out.
fn is_vhdl_decl(s: &str) -> bool {
    if is_vhdl_architecture(s) || is_vhdl_package(s) {
        return true;
    }
    for key in ["entity", "component"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let Some((_, after)) = graphql_ident(rest) else {
            return false;
        };
        return vhdl_ends_with_is(after.trim_start());
    }
    false
}

fn is_vhdl_architecture(s: &str) -> bool {
    let Some(rest) = sql_word(s, "architecture") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after_arch)) = graphql_ident(rest) else {
        return false;
    };
    let after_arch = after_arch.trim_start();
    let Some(after_of) = sql_word(after_arch, "of") else {
        return false;
    };
    if !after_of.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_, after_ent)) = graphql_ident(after_of.trim_start()) else {
        return false;
    };
    vhdl_ends_with_is(after_ent.trim_start())
}

fn is_vhdl_package(s: &str) -> bool {
    let Some(rest) = sql_word(s, "package") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    if let Some(after_body) = sql_word(rest, "body") {
        if !after_body.starts_with(char::is_whitespace) {
            return false;
        }
        rest = after_body.trim_start();
    }
    let Some((_, after)) = graphql_ident(rest) else {
        return false;
    };
    vhdl_ends_with_is(after.trim_start())
}

fn vhdl_ends_with_is(rest: &str) -> bool {
    let Some(after_is) = sql_word(rest, "is") else {
        return false;
    };
    after_is.is_empty()
        || after_is.starts_with(char::is_whitespace)
        || after_is.starts_with("--")
        || after_is.starts_with("//")
        || after_is.starts_with("/*")
}

/// Verilog / SystemVerilog `task do_reset;`, `task automatic foo(`,
/// `macromodule M;`, `program test;`, `primitive udp_and (`, `checker c1;`.
/// Optional leading `extern` / `export`, and `automatic` / `static` after `task`.
/// Prose and bare keywords stay out.
fn is_verilog_decl(s: &str) -> bool {
    let s = verilog_strip_extern_export(s);
    if is_verilog_task(s) {
        return true;
    }
    for key in [
        "macromodule",
        "program",
        "primitive",
        "checker",
        "covergroup",
        "property",
        "sequence",
        "clocking",
    ] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        return verilog_named_tail(rest.trim_start());
    }
    false
}

fn verilog_strip_extern_export(s: &str) -> &str {
    for key in ["extern", "export"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return rest.trim_start();
        }
    }
    s
}

fn is_verilog_task(s: &str) -> bool {
    let Some(rest) = sql_word(s, "task") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    for life in ["automatic", "static"] {
        if let Some(after) = sql_word(rest, life) {
            if after.starts_with(char::is_whitespace) {
                rest = after.trim_start();
                break;
            }
        }
    }
    verilog_named_tail(rest)
}

fn verilog_named_tail(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('(')
        || rest.starts_with('{')
        || rest.starts_with('#')
        || rest.starts_with('@')
        || rest.starts_with(';')
        || rest.starts_with("//")
        || rest.starts_with("/*")
        || rest.starts_with("--");
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.starts_with('(')
            || rest.starts_with('{')
            || rest.starts_with('#')
            || rest.starts_with('@')
            || rest.starts_with(';')
            || rest.is_empty();
    }
    true
}

/// Julia `baremodule Foo`, `primitive type Float16 16 end`,
/// `primitive type Float16 <: AbstractFloat 16`. Prose and bare keywords stay out.
/// `function` / `macro` / `struct` / `mutable struct` / `module` / `abstract type`
/// stay on the generic prefix keys.
fn is_julia_decl(s: &str) -> bool {
    is_julia_baremodule(s) || is_julia_primitive_type(s)
}

/// GDScript `class_name Player`, `class_name Player extends Node2D`,
/// `signal hit`, `signal hit(amount)`, `signal hit(amount: int)`.
/// Prose and bare keywords stay out. `func` stays on the generic prefix keys.
fn is_gdscript_decl(s: &str) -> bool {
    is_gdscript_class_name(s) || is_gdscript_signal(s)
}

/// Ruby `attr_reader :name`, `attr_writer :x`, `attr_accessor :a, :b`,
/// `attr_reader(:ready?)`, `attr_writer(:save!)`. One or more `:ident`
/// symbols (optional trailing `?` / `!`). Parentheses optional. Prose and
/// bare keywords stay out. `def` stays on the generic prefix keys.
fn is_ruby_attr_decl(s: &str) -> bool {
    is_ruby_attr_kind(s, "attr_reader")
        || is_ruby_attr_kind(s, "attr_writer")
        || is_ruby_attr_kind(s, "attr_accessor")
}

/// Erlang `-module(foo).`, `-export([hello/0]).`, `-export_type([t/0]).`,
/// `-record(person, {name})`, `-spec hello() -> ok.`, `-callback handle(term()) -> ok.`,
/// `-type opt() :: ok | error.`, `-opaque id() :: integer()`, and function
/// clauses `hello() -> ok.`, `inc(X) when is_integer(X) -> X.`. Prose, bare
/// attributes, and uppercase heads stay out.
fn is_erlang_decl(s: &str) -> bool {
    is_erlang_attribute(s) || is_erlang_fun_clause(s)
}

fn is_erlang_attribute(s: &str) -> bool {
    let Some(rest) = s.strip_prefix('-') else {
        return false;
    };
    if let Some(after) = sql_word(rest, "module") {
        return erlang_paren_atom(after);
    }
    if let Some(after) = sql_word(rest, "export_type") {
        return erlang_paren_list_start(after);
    }
    if let Some(after) = sql_word(rest, "export") {
        return erlang_paren_list_start(after);
    }
    if let Some(after) = sql_word(rest, "record") {
        return erlang_record(after);
    }
    for key in ["spec", "callback", "type", "opaque"] {
        let Some(after) = sql_word(rest, key) else {
            continue;
        };
        if !(after.starts_with(char::is_whitespace) || after.starts_with('(')) {
            continue;
        }
        return erlang_named_paren(after.trim_start());
    }
    false
}

fn erlang_paren_atom(s: &str) -> bool {
    let Some(inner) = s.trim_start().strip_prefix('(') else {
        return false;
    };
    let Some((name, after)) = graphql_ident(inner.trim_start()) else {
        return false;
    };
    if !erlang_atom_name(name) {
        return false;
    }
    after.trim_start().starts_with(')')
}

fn erlang_paren_list_start(s: &str) -> bool {
    let Some(inner) = s.trim_start().strip_prefix('(') else {
        return false;
    };
    inner.trim_start().starts_with('[')
}

fn erlang_record(s: &str) -> bool {
    let Some(inner) = s.trim_start().strip_prefix('(') else {
        return false;
    };
    let Some((name, after)) = graphql_ident(inner.trim_start()) else {
        return false;
    };
    if !erlang_atom_name(name) {
        return false;
    }
    after.trim_start().starts_with(',')
}

fn erlang_named_paren(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    if !erlang_atom_name(name) {
        return false;
    }
    after.trim_start().starts_with('(')
}

fn erlang_atom_name(name: &str) -> bool {
    matches!(name.as_bytes().first(), Some(b) if b.is_ascii_lowercase() || *b == b'_')
}

fn is_erlang_fun_clause(s: &str) -> bool {
    let Some(open) = s.find('(') else {
        return false;
    };
    let head = s[..open].trim();
    if head.is_empty()
        || head
            .bytes()
            .any(|b| matches!(b, b' ' | b'\t' | b'=' | b';' | b'.'))
        || !erlang_atom_name(head)
        || !head.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
        || is_erlang_reserved(head)
    {
        return false;
    }
    let Some(after) = after_balanced_paren(s, open) else {
        return false;
    };
    let after = after.trim_start();
    let after = if after.len() >= 4
        && after.is_char_boundary(4)
        && after[..4].eq_ignore_ascii_case("when")
        && after[4..].starts_with(char::is_whitespace)
    {
        let Some(idx) = after.find("->") else {
            return false;
        };
        &after[idx..]
    } else {
        after
    };
    after.starts_with("->")
}

fn is_erlang_reserved(name: &str) -> bool {
    matches!(
        name.to_ascii_lowercase().as_str(),
        "if" | "case"
            | "receive"
            | "try"
            | "catch"
            | "begin"
            | "fun"
            | "when"
            | "end"
            | "of"
            | "after"
            | "andalso"
            | "orelse"
            | "not"
            | "bnot"
            | "div"
            | "rem"
            | "band"
            | "bor"
            | "bxor"
            | "bsl"
            | "bsr"
    )
}

/// Sass / SCSS `@mixin flex-center`, `@mixin flex-center($dir)`,
/// `@function rem($px)`, `@keyframes fade-in`. Hyphenated names ok.
/// `@include`, `@media`, prose, and bare keywords stay out.
fn is_sass_decl(s: &str) -> bool {
    is_sass_at_named(s, "@mixin")
        || is_sass_at_named(s, "@function")
        || is_sass_at_named(s, "@keyframes")
}

fn is_sass_at_named(s: &str, key: &str) -> bool {
    let Some(rest) = sass_at_key_rest(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after)) = sass_ident(rest) else {
        return false;
    };
    let rest = after.trim_start();
    rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with("//")
        || rest.starts_with("/*")
}

fn sass_at_key_rest<'a>(s: &'a str, key: &str) -> Option<&'a str> {
    // `key` is ASCII; reject mid-codepoint cuts so unicode source lines do not panic.
    if s.len() < key.len() || !s.is_char_boundary(key.len()) {
        return None;
    }
    if !s[..key.len()].eq_ignore_ascii_case(key) {
        return None;
    }
    let rest = &s[key.len()..];
    if rest.starts_with(|c: char| c.is_ascii_alphanumeric() || c == '_' || c == '-') {
        return None;
    }
    Some(rest)
}

fn sass_ident(s: &str) -> Option<(&str, &str)> {
    let bytes = s.as_bytes();
    if bytes.is_empty() || !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return None;
    }
    let n = bytes
        .iter()
        .take_while(|b| b.is_ascii_alphanumeric() || **b == b'_' || **b == b'-')
        .count();
    Some((&s[..n], &s[n..]))
}

fn sass_at_keyword(s: &str) -> bool {
    for key in ["@mixin", "@function", "@keyframes"] {
        if sass_at_key_rest(s, key).is_some() {
            return true;
        }
    }
    css_at_keyword(s)
}

/// CSS `@property --accent`, `@layer utilities`, `@layer theme, layout`,
/// `@layer framework.layout`, `@counter-style thumbs`. Custom properties
/// need `--`. Layer lists and dotted names ok. Prose and bare keywords stay out.
fn is_css_at_decl(s: &str) -> bool {
    is_css_property_at(s) || is_css_layer_at(s) || is_css_counter_style_at(s)
}

fn css_at_keyword(s: &str) -> bool {
    for key in ["@property", "@layer", "@counter-style"] {
        if sass_at_key_rest(s, key).is_some() {
            return true;
        }
    }
    false
}

fn is_css_property_at(s: &str) -> bool {
    let Some(rest) = sass_at_key_rest(s, "@property") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after)) = css_custom_prop(rest) else {
        return false;
    };
    css_at_tail_ok(after.trim_start())
}

fn is_css_layer_at(s: &str) -> bool {
    let Some(rest) = sass_at_key_rest(s, "@layer") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after)) = css_layer_name(rest) else {
        return false;
    };
    let mut rest = after.trim_start();
    while rest.starts_with(',') {
        rest = rest[1..].trim_start();
        let Some((_, after_name)) = css_layer_name(rest) else {
            return false;
        };
        rest = after_name.trim_start();
    }
    css_at_tail_ok(rest) || rest.starts_with(';')
}

fn is_css_counter_style_at(s: &str) -> bool {
    let Some(rest) = sass_at_key_rest(s, "@counter-style") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after)) = sass_ident(rest) else {
        return false;
    };
    css_at_tail_ok(after.trim_start())
}

fn css_custom_prop(s: &str) -> Option<(&str, &str)> {
    let rest = s.strip_prefix("--")?;
    if rest.is_empty() {
        return None;
    }
    let bytes = rest.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_' || bytes[0] == b'-') {
        return None;
    }
    let n = bytes
        .iter()
        .take_while(|b| b.is_ascii_alphanumeric() || **b == b'_' || **b == b'-')
        .count();
    Some((&s[..2 + n], &s[2 + n..]))
}

fn css_layer_name(s: &str) -> Option<(&str, &str)> {
    let (first, mut rest) = sass_ident(s)?;
    let mut end = first.len();
    while rest.starts_with('.') {
        let after_dot = &rest[1..];
        let (piece, next) = sass_ident(after_dot)?;
        end += 1 + piece.len();
        rest = next;
    }
    Some((&s[..end], rest))
}

fn css_at_tail_ok(rest: &str) -> bool {
    rest.is_empty() || rest.starts_with('{') || rest.starts_with("//") || rest.starts_with("/*")
}

/// PowerShell `filter Get-Odd`, `filter Get-Odd($x) {`, `workflow Invoke-Job {`,
/// `configuration WebSite {`. Names may include hyphens. Optional `(…)` params.
/// Prose and bare keywords stay out. `function` / `class` / `enum` stay on the
/// generic prefix keys.
fn is_powershell_decl(s: &str) -> bool {
    is_powershell_named(s, "filter")
        || is_powershell_named(s, "workflow")
        || is_powershell_named(s, "configuration")
}

fn is_powershell_named(s: &str, kind: &str) -> bool {
    let Some(rest) = sql_word(s, kind) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after_name)) = powershell_ident(rest) else {
        return false;
    };
    let mut rest = after_name.trim_start();
    if rest.starts_with('(') {
        let Some(after_paren) = after_balanced_paren(rest, 0) else {
            return false;
        };
        rest = after_paren.trim_start();
    }
    powershell_tail_ok(rest)
}

fn powershell_ident(s: &str) -> Option<(&str, &str)> {
    let bytes = s.as_bytes();
    if bytes.is_empty() || !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return None;
    }
    let n = bytes
        .iter()
        .take_while(|b| b.is_ascii_alphanumeric() || **b == b'_' || **b == b'-')
        .count();
    Some((&s[..n], &s[n..]))
}

fn powershell_tail_ok(rest: &str) -> bool {
    rest.is_empty() || rest.starts_with('{') || rest.starts_with('#')
}

