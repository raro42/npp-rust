/// `"build:tags": "…"`, `"frontend:dir": "…"`, `"frontend:install": "…"`,
/// `"frontend:build": "…"`, `"frontend:dev": "…"`,
/// `"frontend:dev:build": "…"`, `"frontend:dev:install": "…"`,
