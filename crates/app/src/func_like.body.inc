    if !bytes[0].is_ascii_alphabetic() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'+' | b'-' | b'.'))
}

fn expo_json_string_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 || value.contains('\n') {
