    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return interrogate_ini_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
