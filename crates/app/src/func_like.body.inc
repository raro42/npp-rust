            return false;
        }
        if b.is_ascii_alphanumeric() || b == b'_' || b == b'-' || b == b'.' || b == b'/' {
            has_token = true;
        }
    }
    has_token && (bare.contains('.') || bare.contains('/') || bare.contains('-'))
}

fn pydoclint_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    match key {
        "baseline" => pydoclint_baseline_ok(value),
        "native-mode-noqa-location" => pydoclint_noqa_location_ok(value),
        _ => pydoclint_ini_bool_ok(value),
    }
}

/// doc8 `setup.cfg` / `tox.ini` / `doc8.ini` / `pep8.ini` `[doc8]` /
/// `[tool:doc8]` sections and distinctive keys: `[doc8]`, `[tool:doc8]`,
/// `allow-long-titles = True` / `false`, `ignore-path = .tox,docs/_build`
/// / `*.egg-info`, `ignore-path-errors = docs/odd.rst;D001;D002`,
/// `default-extension = .rst` / `.txt`, `extension = .rst,.txt`,
/// `file-encoding = utf-8` / `latin-1`, `max-line-length = 99` / `120`,
/// `ignore = D000,D001` / `D002`, `sphinx = True` / `yes`. Exact
/// kebab-case keys. INI `key = value` or `key=value`. Optional quotes on
/// values. Optional `#` / `;` comment. Bare `verbose` / `quiet` stay out
/// (shared). `ignore` needs comma-separated `D` / `D0`…`D9` / `D###`
/// check ids (no flake8 `E`/`F`/`W` codes). flake8 / mypy / pytest /
/// isort / coverage / pylint / pycodestyle / autopep8 / black / yapf /
/// pydocstyle / bandit / codespell / docformatter / vulture /
/// interrogate / check-manifest / bumpversion / versioneer /
/// setuptools_scm / towncrier / zest.releaser / cibuildwheel /
/// check-wheel-contents / Twine `.pypirc` / Commitizen /
/// python-semantic-release / scriv / import-linter / darglint /
/// pydoclint / tox / setuptools / Cargo / Pipfile / pyproject
/// `[tool.doc8]` tables / Desktop Entry / pip.conf stay out.
fn is_doc8_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return doc8_ini_section_ok(header);
    }
    let body = doc8_ini_strip_comment(s);
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !doc8_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    doc8_ini_value_ok(key, value)
}

/// Trailing `#` / `;` comments need a preceding whitespace so
/// `ignore-path-errors = file.rst;D001` keeps its `;` delimiters.
fn doc8_ini_strip_comment(s: &str) -> &str {
    let mut in_quote: Option<char> = None;
    let mut prev_ws = false;
    for (i, c) in s.char_indices() {
        if let Some(q) = in_quote {
            if c == q {
                in_quote = None;
            }
            prev_ws = false;
            continue;
        }
        if c == '"' || c == '\'' {
            in_quote = Some(c);
            prev_ws = false;
            continue;
        }
        if (c == '#' || c == ';') && prev_ws {
            return s[..i].trim();
        }
        prev_ws = c.is_whitespace();
    }
    s.trim()
}

fn doc8_ini_section_ok(header: &str) -> bool {
    matches!(header, "doc8" | "tool:doc8")
}

fn doc8_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "allow-long-titles"
            | "ignore-path"
            | "ignore-path-errors"
            | "default-extension"
            | "extension"
            | "file-encoding"
            | "max-line-length"
            | "ignore"
            | "sphinx"
    )
}

fn doc8_ini_bare(value: &str) -> &str {
    value.trim_matches(|c| c == '"' || c == '\'')
}

fn doc8_ini_bool_ok(value: &str) -> bool {
    matches!(
        doc8_ini_bare(value).to_ascii_lowercase().as_str(),
        "true" | "false" | "yes" | "no" | "on" | "off" | "1" | "0"
    )
}

fn doc8_max_line_length_ok(value: &str) -> bool {
    let bare = doc8_ini_bare(value);
    !bare.is_empty() && bare.len() <= 4 && bare.bytes().all(|b| b.is_ascii_digit()) && bare != "0"
}

fn doc8_d_code_ok(token: &str) -> bool {
    let t = token.trim();
    if t.is_empty() || t.len() > 8 {
        return false;
    }
    let bytes = t.as_bytes();
    if bytes[0] != b'D' && bytes[0] != b'd' {
        return false;
    }
    if bytes.len() == 1 {
        return true;
    }
    bytes[1..].iter().all(|b| b.is_ascii_digit())
}

fn doc8_ignore_ok(value: &str) -> bool {
    let bare = doc8_ini_bare(value);
    if bare.is_empty() || bare.len() > 128 {
        return false;
    }
    let mut any = false;
    for part in bare.split(',') {
        let t = part.trim();
        if t.is_empty() {
            return false;
        }
        if !doc8_d_code_ok(t) {
            return false;
        }
        any = true;
    }
    any
}

fn doc8_path_token_ok(token: &str) -> bool {
    let t = token.trim();
    if t.is_empty() || t.len() > 256 {
        return false;
    }
    let mut has_token = false;
    for b in t.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if b.is_ascii_alphanumeric()
            || matches!(b, b'_' | b'-' | b'.' | b'/' | b'*' | b'?' | b'[' | b']')
        {
            has_token = true;
        }
    }
    has_token
}

fn doc8_ignore_path_ok(value: &str) -> bool {
    let bare = doc8_ini_bare(value);
    if bare.is_empty() || bare.len() > 512 {
        return false;
    }
    let mut any = false;
    for part in bare.split(',') {
        if !doc8_path_token_ok(part) {
            return false;
        }
        any = true;
    }
    any
}

fn doc8_ignore_path_errors_ok(value: &str) -> bool {
    let bare = doc8_ini_bare(value);
    if bare.is_empty() || bare.len() > 512 || !bare.contains(';') {
        return false;
    }
    let mut parts = bare.split(';');
    let Some(path) = parts.next() else {
        return false;
    };
    if !doc8_path_token_ok(path) {
        return false;
    }
    let mut any_code = false;
    for code in parts {
        let t = code.trim();
        if t.is_empty() || !doc8_d_code_ok(t) {
            return false;
        }
        any_code = true;
    }
    any_code
}

fn doc8_extension_token_ok(token: &str) -> bool {
    let t = token.trim();
    if t.len() < 2 || t.len() > 16 {
        return false;
    }
    let bytes = t.as_bytes();
    if bytes[0] != b'.' {
        return false;
    }
    bytes[1..]
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
        && bytes[1].is_ascii_alphanumeric()
}

fn doc8_extension_ok(value: &str) -> bool {
    let bare = doc8_ini_bare(value);
    if bare.is_empty() || bare.len() > 64 {
        return false;
    }
    let mut any = false;
    for part in bare.split(',') {
        if !doc8_extension_token_ok(part) {
            return false;
        }
        any = true;
    }
    any
}

fn doc8_file_encoding_ok(value: &str) -> bool {
    let bare = doc8_ini_bare(value);
    if bare.is_empty() || bare.len() > 32 {
        return false;
    }
    let lower = bare.to_ascii_lowercase();
    // Common encodings; hyphen / digit ok (`utf-8`, `iso-8859-1`, `cp1252`).
    let bytes = lower.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || *b == b'-' || *b == b'_')
        && (lower.contains("utf")
            || lower.contains("latin")
            || lower.contains("ascii")
            || lower.contains("iso")
            || lower.starts_with("cp")
            || lower == "utf8"
            || lower == "utf-8")
}

fn doc8_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    match key {
        "allow-long-titles" | "sphinx" => doc8_ini_bool_ok(value),
        "max-line-length" => doc8_max_line_length_ok(value),
        "ignore" => doc8_ignore_ok(value),
        "ignore-path" => doc8_ignore_path_ok(value),
        "ignore-path-errors" => doc8_ignore_path_errors_ok(value),
        "default-extension" | "extension" => doc8_extension_ok(value),
        "file-encoding" => doc8_file_encoding_ok(value),
        _ => false,
    }
}

/// rstcheck `.rstcheck.cfg` / `setup.cfg` / `tox.ini` `[rstcheck]`
/// section and fields: `[rstcheck]`, `report_level = WARNING` / `ERROR`
/// / `INFO` / `SEVERE` / `NONE` / `1`…`5`, `ignore_directives =
/// automodule,click` / `mdinclude`, `ignore_roles = src,RFC`,
/// `ignore_substitutions = image_link`, `ignore_languages = python,cpp`,
/// `ignore_messages = (Document or section may not begin with a
/// transition\\.$)`, `sphinx_source_dir = docs` / `./docs` / `src/docs`.
/// Exact snake_case keys. INI `key = value` or `key=value`. Optional
/// quotes on values. Optional `#` / `;` comment. Trailing commas on
/// ignore lists ok. Bare `verbose` / `quiet` / `ignore` stay out.
/// flake8 / mypy / pytest / isort / coverage / pylint / pycodestyle /
/// autopep8 / black / yapf / pydocstyle / bandit / codespell /
/// docformatter / vulture / interrogate / check-manifest / bumpversion
/// / versioneer / setuptools_scm / towncrier / zest.releaser /
/// cibuildwheel / check-wheel-contents / Twine `.pypirc` / Commitizen /
/// python-semantic-release / scriv / import-linter / darglint /
/// pydoclint / doc8 / tox / setuptools / Cargo / Pipfile / pyproject
/// `[tool.rstcheck]` tables / Desktop Entry / pip.conf stay out.
fn is_rstcheck_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return rstcheck_ini_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !rstcheck_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    rstcheck_ini_value_ok(key, value)
}

fn rstcheck_ini_section_ok(header: &str) -> bool {
    header == "rstcheck"
}

fn rstcheck_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "report_level"
            | "ignore_directives"
            | "ignore_roles"
            | "ignore_substitutions"
            | "ignore_languages"
            | "ignore_messages"
            | "sphinx_source_dir"
    )
}

fn rstcheck_ini_bare(value: &str) -> &str {
    value.trim_matches(|c| c == '"' || c == '\'')
}

fn rstcheck_report_level_ok(value: &str) -> bool {
    let bare = rstcheck_ini_bare(value);
    if bare.is_empty() {
        return false;
    }
    if matches!(
        bare.to_ascii_lowercase().as_str(),
        "info" | "warning" | "error" | "severe" | "none"
    ) {
        return true;
    }
    matches!(bare, "1" | "2" | "3" | "4" | "5")
}

fn rstcheck_ident_token_ok(token: &str) -> bool {
    let t = token.trim();
    if t.is_empty() || t.len() > 64 {
        return false;
    }
    let bytes = t.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
}

fn rstcheck_ignore_list_ok(value: &str) -> bool {
    let bare = rstcheck_ini_bare(value);
    if bare.is_empty() || bare.len() > 512 {
        return false;
    }
    let mut any = false;
    for part in bare.split(',') {
        let t = part.trim();
        if t.is_empty() {
            // Trailing / doubled commas are optional whitespace.
            continue;
        }
        if !rstcheck_ident_token_ok(t) {
            return false;
        }
        any = true;
    }
    any
}

fn rstcheck_ignore_messages_ok(value: &str) -> bool {
    let bare = rstcheck_ini_bare(value);
    if bare.is_empty() || bare.len() > 512 {
        return false;
    }
    // Regex-ish so bare prose stays out.
    let mut has_meta = false;
    let mut has_token = false;
    for b in bare.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if matches!(
            b,
            b'.' | b'\\'
                | b'^'
                | b'$'
                | b'('
                | b')'
                | b'['
                | b']'
                | b'*'
                | b'+'
                | b'?'
                | b'|'
                | b'{'
                | b'}'
        ) {
            has_meta = true;
        }
        if b.is_ascii_alphanumeric() {
            has_token = true;
        }
    }
    has_meta && has_token
}

fn rstcheck_sphinx_source_dir_ok(value: &str) -> bool {
    let bare = rstcheck_ini_bare(value);
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    let mut has_token = false;
    for b in bare.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/') {
            has_token = true;
        }
    }
    has_token
        && (bare.contains('/')
            || bare.contains('.')
            || bare.contains('-')
            || bare.chars().all(|c| c.is_ascii_alphanumeric() || c == '_'))
}

fn rstcheck_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    match key {
        "report_level" => rstcheck_report_level_ok(value),
        "ignore_directives" | "ignore_roles" | "ignore_substitutions" | "ignore_languages" => {
            rstcheck_ignore_list_ok(value)
        }
        "ignore_messages" => rstcheck_ignore_messages_ok(value),
        "sphinx_source_dir" => rstcheck_sphinx_source_dir_ok(value),
        _ => false,
    }
}

