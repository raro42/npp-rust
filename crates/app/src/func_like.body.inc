            // RapiDoc only documents boolean `false` for showMethodInNavBar;
            // enabled forms are the as-*-text / as-*-block strings.
            if key == "showMethodInNavBar" && is_true {
                return false;
            }
            package_json_tail_ok(rest)
        }
        _ => false,
    }
