fn interrogate_ini_section_ok(header: &str) -> bool {
    matches!(header, "interrogate" | "tool:interrogate")
}

fn interrogate_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "ignore-init-method"
            | "ignore-init-module"
            | "ignore-magic"
            | "ignore-semiprivate"
            | "ignore-private"
            | "ignore-property-decorators"
            | "ignore-module"
            | "ignore-nested-functions"
            | "ignore-nested-classes"
            | "ignore-setters"
            | "ignore-overloaded-functions"
            | "fail-under"
            | "ignore-regex"
            | "whitelist-regex"
            | "omit-covered-files"
            | "generate-badge"
