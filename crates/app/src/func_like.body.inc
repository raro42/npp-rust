/// need `{`. Prose and bare keywords stay out. `interface` / `record` /
/// `func` / `package` stay on generic keys; `resource` stays on Smithy.
fn is_wit_decl(s: &str) -> bool {
    let Some(rest) = wit_keyword_rest(s) else {
        return false;
