/// `"acl"` / `"referers"` / `"restrictIndices"` / `"restrictSources"` /
/// `"synonyms"` / `"conditions"` / `"promote"` / `"corrections"` /
/// `"replacements"` / `"validity"` / `"tags"` /
/// `"automaticFacetFilters"` / `"automaticOptionalFacetFilters"` /
/// `"edits"` / `"remove"` / `"words"` / `"decomposition"` /
/// `"eventsScoring"` / `"facetsScoring"` / `"currencies"` / `"countries"` /
/// `"devices"` / `"dates"` / `"clickPositions"` / `"searches"` / `"hits"` /
/// `"attributes"` / `"positions"` / `"position"` / `"values"` / `"orderBy"` /
/// `"parameterValue"` / `"value"` / `"filters"` / `"series"`
/// accept `[`. `"currencies"` also accepts `{`. `"metrics"` also accepts `{`.
/// `"parameter"` accepts `{`. `"scores"` accepts `{`. `"position"` also
/// accepts uint. `"score"` accepts uint. `"sourceIndices"` accepts `[`.
/// `"minHits"` / `"minLetters"` / `"contextLevel"` / `"amount"` accept uint.
/// `"allowSpecialCharacters"` / `"isRunning"` accept bool.
/// `"languages"` / `"exclude"` / `"generate"` / `"external"` accept `[`.
/// `"languages"` also accepts bool. `"replicas"` also accepts bool (still
/// accepts `[`). `"appID"` accepts a non-empty quoted string (distinct from
/// Capacitor / stayed-out `"appId"`).
/// `"orderBy"` also accepts the Analytics order enum string.
/// `"parameterValue"` / `"value"` also accept uint / decimal / bool.
/// `"values"` / `"series"` / `"updatedAt"` also accept `null`.
/// `"clickThroughRate"` / `"conversionRate"` / `"averageClickPosition"` /
/// `"addToCartRate"` / `"purchaseRate"` / `"noResultsRate"` / `"noClickRate"` /
/// `"average"` / `"rate"` / `"revenue"` also accept `null`.
/// `"exclude"` / `"generate"` / `"external"` / `"facets"` / `"analyticsTags"`
/// also accept `null` (Query Suggestions optional defaults).
fn is_algolia_crawler_json_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let key = &rest[..end];
    if !algolia_crawler_json_key_ok(key) {
        return false;
    }
    let after_key = rest[end + 1..].trim_start();
    let Some(after_colon) = after_key.strip_prefix(':') else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    algolia_crawler_json_value_and_tail_ok(key, after_colon)
}

