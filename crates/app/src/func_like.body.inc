fn gitconfig_dotted_sub_ok(sub: &str) -> bool {
    if sub.is_empty() {
        return false;
    }
    let bytes = sub.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.'))
}

fn gitconfig_quoted_sub_ok(rest: &str) -> bool {
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('"') else {
        return false;
    };
    let Some(end) = inner.find('"') else {
        return false;
    };
    if end == 0 {
        return false;
    }
    // Nothing after the closing quote except we already trimmed the
    // bracket via cargo_toml_header; reject trailing junk inside header.
    inner[end + 1..].is_empty()
}

/// SSH config section headers: `Host` / `Match` / `Include`.
/// `Host github.com`, `Host * *.internal`, `Host !lab.example.com`,
/// `Match host *.corp user alice`, `Match all`, `Match canonical`,
/// `Match exec "/usr/bin/true"`, `Include ~/.ssh/config.d/*`.
/// Optional trailing `#` comment. `HostName` / `User` / `Port` /
/// `IdentityFile` key lines, bare keywords, `Match the host` prose,
/// and wrong case stay out.
fn is_ssh_config_decl(s: &str) -> bool {
    let s = s.trim_start();
    ssh_config_host(s) || ssh_config_match(s) || ssh_config_include(s)
}

fn ssh_config_comment_or_end(rest: &str) -> bool {
    let t = rest.trim_start();
    t.is_empty() || t.starts_with('#')
}

/// Next whitespace / `#`-delimited token; `None` at end or comment.
fn ssh_config_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return None;
    }
    let end = s
        .find(|c: char| c.is_ascii_whitespace() || c == '#')
        .unwrap_or(s.len());
    if end == 0 {
        return None;
    }
    Some((&s[..end], &s[end..]))
}

fn ssh_config_host_pattern_ok(pat: &str) -> bool {
    if pat.is_empty() {
        return false;
    }
    pat.chars().all(|c| {
        c.is_ascii_alphanumeric()
            || matches!(c, '*' | '?' | '!' | '.' | '-' | '_' | ':' | '[' | ']' | '/')
    })
}

fn ssh_config_host(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("Host") else {
        return false;
    };
    // Not `HostName` / `HostbasedAuthentication`.
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    let mut saw = false;
    while let Some((pat, after)) = ssh_config_token(rest) {
        if !ssh_config_host_pattern_ok(pat) {
            return false;
        }
        saw = true;
        rest = after;
    }
    saw && ssh_config_comment_or_end(rest)
}

fn ssh_config_match_criterion(tok: &str) -> Option<&'static str> {
    match tok.to_ascii_lowercase().as_str() {
        "all" => Some("all"),
        "canonical" => Some("canonical"),
        "final" => Some("final"),
        "exec" => Some("exec"),
        "host" => Some("host"),
        "originalhost" => Some("originalhost"),
        "user" => Some("user"),
        "localuser" => Some("localuser"),
        "group" => Some("group"),
        "localgroup" => Some("localgroup"),
        "tagged" => Some("tagged"),
        "localnetwork" => Some("localnetwork"),
        _ => None,
    }
}

fn ssh_config_match(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("Match") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    let mut saw = false;
    while let Some((tok, after)) = ssh_config_token(rest) {
        let Some(crit) = ssh_config_match_criterion(tok) else {
            return false;
        };
        rest = after;
        saw = true;
        match crit {
            "all" => {
                // `Match all` ends the criteria list.
                return ssh_config_comment_or_end(rest);
            }
            "canonical" | "final" => {}
            "exec" => {
                let rest_t = rest.trim_start();
                // `exec "cmd …"` or a single unquoted token.
                if let Some(q) = rest_t.as_bytes().first().copied() {
                    if q == b'"' || q == b'\'' {
                        let inner = &rest_t[1..];
                        let Some(end) = inner.find(q as char) else {
                            return false;
                        };
                        if end == 0 {
                            return false;
                        }
                        rest = &inner[end + 1..];
                        continue;
                    }
                }
                let Some((_cmd, after_cmd)) = ssh_config_token(rest) else {
                    return false;
                };
                rest = after_cmd;
            }
            _ => {
                // Pattern / name argument required.
                let Some((pat, after_pat)) = ssh_config_token(rest) else {
                    return false;
                };
                if crit == "tagged" {
                    if pat.is_empty()
                        || !pat
                            .chars()
                            .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
                    {
                        return false;
                    }
                } else if !ssh_config_host_pattern_ok(pat) {
                    return false;
                }
                rest = after_pat;
            }
        }
    }
    saw && ssh_config_comment_or_end(rest)
}

fn ssh_config_include(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("Include") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    let mut saw = false;
    while let Some((path, after)) = ssh_config_token(rest) {
        // Paths / globs: require a path-ish character so prose
        // (`Include the team`) stays out.
        if !(path.contains('/')
            || path.contains('*')
            || path.contains('?')
            || path.contains('~')
            || path.contains('.')
            || path
                .chars()
                .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_'))
        {
            return false;
        }
        // Reject bare English fillers used as a lone first token.
        if !saw && matches!(path, "the" | "a" | "an" | "this" | "that" | "my" | "our") {
            return false;
        }
        saw = true;
        rest = after;
    }
    saw && ssh_config_comment_or_end(rest)
}

/// AWS CLI / SDK config sections (`~/.aws/config`, shared credentials
/// style tables that use the same headers): `[default]`,
/// `[profile production]`, `[sso-session my-sso]`,
/// `[services my-services]`, `[plugins]`. Optional trailing `#` / `;`
/// comment. Named sections need a non-empty alphanumeric / hyphen /
/// underscore name. Key lines (`region =`, `aws_access_key_id =`),
/// bare `[profile]` / `[sso-session]`, git / systemd / Desktop Entry /
/// tox / Cargo / EditorConfig tables, incomplete brackets, and prose
/// stay out.
fn is_aws_config_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if array || header.is_empty() || !tox_ini_tail_ok(after) {
        return false;
    }
    aws_config_header_ok(header)
}

fn aws_config_header_ok(header: &str) -> bool {
    if header == "default" || header == "plugins" {
        return true;
    }
    for prefix in ["profile ", "sso-session ", "services "] {
        if let Some(name) = header.strip_prefix(prefix) {
            return aws_config_name_ok(name);
        }
    }
    false
}

fn aws_config_name_ok(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'-' | b'_' | b'.'))
}

/// WireGuard / `wg-quick` config sections: `[Interface]`, `[Peer]`.
/// Optional trailing `#` / `;` comment. Case-sensitive headers so
/// lowercase `[interface]` / `[peer]` stay out. Key lines
/// (`PrivateKey =`, `Address =`, `AllowedIPs =`, `Endpoint =`),
/// AWS / git / systemd / Desktop Entry / tox / Cargo / EditorConfig
/// tables, incomplete brackets, and prose stay out.
fn is_wireguard_config_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if array || header.is_empty() || !tox_ini_tail_ok(after) {
        return false;
    }
    matches!(header, "Interface" | "Peer")
}

/// MySQL / MariaDB option-file (`my.cnf` / `my.ini`) sections:
/// `[mysqld]`, `[mysql]`, `[client]`, `[mysqldump]`, `[mysqladmin]`,
/// `[mysqlbinlog]`, `[mysqlcheck]`, `[mysqlimport]`, `[mysqlshow]`,
/// `[mysqlslap]`, `[mysql_upgrade]`, `[mysqld_safe]`, `[safe_mysqld]`,
/// `[server]`, `[client-server]`, `[client-mariadb]`, `[mariadb]`,
/// `[mariadbd]`, `[galera]`, `[embedded]`, plus versioned groups
/// (`[mysqld-8.0]`, `[mariadb-10.11]`, `[mariadbd-10.6]`, `[mysql-5.7]`).
/// Optional trailing `#` / `;` comment. Lowercase headers only.
/// Key lines (`port =`, `datadir =`), wrong case, WireGuard / AWS / git /
/// systemd / Desktop Entry / tox / Cargo / EditorConfig tables, incomplete
/// brackets, and prose stay out.
fn is_mysql_cnf_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if array || header.is_empty() || !tox_ini_tail_ok(after) {
        return false;
    }
    mysql_cnf_header_ok(header)
}

fn mysql_cnf_header_ok(header: &str) -> bool {
    const EXACT: &[&str] = &[
        "client",
        "mysql",
        "mysqld",
        "mysqld_safe",
        "safe_mysqld",
        "server",
        "mysqldump",
        "mysqladmin",
        "mysqlbinlog",
        "mysqlcheck",
        "mysqlimport",
        "mysqlshow",
        "mysqlslap",
        "mysql_upgrade",
        "client-server",
        "client-mariadb",
        "mariadb",
        "mariadbd",
        "galera",
        "embedded",
    ];
    if EXACT.contains(&header) {
        return true;
    }
    for prefix in ["mysqld-", "mariadbd-", "mariadb-", "mysql-"] {
        if let Some(ver) = header.strip_prefix(prefix) {
            return mysql_cnf_version_ok(ver);
        }
    }
    false
}

fn mysql_cnf_version_ok(ver: &str) -> bool {
    if ver.is_empty() {
        return false;
    }
    let bytes = ver.as_bytes();
    if !bytes[0].is_ascii_digit() {
        return false;
    }
    // `8.0`, `10.11`, `5.7.40` — digits and dots; no leading/trailing/double `.`.
    let mut prev_dot = false;
    for &b in bytes {
        if b == b'.' {
            if prev_dot {
                return false;
            }
            prev_dot = true;
        } else if b.is_ascii_digit() {
            prev_dot = false;
        } else {
            return false;
        }
    }
    !ver.ends_with('.')
}

