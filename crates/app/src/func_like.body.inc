/// `/etc/crypttab`: `cr_home UUID=… none luks`, `home /dev/sda3 /etc/luks-keys/home luks`,
/// `swap /dev/sda2 /dev/urandom swap,cipher=aes-xts-plain64,size=256`,
/// `data /dev/disk/by-uuid/… - luks,discard,nofail`. Name, device, key file
/// (`none` / `-` / path), optional options. Optional `#` comment. Bare /
/// prose / incomplete / neighbouring families (incl. fstab) stay out.
fn is_crypttab_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let mut fields = Vec::with_capacity(4);
    let mut rest = body;
    while fields.len() < 4 {
        let Some((tok, after)) = fstab_next_token(rest) else {
            break;
        };
        fields.push(tok);
        rest = after;
    }
    if !rest.trim_start().is_empty() {
        return false;
    }
    if fields.len() < 3 || fields.len() > 4 {
        return false;
    }
    if !crypttab_name_ok(fields[0]) || !fstab_spec_ok(fields[1]) || !crypttab_key_ok(fields[2]) {
        return false;
    }
    if fields.len() == 4 && !crypttab_opts_ok(fields[3]) {
        return false;
    }
    true
}

fn crypttab_name_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 64 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // Mapped device name: letters, digits, `_`, `-`. No `=` / `/` (those are
    // device / path shapes for fstab and would collide).
    let bytes = tok.as_bytes();
    if !bytes[0].is_ascii_alphabetic() && bytes[0] != b'_' {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
}

fn crypttab_key_ok(tok: &str) -> bool {
    if tok == "none" || tok == "-" {
        return true;
    }
    if tok.starts_with('/') {
        return tok.len() > 1
            && tok.as_bytes()[1..]
                .iter()
                .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'));
    }
    false
}

fn crypttab_opts_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team",
    ];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    if tok.contains(',') || tok.contains('=') {
        return tok.bytes().all(|b| {
            b.is_ascii_alphanumeric()
                || matches!(
                    b,
                    b'_' | b'-' | b'.' | b'/' | b',' | b'=' | b':' | b'+' | b'%'
                )
        });
    }
    matches!(
        tok,
        "luks"
            | "luks2"
            | "plain"
            | "tcrypt"
            | "bitlk"
            | "verity"
            | "integrity"
            | "swap"
            | "tmp"
            | "tmpfs"
            | "discard"
            | "nofail"
            | "noauto"
            | "readonly"
            | "read-only"
            | "read-write"
            | "tries"
            | "timeout"
            | "cipher"
            | "hash"
            | "size"
            | "offset"
            | "skip"
            | "sector-size"
            | "key-slot"
            | "header"
            | "keyfile-offset"
            | "keyfile-size"
            | "password-echo"
            | "x-initrd.attach"
    ) || (tok
        .bytes()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'))
        && tok.len() >= 2
        && tok.len() <= 48
        && tok.bytes().any(|b| b.is_ascii_alphabetic()))
}

/// udev rules: `KERNEL=="sda"`, `SUBSYSTEM=="usb", ATTR{idVendor}=="1234",
/// MODE="0666"`, `ACTION=="add", RUN+="/usr/local/bin/…"`, `LABEL="end"`,
/// `GOTO="end"`, `ENV{DEVTYPE}=="disk"`. Match/assign keys with `==` / `!=` /
/// `=` / `+=` / `-=` / `:=`. Optional `{…}` on ATTR / ATTRS / ENV / TAG /
/// SYSCTL / SECLABEL / IMPORT. Optional `#` comment. Comma-separated fields.
/// Bare keys, prose, wrong-case keys, and non-udev lines stay out.
fn is_udev_rule_decl(s: &str) -> bool {
    let mut rest = s.trim_start();
    if rest.is_empty() || rest.starts_with('#') {
        return false;
    }
    let mut saw = false;
    loop {
        rest = rest.trim_start();
        if rest.is_empty() || rest.starts_with('#') {
            return saw;
        }
        if saw {
            let Some(after_comma) = rest.strip_prefix(',') else {
                return false;
            };
            rest = after_comma.trim_start();
            if rest.is_empty() || rest.starts_with('#') {
                return false;
            }
        }
        let Some(after_key) = udev_rule_key(rest) else {
            return false;
        };
        let Some(after_op) = udev_rule_operator(after_key) else {
            return false;
        };
        let Some(after_val) = udev_rule_value(after_op) else {
            return false;
        };
        rest = after_val;
        saw = true;
    }
}

fn udev_rule_key(s: &str) -> Option<&str> {
    // Longer / more-specific prefixes first (ATTRS before ATTR, KERNELS before
    // KERNEL, WAIT_FOR / SECLABEL / SUBSYSTEM / DEVPATH / SYMLINK / PROGRAM /
    // OPTIONS / RESULT / IMPORT / ACTION / DRIVER / OWNER / GROUP / CONST /
    // LABEL / GOTO / MODE / NAME / TEST / ENV / TAG / RUN).
    const KEYS: &[&str] = &[
        "SUBSYSTEM",
        "WAIT_FOR",
        "SECLABEL",
        "DEVPATH",
        "KERNELS",
        "KERNEL",
        "SYMLINK",
        "PROGRAM",
        "OPTIONS",
        "RESULT",
        "IMPORT",
        "ACTION",
        "DRIVER",
        "ATTRS",
        "ATTR",
        "SYSCTL",
        "OWNER",
        "GROUP",
        "CONST",
        "LABEL",
        "GOTO",
        "MODE",
        "NAME",
        "TEST",
        "ENV",
        "TAG",
        "RUN",
    ];
    for key in KEYS {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Optional `{attr}` / `{program}` / …
        let rest = if let Some(inner) = rest.strip_prefix('{') {
            let end = inner.find('}')?;
            if end == 0 {
                return None;
            }
            &inner[end + 1..]
        } else {
            rest
        };
        // Must continue with an operator (`==` / `!=` / `=` / `+=` / …).
        if rest.starts_with('=')
            || rest.starts_with('!')
            || rest.starts_with('+')
            || rest.starts_with('-')
            || rest.starts_with(':')
        {
            return Some(rest);
        }
        return None;
    }
    None
}

fn udev_rule_operator(s: &str) -> Option<&str> {
    for op in ["==", "!=", "+=", "-=", ":=", "="] {
        if let Some(rest) = s.strip_prefix(op) {
            return Some(rest);
        }
    }
    None
}

fn udev_rule_value(s: &str) -> Option<&str> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(',') {
        return None;
    }
    if s.starts_with('"') || s.starts_with('\'') {
        let quote = s.as_bytes()[0];
        let bytes = s.as_bytes();
        let mut j = 1usize;
        while j < bytes.len() {
            if bytes[j] == b'\\' {
                j = j.saturating_add(2);
                continue;
            }
            if bytes[j] == quote {
                return Some(&s[j + 1..]);
            }
            j += 1;
        }
        return None;
    }
    // Unquoted value until `,` / `#` / whitespace.
    let end = s
        .find(|c: char| c == ',' || c == '#' || c.is_ascii_whitespace())
        .unwrap_or(s.len());
    if end == 0 {
        return None;
    }
    Some(&s[end..])
}

/// logrotate path-block openers and `include`: `/var/log/messages {`,
/// `/var/log/httpd/*log {`, `/var/log/a.log /var/log/b.log {`,
/// `"/var/log/odd name.log" {`, `include /etc/logrotate.d`. Exact lowercase
/// `include`. Path blocks must start with `/` or `"` and end with `{`
/// (optional `#` after). Directives inside blocks (`rotate`, `weekly`,
/// `postrotate` / `endscript`), nginx `location / {`, syslog-ng / named braces,
/// rsyslog `include(file=…)`, prose (`include the logs`), and wrong case stay
/// out.
fn is_logrotate_decl(s: &str) -> bool {
    let s = s.trim_start();
    if let Some(rest) = s.strip_prefix("include") {
        // Not `include(file=…)` (rsyslog) / `Include` / `includes`.
        if !rest.starts_with(char::is_whitespace) {
            return false;
        }
        let rest = rest.trim_start();
        if rest.is_empty() || rest.starts_with('#') {
            return false;
        }
        let tok_end = rest
            .find(|c: char| c.is_whitespace() || c == '#')
            .unwrap_or(rest.len());
        if tok_end == 0 {
            return false;
        }
        let path = &rest[..tok_end];
        // Path-like: absolute, relative with slash/dot, or glob.
        if !(path.starts_with('/')
            || path.starts_with('.')
            || path.contains('/')
            || path.contains('*'))
        {
            return false;
        }
        let after = rest[tok_end..].trim_start();
        return after.is_empty() || after.starts_with('#');
    }
    let Some(brace_at) = s.find('{') else {
        return false;
    };
    let before = s[..brace_at].trim();
    if before.is_empty() {
        return false;
    }
    let after = s[brace_at + 1..].trim_start();
    if !(after.is_empty() || after.starts_with('#')) {
        return false;
    }
    if let Some(rest) = before.strip_prefix('"') {
        let Some(end) = rest.find('"') else {
            return false;
        };
        if end == 0 {
            return false;
        }
        let path = &rest[..end];
        // Quoted targets must look like filesystem paths (not HCL
        // `data "has space" "name" {` leftovers after a `data` prefix strip).
        if !(path.starts_with('/') || path.contains('/') || path.contains('*')) {
            return false;
        }
        // Optional further absolute / quoted paths after the first quoted one.
        let more = rest[end + 1..].trim_start();
        return more.is_empty() || more.starts_with('/') || more.starts_with('"');
    }
    if before.starts_with('/') {
        let first_end = before.find(char::is_whitespace).unwrap_or(before.len());
        // Reject bare `/ {`.
        return first_end >= 2;
    }
    false
}

/// rsyslog RainerScript objects and classic `$ModLoad` / `$IncludeConfig`:
/// `module(load="imudp")`, `input(type="imudp" port="514")`,
/// `action(type="omfile" file="…")`, `parser(name="json" type="mmjsonparse")`,
/// `timezone(id="UTC" type="offset" offset="+00:00")`,
/// `template(name="tpl" type="string" string="%msg%\\n")`,
/// `ruleset(name="remote") {`, `global(workDirectory="/var/lib/rsyslog")`,
/// `main_queue(queue.size="10000")`, `include(file="/etc/rsyslog.d/*.conf")`,
/// `$ModLoad imudp`, `$IncludeConfig /etc/rsyslog.d/*.conf`. Exact lowercase
/// object names. Params must include a known key (`load=` / `type=` / `name=` /
/// `id=` / `file=` / `workDirectory=` / `queue.size=` / …). Optional `{` or `#`
/// after `)`. Bare `input(` / `module(`, Python `input("…")`, GraphQL
/// `input UserInput {`, syslog-ng `source s_sys {`, prose, and wrong case stay
/// out.
fn is_rsyslog_decl(s: &str) -> bool {
    let s = s.trim_start();
    rsyslog_dollar_directive(s)
        || rsyslog_object(s, "module", &["load="])
        || rsyslog_object(s, "input", &["type="])
        || rsyslog_object(s, "action", &["type="])
        || rsyslog_object(s, "parser", &["type=", "name="])
        || rsyslog_object(s, "timezone", &["id="])
        || rsyslog_object(s, "template", &["name="])
        || rsyslog_object(s, "ruleset", &["name="])
        || rsyslog_object(s, "global", &["="])
        || rsyslog_object(s, "main_queue", &["="])
        || rsyslog_object(s, "include", &["file=", "text="])
}

fn rsyslog_dollar_directive(s: &str) -> bool {
    for key in ["$ModLoad", "$IncludeConfig"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        if rest.is_empty() || rest.starts_with('#') {
            continue;
        }
        // One token (module name or path/glob); optional `#` comment.
        let tok_end = rest
            .find(|c: char| c.is_whitespace() || c == '#')
            .unwrap_or(rest.len());
        if tok_end == 0 {
            continue;
        }
        let after = rest[tok_end..].trim_start();
        if after.is_empty() || after.starts_with('#') {
            return true;
        }
    }
    false
}

fn rsyslog_object(s: &str, key: &str, required: &[&str]) -> bool {
    let Some(rest) = s.strip_prefix(key) else {
        return false;
    };
    // Not `modules` / `inputs` / `actions` / …
    if !rest.starts_with('(') {
        return false;
    }
    let Some(after) = syslog_ng_skip_params(rest) else {
        return false;
    };
    // `rest` is `(…)` + after; inner is between the outer parens.
    let close_at = rest.len().saturating_sub(after.len() + 1);
    if close_at < 1 || !rest.as_bytes().get(close_at).is_some_and(|&b| b == b')') {
        return false;
    }
    let inner = &rest[1..close_at];
    if inner.trim().is_empty() {
        return false;
    }
    if !required.iter().any(|needle| inner.contains(needle)) {
        return false;
    }
    let after = after.trim_start();
    after.is_empty() || after.starts_with('{') || after.starts_with('#')
}

/// Xorg `xorg.conf` / `xorg.conf.d` section openers: `Section "ServerLayout"`,
/// `Section "Files"`, `Section "Module"`, `Section "InputDevice"`,
/// `Section "InputClass"`, `Section "Device"`, `Section "VideoAdaptor"`,
/// `Section "Monitor"`, `Section "Modes"`, `Section "Screen"`,
/// `Section "Vendor"`, `Section "ServerFlags"`, `Section "Display"`,
/// `Section "Extensions"`, `Section "DRI"`, plus obsolete `Section "Pointer"` /
/// `Section "Keyboard"`. Exact `Section` casing and quoted stock names.
/// Optional `#` comment. Wrong case, missing quotes, unknown names,
/// `EndSection`, Apache `<…>` tags, and prose stay out.
fn is_xorg_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix("Section") else {
        return false;
    };
    let rest = rest.trim_start();
    let Some(rest) = rest.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let name = &rest[..end];
    let after = rest[end + 1..].trim_start();
    if !(after.is_empty() || after.starts_with('#')) {
        return false;
    }
    matches!(
        name,
        "ServerLayout"
            | "Files"
            | "Module"
            | "InputDevice"
            | "InputClass"
            | "Device"
            | "VideoAdaptor"
            | "Monitor"
            | "Modes"
            | "Screen"
            | "Vendor"
            | "ServerFlags"
            | "Display"
            | "Extensions"
            | "DRI"
            | "Pointer"
            | "Keyboard"
    )
}

/// Unbound `unbound.conf` / NSD `nsd.conf` top-level clauses: `server:`,
/// `remote-control:`, Unbound `stub-zone:` / `forward-zone:` / `auth-zone:` /
/// `view:` / `python:` / `dynlib:` / `dnscrypt:` / `cachedb:` / `dnstap:` /
/// `rpz:`, NSD `verify:` / `key:` / `pattern:` / `zone:` / `tls-auth:`.
/// Exact lowercase. Clause alone on the line (optional `#` comment). Same-line
/// values, wrong case, nested attrs (`name: example.com`, `directory: "…"`),
/// BIND `zone "x" {`, nginx `server {`, and prose stay out.
fn is_unbound_nsd_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    // Longer keys first so remote-control / forward-zone / stub-zone /
    // auth-zone / tls-auth / dnscrypt / cachedb / dnstap / pattern win.
    for key in [
        "remote-control",
        "forward-zone",
        "stub-zone",
        "auth-zone",
        "tls-auth",
        "dnscrypt",
        "cachedb",
        "dnstap",
        "pattern",
        "python",
        "dynlib",
        "verify",
        "server",
        "view",
        "zone",
        "key",
        "rpz",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        let Some(rest) = rest.strip_prefix(':') else {
            continue;
        };
        let rest = rest.trim_start();
        // Top-level clause only: no same-line value.
        return rest.is_empty() || rest.starts_with('#');
    }
    false
}

/// BitBake / Yocto recipe tasks: `do_compile()`, `do_install()`,
/// `do_configure()`, `do_fetch()`, `do_unpack()`, `do_patch()`,
/// `do_deploy()`, `do_package()`, `do_populate_sysroot()`, …
/// Optional `python` / `fakeroot` prefixes. Legacy `_append` / `_prepend`
/// and modern `:append` / `:prepend` / `:class-native` overrides.
/// Optional `{` and `#` comments. Prose (`do_compile the`), bare
/// `do_compile`, wrong case, empty `do_()`, and anonymous `python()` stay out.
/// Gentoo `src_compile()` stays on the ebuild path.
fn is_bitbake_decl(s: &str) -> bool {
    let mut rest = s;
    for _ in 0..2 {
        if let Some(r) = rest.strip_prefix("python") {
            if r.as_bytes()
                .first()
                .is_some_and(|b| b.is_ascii_whitespace())
            {
                rest = r.trim_start();
                continue;
            }
        }
        if let Some(r) = rest.strip_prefix("fakeroot") {
            if r.as_bytes()
                .first()
                .is_some_and(|b| b.is_ascii_whitespace())
            {
                rest = r.trim_start();
                continue;
            }
        }
        break;
    }
    if !rest.starts_with("do_") {
        return false;
    }
    let after_do = &rest[3..];
    let bytes = after_do.as_bytes();
    // First segment: lowercase / digit / `_` (e.g. `compile`, `install_append`).
    let n0 = bytes
        .iter()
        .take_while(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || **b == b'_')
        .count();
    if n0 == 0 {
        return false;
    }
    // Reject dangling `_` (`do_compile_()`, `do__()`). Legacy `_append` /
    // `_prepend` names end in a letter, so they stay.
    let first = &after_do[..n0];
    if first.ends_with('_') {
        return false;
    }
    let mut i = n0;
    while i < bytes.len() && bytes[i] == b':' {
        i += 1;
        let n = bytes[i..]
            .iter()
            .take_while(|b| {
                b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(**b, b'_' | b'-')
            })
            .count();
        if n == 0 {
            return false;
        }
        let seg = &after_do[i..i + n];
        if seg.starts_with('-') || seg.ends_with('-') || seg.ends_with('_') {
            return false;
        }
        i += n;
    }
    let after_name = after_do[i..].trim_start();
    let Some(inner) = after_name.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    // Shell / python task bodies take no params in the common form.
    let Some(after_paren) = inner.strip_prefix(')') else {
        return false;
    };
    let after_paren = after_paren.trim_start();
    after_paren.is_empty() || after_paren.starts_with('{') || after_paren.starts_with('#')
}

/// Gentoo ebuild phase functions: `src_unpack()`, `src_prepare()`,
/// `src_configure()`, `src_compile()`, `src_test()`, `src_install()`,
/// `pkg_pretend()`, `pkg_setup()`, `pkg_nofetch()`, `pkg_preinst()`,
/// `pkg_postinst()`, `pkg_prerm()`, `pkg_postrm()`, `pkg_config()`,
/// `pkg_info()`. Optional `{` and `#` comments. Prose (`src_prepare the`),
/// bare keywords (`src_prepare`), wrong case, and unknown names stay out.
/// Arch PKGBUILD `prepare()` / `build()` stay on the PKGBUILD path.
/// BitBake `do_compile()` stays on the BitBake path.
fn is_ebuild_decl(s: &str) -> bool {
    const PHASES: &[&str] = &[
        "src_unpack",
        "src_prepare",
        "src_configure",
        "src_compile",
        "src_test",
        "src_install",
        "pkg_pretend",
        "pkg_setup",
        "pkg_nofetch",
        "pkg_preinst",
        "pkg_postinst",
        "pkg_prerm",
        "pkg_postrm",
        "pkg_config",
        "pkg_info",
    ];
    let Some(phase) = PHASES.iter().copied().find(|p| {
        s.starts_with(p)
            && s.as_bytes()
                .get(p.len())
                .is_some_and(|b| *b == b'(' || b.is_ascii_whitespace())
    }) else {
        return false;
    };
    let after = s[phase.len()..].trim_start();
    let Some(inner) = after.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    // Phase functions take no args.
    let Some(after_paren) = inner.strip_prefix(')') else {
        return false;
    };
    let after_paren = after_paren.trim_start();
    after_paren.is_empty() || after_paren.starts_with('{') || after_paren.starts_with('#')
}

/// Arch PKGBUILD / Alpine APKBUILD phase functions:
/// `prepare()`, `build()`, `check()`, `package()`, `pkgver()`, and split
/// `package_foo()` / `package_foo-bar()`. Optional `{` and `#` comments.
/// Prose (`build the`), bare keywords (`build`), and unknown names stay out.
fn is_pkgbuild_decl(s: &str) -> bool {
    const PHASES: &[&str] = &["prepare", "build", "check", "package", "pkgver"];
    let after_name = if let Some(rest) = s.strip_prefix("package_") {
        let n = rest
            .bytes()
            .take_while(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'+'))
            .count();
        if n == 0 {
            return false;
        }
        let name = &rest[..n];
        // Arch names may end in `+` (e.g. `gtk+`); reject dangling `-` / `_` / `.`.
        if name.eq_ignore_ascii_case("the")
            || name.ends_with('-')
            || name.ends_with('_')
            || name.ends_with('.')
        {
            return false;
        }
        &rest[n..]
    } else {
        let Some(phase) = PHASES.iter().copied().find(|p| {
            s.starts_with(p)
                && s.as_bytes()
                    .get(p.len())
                    .is_some_and(|b| *b == b'(' || b.is_ascii_whitespace())
        }) else {
            return false;
        };
        &s[phase.len()..]
    };
    let after = after_name.trim_start();
    let Some(inner) = after.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    // Phase / split package functions take no args.
    let Some(after_paren) = inner.strip_prefix(')') else {
        return false;
    };
    let after_paren = after_paren.trim_start();
    after_paren.is_empty() || after_paren.starts_with('{') || after_paren.starts_with('#')
}

/// Debian `debian/rules` debhelper override / hook targets:
/// `override_dh_auto_build:`, `override_dh_installdocs:`,
/// `override_dh_auto_test-arch:`, `execute_before_dh_auto_configure:`,
/// `execute_after_dh_install --remaining-packages:`. Trailing `#` comments
/// ok. Prose (`override_dh_auto_build now`), bare prefixes
/// (`override_dh_`), wrong case, and `:=` assignments stay out.
fn is_debian_rules_decl(s: &str) -> bool {
    const PREFIXES: &[&str] = &["override_dh_", "execute_before_dh_", "execute_after_dh_"];
    let Some(prefix) = PREFIXES.iter().copied().find(|p| s.starts_with(p)) else {
        return false;
    };
    let rest = &s[prefix.len()..];
    let name_n = rest
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
        .count();
    if name_n == 0 {
        return false;
    }
    let name = &rest[..name_n];
    if name.eq_ignore_ascii_case("the") || name.ends_with('-') || name.ends_with('_') {
        return false;
    }
    let mut after = rest[name_n..].trim_start();
    // Optional flags: `--remaining-packages`
    while let Some(r) = after.strip_prefix("--") {
        let flag_n = r
            .bytes()
            .take_while(|b| b.is_ascii_alphanumeric() || *b == b'-')
            .count();
        if flag_n == 0 || r[..flag_n].ends_with('-') {
            return false;
        }
        after = r[flag_n..].trim_start();
    }
    let Some(after_colon) = after.strip_prefix(':') else {
        return false;
    };
    if after_colon.starts_with('=') {
        return false;
    }
    let after_colon = after_colon.trim_start();
    after_colon.is_empty() || after_colon.starts_with('#')
}

/// Autoconf / Automake / Libtool / Autoconf Archive / pkg-config macros:
/// `AC_INIT([foo], [1.0])`, `AC_PROG_CC`, `AC_CONFIG_FILES([Makefile])`,
/// `AC_OUTPUT`, `AM_INIT_AUTOMAKE([foreign])`, `AM_CONDITIONAL([HAVE_X], …)`,
/// `LT_INIT`, `AS_IF([test], …)`, `AX_CHECK_COMPILE_FLAG(…)`,
/// `PKG_CHECK_MODULES([FOO], [bar])`, `PKG_PROG_PKG_CONFIG`. Trailing `dnl` /
/// `#` comments ok. Prose (`AC_INIT the package`), bare prefixes (`AC_`),
/// lowercase (`Ac_Init`), and shell `PKG_CONFIG=…` stay out.
fn is_autoconf_decl(s: &str) -> bool {
    const PREFIXES: &[&str] = &["AC_", "AM_", "LT_", "AS_", "AX_", "PKG_"];
    let Some(prefix) = PREFIXES.iter().copied().find(|p| s.starts_with(p)) else {
        return false;
    };
    let rest = &s[prefix.len()..];
    let name_n = rest
        .bytes()
        .take_while(|b| b.is_ascii_uppercase() || b.is_ascii_digit() || *b == b'_')
        .count();
    if name_n == 0 {
        return false;
    }
    // Drop trailing underscores so `AC_FOO_` does not count.
    let name = &rest[..name_n];
    if name.ends_with('_') {
        return false;
    }
    let after = rest[name_n..].trim_start();
    if after.is_empty() || after.starts_with('#') {
        return true;
    }
    if let Some(r) = after.strip_prefix("dnl") {
        return r.is_empty() || r.starts_with(char::is_whitespace);
    }
    let Some(inner) = after.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    if inner.is_empty() {
        return true;
    }
    // Reject prose first-arg: `AC_INIT(the package)`.
    let lower = inner.to_ascii_lowercase();
    !(lower.starts_with("the ") || lower.starts_with("the)") || lower == "the")
}

fn sml_name_then_bind(s: &str, allow_paren: bool) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let rest = after.trim_start();
    if rest.starts_with('=') {
        return true;
    }
    if allow_paren && rest.starts_with('(') {
        return true;
    }
    // `structure Foo :> SIG =` / `structure Foo : SIG =`
    let after_colon = if let Some(r) = rest.strip_prefix(":>") {
        r
    } else if let Some(r) = rest.strip_prefix(':') {
        r
    } else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    let Some((sig, after_sig)) = graphql_ident(after_colon) else {
        return false;
    };
    if sig.eq_ignore_ascii_case("the") || is_control_word(sig) {
        return false;
    }
    let after_sig = after_sig.trim_start();
    after_sig.starts_with('=')
        || after_sig.is_empty()
        || after_sig.starts_with("(*")
        || after_sig.starts_with("//")
        || after_sig.starts_with("/*")
}

fn is_nim_keyword_decl(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    nim_decl_name(rest.trim_start())
}

fn nim_decl_name(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let mut rest = after;
    // Export marker: `converter toBool*` / `template max*`
    if let Some(after_star) = rest.strip_prefix('*') {
        rest = after_star;
    }
    let rest = rest.trim_start();
    // Generic params: `template max[T](x, y: T)`
    let rest = if rest.starts_with('[') {
        let Some(end) = rest.find(']') else {
            return false;
        };
        rest[end + 1..].trim_start()
    } else {
        rest
    };
    // Require a Nim tail so prose `converter without_parens` stays out.
    rest.starts_with('(')
        || rest.starts_with('=')
        || rest.starts_with(':')
        || rest.starts_with('{')
        || rest.starts_with('#')
        || rest.starts_with("//")
        || rest.starts_with("/*")
}

fn metal_vector_type(lower: &str) -> bool {
    for base in [
        "bool", "char", "uchar", "short", "ushort", "int", "uint", "long", "ulong", "float",
        "half", "double",
    ] {
        if let Some(n) = lower.strip_prefix(base) {
            if matches!(n, "2" | "3" | "4" | "8" | "16") {
                return true;
            }
        }
    }
    false
}

/// WebAssembly Text `(module`, `(func $add …)`, `(type $t (func …))`,
/// `(memory 1)` / `(memory $mem 1)`, `(table $tbl 2 funcref)`,
/// `(global $g (mut i32) …)`, `(import "env" "f" (func …))`,
/// `(export "add" (func $add))`, `(start $main)`, `(tag $e (param i32))`,
/// `(elem …)`, `(data …)`. Optional `$name` / `(…)` / digit / `"` tails.
/// Lisp `(defun` / `(defn` stay on the Lisp path. Bare `(func` with no
/// useful tail, prose, and `;;` comments stay out. WIT `world` /
/// `variant` / `flags` stay on the WIT path.
fn is_wat_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.starts_with(';') {
        return false;
    }
    let Some(rest) = s.strip_prefix('(') else {
        return false;
    };
    let rest = rest.trim_start();
    for form in [
        "module", "func", "type", "memory", "table", "global", "import", "export", "start", "tag",
        "elem", "data",
    ] {
        if let Some(after) = wat_form_word(rest, form) {
            return wat_tail_ok(form, after);
        }
    }
    false
}

/// Like `lisp_form_word`, but also accepts EOL / `)` / `;` after the form
/// (WAT `(module)` and `(module` at EOL are declarations).
fn wat_form_word<'a>(s: &'a str, word: &str) -> Option<&'a str> {
    let rest = sql_word(s, word)?;
    match rest.as_bytes().first() {
        None => Some(rest),
        Some(b) if b.is_ascii_whitespace() || matches!(*b, b'(' | b')' | b';') => Some(rest),
        _ => None,
    }
}

fn wat_tail_ok(form: &str, after: &str) -> bool {
    let after = after.trim_start();
    match form {
        "module" => {
            after.is_empty()
                || after.starts_with('$')
                || after.starts_with('(')
                || after.starts_with(';')
                || after.starts_with(')')
        }
        "func" | "type" | "global" | "tag" => {
            after.starts_with('$') || after.starts_with('(') || after.starts_with(';')
        }
        "start" => {
            after.starts_with('$')
                || after.starts_with('(')
                || after.starts_with(';')
                || after.bytes().next().is_some_and(|b| b.is_ascii_digit())
        }
        "memory" | "table" => {
            after.starts_with('$')
                || after.starts_with('(')
                || after.starts_with(';')
                || after.bytes().next().is_some_and(|b| b.is_ascii_digit())
        }
        "import" | "export" => after.starts_with('"') || after.starts_with(';'),
        "elem" | "data" => {
            after.starts_with('$')
                || after.starts_with('(')
                || after.starts_with(';')
                || after.starts_with('"')
                || after.bytes().next().is_some_and(|b| b.is_ascii_digit())
        }
        _ => false,
    }
}

fn after_balanced_angles(s: &str) -> Option<&str> {
    let bytes = s.as_bytes();
    if bytes.first() != Some(&b'<') {
        return None;
    }
    let mut depth = 0i32;
    for (i, &b) in bytes.iter().enumerate() {
        match b {
            b'<' => depth += 1,
            b'>' => {
                depth -= 1;
                if depth == 0 {
                    return Some(&s[i + 1..]);
                }
            }
            _ => {}
        }
    }
    None
}

fn after_balanced_paren_or_brace(s: &str) -> Option<&str> {
    let bytes = s.as_bytes();
    let open = *bytes.first()?;
    let close = match open {
        b'(' => b')',
        b'{' => b'}',
        b'[' => b']',
        _ => return None,
    };
    let mut depth = 0i32;
    for (i, &b) in bytes.iter().enumerate() {
        if b == open {
            depth += 1;
        } else if b == close {
            depth -= 1;
            if depth == 0 {
                return Some(&s[i + 1..]);
            }
        }
    }
    None
}

fn is_ruby_attr_kind(s: &str, kind: &str) -> bool {
    let Some(rest) = sql_word(s, kind) else {
        return false;
    };
    if !(rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    if let Some(inner) = rest.strip_prefix('(') {
        return ruby_attr_list(inner, true);
    }
    ruby_attr_list(rest, false)
}

fn ruby_attr_list(s: &str, paren: bool) -> bool {
    let mut rest = s.trim_start();
    loop {
        let Some(after_sym) = ruby_attr_symbol(rest) else {
            return false;
        };
        rest = after_sym.trim_start();
        if paren {
            if let Some(after_close) = rest.strip_prefix(')') {
                let rest = after_close.trim_start();
                return rest.is_empty() || rest.starts_with('#');
            }
        } else if rest.is_empty() || rest.starts_with('#') {
            return true;
        }
        let Some(after_comma) = rest.strip_prefix(',') else {
            return false;
        };
        rest = after_comma.trim_start();
        if rest.is_empty() {
            return false;
        }
    }
}

fn ruby_attr_symbol(s: &str) -> Option<&str> {
    let rest = s.strip_prefix(':')?;
    let (_, after) = graphql_ident(rest)?;
    if let Some(after_bang) = after.strip_prefix('!') {
        return Some(after_bang);
    }
    if let Some(after_q) = after.strip_prefix('?') {
        return Some(after_q);
    }
    Some(after)
}

fn is_gdscript_class_name(s: &str) -> bool {
    let Some(rest) = sql_word(s, "class_name") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.is_empty() || rest.starts_with('#') || gdscript_extends(rest);
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.is_empty() || rest.starts_with('#') || gdscript_extends(rest);
    }
    true
}

fn gdscript_extends(s: &str) -> bool {
    let Some(after) = sql_word(s, "extends") else {
        return false;
    };
    if !after.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = after.trim_start();
    let Some((_, after_type)) = graphql_ident(rest) else {
        return false;
    };
    let rest = after_type.trim_start();
    rest.is_empty() || rest.starts_with('#')
}

fn is_gdscript_signal(s: &str) -> bool {
    let Some(rest) = sql_word(s, "signal") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.is_empty() || rest.starts_with('(') || rest.starts_with('#');
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.is_empty() || rest.starts_with('(') || rest.starts_with('#');
    }
    true
}

fn is_julia_baremodule(s: &str) -> bool {
    let Some(rest) = sql_word(s, "baremodule") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    julia_named_tail(rest.trim_start())
}

fn is_julia_primitive_type(s: &str) -> bool {
    let Some(rest) = sql_word(s, "primitive") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(after_type) = sql_word(rest, "type") else {
        return false;
    };
    if !after_type.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = after_type.trim_start();
    let Some((_, after_name)) = graphql_ident(rest) else {
        return false;
    };
    let mut rest = after_name.trim_start();
    if let Some(after_lt) = rest.strip_prefix("<:") {
        rest = after_lt.trim_start();
        let Some((_, after_super)) = graphql_ident(rest) else {
            return false;
        };
        rest = after_super.trim_start();
    }
    let Some(after_bits) = julia_bits(rest) else {
        return false;
    };
    let rest = after_bits.trim_start();
    rest.is_empty()
        || rest.starts_with('#')
        || sql_word(rest, "end").is_some_and(|after| {
            after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('#')
        })
}

fn julia_named_tail(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('#')
        || sql_word(rest, "end").is_some_and(|after| {
            after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('#')
        });
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.is_empty() || rest.starts_with('#') || sql_word(rest, "end").is_some();
    }
    true
}

fn julia_bits(s: &str) -> Option<&str> {
    let n = s.bytes().take_while(u8::is_ascii_digit).count();
    if n == 0 {
        return None;
    }
    Some(&s[n..])
}

/// Zig `const Point = struct {`, `pub const E = enum(u8)`,
/// `const U = packed union {`, `const O = opaque {}`, `const Err = error{`,
/// `test "add" {`, `test add {`, `test {`. Prose and plain consts stay out.
fn is_zig_decl(s: &str) -> bool {
    let s = match strip_pub_visibility(s) {
        Some(rest) => rest,
        None => s,
    };
    if is_zig_test(s) {
        return true;
    }
    is_zig_const_type(s)
}

fn is_zig_test(s: &str) -> bool {
    let Some(rest) = sql_word(s, "test") else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{')) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() {
        return false;
    }
    if rest.starts_with('{') || rest.starts_with("//") || rest.starts_with("/*") {
        return true;
    }
    if let Some(after_q) = rest.strip_prefix('"') {
        let Some(end) = after_q.find('"') else {
            return false;
        };
        let after = after_q[end + 1..].trim_start();
        return after.is_empty()
            || after.starts_with('{')
            || after.starts_with("//")
            || after.starts_with("/*");
    }
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    let after = after.trim_start();
    let stopped = after.is_empty()
        || after.starts_with('{')
        || after.starts_with("//")
        || after.starts_with("/*");
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return after.starts_with('{');
    }
    true
}

fn is_zig_const_type(s: &str) -> bool {
    let Some(rest) = sql_word(s, "const") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after_name)) = graphql_ident(rest) else {
        return false;
    };
    let rest = after_name.trim_start();
    let Some(after_eq) = rest.strip_prefix('=') else {
        return false;
    };
    let mut rest = after_eq.trim_start();
    for _ in 0..2 {
        if let Some(next) = zig_type_mod(rest) {
            rest = next;
            continue;
        }
        break;
    }
    zig_type_keyword(rest)
}

fn zig_type_mod(s: &str) -> Option<&str> {
    for key in ["packed", "extern"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return Some(rest.trim_start());
        }
    }
    None
}

fn zig_type_keyword(s: &str) -> bool {
    for key in ["struct", "enum", "union", "opaque", "error"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !(rest.is_empty()
            || rest.starts_with(char::is_whitespace)
            || rest.starts_with('{')
            || rest.starts_with('('))
        {
            continue;
        }
        let rest = rest.trim_start();
        return rest.is_empty()
            || rest.starts_with('{')
            || rest.starts_with('(')
            || rest.starts_with("//")
            || rest.starts_with("/*");
    }
    false
}

fn graphql_tail_ok(rest: &str) -> bool {
    if rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with('@')
        || rest.starts_with("//")
        || rest.starts_with("/*")
    {
        return true;
    }
    let Some(after) = sql_word(rest, "implements") else {
        return false;
    };
    after.is_empty()
        || after.starts_with(char::is_whitespace)
        || after.starts_with('{')
        || after.starts_with('(')
        || after.starts_with('@')
}

/// Protobuf `message HelloRequest {`, `service Greeter`, `rpc SayHello (`.
/// One identifier, then `{`, `(`, end of line, or a comment. Extra words stay out.
/// A lowercase name needs `{` or `(` so `service workers` stays out.
fn is_proto_decl(s: &str) -> bool {
    let Some(rest) = proto_keyword_rest(s) else {
        return false;
    };
    proto_decl_name(rest)
}

fn proto_keyword_rest(s: &str) -> Option<&str> {
    for key in ["message", "service", "rpc"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return Some(rest.trim_start());
        }
    }
    None
}

fn proto_decl_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with("//")
        || rest.starts_with("/*");
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
        return rest.starts_with('{') || rest.starts_with('(');
    }
    true
}

/// C++ `operator+(` / `bool operator==(` / `operator new(` / `Foo::operator()(`.
/// The word `operators` and prose without `(` stay out.
fn is_operator_decl(s: &str) -> bool {
    let Some(paren) = s.find('(') else {
        return false;
    };
    let head = s[..paren].trim();
    if head.is_empty() || head.bytes().any(|b| b == b';') {
        return false;
    }
    let bytes = head.as_bytes();
    let mut i = 0usize;
    while i + 8 <= head.len() {
        if &head[i..i + 8] != "operator" {
            i += 1;
            continue;
        }
        let before_ok = i == 0 || !bytes[i - 1].is_ascii_alphanumeric();
        let after = i + 8;
        let after_ok =
            after >= head.len() || (!bytes[after].is_ascii_alphanumeric() && bytes[after] != b'_');
        if !(before_ok && after_ok) {
            i += 1;
            continue;
        }
        let before = head[..i].trim();
        if !before.is_empty() {
            if before.contains('=') {
                return false;
            }
            let mut parts = before.split_whitespace();
            let Some(first) = parts.next() else {
                return false;
            };
            if !is_type_token(first) && !is_qualified_fn_name(first.trim_end_matches(['*', '&'])) {
                return false;
            }
            for tok in parts {
                if !is_type_token(tok) && !is_qualified_fn_name(tok.trim_end_matches(['*', '&'])) {
                    return false;
                }
            }
        }
        let rest = head[after..].trim_start();
        return operator_suffix_ok(rest);
    }
    false
}

fn operator_suffix_ok(rest: &str) -> bool {
    if rest.is_empty() {
        return true;
    }
    if let Some(after) = rest.strip_prefix("new") {
        return after.is_empty()
            || after.starts_with(char::is_whitespace)
            || after.starts_with('[');
    }
    if let Some(after) = rest.strip_prefix("delete") {
        return after.is_empty()
            || after.starts_with(char::is_whitespace)
            || after.starts_with('[');
    }
    rest.chars()
        .all(|c| !c.is_ascii_alphanumeric() && c != '_' && !c.is_whitespace())
}

/// Drop one or more leading Rust outer attributes (`#[inline]`,
/// `#[cfg(all(unix, feature = "x"))]`, `#[doc = "see ]"]`).
/// Returns the declaration that follows, which may be empty.
/// Inner attributes (`#![no_std]`) and other `#` lines stay untouched.
fn strip_leading_rust_attrs(s: &str) -> Option<&str> {
    if !s.starts_with("#[") {
        return None;
    }
    let mut rest = s;
    while rest.starts_with("#[") {
        let after = skip_balanced_rust_group(&rest[1..])?;
        rest = after.trim_start();
    }
    Some(rest)
}

/// `s` starts at `[`. Returns the slice after the matching `]`.
/// Quoted and raw strings do not change the bracket depth.
fn skip_balanced_rust_group(s: &str) -> Option<&str> {
    let bytes = s.as_bytes();
    if bytes.first() != Some(&b'[') {
        return None;
    }
    let mut i = 0usize;
    let mut depth = 0i32;
    while i < bytes.len() {
        if let Some(next) = skip_rust_lit(bytes, i) {
            i = next;
            continue;
        }
        match bytes[i] {
            b'[' => {
                depth += 1;
                i += 1;
            }
            b']' => {
                depth -= 1;
                i += 1;
                if depth == 0 {
                    return Some(&s[i..]);
                }
            }
            _ => i += 1,
        }
    }
    None
}

/// When `bytes[i..]` is a Rust char or string literal, the index after it.
fn skip_rust_lit(bytes: &[u8], i: usize) -> Option<usize> {
    if i >= bytes.len() {
        return None;
    }
    let mut j = i;
    if matches!(bytes[j], b'b' | b'c') {
        let n = j + 1;
        if n < bytes.len() && matches!(bytes[n], b'"' | b'\'' | b'r') {
            j = n;
        } else {
            return None;
        }
    }
    if j < bytes.len() && bytes[j] == b'r' {
        let mut k = j + 1;
        let mut hashes = 0usize;
        while k < bytes.len() && bytes[k] == b'#' {
            hashes += 1;
            k += 1;
        }
        if k >= bytes.len() || bytes[k] != b'"' {
            return None;
        }
        k += 1;
        while k < bytes.len() {
            if bytes[k] == b'"' {
                let tail = k + 1;
                if tail + hashes <= bytes.len()
                    && bytes[tail..tail + hashes].iter().all(|c| *c == b'#')
                {
                    return Some(tail + hashes);
                }
            }
            k += 1;
        }
        return None;
    }
    if j >= bytes.len() || (bytes[j] != b'"' && bytes[j] != b'\'') {
        return None;
    }
    let quote = bytes[j];
    j += 1;
    while j < bytes.len() {
        if bytes[j] == b'\\' {
            j += 2;
            continue;
        }
        if bytes[j] == quote {
            return Some(j + 1);
        }
        j += 1;
    }
    None
}

/// Drop one or more leading Java / Kotlin / TypeScript `@Name` annotations
/// or C# / C++ `[Name]` / `[[name]]` attributes. Returns the declaration
/// that follows, which may be empty. `@interface` stays (Java annotation
/// type). `@implementation` / `@protocol` stay (Objective-C types).
/// `@media`, `[section]`, and `[1, 2]` stay untouched.
fn strip_leading_annots(s: &str) -> Option<&str> {
    let mut rest = s;
    let mut any = false;
    loop {
        if rest.starts_with("@interface") && at_interface_word(rest) {
            break;
        }
        if objc_at_type_keyword(rest) {
            break;
        }
        if sass_at_keyword(rest) {
            break;
        }
        if rest.starts_with('@') {
            let Some(next) = skip_at_annotation(rest) else {
                break;
            };
            rest = next.trim_start();
            any = true;
            continue;
        }
        if rest.starts_with('[') {
            let Some(after) = skip_balanced_rust_group(rest) else {
                break;
            };
            let group_len = rest.len() - after.len();
            if !bracket_looks_like_attr(&rest[..group_len]) {
                break;
            }
            rest = after.trim_start();
            any = true;
            continue;
        }
        break;
    }
    any.then_some(rest)
}

/// Drop one leading C++ `template<…>` / `template <…>` header.
/// Nested `template<template<class> class C>` is one header.
/// `templates`, a bare `template`, and an unclosed `<` stay untouched.
fn strip_template_prefix(s: &str) -> Option<&str> {
    let rest = s.strip_prefix("template")?;
    if rest.starts_with(|c: char| c.is_ascii_alphanumeric() || c == '_') {
        return None;
    }
    let rest = rest.trim_start();
    if !rest.starts_with('<') {
        return None;
    }
    let end = skip_balanced_delim(rest.as_bytes(), 0, b'<', b'>')?;
    Some(rest[end..].trim_start())
}

fn at_interface_word(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("@interface") else {
        return false;
    };
    rest.is_empty()
        || !rest.starts_with(|c: char| c.is_ascii_alphanumeric() || c == '_' || c == '$')
}

fn objc_at_type_keyword(s: &str) -> bool {
    for key in ["@implementation", "@protocol"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if rest.is_empty()
            || !rest.starts_with(|c: char| c.is_ascii_alphanumeric() || c == '_' || c == '$')
        {
            return true;
        }
    }
    false
}

/// Java `@interface Name`. Not `@interfaceName` and not a bare `@interface`.
fn is_java_annotation_type(s: &str) -> bool {
    if !at_interface_word(s) {
        return false;
    }
    let name = s["@interface".len()..].trim_start();
    let name_len = name
        .chars()
        .take_while(|c| *c == '_' || *c == '$' || c.is_ascii_alphanumeric())
        .count();
    if name_len == 0 {
        return false;
    }
    let name = &name[..name_len];
    is_fn_name(name) && !is_control_word(name)
}

fn bracket_looks_like_attr(group: &str) -> bool {
    let mut inner = group.trim_start();
    let Some(rest) = inner.strip_prefix('[') else {
        return false;
    };
    inner = rest.trim_start();
    if inner.starts_with('[') {
        return bracket_looks_like_attr(inner);
    }
    matches!(
        inner.chars().next(),
        Some(c) if c == '_' || c.is_ascii_alphabetic()
    )
}

/// `@Override`, `@org.junit.Test`, `@GetMapping("/x")`, `@get:JvmName("x")`.
fn skip_at_annotation(s: &str) -> Option<&str> {
    let bytes = s.as_bytes();
    if bytes.first() != Some(&b'@') {
        return None;
    }
    let mut i = skip_annot_name(bytes, 1)?;
    if i < bytes.len() && bytes[i] == b'<' {
        i = skip_balanced_delim(bytes, i, b'<', b'>')?;
    }
    i = skip_ascii_ws(bytes, i);
    if i < bytes.len() && bytes[i] == b'(' {
        i = skip_balanced_delim(bytes, i, b'(', b')')?;
    }
    Some(&s[i..])
}

fn skip_annot_name(bytes: &[u8], i: usize) -> Option<usize> {
    let mut j = skip_annot_ident(bytes, i)?;
    while j < bytes.len() && (bytes[j] == b'.' || bytes[j] == b':') {
        j = skip_annot_ident(bytes, j + 1)?;
    }
    Some(j)
}

fn skip_annot_ident(bytes: &[u8], i: usize) -> Option<usize> {
    if i >= bytes.len() {
        return None;
    }
    let b = bytes[i];
    if !(b == b'_' || b == b'$' || b.is_ascii_alphabetic()) {
        return None;
    }
    let mut j = i + 1;
    while j < bytes.len() {
        let c = bytes[j];
        if c == b'_' || c == b'$' || c.is_ascii_alphanumeric() {
            j += 1;
        } else {
            break;
        }
    }
    Some(j)
}

fn skip_ascii_ws(bytes: &[u8], mut i: usize) -> usize {
    while i < bytes.len() && bytes[i].is_ascii_whitespace() {
        i += 1;
    }
    i
}

fn skip_balanced_delim(bytes: &[u8], i: usize, open: u8, close: u8) -> Option<usize> {
    if i >= bytes.len() || bytes[i] != open {
        return None;
    }
    let mut depth = 0i32;
    let mut j = i;
    while j < bytes.len() {
        if let Some(next) = skip_annot_lit(bytes, j) {
            j = next;
            continue;
        }
        if bytes[j] == open {
            depth += 1;
            j += 1;
        } else if bytes[j] == close {
            depth -= 1;
            j += 1;
            if depth == 0 {
                return Some(j);
            }
        } else {
            j += 1;
        }
    }
    None
}

fn skip_annot_lit(bytes: &[u8], i: usize) -> Option<usize> {
    if i >= bytes.len() || (bytes[i] != b'"' && bytes[i] != b'\'') {
        return None;
    }
    let quote = bytes[i];
    let mut j = i + 1;
    while j < bytes.len() {
        if bytes[j] == b'\\' {
            j = j.saturating_add(2);
            continue;
        }
        if bytes[j] == quote {
            return Some(j + 1);
        }
        j += 1;
    }
    None
}

/// `#define MAX(a, b) …` or `# define SQUARE(x) …`. Object-like `#define FOO 1`
/// and other `#` lines (Python comments, `#include`) stay out.
fn is_define_macro(s: &str) -> bool {
    let rest = s.strip_prefix('#').unwrap_or(s).trim_start();
    let Some(rest) = rest.strip_prefix("define") else {
        return false;
    };
    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() {
        return false;
    }
    let name_len = rest
        .chars()
        .take_while(|c| *c == '_' || c.is_ascii_alphanumeric())
        .count();
    if name_len == 0 {
        return false;
    }
    let name = &rest[..name_len];
    if !is_fn_name(name) {
        return false;
    }
    rest[name_len..].trim_start().starts_with('(')
}

/// `const greet = (name) =>`, `let load = async (id) =>`, `paint = x => x`.
/// The left side is one binding name. The right side is an arrow with a
/// parameter list or a single parameter. Bare `(x) =>` and match arms stay out.
fn is_arrow_fn_decl(s: &str) -> bool {
    let Some((lhs, rhs)) = split_single_assign(s) else {
        return false;
    };
    if !is_binding_name(lhs.trim()) {
        return false;
    }
    let rhs = strip_async_word(rhs.trim_start());
    let Some(arrow_at) = rhs.find("=>") else {
        return false;
    };
    arrow_params_ok(rhs[..arrow_at].trim())
}

/// `const greet = function(name) {`, `let load = async function(id) {`,
/// `var gen = function*() {`, `paint = function named(x) {`.
/// The left side is one binding name. The right side is a `function` /
/// `function*` expression (optional name). Calls and `functional` stay out.
fn is_function_expr_assign(s: &str) -> bool {
    let Some((lhs, rhs)) = split_single_assign(s) else {
        return false;
    };
    if !is_binding_name(lhs.trim()) {
        return false;
    }
    let rhs = strip_async_word(rhs.trim_start());
    let rest = if let Some(rest) = rhs.strip_prefix("function*") {
        rest
    } else if let Some(rest) = rhs.strip_prefix("function") {
        if !rest.is_empty() && !rest.starts_with('(') && !rest.starts_with(char::is_whitespace) {
            return false;
        }
        rest
    } else {
        return false;
    };
    let rest = rest.trim_start();
    let rest = if rest.starts_with('(') {
        rest
    } else {
        let name_len = rest
            .chars()
            .take_while(|c| *c == '_' || c.is_ascii_alphanumeric())
            .count();
        if name_len == 0 {
            return false;
        }
        let name = &rest[..name_len];
        if !is_fn_name(name) || is_control_word(name) {
            return false;
        }
        rest[name_len..].trim_start()
    };
    rest.starts_with('(')
}

/// F# / OCaml `let greet name =`, `let rec fact n =`, `let add = fun x ->`,
/// `let parse = function | …`. Optional `rec` and one access word
/// (`private` / `internal` / `public` / `inline`) after `let`. Plain
/// `let x = 1`, bare `let x = function`, `let!`, Rust `let f = |x| x`, and
/// `lettuce` stay out.
fn is_ml_let_fn(s: &str) -> bool {
    let Some(after_let) = sql_word(s, "let") else {
        return false;
    };
    // `let!` (F# computation) and glued words (`lettuce`) stay out.
    if after_let.starts_with('!') || !after_let.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = after_let.trim_start();
    if let Some(after_rec) = sql_word(rest, "rec") {
        if after_rec.starts_with(char::is_whitespace) {
            rest = after_rec.trim_start();
        }
    }
    for mod_word in ["private", "internal", "public", "inline"] {
        if let Some(after_mod) = sql_word(rest, mod_word) {
            if after_mod.starts_with(char::is_whitespace) {
                rest = after_mod.trim_start();
                break;
            }
        }
    }
    let name_end = rest
        .find(|c: char| c.is_whitespace() || c == '(' || c == '=')
        .unwrap_or(rest.len());
    let name = &rest[..name_end];
    if !is_binding_name(name) {
        return false;
    }
    let after_name = rest[name_end..].trim_start();
    if let Some(rhs) = after_name.strip_prefix('=') {
        return is_ml_fun_rhs(rhs.trim_start());
    }
    let Some(eq) = after_name.find('=') else {
        return false;
    };
    let bytes = after_name.as_bytes();
    if bytes.get(eq + 1) == Some(&b'=') || bytes.get(eq + 1) == Some(&b'>') {
        return false;
    }
    if eq > 0 && matches!(bytes[eq - 1], b'=' | b'!' | b'<' | b'>') {
        return false;
    }
    !after_name[..eq].trim().is_empty()
}

fn is_ml_fun_rhs(rhs: &str) -> bool {
    if let Some(rest) = sql_word(rhs, "function") {
        // Same-line pattern or paren; bare `let x = function` (incomplete JS)
        // stays out so Function List does not treat it as an OCaml match.
        let rest = rest.trim_start();
        return rest.starts_with('|') || rest.starts_with('(');
    }
    if let Some(rest) = sql_word(rhs, "fun") {
        return rest.starts_with(char::is_whitespace)
            || rest.starts_with('(')
            || rest.starts_with('|');
    }
    false
}

/// `(defun greet (name)`, `(defn ^String greet [name]`, `(defn- helper [x]`,
/// `(define (fact n)`, `(define fact (lambda (n)`, `(def foo (fn [x]`,
/// `(defmacro unless`, `(defclass widget`, `(ns my.app)`.
/// `(def x 1)`, `(define x 1)`, `(define x (+ 1 2))`, `(let [x 1]`,
/// `(defunct`, `(definition`, and a bare `(defun` stay out.
fn is_lisp_defn(s: &str) -> bool {
    let s = s.trim_start();
    if s.starts_with(';') {
        return false;
    }
    let Some(rest) = s.strip_prefix('(') else {
        return false;
    };
    let rest = rest.trim_start();
    const FORMS: &[&str] = &[
        "define-syntax-rule",
        "define-syntax",
        "defmethod",
        "defgeneric",
        "defmacro",
        "defsubst",
        "defclass",
        "defstruct",
        "defprotocol",
        "defrecord",
        "defmulti",
        "defonce",
        "deftype",
        "defun",
        "defn-",
        "defn",
        "in-ns",
        "ns",
    ];
    for form in FORMS {
        if let Some(after) = lisp_form_word(rest, form) {
            return lisp_has_name(after);
        }
    }
    if let Some(after) = lisp_form_word(rest, "define") {
        return lisp_define_is_fn(after);
    }
    if let Some(after) = lisp_form_word(rest, "def") {
        return lisp_def_is_fn(after);
    }
    false
}

fn lisp_form_word<'a>(s: &'a str, word: &str) -> Option<&'a str> {
    let rest = sql_word(s, word)?;
    match rest.as_bytes().first() {
        Some(b) if b.is_ascii_whitespace() || *b == b'(' => Some(rest),
        _ => None,
    }
}

fn lisp_has_name(after: &str) -> bool {
    let after = after.trim_start().trim_start_matches(['\'', '`']);
    if let Some(inner) = after.strip_prefix('(') {
        return lisp_symbol_len(skip_lisp_meta(inner.trim_start())) > 0;
    }
    lisp_symbol_len(skip_lisp_meta(after)) > 0
}

fn skip_lisp_meta(s: &str) -> &str {
    let mut s = s.trim_start();
    while let Some(rest) = s.strip_prefix('^') {
        let rest = rest.trim_start();
        let n = rest
            .bytes()
            .take_while(|b| !b.is_ascii_whitespace() && *b != b'(' && *b != b'[')
            .count();
        if n == 0 {
            break;
        }
        s = rest[n..].trim_start();
    }
    s
}

fn lisp_symbol_len(s: &str) -> usize {
    let bytes = s.as_bytes();
    let Some(&first) = bytes.first() else {
        return 0;
    };
    if !(first.is_ascii_alphabetic()
        || matches!(
            first,
            b'_' | b'*' | b'+' | b'-' | b'/' | b'<' | b'>' | b'=' | b'!'
        ))
    {
        return 0;
    }
    bytes
        .iter()
        .take_while(|b| {
            b.is_ascii_alphanumeric()
                || matches!(
                    **b,
                    b'_' | b'-' | b'*' | b'+' | b'!' | b'?' | b'/' | b'<' | b'>' | b'=' | b'.'
                )
        })
        .count()
}

fn lisp_define_is_fn(after: &str) -> bool {
    let after = after.trim_start();
    if after.starts_with('(') {
        return lisp_has_name(after);
    }
    let after = skip_lisp_meta(after);
    let n = lisp_symbol_len(after);
    if n == 0 {
        return false;
    }
    lisp_lambda_or_fn(after[n..].trim_start())
}

fn lisp_def_is_fn(after: &str) -> bool {
    let after = skip_lisp_meta(after.trim_start());
    let n = lisp_symbol_len(after);
    if n == 0 {
        return false;
    }
    let Some(inner) = after[n..].trim_start().strip_prefix('(') else {
        return false;
    };
    lisp_fn_head(inner.trim_start())
}

fn lisp_lambda_or_fn(rest: &str) -> bool {
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    if inner.starts_with('λ') {
        return true;
    }
    if let Some(after) = sql_word(inner, "lambda") {
        return after.is_empty()
            || after.starts_with(char::is_whitespace)
            || after.starts_with('(')
            || after.starts_with('[');
    }
    lisp_fn_head(inner)
}

fn lisp_fn_head(inner: &str) -> bool {
    let Some(after_fn) = sql_word(inner, "fn") else {
        return false;
    };
    let after_fn = after_fn.strip_prefix('*').unwrap_or(after_fn);
    after_fn.is_empty()
        || after_fn.starts_with(char::is_whitespace)
        || after_fn.starts_with('[')
        || after_fn.starts_with('(')
}

/// R `mean <- function(x)`, `mean <<- function(x)`, `read.csv <- \(file)`.
/// The left side is one name (dots allowed). The right side is `function(`
/// or the R 4.1 `\(` form. `x <- 1`, `x <- functional(y)`, and `x < - function`
/// stay out.
fn is_r_function_assign(s: &str) -> bool {
    let Some((lhs, rhs)) = split_r_assign(s) else {
        return false;
    };
    if !is_r_binding_name(lhs) {
        return false;
    }
    let rhs = rhs.trim_start();
    if let Some(rest) = rhs.strip_prefix('\\') {
        return rest.trim_start().starts_with('(');
    }
    let Some(rest) = rhs.strip_prefix("function") else {
        return false;
    };
    if !rest.is_empty() && !rest.starts_with('(') && !rest.starts_with(char::is_whitespace) {
        return false;
    }
    rest.trim_start().starts_with('(')
}

fn split_r_assign(s: &str) -> Option<(&str, &str)> {
    let bytes = s.as_bytes();
    let mut i = 0;
    while i + 1 < bytes.len() {
        if bytes[i] == b'<' && bytes[i + 1] == b'-' {
            let lhs_end = if i > 0 && bytes[i - 1] == b'<' {
                i - 1
            } else {
                i
            };
            return Some((&s[..lhs_end], &s[i + 2..]));
        }
        i += 1;
    }
    None
}

fn is_r_binding_name(name: &str) -> bool {
    let name = name.trim();
    if name.is_empty() || is_control_word(name) {
        return false;
    }
    let mut chars = name.chars();
    match chars.next() {
        Some(c) if c == '_' || c == '.' || c.is_ascii_alphabetic() => {}
        _ => return false,
    }
    chars.all(|c| c == '_' || c == '.' || c.is_ascii_alphanumeric())
}

fn split_single_assign(s: &str) -> Option<(&str, &str)> {
    let idx = s.find('=')?;
    let bytes = s.as_bytes();
    if bytes.get(idx + 1) == Some(&b'=') || bytes.get(idx + 1) == Some(&b'>') {
        return None;
    }
    if idx > 0 && matches!(bytes[idx - 1], b'=' | b'!' | b'<' | b'>') {
        return None;
    }
    Some((&s[..idx], &s[idx + 1..]))
}

fn is_binding_name(name: &str) -> bool {
    let name = name.strip_prefix('#').unwrap_or(name);
    !name.is_empty() && is_fn_name(name) && !is_control_word(name)
}

fn strip_async_word(rhs: &str) -> &str {
    let Some(rest) = rhs.strip_prefix("async") else {
        return rhs;
    };
    if rest.starts_with('(') || rest.starts_with(char::is_whitespace) {
        rest.trim_start()
    } else {
        rhs
    }
}

fn arrow_params_ok(before: &str) -> bool {
    if before.is_empty() {
        return false;
    }
    if before.starts_with('(') {
        let Some(after) = after_balanced_paren(before, 0) else {
            return false;
        };
        let after = after.trim_start();
        return after.is_empty() || after.starts_with(':');
    }
    let name = before.split(':').next().unwrap_or("").trim();
    if name.is_empty() || !is_fn_name(name) || is_control_word(name) {
        return false;
    }
    let rest = before[name.len()..].trim_start();
    rest.is_empty() || rest.starts_with(':')
}

/// `greet(name) {`, `get count() {`, `Foo::bar() {`, `Widget() :`.
/// The parameter list must be followed by `{` or `:` (optional `const` /
/// `override` / `final`). `foo();` and `obj.method()` stay out.
fn is_brace_method_decl(s: &str) -> bool {
    let Some(open) = s.find('(') else {
        return false;
    };
    if !is_method_head(s[..open].trim()) {
        return false;
    }
    let Some(after) = after_balanced_paren(s, open) else {
        return false;
    };
    opens_method_body(after)
}

fn is_method_head(head: &str) -> bool {
    if head.is_empty()
        || head
            .bytes()
            .any(|b| matches!(b, b'=' | b';' | b'.' | b' ' | b'\t'))
    {
        return false;
    }
    let head = head.strip_prefix('#').unwrap_or(head);
    let mut rest = head;
    let mut saw = false;
    while !saw || !rest.is_empty() {
        let (piece, next) = match rest.split_once("::") {
            Some((piece, next)) => (piece, next),
            None => (rest, ""),
        };
        if piece.is_empty() {
            return false;
        }
        let piece = if next.is_empty() {
            piece.strip_prefix('~').unwrap_or(piece)
        } else {
            piece
        };
        if !is_fn_name(piece) || is_control_word(piece) {
            return false;
        }
        saw = true;
        if next.is_empty() {
            break;
        }
        rest = next;
    }
    saw
}

fn after_balanced_paren(s: &str, open: usize) -> Option<&str> {
    let bytes = s.as_bytes();
    if bytes.get(open) != Some(&b'(') {
        return None;
    }
    let mut depth = 0i32;
    for (i, b) in bytes.iter().enumerate().skip(open) {
        match b {
            b'(' => depth += 1,
            b')' => {
                depth -= 1;
                if depth == 0 {
                    return Some(&s[i + 1..]);
                }
            }
            _ => {}
        }
    }
    None
}

fn opens_method_body(after: &str) -> bool {
    let rest = after.trim_start();
    let rest = ["const", "override", "final"]
        .iter()
        .find_map(|qual| {
            let next = rest.strip_prefix(qual)?;
            (next.is_empty() || next.starts_with(char::is_whitespace)).then(|| next.trim_start())
        })
        .unwrap_or(rest);
    rest.starts_with('{') || rest.starts_with(':')
}

/// `void main(`, `int count(`, `String name(`, `unsigned long parse(`.
/// Needs a type token and a name before `(`. Rejects `foo(`, `obj.method(`,
/// `int x = f(`, and control-flow heads (`if`, `return`, `new`).
fn is_typed_fn_decl(s: &str) -> bool {
    let Some(paren) = s.find('(') else {
        return false;
    };
    let head = s[..paren].trim();
    if head.is_empty() || head.bytes().any(|b| matches!(b, b'=' | b';')) {
        return false;
    }
    let mut parts = head.split_whitespace();
    let Some(first) = parts.next() else {
        return false;
    };
    let Some(mut name) = parts.next() else {
        return false;
    };
    if !is_type_token(first) || is_control_word(first) {
        return false;
    }
    for tok in parts {
        if !is_type_token(name) || is_control_word(name) {
            return false;
        }
        name = tok;
    }
    is_qualified_fn_name(name)
}

/// `bar`, `Foo::bar`, or `Foo::~Foo`. Not `obj.method` (dot stays out).
fn is_qualified_fn_name(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    tok.split("::").all(|piece| {
        let piece = piece.strip_prefix('~').unwrap_or(piece);
        !piece.is_empty() && is_fn_name(piece) && !is_control_word(piece)
    })
}

fn is_control_word(tok: &str) -> bool {
    let bare = tok.trim_matches(['*', '&']);
    let key = bare.split([':', '<', '.']).next().unwrap_or(bare);
    NOT_TYPED_FN.iter().any(|w| key.eq_ignore_ascii_case(w))
}

fn is_type_token(tok: &str) -> bool {
    let t = tok.trim_matches(['*', '&']);
    let mut chars = t.chars();
    match chars.next() {
        Some(c) if c == '_' || c.is_ascii_alphabetic() => {}
        _ => return false,
    }
    chars.all(|c| {
        c.is_ascii_alphanumeric() || matches!(c, '_' | ':' | '.' | '<' | '>' | ',' | '[' | ']')
    })
}

fn is_fn_name(tok: &str) -> bool {
    let t = tok.trim_start_matches(['*', '&']);
    let mut chars = t.chars();
    match chars.next() {
        Some(c) if c == '_' || c.is_ascii_alphabetic() => {}
        _ => return false,
    }
    chars.all(|c| c == '_' || c.is_ascii_alphanumeric())
}

/// SQL `CREATE TABLE users`, `create or replace function public.foo(`,
/// `CREATE TEMPORARY VIEW v AS`, `CREATE UNIQUE INDEX IF NOT EXISTS idx`.
/// The object name may be dotted or quoted. `created`, `create a note`,
/// `CREATE` with no name, and `create tables` (plural) stay out.
fn is_sql_create(s: &str) -> bool {
    let Some(rest) = sql_word(s, "create") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    for _ in 0..6 {
        if let Some(after_or) = sql_word(rest, "or") {
            if after_or.starts_with(char::is_whitespace) {
                let after_or = after_or.trim_start();
                let Some(after_replace) = sql_word(after_or, "replace") else {
                    break;
                };
                if !after_replace.starts_with(char::is_whitespace) {
                    return false;
                }
                rest = after_replace.trim_start();
                continue;
            }
        }
        let mut advanced = false;
        for qual in [
            "unique",
            "temp",
            "temporary",
            "materialized",
            "global",
            "local",
            "unlogged",
        ] {
            if let Some(after) = sql_word(rest, qual) {
                if after.starts_with(char::is_whitespace) {
                    rest = after.trim_start();
                    advanced = true;
                    break;
                }
            }
        }
        if !advanced {
            break;
        }
    }
    const KINDS: &[&str] = &[
        "table",
        "view",
        "function",
        "procedure",
        "trigger",
        "index",
        "schema",
        "type",
    ];
    let mut after_kind = None;
    for kind in KINDS {
        if let Some(after) = sql_word(rest, kind) {
            if after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('(')
            {
                after_kind = Some(after);
                break;
            }
        }
    }
    let Some(after) = after_kind else {
        return false;
    };
    sql_object_name(strip_if_not_exists(after.trim_start()))
}

fn sql_word<'a>(s: &'a str, word: &str) -> Option<&'a str> {
    // `word` is ASCII; reject mid-codepoint cuts so unicode source lines do not panic.
    if s.len() < word.len() || !s.is_char_boundary(word.len()) {
        return None;
    }
    if !s[..word.len()].eq_ignore_ascii_case(word) {
        return None;
    }
    Some(&s[word.len()..])
}

fn strip_if_not_exists(s: &str) -> &str {
    let Some(after_if) = sql_word(s, "if") else {
        return s;
    };
    if !after_if.starts_with(char::is_whitespace) {
        return s;
    }
    let after_if = after_if.trim_start();
    let Some(after_not) = sql_word(after_if, "not") else {
        return s;
    };
    if !after_not.starts_with(char::is_whitespace) {
        return s;
    }
    let after_not = after_not.trim_start();
    let Some(after_exists) = sql_word(after_not, "exists") else {
        return s;
    };
    if after_exists.is_empty() || after_exists.starts_with(char::is_whitespace) {
        after_exists.trim_start()
    } else {
        s
    }
}

fn sql_object_name(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() {
        return false;
    }
    let bytes = s.as_bytes();
    if matches!(bytes[0], b'"' | b'`' | b'[') {
        let close = if bytes[0] == b'[' { b']' } else { bytes[0] };
        let inner = &bytes[1..];
        return inner
            .iter()
            .position(|b| *b == close)
            .is_some_and(|end| end > 0);
    }
    let mut rest = s;
    loop {
        let n = rest
            .bytes()
            .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
            .count();
        if n == 0 {
            return false;
        }
        let first = rest.as_bytes()[0];
        if !(first == b'_' || first.is_ascii_alphabetic()) {
            return false;
        }
        rest = &rest[n..];
        if let Some(next) = rest.strip_prefix('.') {
            rest = next;
            continue;
        }
        return true;
    }
}

/// Haskell `data Tree`, `newtype Name`, `instance Show Foo`, `instance (Eq a)`.
/// The next token must start with an uppercase letter or `(`. `data class`
/// (Kotlin) and prose (`data stays`, `instance of`) stay out so `data` can
/// still be stripped as a qualifier.
fn is_haskell_decl(s: &str) -> bool {
    let lower = s.to_ascii_lowercase();
    for key in ["newtype", "instance", "data"] {
        let Some(rest) = lower.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let orig = s[key.len()..].trim_start();
        return match orig.chars().next() {
            Some('(') => true,
            Some(c) if c.is_ascii_uppercase() => true,
            _ => false,
        };
    }
    false
}

/// Scala `case class User(name: String)` and `case object Empty`.
/// `sealed` / `abstract` / `final` are stripped earlier. Python match arms
/// (`case Point(x):`, `case 1:`), bare `case class`, `case classes`, and
/// `case object oriented` stay out.
fn is_scala_case_decl(s: &str) -> bool {
    let Some(rest) = sql_word(s, "case") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if let Some(after) = sql_word(rest, "class") {
        if scala_kind_boundary(after) {
            return scala_type_name(after.trim_start());
        }
    }
    if let Some(after) = sql_word(rest, "object") {
        if scala_kind_boundary(after) {
            return scala_object_name(after.trim_start());
        }
    }
    false
}

fn scala_kind_boundary(after: &str) -> bool {
    after.is_empty()
        || after.starts_with(char::is_whitespace)
        || matches!(after.as_bytes().first(), Some(b'(' | b'[' | b'{'))
}

fn scala_type_name(s: &str) -> bool {
    let s = s.trim_start();
    if let Some(inner) = s.strip_prefix('`') {
        return inner.find('`').is_some_and(|end| end > 0);
    }
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    first == b'_' || first.is_ascii_alphabetic()
}

fn scala_object_name(s: &str) -> bool {
    let s = s.trim_start();
    match s.chars().next() {
        Some('{') | Some(':') => true,
        Some('`') => scala_type_name(s),
        Some(c) if c.is_ascii_uppercase() || c == '_' => scala_type_name(s),
        _ => false,
    }
}

/// F# `member this.Greet(name)`, `static member Create()`,
/// `abstract member Draw : unit -> unit`, `override this.ToString()`,
/// `default this.Add(x)`. `member of`, `members`, `membership`, and a C#
/// `override ToString()` stay out. Kotlin `override fun` still counts as `fun`.
fn is_fsharp_member(s: &str) -> bool {
    let mut rest = s.trim_start();
    let mut saw_member = false;
    let mut saw_override = false;
    for _ in 0..6 {
        if let Some(after) = fsharp_kw(rest, "member") {
            saw_member = true;
            rest = after.trim_start();
            continue;
        }
        let mut peeled = false;
        for word in [
            "static", "abstract", "inline", "private", "internal", "public",
        ] {
            if let Some(after) = fsharp_kw(rest, word) {
                rest = after.trim_start();
                peeled = true;
                break;
            }
        }
        if peeled {
            continue;
        }
        for word in ["override", "default"] {
            if let Some(after) = fsharp_kw(rest, word) {
                saw_override = true;
                rest = after.trim_start();
                peeled = true;
                break;
            }
        }
        if !peeled {
            break;
        }
    }
    if !saw_member && !saw_override {
        return false;
    }
    fsharp_member_tail(rest, saw_member)
}

fn fsharp_kw<'a>(s: &'a str, word: &str) -> Option<&'a str> {
    let after = sql_word(s, word)?;
    if after.is_empty() || after.starts_with(char::is_whitespace) {
        Some(after)
    } else {
        None
    }
}

fn fsharp_member_tail(s: &str, allow_colon: bool) -> bool {
    let n = fsharp_ident_len(s);
    if n == 0 || is_control_word(&s[..n]) {
        return false;
    }
    let after = s[n..].trim_start();
    if let Some(after_dot) = after.strip_prefix('.') {
        let after_dot = after_dot.trim_start();
        let m = fsharp_ident_len(after_dot);
        return m > 0 && !is_control_word(&after_dot[..m]);
    }
    if allow_colon && after.starts_with(':') {
        let first = s.as_bytes()[0];
        return first.is_ascii_uppercase() || first == b'_';
    }
    false
}

fn fsharp_ident_len(s: &str) -> usize {
    let bytes = s.as_bytes();
    let Some(&first) = bytes.first() else {
        return 0;
    };
    if !(first.is_ascii_alphabetic() || first == b'_') {
        return 0;
    }
    bytes
        .iter()
        .take_while(|b| b.is_ascii_alphanumeric() || **b == b'_')
        .count()
}

/// Kotlin / Scala `object Name`, `object {`, or `object :`. Not the word `objective`
/// and not prose such as `object oriented`.
fn is_object_decl(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("object") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    match rest.chars().next() {
        Some('{') | Some(':') => true,
        Some(c) if c.is_uppercase() => true,
        _ => false,
    }
}

/// Drop one leading qualifier. Returns `s` when nothing matches.
fn strip_func_like_prefix(s: &str) -> &str {
    if let Some(rest) = strip_pub_visibility(s) {
        return rest;
    }
    if let Some(rest) = strip_extern_abi(s) {
        return rest;
    }
    for m in FUNC_LIKE_MODS {
        if let Some(rest) = s.strip_prefix(m) {
            return rest.trim_start();
        }
    }
    s
}

/// `pub`, `pub(crate)`, `pub(super)`, or `pub(in path)`. Not the word `public`.
fn strip_pub_visibility(s: &str) -> Option<&str> {
    let rest = s.strip_prefix("pub")?;
    if rest.starts_with('(') {
        let end = rest.find(')')?;
        return Some(rest[end + 1..].trim_start());
    }
    if rest.is_empty() || rest.starts_with(char::is_whitespace) {
        return Some(rest.trim_start());
    }
    None
}

/// `extern`, `extern "C"`, or `extern "system"`. Not a mid-line `extern`.
fn strip_extern_abi(s: &str) -> Option<&str> {
    let rest = s.strip_prefix("extern")?;
    let rest = rest.trim_start();
    if let Some(after_quote) = rest.strip_prefix('"') {
        let end = after_quote.find('"')?;
        return Some(after_quote[end + 1..].trim_start());
    }
    if rest.is_empty() || rest.starts_with(char::is_whitespace) {
        return Some(rest);
    }
    None
}
