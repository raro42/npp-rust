fn interrogate_ini_bool_ok(value: &str) -> bool {
    matches!(
        value,
        "True" | "False" | "true" | "false" | "yes" | "no" | "1" | "0"
    )
}

fn interrogate_ini_number_ok(value: &str) -> bool {
    if value.is_empty() {
        return false;
    }
    let mut saw_digit = false;
    let mut saw_dot = false;
    for b in value.bytes() {
        if b.is_ascii_digit() {
            saw_digit = true;
        } else if b == b'.' {
            if saw_dot {
                return false;
            }
            saw_dot = true;
        } else {
            return false;
        }
    }
    saw_digit
}

fn interrogate_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if key == "fail-under" {
        return interrogate_ini_number_ok(value);
    }
    if key == "badge-format" {
        return matches!(value, "svg" | "png");
    }
    if matches!(
        key,
        "ignore-init-method"
            | "ignore-init-module"
            | "ignore-magic"
            | "ignore-semiprivate"
            | "ignore-private"
            | "ignore-property-decorators"
            | "ignore-module"
            | "ignore-nested-functions"
            | "ignore-nested-classes"
            | "ignore-setters"
            | "ignore-overloaded-functions"
            | "omit-covered-files"
    ) {
        return interrogate_ini_bool_ok(value);
    }
    // ignore-regex / whitelist-regex / generate-badge: regex or path
    // (`.` alone is a valid badge output dir).
    let mut has_token = false;
    for b in value.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if b.is_ascii_alphanumeric()
            || b == b'_'
            || b == b'.'
            || b == b'/'
            || b == b'*'
            || b == b'^'
            || b == b'$'
        {
            has_token = true;
        }
    }
    has_token
}

