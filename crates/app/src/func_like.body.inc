/// `"vector_column_name"` / Milvus `"annsField"` / Chroma `"n_results"` /
/// Pinecone `"topK"` / Weaviate `"nearVector"` / `"invertedIndexConfig"` /
/// Qdrant `"vectors_count"` / Algolia `"processingTimeMS"` / Meilisearch
/// `"processingTimeMs"` / Typesense `"search_time_ms"` / Solr
/// `"responseHeader"` / Elasticsearch `"track_total_hits"` / DocSearch
/// `"maxResultsPerGroup"` / `"disableUserPersonalization"` /
/// `"recentSearchesLimit"` / `"recentSearchesWithFavoritesLimit"` /
/// `"resultBadgeKey"` / `"insights"` / `"initialQuery"` / `"indices"` /
/// prettier `"printWidth"` / karma `"basePath"` stay out. String keys
/// require a non-empty quoted string. Enum keys only match
/// `Ignore` / `Omit` / `Parse` / `Minimal` / `Moderate` / `Large` /
/// `Ridiculous` / `PlainText` / `SRTSubtitle` / `HTML` / `Markdown` /
/// `NumberOfSeconds` / `MinutesAndSeconds`. Object `"srt_config"` /
/// `"resultNoun"` / `"strings"` and JS callback keys (`generateMessage`,
/// `onQueryUpdate`, …) require `{`. Bool keys only match `true` / `false`.
/// Numeric keys reject leading zeros beyond `0`. Coveo `"numberOfResults"` /
/// `"excerptLength"` stay out of Stork.
fn is_stork_json_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let key = &rest[..end];
    if !stork_json_key_ok(key) {
        return false;
    }
    let after_key = rest[end + 1..].trim_start();
    let Some(after_colon) = after_key.strip_prefix(':') else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    stork_json_value_and_tail_ok(key, after_colon)
}

fn stork_json_key_ok(key: &str) -> bool {
    matches!(
        key,
        "exclude_html_selector"
            | "frontmatter_handling"
            | "excerpts_per_result"
            | "displayed_results_count"
