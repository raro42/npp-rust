}

/// Metal scalars / vectors, or a Capitalized / `_`-prefixed user type.
/// Rejects prose like `device the buffer` / `vertex the shader`.
fn metal_type_name_ok(ty: &str) -> bool {
    if opencl_type_name_ok(ty) || hlsl_type_name_ok(ty) {
        return true;
    }
    let lower = ty.to_ascii_lowercase();
    matches!(
        lower.as_str(),
        "float2x2"
            | "float3x3"
            | "float4x4"
            | "float3x4"
            | "float4x3"
            | "half2x2"
            | "half3x3"
            | "half4x4"
            | "packed_float3"
            | "packed_float4"
            | "simdgroup_float8x8"
            | "atomic_uint"
            | "atomic_int"
            | "metal::float4"
    ) || metal_vector_type(&lower)
}

/// Pony `be ping() =>`, `new create(env: Env) =>`, optional capability
/// before the name (`new iso create() =>`, `be tag receive(msg) =>`),
/// and Capitalized `primitive Foo`. Requires `=>` (or `{`) after params
/// so JS `new Foo()` stays out. Verilog `primitive udp_and (` stays on
/// the Verilog path (lowercase name + `(`).
fn is_pony_decl(s: &str) -> bool {
    is_pony_be(s) || is_pony_new(s) || is_pony_primitive(s)
}

fn is_pony_be(s: &str) -> bool {
    let Some(rest) = sql_word(s, "be") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    pony_method_after_keyword(rest.trim_start())
}

fn is_pony_new(s: &str) -> bool {
    let Some(rest) = sql_word(s, "new") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    pony_method_after_keyword(rest.trim_start())
}

fn pony_method_after_keyword(s: &str) -> bool {
    let rest = strip_pony_cap(s);
    let Some(open) = rest.find('(') else {
        return false;
    };
    let head = rest[..open].trim();
    if head.is_empty() || head.contains(char::is_whitespace) {
        return false;
    }
    if head.eq_ignore_ascii_case("the") || is_control_word(head) || !is_fn_name(head) {
        return false;
    }
    let Some(after) = after_balanced_paren(rest, open) else {
        return false;
    };
    pony_arrow_body(after)
}

fn strip_pony_cap(s: &str) -> &str {
    for cap in ["iso", "trn", "ref", "val", "box", "tag"] {
        let Some(after) = sql_word(s, cap) else {
            continue;
        };
        if after.starts_with(char::is_whitespace) {
            return after.trim_start();
        }
    }
    s
}

fn pony_arrow_body(after: &str) -> bool {
    let rest = after.trim_start();
    if rest.starts_with("=>") || rest.starts_with('{') {
        return true;
    }
    if !rest.starts_with(':') {
        return false;
    }
    // `: Type =>` or `: Type ? =>`
    rest.contains("=>")
}

fn is_pony_primitive(s: &str) -> bool {
    let Some(rest) = sql_word(s, "primitive") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || !name.starts_with(|c: char| c.is_ascii_uppercase()) {
        return false;
    }
    let after = after.trim_start();
    // Verilog `primitive udp_and (` uses a lowercase name; Capitalized + `(`
    // is not a Pony primitive form either.
    if after.starts_with('(') {
        return false;
    }
    after.is_empty()
        || after.starts_with('[')
        || after.starts_with("//")
        || after.starts_with("/*")
        || sql_word(after, "is").is_some_and(|a| a.is_empty() || a.starts_with(char::is_whitespace))
}

/// Cython `cdef int add(`, `cpdef float mul(`, `cdef class Point:`,
/// `cdef packed struct Foo:`, `cdef enum Color:`, `cdef extern from "h":`,
/// `ctypedef int my_int` / `ctypedef struct Foo:`. Optional modifiers
/// `inline` / `nogil` / `gil` / `api` / `public` / `readonly`. Prose and
/// bare keywords stay out. Plain `def` / `class` / `struct` / `typedef`
/// stay on the generic prefix keys.
fn is_cython_decl(s: &str) -> bool {
    is_cython_cdef_cpdef(s) || is_cython_ctypedef(s)
}

fn is_cython_cdef_cpdef(s: &str) -> bool {
    for key in ["cdef", "cpdef"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        return cython_after_cdef(rest.trim_start());
    }
    false
}

fn cython_after_cdef(s: &str) -> bool {
    if is_cython_extern_from(s) {
        return true;
    }
    let rest = strip_cython_mods(s);
    if rest.is_empty() {
        return false;
    }
    is_cython_class(rest)
        || is_cython_aggregate(rest)
        || is_typed_fn_decl(rest)
        || is_cython_typed_var(rest)
}

fn strip_cython_mods(s: &str) -> &str {
    let mut rest = s;
    for _ in 0..6 {
        let mut stripped = false;
        for m in ["inline", "nogil", "gil", "api", "public", "readonly"] {
            let Some(after) = sql_word(rest, m) else {
                continue;
            };
            if !after.starts_with(char::is_whitespace) {
                continue;
            }
            rest = after.trim_start();
            stripped = true;
            break;
        }
        if !stripped {
            break;
        }
    }
    rest
}

fn is_cython_extern_from(s: &str) -> bool {
    let Some(rest) = sql_word(s, "extern") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(rest) = sql_word(rest, "from") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if let Some(after_star) = rest.strip_prefix('*') {
        let after = after_star.trim_start();
        return after.is_empty()
            || after.starts_with(':')
            || after.starts_with("//")
            || after.starts_with("/*")
            || sql_word(after, "nogil").is_some_and(|a| {
                a.is_empty() || a.starts_with(char::is_whitespace) || a.starts_with(':')
            });
    }
    let quote = match rest.as_bytes().first() {
        Some(b'"') => '"',
        Some(b'\'') => '\'',
        _ => return false,
    };
    let Some(end) = rest[1..].find(quote) else {
        return false;
    };
    let after = rest[end + 2..].trim_start();
    after.is_empty()
        || after.starts_with(':')
        || after.starts_with("//")
        || after.starts_with("/*")
        || sql_word(after, "nogil").is_some_and(|a| {
            a.is_empty() || a.starts_with(char::is_whitespace) || a.starts_with(':')
        })
}

fn is_cython_class(s: &str) -> bool {
    let Some(rest) = sql_word(s, "class") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with(':')
        || after.starts_with('(')
        || after.starts_with("//")
        || after.starts_with("/*")
}

fn is_cython_aggregate(s: &str) -> bool {
    let rest = if let Some(after) = sql_word(s, "packed") {
        if !after.starts_with(char::is_whitespace) {
            return false;
        }
        after.trim_start()
    } else {
        s
    };
    for key in ["struct", "union", "enum"] {
        let Some(after) = sql_word(rest, key) else {
            continue;
        };
        if !after.starts_with(char::is_whitespace) {
            // `cdef struct:` anonymous is rare; require a name.
            return false;
        }
        let Some((name, tail)) = graphql_ident(after.trim_start()) else {
            return false;
        };
        if name.eq_ignore_ascii_case("the") || is_control_word(name) {
            return false;
        }
        let tail = tail.trim_start();
        return tail.is_empty()
            || tail.starts_with(':')
            || tail.starts_with('{')
            || tail.starts_with("//")
            || tail.starts_with("/*");
    }
    false
}

fn is_cython_typed_var(s: &str) -> bool {
    let Some((ty, after_ty)) = graphql_ident(s) else {
        return false;
    };
    if !cython_type_name_ok(ty) {
        return false;
    }
    let name_src = after_ty
        .trim_start()
        .trim_start_matches(['*', '&'])
        .trim_start();
    if name_src.is_empty() {
        return false;
    }
    // Functions go through `is_typed_fn_decl`.
    if name_src.contains('(') {
        return false;
    }
    let Some((name, after)) = graphql_ident(name_src) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with(':')
        || after.starts_with(';')
        || after.starts_with('[')
        || after.starts_with('=')
        || after.starts_with(',')
        || after.starts_with("//")
        || after.starts_with("/*")
}

fn cython_type_name_ok(ty: &str) -> bool {
    if cuda_type_name_ok(ty) {
        return true;
    }
    let lower = ty.to_ascii_lowercase();
    matches!(
        lower.as_str(),
        "bint"
            | "object"
            | "str"
            | "bytes"
            | "unicode"
            | "list"
            | "dict"
            | "tuple"
            | "set"
            | "frozenset"
            | "complex"
            | "py_ssize_t"
            | "py_hash_t"
            | "py_ucs4"
    )
}

fn is_cython_ctypedef(s: &str) -> bool {
    let Some(rest) = sql_word(s, "ctypedef") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() {
        return false;
    }
    if is_cython_aggregate(rest) || is_cython_fused(rest) {
        return true;
    }
    // `ctypedef int my_int` / `ctypedef unsigned long ulong_t`
    is_cython_typed_var(rest) || is_cython_ctypedef_alias(rest)
}

fn is_cython_fused(s: &str) -> bool {
    let Some(rest) = sql_word(s, "fused") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    after.is_empty() || after.starts_with(':') || after.starts_with("//") || after.starts_with("/*")
}

fn is_cython_ctypedef_alias(s: &str) -> bool {
    // Multi-token type then name: `ctypedef unsigned long my_ulong`
    if s.contains('(') {
        return false;
    }
    let parts: Vec<&str> = s.split_whitespace().collect();
    if parts.len() < 2 {
        return false;
    }
    let name = parts[parts.len() - 1];
    let ty_parts = &parts[..parts.len() - 1];
    if name.eq_ignore_ascii_case("the") || is_control_word(name) || !is_fn_name(name) {
        return false;
    }
    ty_parts.iter().all(|t| {
        is_type_token(t)
            || matches!(
                t.to_ascii_lowercase().as_str(),
                "unsigned" | "signed" | "long" | "short" | "const" | "volatile"
            )
    })
}

/// Nim `converter toBool(x: int): bool =`, `template max(x, y): untyped =`,
/// `template foo =`, optional export `*` / `[T]` after the name.
/// C++ `template<…>` does not match (no whitespace after `template`).
/// Prose and bare keywords stay out. `proc` / `method` / `iterator` /
/// `func` / `macro` stay on the generic prefix keys.
fn is_nim_decl(s: &str) -> bool {
    is_nim_keyword_decl(s, "converter") || is_nim_keyword_decl(s, "template")
}

/// Standard ML `structure Foo = struct`, `structure Foo :> FOO =`,
/// `structure Foo : FOO =`, `signature FOO = sig`,
/// `functor Make (Elem: ORD) = struct`, `functor F =`.
/// Lean `structure Point where` stays on Lean. Smithy `structure City {`
/// stays on Smithy. Prose and bare keywords stay out.
fn is_sml_decl(s: &str) -> bool {
    is_sml_keyword_decl(s, "structure", false)
        || is_sml_keyword_decl(s, "signature", false)
        || is_sml_keyword_decl(s, "functor", true)
}

fn is_sml_keyword_decl(s: &str, key: &str, allow_paren: bool) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    sml_name_then_bind(rest.trim_start(), allow_paren)
}

/// D `unittest {`, `unittest "add" {`, `unittest Foo {`,
/// `mixin template Name()`, `mixin template Name {`,
/// `static this()`, `static ~this()`, `shared static this()`,
/// `shared static ~this()`. Prose and bare keywords stay out.
/// Nim `template` stays on Nim. `class` / `struct` / `interface` /
/// `enum` stay on the generic prefix keys.
fn is_d_decl(s: &str) -> bool {
    is_d_unittest(s) || is_d_mixin_template(s) || is_d_module_ctor(s)
}

fn is_d_unittest(s: &str) -> bool {
    let Some(rest) = sql_word(s, "unittest") else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{')) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() {
        return false;
    }
    if rest.starts_with('{') || rest.starts_with("//") || rest.starts_with("/*") {
        return true;
    }
    if let Some(after_q) = rest.strip_prefix('"') {
        let Some(end) = after_q.find('"') else {
            return false;
        };
        let after = after_q[end + 1..].trim_start();
        return after.is_empty()
            || after.starts_with('{')
            || after.starts_with("//")
            || after.starts_with("/*");
    }
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    let stopped = after.is_empty()
        || after.starts_with('{')
        || after.starts_with("//")
        || after.starts_with("/*");
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return after.starts_with('{');
    }
    true
}

fn is_d_mixin_template(s: &str) -> bool {
    let Some(after_mixin) = sql_word(s, "mixin") else {
        return false;
    };
    if !after_mixin.starts_with(char::is_whitespace) {
        return false;
    }
    let after_mixin = after_mixin.trim_start();
    let Some(after_template) = sql_word(after_mixin, "template") else {
        return false;
    };
    if !after_template.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = after_template.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with('(')
        || after.starts_with('{')
        || after.starts_with("//")
        || after.starts_with("/*")
}

fn is_d_module_ctor(s: &str) -> bool {
    let mut rest = s;
    if let Some(after_shared) = sql_word(rest, "shared") {
        if after_shared.starts_with(char::is_whitespace) {
            rest = after_shared.trim_start();
        }
    }
    let Some(after_static) = sql_word(rest, "static") else {
        return false;
    };
    if !after_static.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = after_static.trim_start();
    let rest = if let Some(after_tilde) = rest.strip_prefix('~') {
        after_tilde
    } else {
        rest
    };
    let Some(after_this) = sql_word(rest, "this") else {
        return false;
    };
    let after_this = after_this.trim_start();
    after_this.starts_with('(')
        || after_this.starts_with('{')
        || after_this.is_empty()
        || after_this.starts_with("//")
        || after_this.starts_with("/*")
}

/// Ada `task Buffer is`, `task type Worker is`, `task body Buffer is`,
/// `protected Counter is`, `protected type Lock is`,
/// `protected body Counter is`. Optional discriminant `(…)` before `is`.
/// Verilog `task do_reset;` stays on Verilog. Prose and bare keywords stay out.
/// `procedure` / `function` / `package` stay on the generic prefix keys.
fn is_ada_decl(s: &str) -> bool {
    is_ada_keyword_unit(s, "task") || is_ada_keyword_unit(s, "protected")
}

fn is_ada_keyword_unit(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    for kind in ["type", "body"] {
        if let Some(after) = sql_word(rest, kind) {
            if after.starts_with(char::is_whitespace) {
                rest = after.trim_start();
                break;
            }
        }
    }
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let mut rest = after.trim_start();
    if rest.starts_with('(') {
        let Some(close) = rest.find(')') else {
            return false;
        };
        rest = rest[close + 1..].trim_start();
    }
    ada_ends_with_is(rest)
}

fn ada_ends_with_is(rest: &str) -> bool {
    let Some(after_is) = sql_word(rest, "is") else {
        return false;
    };
    after_is.is_empty()
        || after_is.starts_with(char::is_whitespace)
        || after_is.starts_with("--")
        || after_is.starts_with("//")
        || after_is.starts_with("/*")
}

/// Fortran `program Main`, `block data` / `block data Init`,
/// `submodule (Parent) Child`. `subroutine` / `function` / `module` /
/// `interface` stay on the generic prefix keys. Prose and bare keywords stay out.
fn is_fortran_decl(s: &str) -> bool {
    is_fortran_program(s) || is_fortran_block_data(s) || is_fortran_submodule(s)
}

fn is_fortran_program(s: &str) -> bool {
    let Some(rest) = sql_word(s, "program") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    fortran_unit_name(rest.trim_start())
}

fn is_fortran_block_data(s: &str) -> bool {
    let Some(rest) = sql_word(s, "block") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some(after_data) = sql_word(rest.trim_start(), "data") else {
        return false;
    };
    // Word boundary after `data` (reject `block datas`).
    if !after_data.is_empty()
        && !after_data.starts_with(char::is_whitespace)
        && !after_data.starts_with('!')
        && !after_data.starts_with("//")
        && !after_data.starts_with("/*")
    {
        return false;
    }
    // Unnamed `block data` is a valid Fortran unit.
    let rest = after_data.trim_start();
    if rest.is_empty() || rest.starts_with('!') || rest.starts_with("//") || rest.starts_with("/*")
    {
        return true;
    }
    fortran_unit_name(rest)
}

fn is_fortran_submodule(s: &str) -> bool {
    let Some(rest) = sql_word(s, "submodule") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if !rest.starts_with('(') {
        return false;
    }
    let Some(close) = rest.find(')') else {
        return false;
    };
    let inner = &rest[1..close];
    if inner.trim().is_empty() {
        return false;
    }
    fortran_unit_name(rest[close + 1..].trim_start())
}

fn fortran_unit_name(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let rest = after.trim_start();
    rest.is_empty() || rest.starts_with('!') || rest.starts_with("//") || rest.starts_with("/*")
}

/// Tcl `oo::class create Greeter`, `oo::define Greeter`, `coroutine tick …`.
/// `proc` / `namespace` stay on the generic prefix keys. Prose and bare
/// keywords stay out.
fn is_tcl_decl(s: &str) -> bool {
    is_tcl_oo_class_create(s) || is_tcl_oo_define(s) || is_tcl_coroutine(s)
}

fn is_tcl_oo_class_create(s: &str) -> bool {
    let Some(rest) = tcl_strip_prefix(s, "oo::class") else {
        return false;
    };
    let Some(after_create) = sql_word(rest, "create") else {
        return false;
    };
    if !after_create.starts_with(char::is_whitespace) {
        return false;
    }
    tcl_named_tail(after_create.trim_start())
}

fn is_tcl_oo_define(s: &str) -> bool {
    let Some(rest) = tcl_strip_prefix(s, "oo::define") else {
        return false;
    };
    tcl_named_tail(rest)
}

fn is_tcl_coroutine(s: &str) -> bool {
    let Some(rest) = sql_word(s, "coroutine") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    // Require a following command word so prose `coroutine the tick` stays out
    // and bare `coroutine` stays out. Name may be followed by more Tcl words.
    let rest = rest.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    // Bare `coroutine tick` is rare; prefer a second word, `::cmd`, or `{` body.
    !after.is_empty()
        && (after.starts_with('{')
            || after.starts_with('[')
            || after.starts_with("::")
            || graphql_ident(after).is_some())
}

fn tcl_strip_prefix<'a>(s: &'a str, prefix: &str) -> Option<&'a str> {
    if s.len() < prefix.len() || !s.is_char_boundary(prefix.len()) {
        return None;
    }
    if !s[..prefix.len()].eq_ignore_ascii_case(prefix) {
        return None;
    }
    let rest = &s[prefix.len()..];
    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
        return None;
    }
    Some(rest.trim_start())
}

fn tcl_named_tail(s: &str) -> bool {
    // Allow `::app::Greeter` / `Greeter` / `#auto`.
    let s = s.trim_start();
    if let Some(rest) = s.strip_prefix('#') {
        let rest = rest.trim_start();
        return graphql_ident(rest).is_some_and(|(name, after)| {
            !name.eq_ignore_ascii_case("the")
                && !is_control_word(name)
                && tcl_name_after_ok(after.trim_start())
        });
    }
    let mut rest = s;
    // Leading `::` absolute path.
    if let Some(after) = rest.strip_prefix("::") {
        rest = after;
    }
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let mut after = after;
    // Nested `foo::bar::Baz`.
    while let Some(next) = after.strip_prefix("::") {
        let Some((piece, tail)) = graphql_ident(next) else {
            return false;
        };
        if piece.eq_ignore_ascii_case("the") || is_control_word(piece) {
            return false;
        }
        after = tail;
    }
    tcl_name_after_ok(after.trim_start())
}

fn tcl_name_after_ok(rest: &str) -> bool {
    rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('[')
        || rest.starts_with('#')
        || rest.starts_with("//")
        || rest.starts_with("/*")
        || graphql_ident(rest).is_some()
}

/// Vimscript `function! s:Foo(`, `def! Bar(`, `augroup mygroup`,
/// `command! -nargs=1 MyCmd`. Plain `function` / `def` stay on the generic
/// prefix keys. `augroup END`, prose, and bare keywords stay out.
fn is_vimscript_decl(s: &str) -> bool {
    is_vim_function_bang(s) || is_vim_def_bang(s) || is_vim_augroup(s) || is_vim_command(s)
}

fn is_vim_function_bang(s: &str) -> bool {
    let Some(rest) = sql_word(s, "function") else {
        return false;
    };
    let Some(rest) = rest.strip_prefix('!') else {
        return false;
    };
    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
        return false;
    }
    vim_fn_name_then_paren(rest.trim_start())
}

fn is_vim_def_bang(s: &str) -> bool {
    let Some(rest) = sql_word(s, "def") else {
        return false;
    };
    let Some(rest) = rest.strip_prefix('!') else {
        return false;
    };
    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
        return false;
    }
    vim_fn_name_then_paren(rest.trim_start())
}

fn is_vim_augroup(s: &str) -> bool {
    let Some(rest) = sql_word(s, "augroup") else {
        return false;
    };
    let rest = match rest.strip_prefix('!') {
        Some(r) => r,
        None => rest,
    };
    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("end") || name.eq_ignore_ascii_case("the") || is_control_word(name)
    {
        return false;
    }
    vim_line_tail_ok(after.trim_start())
}

fn is_vim_command(s: &str) -> bool {
    let Some(rest) = sql_word(s, "command") else {
        return false;
    };
    let rest = match rest.strip_prefix('!') {
        Some(r) => r,
        None => rest,
    };
    if !rest.is_empty() && !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    // Optional `-nargs=*` / `-bang` / `-complete=file` attrs before the name.
    for _ in 0..16 {
        if !rest.starts_with('-') {
            break;
        }
        let after_dash = &rest[1..];
        let n = after_dash
            .bytes()
            .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
            .count();
        if n == 0 {
            return false;
        }
        rest = &after_dash[n..];
        if let Some(after_eq) = rest.strip_prefix('=') {
            // Value may be bare word, or `<…>`, or comma-list without spaces.
            let val_n = after_eq
                .bytes()
                .take_while(|b| {
                    b.is_ascii_alphanumeric()
                        || matches!(*b, b'_' | b'-' | b',' | b'<' | b'>' | b':' | b'.')
                })
                .count();
            if val_n == 0 {
                return false;
            }
            rest = after_eq[val_n..].trim_start();
        } else {
            rest = rest.trim_start();
        }
    }
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    // User-defined commands must start with an uppercase letter.
    if !name.as_bytes()[0].is_ascii_uppercase()
        || name.eq_ignore_ascii_case("the")
        || is_control_word(name)
    {
        return false;
    }
    let after = after.trim_start();
    // Require a replacement / body cue so bare `command Foo` prose stays weak,
    // but allow EOL and Vim comments.
    after.is_empty()
        || after.starts_with('"')
        || after.starts_with('|')
        || after.starts_with("//")
        || after.starts_with("/*")
        || after.starts_with(':')
        || graphql_ident(after).is_some()
        || after.starts_with('<')
}

fn vim_fn_name_then_paren(s: &str) -> bool {
    let s = s.trim_start();
    // Optional `<SID>` before a script-local name.
    let s = if let Some(rest) = s.strip_prefix("<SID>") {
        rest
    } else if let Some(rest) = s.strip_prefix("<sid>") {
        rest
    } else {
        s
    };
    // Optional single-letter scope `s:` / `g:` / `b:` / `w:` / `t:`.
    let s = if s.len() >= 2
        && matches!(s.as_bytes()[0], b's' | b'g' | b'b' | b'w' | b't' | b'v')
        && s.as_bytes()[1] == b':'
    {
        &s[2..]
    } else {
        s
    };
    // Autoload path: `foo#bar#Baz` or a plain name.
    let mut rest = s;
    let mut pieces = 0usize;
    loop {
        let Some((piece, after)) = graphql_ident(rest) else {
            return false;
        };
        if piece.eq_ignore_ascii_case("the") || is_control_word(piece) {
            return false;
        }
        pieces += 1;
        if let Some(next) = after.strip_prefix('#') {
            rest = next;
            continue;
        }
        let after = after.trim_start();
        return pieces > 0 && after.starts_with('(');
    }
}

fn vim_line_tail_ok(rest: &str) -> bool {
    rest.is_empty()
        || rest.starts_with('"')
        || rest.starts_with('|')
        || rest.starts_with("//")
        || rest.starts_with("/*")
}

/// Dockerfile `FROM ubuntu:22.04 AS builder`, `FROM scratch AS export`,
/// `ONBUILD FROM python:3 AS runtime`, `FROM --platform=linux/amd64 golang:1.22 AS build`.
/// Image must look like a container ref (`:`, `/`, `@`, `$`, or `scratch`) so SQL
/// `FROM users AS u` and untagged `FROM ubuntu AS x` stay out. Prose and bare
/// `FROM` stay out.
fn is_dockerfile_decl(s: &str) -> bool {
    let mut rest = s;
    if let Some(after) = sql_word(rest, "onbuild") {
        if !after.starts_with(char::is_whitespace) {
            return false;
        }
        rest = after.trim_start();
    }
    let Some(after_from) = sql_word(rest, "from") else {
        return false;
    };
    if !after_from.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = after_from.trim_start();
    // Optional `--platform=linux/amd64` / `--platform linux/amd64` (and similar).
    for _ in 0..8 {
        if !rest.starts_with("--") {
            break;
        }
        let after_dashes = &rest[2..];
        let flag_n = after_dashes
            .bytes()
            .take_while(|b| b.is_ascii_alphanumeric() || *b == b'-' || *b == b'_')
            .count();
        if flag_n == 0 {
            return false;
        }
        rest = &after_dashes[flag_n..];
        if let Some(after_eq) = rest.strip_prefix('=') {
            let val_n = after_eq
                .bytes()
                .take_while(|b| !b.is_ascii_whitespace())
                .count();
            if val_n == 0 {
                return false;
            }
            rest = after_eq[val_n..].trim_start();
        } else {
            rest = rest.trim_start();
            let val_n = rest
                .bytes()
                .take_while(|b| !b.is_ascii_whitespace())
                .count();
            if val_n == 0 {
                return false;
            }
            rest = rest[val_n..].trim_start();
        }
    }
    if rest.is_empty() {
        return false;
    }
    let img_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if img_n == 0 {
        return false;
    }
    let img = &rest[..img_n];
    if img.eq_ignore_ascii_case("as")
        || img.eq_ignore_ascii_case("the")
        || !docker_image_looks_like_ref(img)
    {
        return false;
    }
    rest = rest[img_n..].trim_start();
    let Some(after_as) = sql_word(rest, "as") else {
        return false;
    };
    if !after_as.starts_with(char::is_whitespace) {
        return false;
    }
    rest = after_as.trim_start();
    let name_n = rest
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
        .count();
    if name_n == 0 {
        return false;
    }
    let first = rest.as_bytes()[0];
    if !(first.is_ascii_alphabetic() || first == b'_') {
        return false;
    }
    let name = &rest[..name_n];
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = rest[name_n..].trim_start();
    after.is_empty() || after.starts_with('#') || after.starts_with("//") || after.starts_with("/*")
}

fn docker_image_looks_like_ref(img: &str) -> bool {
    img.eq_ignore_ascii_case("scratch")
        || img.bytes().any(|b| matches!(b, b':' | b'/' | b'@' | b'$'))
}

/// Meson `project('app', 'c')`, `executable('prog', 'main.c')`,
/// `shared_library('foo', 'foo.c')`, `lib = static_library('bar', 'bar.c')`,
/// `custom_target('gen', …)`, `subproject('wrap')`. Single-quoted target name
/// on the same line. Optional `name =` assignment. `test(` / `benchmark(` stay
/// out (Jest and similar). Prose and bare keywords stay out.
fn is_meson_decl(s: &str) -> bool {
    let rest = meson_strip_assign(s);
    for key in [
        "project",
        "executable",
        "shared_library",
        "static_library",
        "both_libraries",
        "shared_module",
        "custom_target",
        "run_target",
        "alias_target",
        "subproject",
        "library",
        "jar",
    ] {
        if meson_call_named(rest, key) {
            return true;
        }
    }
    false
}

fn meson_strip_assign(s: &str) -> &str {
    let Some((name, after)) = graphql_ident(s) else {
        return s;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return s;
    }
    let after = after.trim_start();
    let Some(after_eq) = after.strip_prefix('=') else {
        return s;
    };
    after_eq.trim_start()
}

fn meson_call_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    // Meson strings use single quotes.
    let Some(after_q) = inner.strip_prefix('\'') else {
        return false;
    };
    let Some(end) = after_q.find('\'') else {
        return false;
    };
    if end == 0 {
        return false;
    }
    let name = &after_q[..end];
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after_q[end + 1..].trim_start();
    after.is_empty()
        || after.starts_with(',')
        || after.starts_with(')')
        || after.starts_with('#')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// GN `executable("chrome") {`, `source_set("base") {`,
/// `shared_library("foo") {`, `lib = static_library("bar") {`,
/// `action("gen") {`, `target("executable", "tool") {`. Double-quoted
/// target name on the same line. Optional `name =` assignment. Overlaps
/// Meson target verbs but Meson uses single quotes. Prose and bare
/// keywords stay out.
fn is_gn_decl(s: &str) -> bool {
    let rest = meson_strip_assign(s);
    if gn_target_call(rest) {
        return true;
    }
    for key in [
        "shared_library",
        "static_library",
        "loadable_module",
        "source_set",
        "action_foreach",
        "generated_file",
        "bundle_data",
        "create_bundle",
        "rust_library",
        "rust_proc_macro",
        "rust_executable",
        "rust_static_library",
        "rust_shared_library",
        "rust_test",
        "executable",
        "template",
        "toolchain",
        "config",
        "action",
        "group",
        "copy",
    ] {
        if gn_call_named(rest, key) {
            return true;
        }
    }
    false
}

fn gn_call_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    // GN strings use double quotes.
    let Some(after_q) = inner.strip_prefix('"') else {
        return false;
    };
    let Some(end) = after_q.find('"') else {
        return false;
    };
    if end == 0 {
        return false;
    }
    let name = &after_q[..end];
    if !gn_target_name_ok(name) {
        return false;
    }
    let after = after_q[end + 1..].trim_start();
    gn_after_name_ok(after)
}

/// `target("executable", "tool") {` — type string then name string.
fn gn_target_call(s: &str) -> bool {
    let Some(rest) = sql_word(s, "target") else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    let Some(after_type_q) = inner.strip_prefix('"') else {
        return false;
    };
    let Some(type_end) = after_type_q.find('"') else {
        return false;
    };
    if type_end == 0 {
        return false;
    }
    let ty = &after_type_q[..type_end];
    if !gn_target_name_ok(ty) {
        return false;
    }
    let after_type = after_type_q[type_end + 1..].trim_start();
    let Some(after_comma) = after_type.strip_prefix(',') else {
        return false;
    };
    let after_comma = after_comma.trim_start();
    let Some(after_name_q) = after_comma.strip_prefix('"') else {
        return false;
    };
    let Some(name_end) = after_name_q.find('"') else {
        return false;
    };
    if name_end == 0 {
        return false;
    }
    let name = &after_name_q[..name_end];
    if !gn_target_name_ok(name) {
        return false;
    }
    let after = after_name_q[name_end + 1..].trim_start();
    gn_after_name_ok(after)
}

fn gn_target_name_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
    {
        return false;
    }
    !name.eq_ignore_ascii_case("the") && !is_control_word(name)
}

fn gn_after_name_ok(after: &str) -> bool {
    after.is_empty()
        || after.starts_with(',')
        || after.starts_with(')')
        || after.starts_with('{')
        || after.starts_with('#')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// Bazel / Starlark `cc_binary(name = "hello")`, `java_library(name = "lib")`,
/// `py_binary(name = "tool")`, `lib = cc_library(name = "lib")`. Same-line
/// `name = "…"` / `name = '…'` required. Multi-line rules stay out. Optional
/// `name =` assignment of the rule call. Prose and bare keywords stay out.
fn is_bazel_decl(s: &str) -> bool {
    let rest = meson_strip_assign(s);
    for key in [
        "cc_shared_library",
        "cc_proto_library",
        "java_proto_library",
        "py_proto_library",
        "go_proto_library",
        "rust_shared_library",
        "rust_static_library",
        "rust_proc_macro",
        "kt_jvm_library",
        "kt_jvm_binary",
        "kt_jvm_test",
        "kt_android_library",
        "android_instrumentation_test",
        "android_local_test",
        "android_library",
        "android_binary",
        "objc_library",
        "objc_binary",
        "objc_test",
        "scala_library",
        "scala_binary",
        "scala_test",
        "config_setting",
        "constraint_setting",
        "constraint_value",
        "proto_library",
        "filegroup",
        "test_suite",
        "cc_binary",
        "cc_library",
        "cc_import",
        "cc_test",
        "java_binary",
        "java_library",
        "java_plugin",
        "java_test",
        "py_binary",
        "py_library",
        "py_test",
        "go_binary",
        "go_library",
        "go_test",
        "rust_binary",
        "rust_library",
        "rust_test",
        "sh_binary",
        "sh_library",
        "sh_test",
        "genrule",
        "platform",
        "toolchain",
        "alias",
    ] {
        if bazel_call_named(rest, key) {
            return true;
        }
    }
    false
}

fn bazel_call_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    let Some(after_name_kw) = sql_word(inner, "name") else {
        return false;
    };
    if !(after_name_kw.is_empty()
        || after_name_kw.starts_with(char::is_whitespace)
        || after_name_kw.starts_with('='))
    {
        return false;
    }
    let after_name_kw = after_name_kw.trim_start();
    let Some(after_eq) = after_name_kw.strip_prefix('=') else {
        return false;
    };
    let after_eq = after_eq.trim_start();
    let (quote, after_q) = if let Some(rest) = after_eq.strip_prefix('"') {
        ('"', rest)
    } else if let Some(rest) = after_eq.strip_prefix('\'') {
        ('\'', rest)
    } else {
        return false;
    };
    let Some(end) = after_q.find(quote) else {
        return false;
    };
    if end == 0 {
        return false;
    }
    let name = &after_q[..end];
    if !bazel_target_name_ok(name) {
        return false;
    }
    let after = after_q[end + 1..].trim_start();
    bazel_after_name_ok(after)
}

fn bazel_target_name_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
    {
        return false;
    }
    !name.eq_ignore_ascii_case("the") && !is_control_word(name)
}

fn bazel_after_name_ok(after: &str) -> bool {
    after.is_empty()
        || after.starts_with(',')
        || after.starts_with(')')
        || after.starts_with('#')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// Gradle Groovy / Kotlin DSL task declarations:
/// `task hello {`, `task hello(type: Copy) {`, `task("hello") {`,
/// `tasks.register("hello")`, `tasks.named("build")`, `tasks.create("x")`,
/// `tasks.registering("hello")`, `val hello by tasks.registering`,
/// `val hello by tasks.creating`. Ada `task Buffer is` stays on Ada.
/// Prose and bare keywords stay out.
fn is_gradle_decl(s: &str) -> bool {
    is_gradle_task_kw(s) || is_gradle_tasks_api(s) || is_gradle_tasks_delegate(s)
}

fn is_gradle_task_kw(s: &str) -> bool {
    let Some(rest) = sql_word(s, "task") else {
        return false;
    };
    if !(rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    // `task("hello") {` / `task('hello') {`
    if rest.starts_with('(') {
        return gradle_quoted_call_tail(rest);
    }
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    // `task hello {` / `task hello(type: Copy) {`
    after.starts_with('{') || after.starts_with('(')
}

fn is_gradle_tasks_api(s: &str) -> bool {
    let Some(rest) = sql_word(s, "tasks") else {
        return false;
    };
    if !rest.starts_with('.') {
        return false;
    }
    let rest = &rest[1..];
    for method in ["registering", "register", "named", "create", "creating"] {
        let Some(after_m) = sql_word(rest, method) else {
            continue;
        };
        if !(after_m.is_empty()
            || after_m.starts_with(char::is_whitespace)
            || after_m.starts_with('(')
            || after_m.starts_with('<'))
        {
            return false;
        }
        let after_m = after_m.trim_start();
        // Kotlin `tasks.registering<Copy>()` / `tasks.registering<Copy>("x")`
        let after_m = if after_m.starts_with('<') {
            let Some(end) = skip_balanced_delim(after_m.as_bytes(), 0, b'<', b'>') else {
                return false;
            };
            after_m[end..].trim_start()
        } else {
            after_m
        };
        return gradle_quoted_call_tail(after_m);
    }
    false
}

fn is_gradle_tasks_delegate(s: &str) -> bool {
    // `val hello by tasks.registering` / `val hello by tasks.creating {`
    let Some(rest) = sql_word(s, "val") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = graphql_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    let Some(after_by) = sql_word(after, "by") else {
        return false;
    };
    if !after_by.starts_with(char::is_whitespace) {
        return false;
    }
    let after_by = after_by.trim_start();
    let Some(after_tasks) = sql_word(after_by, "tasks") else {
        return false;
    };
    if !after_tasks.starts_with('.') {
        return false;
    }
    let after_tasks = &after_tasks[1..];
    for method in ["registering", "creating"] {
        let Some(after_m) = sql_word(after_tasks, method) else {
            continue;
        };
        if !(after_m.is_empty()
            || after_m.starts_with(char::is_whitespace)
            || after_m.starts_with('(')
            || after_m.starts_with('<')
            || after_m.starts_with('{')
            || after_m.starts_with("//")
            || after_m.starts_with("/*"))
        {
            return false;
        }
        let after_m = after_m.trim_start();
        let after_m = if after_m.starts_with('<') {
            let Some(end) = skip_balanced_delim(after_m.as_bytes(), 0, b'<', b'>') else {
                return false;
            };
            after_m[end..].trim_start()
        } else {
            after_m
        };
        // Name is the `val` binding. Optional type args, string name, or body.
        if after_m.is_empty()
            || after_m.starts_with('{')
            || after_m.starts_with('(')
            || after_m.starts_with("//")
            || after_m.starts_with("/*")
        {
            return true;
        }
        return false;
    }
    false
}

fn gradle_quoted_call_tail(s: &str) -> bool {
    let Some(inner) = s.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    let (quote, after_q) = if let Some(rest) = inner.strip_prefix('"') {
        ('"', rest)
    } else if let Some(rest) = inner.strip_prefix('\'') {
        ('\'', rest)
    } else {
        return false;
    };
    let Some(end) = after_q.find(quote) else {
        return false;
    };
    if end == 0 {
        return false;
    }
    let name = &after_q[..end];
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b':'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after_q[end + 1..].trim_start();
    after.is_empty()
        || after.starts_with(',')
        || after.starts_with(')')
        || after.starts_with('{')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// Ninja `rule cc`, `pool link_pool`, `build foo.o: cc foo.c`, `default app`.
/// `build out1 out2: link a.o | order || dyndep`. Indent attribute lines stay
/// out (leading whitespace trimmed already). Prose and bare keywords stay out.
/// Gradle / Meson / GN / Bazel keep their own shapes.
fn is_ninja_decl(s: &str) -> bool {
    is_ninja_named_kw(s, "rule")
        || is_ninja_named_kw(s, "pool")
        || is_ninja_build(s)
        || is_ninja_default(s)
}

fn is_ninja_named_kw(s: &str, kw: &str) -> bool {
    let Some(rest) = sql_word(s, kw) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = ninja_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    after.is_empty() || after.starts_with('#')
}

fn is_ninja_build(s: &str) -> bool {
    let Some(rest) = sql_word(s, "build") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(colon) = rest.find(':') else {
        return false;
    };
    let outs = rest[..colon].trim();
    if outs.is_empty() || !ninja_path_list_ok(outs) {
        return false;
    }
    let after_colon = rest[colon + 1..].trim_start();
    let Some((rule, after_rule)) = ninja_ident(after_colon) else {
        return false;
    };
    if rule.eq_ignore_ascii_case("the") || is_control_word(rule) {
        return false;
    }
    let after_rule = after_rule.trim_start();
    after_rule.is_empty()
        || after_rule.starts_with('#')
        || after_rule.starts_with('|')
        || ninja_path_token_ok(
            after_rule
                .split(|c: char| c.is_ascii_whitespace() || c == '|')
                .next()
                .unwrap_or(""),
        )
}

fn is_ninja_default(s: &str) -> bool {
    let Some(rest) = sql_word(s, "default") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() || rest.starts_with('#') || rest.starts_with('=') || rest.starts_with('(') {
        return false;
    }
    let body = rest.split('#').next().unwrap_or(rest).trim();
    let Some(first) = body.split_whitespace().next() else {
        return false;
    };
    // JS/TS `default export` / `default function` / F# `default member` stay out.
    if ninja_default_kw_reject(first) {
        return false;
    }
    ninja_path_list_ok(body)
}

fn ninja_default_kw_reject(tok: &str) -> bool {
    matches!(
        tok.to_ascii_lowercase().as_str(),
        "export"
            | "function"
            | "class"
            | "async"
            | "interface"
            | "type"
            | "const"
            | "let"
            | "var"
            | "void"
            | "int"
            | "string"
            | "number"
            | "boolean"
            | "object"
            | "new"
            | "this"
            | "member"
            | "override"
            | "abstract"
            | "public"
            | "private"
            | "static"
            | "return"
            | "module"
            | "namespace"
    )
}

fn ninja_ident(s: &str) -> Option<(&str, &str)> {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-' || *b == b'.')
        .count();
    if n == 0 {
        return None;
    }
    let first = s.as_bytes()[0];
    if !(first.is_ascii_alphabetic() || first == b'_') {
        return None;
    }
    Some((&s[..n], &s[n..]))
}

fn ninja_path_list_ok(s: &str) -> bool {
    let mut any = false;
    for tok in s.split_whitespace() {
        if tok == "|" || tok == "||" {
            continue;
        }
        if !ninja_path_token_ok(tok) {
            return false;
        }
        any = true;
    }
    any
}

fn ninja_path_token_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    if tok.eq_ignore_ascii_case("the") || is_control_word(tok) {
        return false;
    }
    let bytes = tok.as_bytes();
    let first = bytes[0];
    if !(first.is_ascii_alphanumeric() || matches!(first, b'_' | b'$' | b'.' | b'/' | b'%' | b'-'))
    {
        return false;
    }
    bytes.iter().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                *b,
                b'_' | b'-' | b'.' | b'/' | b'$' | b'%' | b'+' | b'=' | b'{' | b'}' | b':' | b'@'
            )
    })
}

/// Makefile `.PHONY: clean`, `.SUFFIXES: .c .o`, other special targets,
/// pattern rules `%.o: %.c` / `$(DIR)/%.o: %.c`, `include` / `-include` /
/// `sinclude` paths, and `define NAME` / `endef`. Assignments (`FOO =`,
/// `FOO :=`) stay out. Prose and bare keywords stay out. Ninja keeps its
/// own shapes.
fn is_makefile_decl(s: &str) -> bool {
    is_make_special_target(s) || is_make_pattern_rule(s) || is_make_include(s) || is_make_define(s)
}

fn is_make_special_target(s: &str) -> bool {
    if !s.starts_with('.') {
        return false;
    }
    let rest = &s[1..];
    let n = rest
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let name = &rest[..n];
    if !make_special_target_name(name) {
        return false;
    }
    let after = rest[n..].trim_start();
    // `.PHONY: …` / `.SUFFIXES:` — not `.PHONY :=` assignments.
    if !after.starts_with(':') || after.starts_with(":=") || after.starts_with("::=") {
        return false;
    }
    let after_colon = after[1..].trim_start();
    after_colon.is_empty() || after_colon.starts_with('#') || make_prereq_list_ok(after_colon)
}

fn make_special_target_name(name: &str) -> bool {
    matches!(
        name.to_ascii_uppercase().as_str(),
        "PHONY"
            | "SUFFIXES"
            | "DEFAULT"
            | "PRECIOUS"
            | "INTERMEDIATE"
            | "SECONDARY"
            | "DELETE_ON_ERROR"
            | "IGNORE"
            | "LOW_RESOLUTION_TIME"
            | "SILENT"
            | "EXPORT_ALL_VARIABLES"
            | "NOTPARALLEL"
            | "ONESHELL"
            | "POSIX"
            | "SECONDEXPANSION"
            | "MAKE"
            | "WAIT"
            | "NOTINTERMEDIATE"
            | "EXTRA_PREREQS"
    )
}

fn is_make_pattern_rule(s: &str) -> bool {
    let Some(colon) = make_rule_colon(s) else {
        return false;
    };
    let target = s[..colon].trim();
    if target.is_empty() || !target.contains('%') {
        return false;
    }
    if !make_target_token_ok(target) {
        return false;
    }
    let after = s[colon + 1..].trim_start();
    after.is_empty() || after.starts_with('#') || make_prereq_list_ok(after)
}

fn make_rule_colon(s: &str) -> Option<usize> {
    let bytes = s.as_bytes();
    let mut i = 0;
    while i < bytes.len() {
        if bytes[i] == b':' {
            // Skip Make assignments: `:=` `::=` `:::=` and `:` followed by `=`.
            let next = bytes.get(i + 1).copied();
            if next == Some(b'=') {
                return None;
            }
            if next == Some(b':') {
                // Double-colon rule `target:: deps` is rare; treat `::=` as assign.
                if bytes.get(i + 2).copied() == Some(b'=') {
                    return None;
                }
                return Some(i);
            }
            return Some(i);
        }
        i += 1;
    }
    None
}

fn is_make_include(s: &str) -> bool {
    let rest = if let Some(r) = sql_word(s, "include") {
        r
    } else if let Some(r) = sql_word(s, "-include") {
        r
    } else if let Some(r) = sql_word(s, "sinclude") {
        r
    } else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() || rest.starts_with('#') {
        return false;
    }
    let body = rest.split('#').next().unwrap_or(rest).trim();
    make_prereq_list_ok(body)
}

fn is_make_define(s: &str) -> bool {
    if let Some(rest) = sql_word(s, "endef") {
        if rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('#') {
            let after = rest.trim_start();
            return after.is_empty() || after.starts_with('#');
        }
    }
    let Some(rest) = sql_word(s, "define") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = make_var_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with('#')
        || after.starts_with('=')
        || after.starts_with(":=")
        || after.starts_with("::=")
}

fn make_var_ident(s: &str) -> Option<(&str, &str)> {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-' || *b == b'.')
        .count();
    if n == 0 {
        return None;
    }
    let first = s.as_bytes()[0];
    if !(first.is_ascii_alphabetic() || first == b'_') {
        return None;
    }
    Some((&s[..n], &s[n..]))
}

fn make_prereq_list_ok(s: &str) -> bool {
    let body = s.split('#').next().unwrap_or(s).trim();
    if body.is_empty() {
        return false;
    }
    let mut any = false;
    for tok in body.split_whitespace() {
        if !make_target_token_ok(tok) {
            return false;
        }
        any = true;
    }
    any
}

fn make_target_token_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    if tok.eq_ignore_ascii_case("the") {
        return false;
    }
    // Reject bare English control words without Make metacharacters.
    if is_control_word(tok) && !tok.contains(['%', '$', '/', '.', '-']) {
        return false;
    }
    let bytes = tok.as_bytes();
    let first = bytes[0];
    if !(first.is_ascii_alphanumeric()
        || matches!(first, b'_' | b'.' | b'%' | b'$' | b'/' | b'-' | b'*'))
    {
        return false;
    }
    bytes.iter().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                *b,
                b'_' | b'-'
                    | b'.'
                    | b'/'
                    | b'%'
                    | b'$'
                    | b'('
                    | b')'
                    | b'{'
                    | b'}'
                    | b'*'
                    | b'+'
                    | b'?'
                    | b'@'
                    | b'<'
                    | b'>'
            )
    })
}

/// Justfile `[private]` / `[unix]` / `[confirm("…")]` attributes,
/// `alias f := foo`, `set dotenv-load` / `set shell := […]`,
/// `export FOO := "bar"`, `import "foo.just"`, quiet `@build:` /
/// `@build: clean`, and parameterized recipes (`test *args:`,
/// `hello name="world":`). Bare `build:` without `@` or params stays out
/// (avoids CSS / switch `default:` / Make `note: something`). Makefile /
/// Ninja keep their own shapes.
fn is_just_decl(s: &str) -> bool {
    is_just_attribute(s)
        || is_just_alias(s)
        || is_just_set(s)
        || is_just_export(s)
        || is_just_import(s)
        || is_just_recipe(s)
}

fn is_just_attribute(s: &str) -> bool {
    let mut rest = s;
    let mut any = false;
    while rest.starts_with('[') {
        let Some(end) = rest.find(']') else {
            return false;
        };
        let inner = rest[1..end].trim();
        if !just_attr_inner_ok(inner) {
            return false;
        }
        any = true;
        rest = rest[end + 1..].trim_start();
    }
    any && (rest.is_empty() || rest.starts_with('#'))
}

fn just_attr_inner_ok(inner: &str) -> bool {
    if inner.is_empty() {
        return false;
    }
    let n = inner
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'-' || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let name = &inner[..n];
    if !just_attr_name(name) {
        return false;
    }
    let after = inner[n..].trim_start();
    after.is_empty() || after.starts_with('(')
}

fn just_attr_name(name: &str) -> bool {
    matches!(
        name.to_ascii_lowercase().as_str(),
        "private"
            | "unix"
            | "linux"
            | "macos"
            | "windows"
            | "openbsd"
            | "freebsd"
            | "no-cd"
            | "no-exit-message"
            | "confirm"
            | "group"
            | "working-directory"
            | "script"
            | "doc"
            | "positional-arguments"
            | "metadata"
            | "no-quiet"
            | "quiet"
    )
}

fn is_just_alias(s: &str) -> bool {
    let Some(rest) = sql_word(s, "alias") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = just_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    after.starts_with(":=")
}

fn is_just_set(s: &str) -> bool {
    let Some(rest) = sql_word(s, "set") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = just_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let after = after.trim_start();
    if after.starts_with(":=") || (after.starts_with('=') && !after.starts_with("=>")) {
        return just_setting_name(name) || name.contains('-');
    }
    (after.is_empty() || after.starts_with('#')) && just_setting_name(name)
}

fn just_setting_name(name: &str) -> bool {
    matches!(
        name.to_ascii_lowercase().as_str(),
        "allow-duplicate-recipes"
            | "allow-duplicate-variables"
            | "dotenv-load"
            | "dotenv-filename"
            | "dotenv-path"
            | "dotenv-required"
            | "export"
            | "fallback"
            | "ignore-comments"
            | "positional-arguments"
            | "shell"
            | "windows-shell"
            | "tempdir"
            | "unstable"
            | "quiet"
            | "no-exit-message"
            | "script-interpreter"
    )
}

fn is_just_export(s: &str) -> bool {
    let Some(rest) = sql_word(s, "export") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = just_ident(rest) else {
        return false;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) || just_export_name_reject(name) {
        return false;
    }
    let after = after.trim_start();
    after.starts_with(":=") || (after.starts_with('=') && !after.starts_with("=>"))
}

fn just_export_name_reject(name: &str) -> bool {
    matches!(
        name.to_ascii_lowercase().as_str(),
        "fn" | "def"
            | "function"
            | "class"
            | "struct"
            | "trait"
            | "interface"
            | "enum"
            | "type"
            | "const"
            | "let"
            | "var"
            | "async"
            | "default"
            | "mod"
            | "module"
            | "crate"
            | "super"
            | "use"
            | "pub"
            | "impl"
    )
}

fn is_just_import(s: &str) -> bool {
    let Some(rest) = sql_word(s, "import") else {
        return false;
    };
    // `import "foo.just"` or `import? "foo.just"` (optional import).
    if !(rest.starts_with(char::is_whitespace) || rest.starts_with('?')) {
        return false;
    }
    let mut rest = rest.trim_start();
    if let Some(after) = rest.strip_prefix('?') {
        rest = after.trim_start();
    }
    let Some(&quote) = rest.as_bytes().first() else {
        return false;
    };
    if quote != b'"' && quote != b'\'' {
        return false;
    }
    just_quoted_path_line(rest, quote)
}

fn just_quoted_path_line(rest: &str, quote: u8) -> bool {
    let bytes = rest.as_bytes();
    if bytes.first().copied() != Some(quote) {
        return false;
    }
    let Some(end) = bytes.iter().skip(1).position(|&b| b == quote) else {
        return false;
    };
    let end = end + 1;
    if end <= 1 {
        return false;
    }
    // Require `.just` so JS/TS `import "foo.js"` / bare `import "side"` stay out.
    let path = &rest[1..end];
    if !path.to_ascii_lowercase().contains(".just") {
        return false;
    }
    let after = rest[end + 1..].trim_start();
    after.is_empty() || after.starts_with('#')
}

fn is_just_recipe(s: &str) -> bool {
    let quiet = s.starts_with('@');
    let body = if quiet { &s[1..] } else { s };
    let Some((name, rest)) = just_ident(body) else {
        return false;
    };
    if !just_recipe_name_ok(name) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(colon) = just_recipe_colon(rest) else {
        return false;
    };
    let params = rest[..colon].trim();
    let after = rest[colon + 1..].trim_start();
    let after_ok = after.is_empty() || after.starts_with('#') || just_deps_ok(after);
    if quiet {
        return after_ok && (params.is_empty() || just_params_ok(params));
    }
    if params.is_empty() || !just_params_ok(params) {
        return false;
    }
    // Plain `hello name:` is Just; plain `data nat : nowhere` / `parameters n : Nat`
    // (Agda / Idris prose) must stay out — only allow deps when params use
    // Just markers (`*`, `+`, or `=`).
    if just_params_are_plain_idents(params) {
        return after.is_empty() || after.starts_with('#');
    }
    after_ok
}

fn just_params_are_plain_idents(params: &str) -> bool {
    let mut rest = params;
    while !rest.is_empty() {
        rest = rest.trim_start();
        if rest.is_empty() {
            break;
        }
        let Some((tok, after)) = just_next_param_token(rest) else {
            return false;
        };
        if tok.starts_with('*') || tok.starts_with('+') || tok.contains('=') {
            return false;
        }
        rest = after;
    }
    true
}

fn just_recipe_name_ok(name: &str) -> bool {
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    !matches!(
        name.to_ascii_lowercase().as_str(),
        "default" | "case" | "else" | "catch" | "finally" | "note" | "color" | "margin" | "padding"
    )
}

fn just_ident(s: &str) -> Option<(&str, &str)> {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
        .count();
    if n == 0 {
        return None;
    }
    let first = s.as_bytes()[0];
    if !(first.is_ascii_alphabetic() || first == b'_') {
        return None;
    }
    Some((&s[..n], &s[n..]))
}

fn just_recipe_colon(s: &str) -> Option<usize> {
    let bytes = s.as_bytes();
    let mut i = 0;
    let mut quote: Option<u8> = None;
    while i < bytes.len() {
        let b = bytes[i];
        if let Some(q) = quote {
            if b == q {
                quote = None;
            }
            i += 1;
            continue;
        }
        if b == b'"' || b == b'\'' {
            quote = Some(b);
            i += 1;
            continue;
        }
        if b == b':' {
            if bytes.get(i + 1).copied() == Some(b'=') {
                return None;
            }
            return Some(i);
        }
        i += 1;
    }
    None
}

fn just_params_ok(params: &str) -> bool {
    let mut any = false;
    let mut rest = params;
    while !rest.is_empty() {
        rest = rest.trim_start();
        if rest.is_empty() {
            break;
        }
        let Some((tok, after)) = just_next_param_token(rest) else {
            return false;
        };
        if !just_param_token_ok(tok) {
            return false;
        }
        any = true;
        rest = after;
    }
    any
}

fn just_next_param_token(s: &str) -> Option<(&str, &str)> {
    let bytes = s.as_bytes();
    if bytes.is_empty() {
        return None;
    }
    let mut i = 0;
    let mut quote: Option<u8> = None;
    while i < bytes.len() {
        let b = bytes[i];
        if let Some(q) = quote {
            if b == q {
                quote = None;
            }
            i += 1;
            continue;
        }
        if b == b'"' || b == b'\'' {
            quote = Some(b);
            i += 1;
            continue;
        }
        if b.is_ascii_whitespace() {
            break;
        }
        i += 1;
    }
    if i == 0 {
        return None;
    }
    Some((&s[..i], &s[i..]))
}

fn just_param_token_ok(tok: &str) -> bool {
    let tok = tok
        .strip_prefix('*')
        .or_else(|| tok.strip_prefix('+'))
        .unwrap_or(tok);
    if let Some((name, val)) = tok.split_once('=') {
        if name.is_empty() || val.is_empty() {
            return false;
        }
        return just_ident(name).is_some_and(|(n, rest)| rest.is_empty() && just_recipe_name_ok(n));
    }
    just_ident(tok).is_some_and(|(n, rest)| rest.is_empty() && just_recipe_name_ok(n))
}

fn just_deps_ok(s: &str) -> bool {
    let body = s.split('#').next().unwrap_or(s).trim();
    if body.is_empty() {
        return false;
    }
    let mut any = false;
    for tok in body.split_whitespace() {
        if tok.eq_ignore_ascii_case("the") {
            return false;
        }
        let pathish = tok.contains('/') || tok.contains('.') || tok.contains('$');
        let ident_ok = just_ident(tok).is_some_and(|(_, rest)| rest.is_empty());
        if !(pathish || ident_ok) {
            return false;
        }
        any = true;
    }
    any
}

/// Earthfile `VERSION 0.8`, `FROM alpine:3.18` / `FROM +base` (optional
/// `--platform=…`; `AS` stage optional), `SAVE ARTIFACT` / `SAVE IMAGE`,
/// `BUILD +target`, `IMPORT github.com/…`, `GIT CLONE …`, `LOCALLY`,
/// `PROJECT …`, `COMMAND` / `COMMAND --foo=STRING`, `DO +INSTALL`.
/// Bare targets (`build:`) stay out. Dockerfile `FROM … AS stage` stays on
/// Dockerfile. SQL `FROM users` and untagged `FROM ubuntu` stay out.
fn is_earthfile_decl(s: &str) -> bool {
    is_earth_version(s)
        || is_earth_from(s)
        || is_earth_save(s)
        || is_earth_build(s)
        || is_earth_import(s)
        || is_earth_git_clone(s)
        || is_earth_locally(s)
        || is_earth_project(s)
        || is_earth_command(s)
        || is_earth_do(s)
}

fn is_earth_version(s: &str) -> bool {
    let Some(rest) = sql_word(s, "version") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    rest = earth_skip_flags(rest);
    if rest.is_empty() {
        return false;
    }
    let ver_n = rest
        .bytes()
        .take_while(|b| b.is_ascii_digit() || *b == b'.')
        .count();
    if ver_n == 0 || !rest.as_bytes()[0].is_ascii_digit() {
        return false;
    }
    let after = rest[ver_n..].trim_start();
    earth_line_tail_ok(after)
}

fn is_earth_from(s: &str) -> bool {
    let Some(after_from) = sql_word(s, "from") else {
        return false;
    };
    if !after_from.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = after_from.trim_start();
    rest = earth_skip_flags(rest);
    if rest.is_empty() {
        return false;
    }
    let img_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if img_n == 0 {
        return false;
    }
    let img = &rest[..img_n];
    if img.eq_ignore_ascii_case("as") || img.eq_ignore_ascii_case("the") || !earth_from_ref_ok(img)
    {
        return false;
    }
    rest = rest[img_n..].trim_start();
    // Optional `AS name` (Earthfile allows FROM without AS; Dockerfile path
    // still owns `FROM image AS stage` via is_dockerfile_decl).
    if let Some(after_as) = sql_word(rest, "as") {
        if after_as.starts_with(char::is_whitespace) {
            rest = after_as.trim_start();
            let name_n = rest
                .bytes()
                .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
                .count();
            if name_n == 0 {
                return false;
            }
            let first = rest.as_bytes()[0];
            if !(first.is_ascii_alphabetic() || first == b'_') {
                return false;
            }
            let name = &rest[..name_n];
            if name.eq_ignore_ascii_case("the") || is_control_word(name) {
                return false;
            }
            rest = rest[name_n..].trim_start();
        }
    }
    earth_line_tail_ok(rest)
}

fn earth_from_ref_ok(img: &str) -> bool {
    if let Some(name) = img.strip_prefix('+') {
        return !name.is_empty()
            && name
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'/' | b'.'))
            && !name.eq_ignore_ascii_case("the");
    }
    docker_image_looks_like_ref(img)
}

fn is_earth_save(s: &str) -> bool {
    let Some(rest) = sql_word(s, "save") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if let Some(after) = sql_word(rest, "artifact") {
        if after.is_empty() || after.starts_with(char::is_whitespace) {
            return earth_save_artifact_body(after.trim_start());
        }
    }
    if let Some(after) = sql_word(rest, "image") {
        if after.is_empty() || after.starts_with(char::is_whitespace) {
            return earth_save_image_body(after.trim_start());
        }
    }
    false
}

fn earth_save_artifact_body(s: &str) -> bool {
    let mut rest = earth_skip_flags(s);
    // Need at least one path token.
    let path_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if path_n == 0 {
        return false;
    }
    let path = &rest[..path_n];
    if path.eq_ignore_ascii_case("as") || path.eq_ignore_ascii_case("the") {
        return false;
    }
    rest = rest[path_n..].trim_start();
    if let Some(after_as) = sql_word(rest, "as") {
        if after_as.starts_with(char::is_whitespace) {
            let after_as = after_as.trim_start();
            if let Some(after_local) = sql_word(after_as, "local") {
                if after_local.is_empty() || after_local.starts_with(char::is_whitespace) {
                    rest = after_local.trim_start();
                    let dest_n = rest
                        .bytes()
                        .take_while(|b| !b.is_ascii_whitespace())
                        .count();
                    if dest_n == 0 {
                        return false;
                    }
                    rest = rest[dest_n..].trim_start();
                }
            }
        }
    }
    earth_line_tail_ok(rest)
}

fn earth_save_image_body(s: &str) -> bool {
    let rest = earth_skip_flags(s);
    // `SAVE IMAGE` alone (cache) or with a name / `--push name`.
    if earth_line_tail_ok(rest) {
        return true;
    }
    let name_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if name_n == 0 {
        return false;
    }
    let name = &rest[..name_n];
    if name.eq_ignore_ascii_case("the") || name.starts_with("--") {
        return false;
    }
    earth_line_tail_ok(rest[name_n..].trim_start())
}

fn is_earth_build(s: &str) -> bool {
    let Some(rest) = sql_word(s, "build") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = earth_skip_flags(rest.trim_start());
    // One or more `+target` refs.
    let mut any = false;
    while rest.starts_with('+') {
        let tok_n = rest
            .bytes()
            .take_while(|b| !b.is_ascii_whitespace())
            .count();
        if tok_n < 2 || !earth_from_ref_ok(&rest[..tok_n]) {
            return false;
        }
        any = true;
        rest = rest[tok_n..].trim_start();
        rest = earth_skip_flags(rest);
    }
    any && earth_line_tail_ok(rest)
}

fn is_earth_import(s: &str) -> bool {
    let Some(rest) = sql_word(s, "import") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    // Not Justfile `import "foo.just"` / JS `import {`.
    if rest.starts_with('"')
        || rest.starts_with('\'')
        || rest.starts_with('{')
        || rest.starts_with('?')
    {
        return false;
    }
    rest = earth_skip_flags(rest);
    let path_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if path_n == 0 {
        return false;
    }
    let path = &rest[..path_n];
    // Earthly imports look like `github.com/org/repo` or `./lib` or `+target`.
    // Require `/`, a relative `.` / `..` prefix, or `+` so Python `import os.path`
    // and JS bare `import x` stay out.
    if !(path.starts_with('+') || path.starts_with('.') || path.contains('/')) {
        return false;
    }
    if path.eq_ignore_ascii_case("the") {
        return false;
    }
    rest = rest[path_n..].trim_start();
    // Optional `AS alias`.
    if let Some(after_as) = sql_word(rest, "as") {
        if after_as.starts_with(char::is_whitespace) {
            rest = after_as.trim_start();
            let alias_n = rest
                .bytes()
                .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
                .count();
            if alias_n == 0 {
                return false;
            }
            let alias = &rest[..alias_n];
            if alias.eq_ignore_ascii_case("the") || is_control_word(alias) {
                return false;
            }
            rest = rest[alias_n..].trim_start();
        }
    }
    earth_line_tail_ok(rest)
}

fn is_earth_git_clone(s: &str) -> bool {
    let Some(rest) = sql_word(s, "git") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(after_clone) = sql_word(rest, "clone") else {
        return false;
    };
    if !after_clone.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = earth_skip_flags(after_clone.trim_start());
    let url_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if url_n == 0 {
        return false;
    }
    let url = &rest[..url_n];
    if url.eq_ignore_ascii_case("the") {
        return false;
    }
    // Rough URL / path shape.
    if !(url.contains(':') || url.contains('/') || url.contains('@') || url.starts_with('.')) {
        return false;
    }
    rest = rest[url_n..].trim_start();
    // Optional dest directory.
    if !rest.is_empty() && !rest.starts_with('#') && !rest.starts_with("//") {
        let dest_n = rest
            .bytes()
            .take_while(|b| !b.is_ascii_whitespace())
            .count();
        if dest_n == 0 {
            return false;
        }
        rest = rest[dest_n..].trim_start();
    }
    earth_line_tail_ok(rest)
}

fn is_earth_locally(s: &str) -> bool {
    let Some(rest) = sql_word(s, "locally") else {
        return false;
    };
    earth_line_tail_ok(rest.trim_start())
}

fn is_earth_project(s: &str) -> bool {
    let Some(rest) = sql_word(s, "project") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    // Not CMake/Meson `project(`.
    let rest = rest.trim_start();
    if rest.starts_with('(') || rest.starts_with('\'') {
        return false;
    }
    let path_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if path_n == 0 {
        return false;
    }
    let path = &rest[..path_n];
    if path.eq_ignore_ascii_case("the") || is_control_word(path) {
        return false;
    }
    // Earthly PROJECT org/name looks path-like.
    if !(path.contains('/') || path.contains('.')) {
        return false;
    }
    earth_line_tail_ok(rest[path_n..].trim_start())
}

fn is_earth_command(s: &str) -> bool {
    // Case-sensitive `COMMAND` so Vim/prose lowercase `command` stays out.
    let Some(rest) = s.strip_prefix("COMMAND") else {
        return false;
    };
    // Not Vim `command!` (different case anyway) / `COMMANDs`.
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('-')) {
        return false;
    }
    let rest = earth_skip_flags(rest.trim_start());
    earth_line_tail_ok(rest)
}

fn is_earth_do(s: &str) -> bool {
    let Some(rest) = sql_word(s, "do") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = earth_skip_flags(rest.trim_start());
    if !rest.starts_with('+') {
        return false;
    }
    let tok_n = rest
        .bytes()
        .take_while(|b| !b.is_ascii_whitespace())
        .count();
    if tok_n < 2 || !earth_from_ref_ok(&rest[..tok_n]) {
        return false;
    }
    rest = rest[tok_n..].trim_start();
    rest = earth_skip_flags(rest);
    earth_line_tail_ok(rest)
}

fn earth_skip_flags(mut rest: &str) -> &str {
    for _ in 0..12 {
        if !rest.starts_with("--") {
            break;
        }
        let after_dashes = &rest[2..];
        let flag_n = after_dashes
            .bytes()
            .take_while(|b| b.is_ascii_alphanumeric() || *b == b'-' || *b == b'_')
            .count();
        if flag_n == 0 {
            break;
        }
        let flag = &after_dashes[..flag_n];
        rest = &after_dashes[flag_n..];
        if let Some(after_eq) = rest.strip_prefix('=') {
            let val_n = after_eq
                .bytes()
                .take_while(|b| !b.is_ascii_whitespace())
                .count();
            if val_n == 0 {
                break;
            }
            rest = after_eq[val_n..].trim_start();
        } else {
            rest = rest.trim_start();
            if rest.starts_with("--") || rest.starts_with('+') || rest.is_empty() {
                continue;
            }
            let val_n = rest
                .bytes()
                .take_while(|b| !b.is_ascii_whitespace())
                .count();
            if val_n == 0 {
                break;
            }
            // Space-separated value only for known value-flags. Boolean flags
            // must not swallow versions (`0.7`), paths (`./out`), or image refs
            // after `--push` / `--keep-ts`.
            let known_value = matches!(
                flag.to_ascii_lowercase().as_str(),
                "platform"
                    | "branch"
                    | "remote-path"
                    | "chmod"
                    | "user"
                    | "entrypoint"
                    | "shell"
                    | "build-arg"
                    | "tag"
            );
            if known_value {
                rest = rest[val_n..].trim_start();
            }
        }
    }
    rest
}

fn earth_line_tail_ok(after: &str) -> bool {
    after.is_empty() || after.starts_with('#') || after.starts_with("//") || after.starts_with("/*")
}

/// RPM `.spec` section markers and macros: `%prep`, `%build`, `%install`,
/// `%check`, `%clean`, `%files`, `%changelog`, `%description`, `%package`,
/// `%pre` / `%post` / `%preun` / `%postun` / `%pretrans` / `%posttrans`,
/// `%verifyscript`, `%generate_buildrequires`, `%conf`, `%trigger*`,
/// `%define` / `%global` / `%undefine` / `%bcond_with` / `%bcond_without`.
/// `%{…}` expansions, `%%` escapes, and Makefile `%.o:` stay out.
fn is_rpmspec_decl(s: &str) -> bool {
    let Some(rest) = s.strip_prefix('%') else {
        return false;
    };
    // `%%` literal percent, `%{macro}`, `%(shell)`, Makefile `%.o:`.
    if rest.starts_with('%')
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with('.')
    {
        return false;
    }
    let name_n = rest
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if name_n == 0 {
        return false;
    }
    let name = &rest[..name_n];
    let after = rest[name_n..].trim_start();
    let lower = name.to_ascii_lowercase();
    match lower.as_str() {
        "prep"
        | "build"
        | "install"
        | "check"
        | "clean"
        | "changelog"
        | "pre"
        | "post"
        | "preun"
        | "postun"
        | "pretrans"
        | "posttrans"
        | "preuntrans"
        | "postuntrans"
        | "verifyscript"
        | "generate_buildrequires"
        | "conf" => rpm_simple_section_ok(after),
        "files" | "description" => rpm_named_section_ok(after),
        "package" => rpm_package_ok(after),
        "define" | "global" | "undefine" => rpm_define_ok(after),
        "bcond_with" | "bcond_without" => rpm_bcond_ok(after),
        n if n.starts_with("trigger")
            || n.starts_with("filetrigger")
            || n.starts_with("transfiletrigger") =>
        {
            rpm_trigger_ok(after)
        }
        _ => false,
    }
}

fn rpm_simple_section_ok(after: &str) -> bool {
    let rest = after.trim_start();
    rest.is_empty() || rest.starts_with('#')
}

fn rpm_named_section_ok(after: &str) -> bool {
    let mut rest = after.trim_start();
    for _ in 0..8 {
        if rest.is_empty() || rest.starts_with('#') {
            return true;
        }
        // `-n name` / `-f filelist`
        if let Some(r) = rest.strip_prefix("-n") {
            if !(r.is_empty() || r.starts_with(char::is_whitespace)) {
                return false;
            }
            rest = r.trim_start();
            let Some(n) = rpm_ident_len(rest) else {
                return false;
            };
            let name = &rest[..n];
            if name.eq_ignore_ascii_case("the") || is_control_word(name) {
                return false;
            }
            rest = rest[n..].trim_start();
            continue;
        }
        if let Some(r) = rest.strip_prefix("-f") {
            if !(r.is_empty() || r.starts_with(char::is_whitespace)) {
                return false;
            }
            rest = r.trim_start();
            let Some(n) = rpm_ident_len(rest) else {
                return false;
            };
            let name = &rest[..n];
            if name.eq_ignore_ascii_case("the") || is_control_word(name) {
                return false;
            }
            rest = rest[n..].trim_start();
            continue;
        }
        // Bare package name after `%package foo` (no `-n`).
        if rest.starts_with('-') {
            return false;
        }
        let Some(n) = rpm_ident_len(rest) else {
            return false;
        };
        let name = &rest[..n];
        if name.eq_ignore_ascii_case("the") || is_control_word(name) {
            return false;
        }
        rest = rest[n..].trim_start();
        return rest.is_empty() || rest.starts_with('#');
    }
    rest.is_empty() || rest.starts_with('#')
}

fn rpm_package_ok(after: &str) -> bool {
    // `%package` always names a subpackage (`%package devel` / `%package -n foo`).
    let rest = after.trim_start();
    if rest.is_empty() || rest.starts_with('#') {
        return false;
    }
    rpm_named_section_ok(after)
}

fn rpm_trigger_ok(after: &str) -> bool {
    let mut rest = after.trim_start();
    if rest.is_empty() || rest.starts_with('#') {
        return true;
    }
    // Optional `-n subpkg` before `--`.
    if let Some(r) = rest.strip_prefix("-n") {
        if !(r.is_empty() || r.starts_with(char::is_whitespace)) {
            return false;
        }
        rest = r.trim_start();
        let Some(n) = rpm_ident_len(rest) else {
            return false;
        };
        rest = rest[n..].trim_start();
    }
    if rest.is_empty() || rest.starts_with('#') {
        return true;
    }
    // `%triggerin -- pkg [, pkg2 …]`
    let Some(r) = rest.strip_prefix("--") else {
        return false;
    };
    if !(r.is_empty() || r.starts_with(char::is_whitespace)) {
        return false;
    }
    rest = r.trim_start();
    let Some(n) = rpm_ident_len(rest) else {
        return false;
    };
    let name = &rest[..n];
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    rest = rest[n..].trim_start();
    // Optional more packages (comma / space separated); accept rest of line.
    rest.is_empty()
        || rest.starts_with('#')
        || rest.starts_with(',')
        || rpm_ident_len(rest).is_some()
}

fn rpm_define_ok(after: &str) -> bool {
    let rest = after.trim_start();
    let Some(n) = rpm_ident_len(rest) else {
        return false;
    };
    let name = &rest[..n];
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    // `%undefine name` needs only the name; `%define` / `%global` may have a value.
    let rest = rest[n..].trim_start();
    if rest.is_empty() || rest.starts_with('#') {
        return true;
    }
    // Reject prose `the …` as a value token.
    !rest.to_ascii_lowercase().starts_with("the ")
}

fn rpm_bcond_ok(after: &str) -> bool {
    let rest = after.trim_start();
    let Some(n) = rpm_ident_len(rest) else {
        return false;
    };
    let name = &rest[..n];
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    let rest = rest[n..].trim_start();
    rest.is_empty() || rest.starts_with('#')
}

fn rpm_ident_len(s: &str) -> Option<usize> {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'+'))
        .count();
    if n == 0 {
        return None;
    }
    let first = s.as_bytes()[0];
    if !(first.is_ascii_alphabetic() || first == b'_') {
        return None;
    }
    Some(n)
}

/// Android.bp / Soong module types: `cc_binary {`, `cc_library_shared {`,
/// `android_app {`, `java_library {`, `rust_binary {`, `filegroup {`,
/// `genrule {`, `apex {`, … Optional same-line props (`name: "x",`) and
/// `//` / `#` comments. Prose (`cc_binary the`), bare keywords, wrong case,
/// and Bazel `cc_binary(name = …)` stay out.
fn is_android_bp_decl(s: &str) -> bool {
    // Longer names first so `cc_library_shared` wins over `cc_library`.
    const TYPES: &[&str] = &[
        "cc_prebuilt_library_shared",
        "cc_prebuilt_library_static",
        "cc_library_host_shared",
        "cc_library_host_static",
        "android_test_helper_app",
        "cc_prebuilt_library",
        "cc_prebuilt_binary",
        "cc_library_headers",
        "cc_library_shared",
        "cc_library_static",
        "cc_benchmark_host",
        "java_library_static",
        "java_library_host",
        "java_binary_host",
        "java_import_host",
        "java_sdk_library",
        "java_test_host",
        "python_binary_host",
        "python_library_host",
        "python_test_host",
        "rust_library_shared",
        "rust_library_static",
        "rust_library_dylib",
        "rust_library_rlib",
        "rust_binary_host",
        "rust_proc_macro",
        "rust_ffi_shared",
        "rust_ffi_static",
        "android_app_certificate",
        "android_robolectric",
        "prebuilt_usr_share",
        "cc_test_library",
        "cc_binary_host",
        "cc_defaults",
        "cc_genrule",
        "cc_object",
        "cc_benchmark",
        "cc_binary",
        "cc_library",
        "cc_test",
        "java_library",
        "java_binary",
        "java_import",
        "java_defaults",
        "java_test",
        "android_app",
        "android_library",
        "android_test",
        "python_library",
        "python_test",
        "rust_binary",
        "rust_library",
        "rust_defaults",
        "rust_test",
        "rust_ffi",
        "sh_binary_host",
        "sh_binary",
        "sh_test",
        "filegroup",
        "gensrcs",
        "genrule",
        "prebuilt_etc",
        "prebuilt_font",
        "apex_key",
        "apex",
        "phony",
        "ndk_library",
        "llndk_library",
        "toolchain_library",
    ];
    TYPES.iter().any(|t| android_bp_module(s, t))
}

fn android_bp_module(s: &str, key: &str) -> bool {
    if !s.starts_with(key) {
        return false;
    }
    let after = &s[key.len()..];
    if !(after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('{')) {
        return false;
    }
    let after = after.trim_start();
    let Some(rest) = after.strip_prefix('{') else {
        return false;
    };
    let rest = rest.trim_start();
    // Empty body start, `}`, comment, or Soong props (`name: "…"`, `srcs: [`).
    rest.is_empty()
        || rest.starts_with('}')
        || rest.starts_with("//")
        || rest.starts_with('#')
        || android_bp_prop_start(rest)
}

fn android_bp_prop_start(s: &str) -> bool {
    // Property name: lowercase / digit / `_`, then `:`.
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let name = &s[..n];
    if name.eq_ignore_ascii_case("the") || name.ends_with('_') {
        return false;
    }
    let after = s[n..].trim_start();
    after.starts_with(':')
}

/// SCons builders: `Program('hello', 'hello.c')`, `SharedLibrary("foo", …)`,
/// `env.Library('bar', …)`, `lib = Object('x.o', 'x.c')`, `Command(…)`,
/// `Alias('install', …)`, `Install('/usr/bin', …)`, `InstallAs(…)`.
/// Optional assignment and `receiver.` prefix. Quoted target (single or
/// double) on the same line. Meson single-quoted `library` / `shared_library`
/// / `static_library` already match via Meson; this path adds `Program`,
/// `Object*`, `Command`, `Alias`, `Install*`, double-quoted forms, and
/// `env.` receivers. GN brace targets stay on GN. Prose and bare keywords
/// stay out.
fn is_scons_decl(s: &str) -> bool {
    let rest = scons_strip_assign(s);
    let rest = scons_strip_receiver(rest);
    for key in [
        "InstallVersionedLib",
        "SharedLibrary",
        "StaticLibrary",
        "LoadableModule",
        "StaticObject",
        "SharedObject",
        "InstallAs",
        "Library",
        "Program",
        "Object",
        "Command",
        "Install",
        "Alias",
        "Package",
        "JavaJar",
        "Java",
    ] {
        if scons_call_named(rest, key) {
            return true;
        }
    }
    false
}

fn scons_strip_assign(s: &str) -> &str {
    let Some((name, after)) = graphql_ident(s) else {
        return s;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return s;
    }
    let after = after.trim_start();
    let Some(after_eq) = after.strip_prefix('=') else {
        return s;
    };
    after_eq.trim_start()
}

/// `env.Program(...)` / `env['BUILDERS'].Program` is too free-form; only
/// simple `ident.Builder(...)`.
fn scons_strip_receiver(s: &str) -> &str {
    let Some((name, after)) = graphql_ident(s) else {
        return s;
    };
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return s;
    }
    let after = after.trim_start();
    let Some(after_dot) = after.strip_prefix('.') else {
        return s;
    };
    after_dot.trim_start()
}

fn scons_call_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    let (q, after_q) = if let Some(a) = inner.strip_prefix('\'') {
        ('\'', a)
    } else if let Some(a) = inner.strip_prefix('"') {
        ('"', a)
    } else {
        return false;
    };
    let Some(end) = after_q.find(q) else {
        return false;
    };
    if end == 0 {
        return false;
    }
    let name = &after_q[..end];
    if !scons_target_name_ok(name) {
        return false;
    }
    let after = after_q[end + 1..].trim_start();
    after.is_empty()
        || after.starts_with(',')
        || after.starts_with(')')
        || after.starts_with('#')
        || after.starts_with("//")
        || after.starts_with("/*")
}

fn scons_target_name_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    let first = bytes[0];
    // Target or install path: ident, `hello`, `foo/bar`, `/usr/bin`, `./out`.
    if !(first.is_ascii_alphanumeric()
        || first == b'_'
        || first == b'/'
        || first == b'.'
        || first == b'$')
    {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/' | b'$'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    true
}

/// Apache Ant / MSBuild XML targets: `<target name="compile">`,
/// `<project name="Foo" default="all">`, `<macrodef name="with-echo">`,
/// `<Target Name="Build" DependsOnTargets="Prepare">`. Tag is case-insensitive
/// (`target` / `Target` / `TARGET`). Quoted `name` / `Name` attribute on the
/// same line (single or double quotes; other attrs may precede). Prose
/// (`<target the compile>`), bare tags (`<target>`), closing tags, and
/// non-name elements stay out.
fn is_ant_msbuild_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('<') else {
        return false;
    };
    let rest = rest.trim_start();
    if rest.starts_with('/') || rest.starts_with('!') || rest.starts_with('?') {
        return false;
    }
    let after_tag = if let Some(a) = ant_xml_open_tag(rest, "macrodef") {
        a
    } else if let Some(a) = ant_xml_open_tag(rest, "target") {
        a
    } else if let Some(a) = ant_xml_open_tag(rest, "project") {
        a
    } else {
        return false;
    };
    ant_msbuild_name_attr(after_tag)
}

fn ant_xml_open_tag<'a>(s: &'a str, tag: &str) -> Option<&'a str> {
    let rest = sql_word(s, tag)?;
    if !(rest.is_empty()
        || rest.starts_with(char::is_whitespace)
        || rest.starts_with('/')
        || rest.starts_with('>'))
    {
        return None;
    }
    Some(rest.trim_start())
}

fn ant_msbuild_name_attr(s: &str) -> bool {
    let bytes = s.as_bytes();
    let mut i = 0;
    while i < bytes.len() {
        while i < bytes.len() && bytes[i].is_ascii_whitespace() {
            i += 1;
        }
        if i >= bytes.len() {
            return false;
        }
        if bytes[i] == b'>' {
            return false;
        }
        if bytes[i] == b'/' {
            return false;
        }
        let start = i;
        while i < bytes.len()
            && (bytes[i].is_ascii_alphanumeric() || matches!(bytes[i], b'_' | b'-' | b':'))
        {
            i += 1;
        }
        if i == start {
            return false;
        }
        let attr = &s[start..i];
        let is_name = attr.eq_ignore_ascii_case("name");
        while i < bytes.len() && bytes[i].is_ascii_whitespace() {
            i += 1;
        }
        if i >= bytes.len() || bytes[i] != b'=' {
            return false;
        }
        i += 1;
        while i < bytes.len() && bytes[i].is_ascii_whitespace() {
            i += 1;
        }
        if i >= bytes.len() {
            return false;
        }
        let q = bytes[i];
        if q != b'"' && q != b'\'' {
            return false;
        }
        i += 1;
        let val_start = i;
        while i < bytes.len() && bytes[i] != q {
            // Names stay on one line; reject raw `<` / `>` inside the value.
            if bytes[i] == b'<' || bytes[i] == b'>' {
                return false;
            }
            i += 1;
        }
        if i >= bytes.len() {
            return false;
        }
        let val = &s[val_start..i];
        i += 1;
        if is_name {
            return ant_msbuild_name_ok(val);
        }
    }
    false
}

fn ant_msbuild_name_ok(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    let bytes = name.as_bytes();
    let first = bytes[0];
    if !(first.is_ascii_alphanumeric() || first == b'_' || first == b'.' || first == b'$') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'$'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    true
}

/// Premake workspace / project / solution: `workspace "App"`, `project "Lib"`,
/// `solution "Old"` (Premake 4). Keyword, whitespace, then a quoted name on the
/// same line (single or double quotes). Optional trailing Lua `--` comment.
/// Meson `project('app', 'c')` (paren + single-quoted args) stays on Meson.
/// Prose (`project the app`), bare keywords, and call-paren forms stay out.
fn is_premake_decl(s: &str) -> bool {
    let s = s.trim_start();
    for key in ["workspace", "project", "solution"] {
        if premake_named(s, key) {
            return true;
        }
    }
    false
}

fn premake_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    // Space then quote — not `project(` (Meson) / `projects` / bare keyword.
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let bytes = rest.as_bytes();
    let Some(&q) = bytes.first() else {
        return false;
    };
    if q != b'"' && q != b'\'' {
        return false;
    }
    let after_q = &rest[1..];
    let Some(end) = after_q.as_bytes().iter().position(|&b| b == q) else {
        return false;
    };
    if end == 0 {
        return false;
    }
    let name = &after_q[..end];
    if !premake_name_ok(name) {
        return false;
    }
    let after = after_q[end + 1..].trim_start();
    after.is_empty()
        || after.starts_with("--")
        || after.starts_with('#')
        || after.starts_with("//")
        || after.starts_with("/*")
}

fn premake_name_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    let first = bytes[0];
    if !(first.is_ascii_alphanumeric() || first == b'_') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    true
}

/// xmake.lua `target` / `option` / `package` / `rule` / `toolchain` / `task`:
/// `target("app")`, `option("foo")`, `package("zlib")`, `rule("markdown")`,
/// `toolchain("clang")`, `task("hello")`. Keyword then `(` then a quoted name
/// on the same line (single or double). Optional trailing Lua `--` comment.
/// GN `target("type", "name")` (two string args) stays on GN. Meson
/// single-quoted builders and Gradle `task("…")` keep their own shapes.
/// Prose (`target the app`), bare keywords, and unquoted names stay out.
fn is_xmake_decl(s: &str) -> bool {
    let s = s.trim_start();
    for key in ["target", "option", "package", "rule", "toolchain", "task"] {
        if xmake_call_named(s, key) {
            return true;
        }
    }
    false
}

fn xmake_call_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('(')) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    let bytes = inner.as_bytes();
    let Some(&q) = bytes.first() else {
        return false;
    };
    if q != b'"' && q != b'\'' {
        return false;
    }
    let after_q = &inner[1..];
    let Some(end) = after_q.as_bytes().iter().position(|&b| b == q) else {
        return false;
    };
    if end == 0 {
        return false;
    }
    let name = &after_q[..end];
    if !xmake_name_ok(name) {
        return false;
    }
    let after = after_q[end + 1..].trim_start();
    // Single-arg form only — reject GN `target("executable", "tool")`.
    after.is_empty()
        || after.starts_with(')')
        || after.starts_with("--")
        || after.starts_with('#')
        || after.starts_with("//")
        || after.starts_with("/*")
}

fn xmake_name_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    let first = bytes[0];
    if !(first.is_ascii_alphanumeric() || first == b'_') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    true
}

/// Rake `task` / `multitask` / `file` / `directory` / `rule`:
/// `task :default`, `task :default => [:test]`, `task "build" do`,
/// `task migrate: :environment`, `multitask :parallel => [:a, :b]`,
/// `file "out.txt" => ["in.txt"]`, `directory "tmp"`, `rule '.o' => '.c'`.
/// Symbol (`:name`), quoted name, or Rails `name:` label on the same line.
/// Optional deps (`=>`), arg lists, `do` / `{`, and `#` comments.
/// Gradle `task hello {` / `task("hello")` stay on Gradle (paren or bare-ident
/// brace forms). xmake `rule("…")` stays on xmake. Prose and bare keywords
/// stay out.
fn is_rake_decl(s: &str) -> bool {
    is_rake_task_like(s, "task")
        || is_rake_task_like(s, "multitask")
        || is_rake_named_path(s, "file")
        || is_rake_named_path(s, "directory")
        || is_rake_rule(s)
}

fn is_rake_task_like(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    // `:symbol` form — `task :default`, `task :default => [:test]`
    if let Some(after_sym) = ruby_attr_symbol(rest) {
        return rake_task_tail_ok(after_sym);
    }
    // Quoted — `task "build" do`, `task 'clean'`
    if let Some(after_q) = rake_quoted_name(rest) {
        return rake_task_tail_ok(after_q);
    }
    // Rails label — `task migrate: :environment do`
    if let Some((name, after)) = graphql_ident(rest) {
        if name.eq_ignore_ascii_case("the") || is_control_word(name) {
            return false;
        }
        if let Some(after_colon) = after.strip_prefix(':') {
            // Not Gradle `task hello {` / `task hello(…)` — require the label colon.
            return rake_task_tail_ok(after_colon);
        }
    }
    false
}

fn is_rake_named_path(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if let Some(after_sym) = ruby_attr_symbol(rest) {
        return rake_task_tail_ok(after_sym);
    }
    if let Some(after_q) = rake_quoted_name(rest) {
        return rake_task_tail_ok(after_q);
    }
    false
}

fn is_rake_rule(s: &str) -> bool {
    let Some(rest) = sql_word(s, "rule") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    // Quoted pattern only — reject xmake `rule("markdown")` (paren, no space).
    let Some(after_q) = rake_quoted_name(rest) else {
        return false;
    };
    rake_task_tail_ok(after_q)
}

fn rake_quoted_name(s: &str) -> Option<&str> {
    let bytes = s.as_bytes();
    let &q = bytes.first()?;
    if q != b'"' && q != b'\'' {
        return None;
    }
    let after_q = &s[1..];
    let end = after_q.as_bytes().iter().position(|&b| b == q)?;
    if end == 0 {
        return None;
    }
    let name = &after_q[..end];
    if !rake_name_ok(name) {
        return None;
    }
    Some(&after_q[end + 1..])
}

fn rake_name_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    // Paths / extensions: `out.txt`, `.o`, `lib/foo`, `build-app`
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/' | b'+' | b'%'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    true
}

fn rake_task_tail_ok(after: &str) -> bool {
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with("=>")
        || after.starts_with(',')
        || after.starts_with('[')
        || after.starts_with('(')
        || after.starts_with('{')
        || after.starts_with(':') // `task migrate: :environment`
        || sql_word(after, "do").is_some_and(|r| {
            r.is_empty() || r.starts_with(char::is_whitespace) || r.starts_with('|')
        })
        || after.starts_with('#')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// Cabal `.cabal` package stanzas: `library`, `library mylib`,
/// `executable foo`, `test-suite tests`, `benchmark bench`,
/// `foreign-library mylib`, `common shared`, `flag debug`,
/// `source-repository head` / `this`. Keyword then optional/required
/// component name on the same line. Optional trailing `--` comment.
/// Meson `executable('…')` / GN `executable("…")` / Solidity `library Math {`
/// stay on their paths (paren or brace). Prose and bare keywords (except
/// bare `library`) stay out.
fn is_cabal_decl(s: &str) -> bool {
    let s = s.trim_start();
    is_cabal_library(s)
        || cabal_named(s, "executable")
        || cabal_named(s, "test-suite")
        || cabal_named(s, "benchmark")
        || cabal_named(s, "foreign-library")
        || cabal_named(s, "common")
        || cabal_named(s, "flag")
        || is_cabal_source_repository(s)
}

fn is_cabal_library(s: &str) -> bool {
    let Some(rest) = sql_word(s, "library") else {
        return false;
    };
    // Reject `library(` (Meson) / `librarys` / `library{`.
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace)) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() || cabal_tail_ok(rest) {
        return true;
    }
    // Named library: `library mylib`
    let Some((name, after)) = cabal_component_name(rest) else {
        return false;
    };
    if !cabal_name_ok(name) {
        return false;
    }
    cabal_tail_ok(after.trim_start())
}

fn cabal_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = cabal_component_name(rest) else {
        return false;
    };
    if !cabal_name_ok(name) {
        return false;
    }
    cabal_tail_ok(after.trim_start())
}

fn is_cabal_source_repository(s: &str) -> bool {
    let Some(rest) = sql_word(s, "source-repository") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = cabal_component_name(rest) else {
        return false;
    };
    if !name.eq_ignore_ascii_case("head") && !name.eq_ignore_ascii_case("this") {
        return false;
    }
    cabal_tail_ok(after.trim_start())
}

fn cabal_component_name(s: &str) -> Option<(&str, &str)> {
    let bytes = s.as_bytes();
    if bytes.is_empty() {
        return None;
    }
    let mut i = 0;
    while i < bytes.len() {
        let b = bytes[i];
        if b.is_ascii_alphanumeric() || b == b'-' || b == b'_' {
            i += 1;
        } else {
            break;
        }
    }
    if i == 0 {
        return None;
    }
    Some((&s[..i], &s[i..]))
}

fn cabal_name_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    let first = bytes[0];
    if !first.is_ascii_alphanumeric() {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'-' | b'_'))
    {
        return false;
    }
    if name.eq_ignore_ascii_case("the") || is_control_word(name) {
        return false;
    }
    true
}

fn cabal_tail_ok(after: &str) -> bool {
    after.is_empty() || after.starts_with("--")
}

/// Cargo.toml structural tables: `[package]`, `[lib]`, `[[bin]]` /
/// `[[example]]` / `[[test]]` / `[[bench]]`, `[workspace]` /
/// `[workspace.package]`, `[features]`, `[profile.dev]` / `[profile.release]`,
/// `[lints]` / `[lints.rust]`, `[patch.crates-io]`, `[replace]`,
/// `[package.metadata.…]`, `[target.…]`. Optional trailing `#` comment.
/// `[dependencies]` / `[dev-dependencies]` / `[build-dependencies]` stay out
/// (too noisy). Incomplete `[package` / prose stay out.
fn is_cargo_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if !cargo_toml_tail_ok(after) {
        return false;
    }
    if array {
        matches!(header, "bin" | "example" | "test" | "bench")
    } else {
        cargo_toml_single_ok(header)
    }
}

fn cargo_toml_header(s: &str) -> Option<(&str, bool, &str)> {
    let bytes = s.as_bytes();
    if bytes.first() != Some(&b'[') {
        return None;
    }
    let array = bytes.get(1) == Some(&b'[');
    let start = if array { 2 } else { 1 };
    // Find first `]` (for `[[bin]]` the first `]` ends the name; next must be `]`).
    let mut i = start;
    while i < bytes.len() && bytes[i] != b']' {
        i += 1;
    }
    if i >= bytes.len() {
        return None;
    }
    let header = s.get(start..i)?;
    let after_first = i + 1;
    if array {
        if bytes.get(after_first) != Some(&b']') {
            return None;
        }
        let after = s.get(after_first + 1..)?;
        Some((header, true, after))
    } else {
        let after = s.get(after_first..)?;
        Some((header, false, after))
    }
}

fn cargo_toml_tail_ok(after: &str) -> bool {
    let t = after.trim_start();
    t.is_empty() || t.starts_with('#')
}

fn cargo_toml_single_ok(header: &str) -> bool {
    if header.is_empty() {
        return false;
    }
    // Noisy dependency tables (including dotted target.*.dependencies) stay out
    // when the whole header is exactly one of these.
    if matches!(
        header,
        "dependencies" | "dev-dependencies" | "build-dependencies"
    ) {
        return false;
    }
    match header {
        "package" | "lib" | "workspace" | "features" | "lints" | "replace" => true,
        h if h.starts_with("workspace.")
            || h.starts_with("profile.")
            || h.starts_with("lints.")
            || h.starts_with("patch.")
            || h.starts_with("package.metadata")
            || h.starts_with("target.") =>
        {
            cargo_toml_key_path_ok(h)
        }
        _ => false,
    }
}

fn cargo_toml_key_path_ok(header: &str) -> bool {
    // Allow bare dotted keys and simple quoted cfg fragments used by Cargo
    // target tables: target.'cfg(windows)'.dependencies
    if header.is_empty() {
        return false;
    }
    let bytes = header.as_bytes();
    let mut i = 0;
    while i < bytes.len() {
        // Quoted key: '…' or "…"
        if bytes[i] == b'\'' || bytes[i] == b'"' {
            let quote = bytes[i];
            i += 1;
            let mut found = false;
            while i < bytes.len() {
                if bytes[i] == quote {
                    found = true;
                    i += 1;
                    break;
                }
                i += 1;
            }
            if !found {
                return false;
            }
        } else {
            // Bare key segment: [A-Za-z0-9_-]+
            let start = i;
            while i < bytes.len() {
                let b = bytes[i];
                if b.is_ascii_alphanumeric() || b == b'_' || b == b'-' {
                    i += 1;
                } else {
                    break;
                }
            }
            if i == start {
                return false;
            }
        }
        if i >= bytes.len() {
            return true;
        }
        if bytes[i] == b'.' {
            i += 1;
            if i >= bytes.len() {
                return false;
            }
            continue;
        }
        return false;
    }
    true
}

/// pyproject.toml structural tables: `[project]` / `[project.scripts]` /
/// `[project.optional-dependencies]` / `[project.urls]` /
/// `[project.entry-points.…]`, `[build-system]`, `[tool]` /
/// `[tool.poetry]` / `[tool.ruff]` / `[tool.pytest.ini_options]` / …,
/// `[dependency-groups]`. Optional trailing `#` comment. Array tables
/// (`[[…]]`) and incomplete / prose / Cargo `[package]` stay out.
fn is_pyproject_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if array || !cargo_toml_tail_ok(after) {
        return false;
    }
    pyproject_toml_single_ok(header)
}

fn pyproject_toml_single_ok(header: &str) -> bool {
    if header.is_empty() {
        return false;
    }
    match header {
        "project" | "build-system" | "tool" | "dependency-groups" => true,
        h if h.starts_with("project.")
            || h.starts_with("tool.")
            || h.starts_with("dependency-groups.") =>
        {
            cargo_toml_key_path_ok(h)
        }
        _ => false,
    }
}

/// package.json / deno.json structural keys: `"scripts": {`, `"bin": {` /
/// `"bin": "./cli.js"`, `"exports": {`, `"imports": {`, `"workspaces": [` /
/// `{`, `"contributes": {`, `"engines": {`, `"overrides": {`,
/// `"resolutions": {`, `"typesVersions": {`, `"publishConfig": {`,
/// `"packageManager": "pnpm@9.0.0"`, `"tasks": {` (Deno), `"browser": {` /
/// `"browser": "…"`. Optional trailing `,` and `//` / `/*` comment.
/// Dependency maps and leaf metadata (`"name"`, `"version"`, `"main"`, …)
/// stay out. Incomplete quotes / missing `:` stay out.
fn is_package_json_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let key = &rest[..end];
    if !package_json_key_ok(key) {
        return false;
    }
    let after_key = rest[end + 1..].trim_start();
    let Some(after_colon) = after_key.strip_prefix(':') else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    package_json_value_and_tail_ok(key, after_colon)
}

fn package_json_key_ok(key: &str) -> bool {
    matches!(
        key,
        "scripts"
            | "bin"
            | "exports"
            | "imports"
            | "workspaces"
            | "contributes"
            | "engines"
            | "overrides"
            | "resolutions"
            | "typesVersions"
            | "publishConfig"
            | "packageManager"
            | "tasks"
            | "browser"
    )
}

fn package_json_value_and_tail_ok(key: &str, after_colon: &str) -> bool {
    let bytes = after_colon.as_bytes();
    let Some(first) = bytes.first().copied() else {
        return false;
    };
    match first {
        b'{' => {
            // Object open: scripts/exports/…; workspaces may be object too.
            if matches!(key, "packageManager") {
                return false;
            }
            package_json_tail_ok(&after_colon[1..])
        }
        b'[' => {
            // Array open: workspaces only (npm workspaces field).
            if key != "workspaces" {
                return false;
            }
            package_json_tail_ok(&after_colon[1..])
        }
        b'"' => {
            // String value: bin / browser / packageManager.
            if !matches!(key, "bin" | "browser" | "packageManager") {
                return false;
            }
            let rest = &after_colon[1..];
            let Some(end) = rest.find('"') else {
                return false;
            };
            package_json_tail_ok(&rest[end + 1..])
        }
        _ => false,
    }
}

fn package_json_tail_ok(after: &str) -> bool {
    let t = after.trim_start();
    t.is_empty()
        || t.starts_with(',')
        || t.starts_with('}')
        || t.starts_with(']')
        || t.starts_with("//")
        || t.starts_with("/*")
}

/// composer.json structural keys: `"autoload": {`, `"autoload-dev": {`,
/// `"scripts": {`, `"repositories": [` / `{`, `"config": {`, `"extra": {`,
/// `"bin": ["bin/console"]`, `"provide": {`, `"replace": {`, `"conflict": {`,
/// `"suggest": {`. Optional trailing `,` and `//` / `/*` comment.
/// `"require"` / `"require-dev"` and leaf metadata (`"name"`, `"type"`,
/// `"license"`, `"version"`, …) stay out. Incomplete quotes / missing `:`
/// stay out. package.json `"bin": {` / `"bin": "…"` stay on the npm path.
fn is_composer_json_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let key = &rest[..end];
    if !composer_json_key_ok(key) {
        return false;
    }
    let after_key = rest[end + 1..].trim_start();
    let Some(after_colon) = after_key.strip_prefix(':') else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    composer_json_value_and_tail_ok(key, after_colon)
}

fn composer_json_key_ok(key: &str) -> bool {
    matches!(
        key,
        "autoload"
            | "autoload-dev"
            | "scripts"
            | "repositories"
            | "config"
            | "extra"
            | "bin"
            | "provide"
            | "replace"
            | "conflict"
            | "suggest"
    )
}

fn composer_json_value_and_tail_ok(key: &str, after_colon: &str) -> bool {
    let bytes = after_colon.as_bytes();
    let Some(first) = bytes.first().copied() else {
        return false;
    };
    match first {
        b'{' => {
            // Object open: all listed keys except bin (Composer bin is an array).
            if key == "bin" {
                return false;
            }
            package_json_tail_ok(&after_colon[1..])
        }
        b'[' => {
            // Array open: repositories and bin. Allow a same-line first
            // string (`"bin": ["bin/console"]`) or object (`"repositories": [{`).
            if !matches!(key, "repositories" | "bin") {
                return false;
            }
            let rest = after_colon[1..].trim_start();
            if package_json_tail_ok(rest) {
                return true;
            }
            if let Some(inner) = rest.strip_prefix('"') {
                let Some(end) = inner.find('"') else {
                    return false;
                };
                return package_json_tail_ok(&inner[end + 1..]);
            }
            if let Some(inner) = rest.strip_prefix('{') {
                return package_json_tail_ok(inner);
            }
            false
        }
        _ => false,
    }
}

/// Pyre `.pyre_configuration` / `.pyre_configuration.local` JSON keys:
/// `"source_directories": [`, `"search_path": [`, `"exclude": [`,
/// `"extensions": [`, `"ignore_all_errors": [`, `"site_roots": [`,
/// `"binary": "…"`, `"logger": "…"`, `"typeshed": "…"`,
/// `"python_version": "3.10.0"`, `"system_platform": "linux"`,
/// `"site_package_search_strategy": "all"` / `"none"` / `"pep561"`,
/// `"strict": true`, `"workers": 4`. Optional trailing `,` and `//` /
/// `/*` comment. Incomplete quotes / missing `:` stay out. package.json /
/// composer.json structural keys, pyright / ty TOML, and leaf metadata
/// stay out.
fn is_pyre_configuration_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let key = &rest[..end];
    if !pyre_configuration_key_ok(key) {
        return false;
    }
    let after_key = rest[end + 1..].trim_start();
    let Some(after_colon) = after_key.strip_prefix(':') else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    pyre_configuration_value_and_tail_ok(key, after_colon)
}

fn pyre_configuration_key_ok(key: &str) -> bool {
    matches!(
        key,
        "source_directories"
            | "search_path"
            | "exclude"
            | "extensions"
            | "ignore_all_errors"
            | "site_roots"
            | "binary"
            | "logger"
            | "typeshed"
            | "python_version"
            | "system_platform"
            | "site_package_search_strategy"
            | "strict"
            | "workers"
    )
}

fn pyre_configuration_value_and_tail_ok(key: &str, after_colon: &str) -> bool {
    let bytes = after_colon.as_bytes();
    let Some(first) = bytes.first().copied() else {
        return false;
    };
    match first {
        b'[' => {
            if !matches!(
                key,
                "source_directories"
                    | "search_path"
                    | "exclude"
                    | "extensions"
                    | "ignore_all_errors"
                    | "site_roots"
            ) {
                return false;
            }
            package_json_tail_ok(&after_colon[1..])
        }
        b'"' => {
            if !matches!(
                key,
                "binary"
                    | "logger"
                    | "typeshed"
                    | "python_version"
                    | "system_platform"
                    | "site_package_search_strategy"
            ) {
                return false;
            }
            let rest = &after_colon[1..];
            let Some(end) = rest.find('"') else {
                return false;
            };
            let value = &rest[..end];
            if !pyre_configuration_string_ok(key, value) {
                return false;
            }
            package_json_tail_ok(&rest[end + 1..])
        }
        b't' | b'f' => {
            if key != "strict" {
                return false;
            }
            let rest = if let Some(rest) = after_colon.strip_prefix("true") {
                rest
            } else if let Some(rest) = after_colon.strip_prefix("false") {
                rest
            } else {
                return false;
            };
            package_json_tail_ok(rest)
        }
        b'0'..=b'9' => {
            if key != "workers" {
                return false;
            }
            let digits = after_colon
                .bytes()
                .take_while(|b| b.is_ascii_digit())
                .count();
            if digits == 0 || digits > 6 {
                return false;
            }
            // Reject a bare 0 workers count.
            if digits == 1 && after_colon.as_bytes()[0] == b'0' {
                return false;
            }
            package_json_tail_ok(&after_colon[digits..])
        }
        _ => false,
    }
}

fn pyre_configuration_string_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 || value.contains('\n') {
        return false;
    }
    match key {
        "binary" | "logger" | "typeshed" => true,
        "python_version" => pyre_configuration_python_version_ok(value),
        "system_platform" => pyre_configuration_platform_ok(value),
        "site_package_search_strategy" => {
            matches!(value, "all" | "none" | "pep561")
        }
        _ => false,
    }
}

fn pyre_configuration_python_version_ok(value: &str) -> bool {
    let mut parts = value.split('.');
    let Some(major) = parts.next() else {
        return false;
    };
    let Some(minor) = parts.next() else {
        return false;
    };
    let Some(patch) = parts.next() else {
        return false;
    };
    if parts.next().is_some() {
        return false;
    }
    !major.is_empty()
        && !minor.is_empty()
        && !patch.is_empty()
        && major.bytes().all(|b| b.is_ascii_digit())
        && minor.bytes().all(|b| b.is_ascii_digit())
        && patch.bytes().all(|b| b.is_ascii_digit())
        && major.len() <= 2
        && minor.len() <= 2
        && patch.len() <= 3
}

fn pyre_configuration_platform_ok(value: &str) -> bool {
    matches!(
        value,
        "linux"
            | "win32"
            | "cygwin"
            | "darwin"
            | "aix"
            | "freebsd"
            | "netbsd"
            | "openbsd"
            | "sunos5"
            | "emscripten"
            | "wasi"
    )
}

/// Pyright / basedpyright `pyrightconfig.json` JSON keys:
/// `"include": [`, `"exclude": [`, `"ignore": [`, `"strict": [`,
/// `"extraPaths": [`, `"executionEnvironments": [`,
/// `"typeCheckingMode": "strict"` / `"standard"` / `"basic"` / `"off"` /
/// `"recommended"` / `"all"`, `"pythonVersion": "3.12"`,
/// `"pythonPlatform": "Linux"` / `"Darwin"` / `"Windows"` / `"All"`,
/// `"stubPath": "typings"`, `"venvPath": "."`, `"venv": ".venv"`,
/// `"typeshedPath": "stubs"`, `"useLibraryCodeForTypes": true`,
/// `"enableTypeIgnoreComments": true`,
/// `"enableReachabilityAnalysis": true`,
/// `"deprecateTypingAliases": false`,
/// `"disableBytesTypePromotions": true`,
/// `"analyzeUnannotatedFunctions": true`,
/// `"strictListInference": true`, `"strictDictionaryInference": true`,
/// `"strictSetInference": true`, `"strictParameterNoneValue": true`,
/// `"enableExperimentalFeatures": false`,
/// `"reportMissingImports": "error"` / `true`,
/// `"reportMissingTypeStubs": false` / `"warning"`,
/// `"reportUnusedImport": "none"`, `"failOnWarnings": true`.
/// Optional trailing `,` and `//` / `/*` comment. Incomplete quotes /
/// missing `:` stay out. package.json / composer.json structural keys,
/// Pyre `.pyre_configuration`, pyright / ty TOML, and leaf metadata stay
/// out. Maps (`"defineConstant": {`) stay out.
fn is_pyrightconfig_json_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let key = &rest[..end];
    if !pyrightconfig_json_key_ok(key) {
        return false;
    }
    let after_key = rest[end + 1..].trim_start();
    let Some(after_colon) = after_key.strip_prefix(':') else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    pyrightconfig_json_value_and_tail_ok(key, after_colon)
}

fn pyrightconfig_json_key_ok(key: &str) -> bool {
    matches!(
        key,
        "include"
            | "exclude"
            | "ignore"
            | "strict"
            | "extraPaths"
            | "executionEnvironments"
            | "typeCheckingMode"
            | "pythonVersion"
            | "pythonPlatform"
            | "stubPath"
            | "venvPath"
            | "venv"
            | "typeshedPath"
            | "useLibraryCodeForTypes"
            | "enableTypeIgnoreComments"
            | "enableReachabilityAnalysis"
            | "deprecateTypingAliases"
            | "disableBytesTypePromotions"
            | "analyzeUnannotatedFunctions"
