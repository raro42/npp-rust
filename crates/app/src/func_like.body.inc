    // URLs with $releasever/$basearch, spaced display names, file:// keys,
    // True/False/yes/no/1/0, durations (`7d`).
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'_'
                    | b'-'
                    | b':'
                    | b'@'
