fn scriv_ini_version_ok(value: &str) -> bool {
    let bare = scriv_ini_bare(value);
    if bare.is_empty() || bare.len() > 512 {
        return false;
    }
    let lower = bare.to_ascii_lowercase();
    // `literal: 1.2.3`, `call: pkg:get_version`, `parse: file:regex`.
    let Some((kind, rest)) = lower.split_once(':') else {
        return false;
    };
    let rest = rest.trim();
    if rest.is_empty() {
        return false;
    }
    match kind {
        "literal" => {
            // Semver-ish or dotted token; reject bare words without digits.
            rest.chars().any(|c| c.is_ascii_digit())
                && rest
                    .chars()
                    .all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '-' | '_' | '+' | ' '))
        }
        "call" => {
            // `module:attr` or `module.sub:attr`.
            let orig = scriv_ini_bare(value);
            let Some((_, call_rest)) = orig.split_once(':') else {
                return false;
            };
            let call_rest = call_rest.trim();
            let Some((module, attr)) = call_rest.split_once(':') else {
                return false;
            };
            let module = module.trim();
            let attr = attr.trim();
            if module.is_empty() || attr.is_empty() {
                return false;
            }
            let mod_ok = module
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'.'));
            let attr_ok = attr.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_');
            mod_ok && attr_ok
        }
        "parse" => {
            // `file:regex` — regex needs a meta so prose stays out.
            let orig = scriv_ini_bare(value);
            let Some((_, parse_rest)) = orig.split_once(':') else {
                return false;
            };
            let parse_rest = parse_rest.trim();
            let Some((path, pat)) = parse_rest.split_once(':') else {
                return false;
            };
            let path = path.trim();
            let pat = pat.trim();
            if path.is_empty() || pat.is_empty() {
                return false;
            }
            let path_bytes = path.as_bytes();
            if !(path_bytes[0].is_ascii_alphanumeric() || matches!(path_bytes[0], b'_' | b'.')) {
                return false;
            }
            if !path_bytes
                .iter()
                .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
            {
                return false;
            }
            pat.chars().any(|c| {
                matches!(
                    c,
                    '(' | ')' | '[' | ']' | '\\' | '+' | '*' | '?' | '|' | '"'
                )
            })
        }
        _ => false,
    }
}

fn scriv_ini_entry_directory_ok(value: &str) -> bool {
    let bare = scriv_ini_bare(value);
    if bare.is_empty() || bare.len() > 128 {
        return false;
    }
    let lower = bare.to_ascii_lowercase();
    // Prefer stock `changelog.d` / `news/` / dotted dirs; bare `fragments`
    // alone stays out.
    let cue = lower.contains("changelog")
        || lower.contains("changes")
        || lower.contains("news")
        || lower.contains('/')
        || lower.contains('.')
        || lower.ends_with(".d");
    if !cue {
        return false;
    }
    let bytes = bare.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || matches!(bytes[0], b'_' | b'.')) {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
}

fn scriv_ini_branches_ok(value: &str) -> bool {
    let bare = scriv_ini_bare(value);
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    let mut any = false;
    for raw in bare.split(',') {
        let tok = raw.trim();
        if tok.is_empty() {
            return false;
        }
        let bytes = tok.as_bytes();
        if !bytes[0].is_ascii_alphanumeric() {
            return false;
        }
        if !bytes
            .iter()
            .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'/' | b'.'))
        {
            return false;
        }
        any = true;
    }
    any
}

fn scriv_ini_template_ok(value: &str) -> bool {
    let bare = scriv_ini_bare(value);
    if bare.is_empty() || bare.len() > 512 {
        return false;
    }
    // Jinja-style `{{ version }}` / `{% if … %}` placeholders.
    if !(bare.contains("{{") || bare.contains("{%") || bare.contains("{version}")) {
        return false;
    }
    bare.chars().all(|c| !c.is_control())
}

fn scriv_ini_rst_header_chars_ok(value: &str) -> bool {
    let bare = scriv_ini_bare(value);
    if bare.is_empty() || bare.len() > 16 {
        return false;
    }
    // Stock default `#*=`; allow common RST adornment chars.
    bare.chars().all(|c| {
        matches!(
            c,
            '#' | '*' | '=' | '-' | '~' | '^' | '"' | '\'' | '+' | ':' | '.'
        )
    }) && bare.chars().count() >= 2
}

fn scriv_ini_md_header_level_ok(value: &str) -> bool {
    let bare = scriv_ini_bare(value);
    matches!(bare, "1" | "2" | "3" | "4" | "5" | "6")
}

fn scriv_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        // Templates may start with `{{` — allow those keys through.
        if !matches!(key, "new_path_template" | "entry_title_template") {
            return false;
        }
    }
    match key {
        "format" => scriv_ini_format_ok(value),
        "output_file" => scriv_ini_output_file_ok(value),
        "insert_marker" | "end_marker" => scriv_ini_marker_ok(value),
        "version" => scriv_ini_version_ok(value),
        "entry_directory" => scriv_ini_entry_directory_ok(value),
        "main_branches" => scriv_ini_branches_ok(value),
        "new_path_template" | "entry_title_template" => scriv_ini_template_ok(value),
        "rst_header_chars" => scriv_ini_rst_header_chars_ok(value),
        "md_header_level" => scriv_ini_md_header_level_ok(value),
        "keep_fragments" | "skip_fragments" => scriv_ini_bool_ok(value),
        _ => false,
    }
}

/// import-linter `.importlinter` / `setup.cfg` / `tox.ini`
/// `[importlinter]` / `[importlinter:contract:…]` sections and fields:
/// `[importlinter]`, `[importlinter:contract:layers]`,
/// `root_package = mypackage`, `root_packages = pkg.a, pkg.b`,
/// `include_external_packages = True`,
/// `exclude_type_checking_imports = yes`,
/// `unmatched_ignore_imports_alerting = error` / `warn` / `none`,
/// `allow_indirect_imports = false`, `as_packages = true`,
/// `exhaustive = True`, `type = layers` / `independence` / `forbidden` /
/// `protected` / `acyclic_siblings`, `forbidden_modules = pkg.x`,
/// `protected_modules = pkg.y`, `allowed_importers = pkg.z`,
/// `source_modules = pkg.a`, `exhaustive_ignores = pkg.legacy`. Exact
/// snake_case keys. INI `key = value` or `key=value`. Optional quotes on
/// values. Optional `#` / `;` comment. Bare `name` / `layers` /
/// `modules` / `containers` / `ignore_imports` stay out (too generic /
/// usually multi-line). flake8 / mypy / pytest / isort / coverage /
/// pylint / pycodestyle / autopep8 / black / yapf / pydocstyle / bandit /
/// codespell / docformatter / vulture / interrogate / check-manifest /
/// bumpversion / versioneer / setuptools_scm / towncrier / zest.releaser /
/// cibuildwheel / check-wheel-contents / Twine `.pypirc` / Commitizen /
/// python-semantic-release / scriv / tox / setuptools / Cargo / Pipfile /
/// pyproject `[tool.importlinter]` tables / Desktop Entry / pip.conf stay
/// out.
fn is_importlinter_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return importlinter_ini_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !importlinter_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    importlinter_ini_value_ok(key, value)
}

fn importlinter_ini_section_ok(header: &str) -> bool {
    if header == "importlinter" {
        return true;
    }
    if let Some(id) = header.strip_prefix("importlinter:contract:") {
        return importlinter_contract_id_ok(id);
    }
    false
}

fn importlinter_contract_id_ok(id: &str) -> bool {
    if id.is_empty() || id.len() > 128 {
        return false;
    }
    let bytes = id.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-'))
}

fn importlinter_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "root_package"
            | "root_packages"
            | "include_external_packages"
            | "exclude_type_checking_imports"
            | "unmatched_ignore_imports_alerting"
            | "allow_indirect_imports"
            | "as_packages"
            | "exhaustive"
            | "type"
            | "forbidden_modules"
            | "protected_modules"
            | "allowed_importers"
            | "source_modules"
            | "exhaustive_ignores"
    )
}

fn importlinter_ini_bare(value: &str) -> &str {
    value.trim_matches(|c| c == '"' || c == '\'')
}

fn importlinter_ini_bool_ok(value: &str) -> bool {
    matches!(
        importlinter_ini_bare(value).to_ascii_lowercase().as_str(),
        "true" | "false" | "yes" | "no" | "on" | "off" | "1" | "0"
    )
}

fn importlinter_ini_alerting_ok(value: &str) -> bool {
    matches!(
        importlinter_ini_bare(value).to_ascii_lowercase().as_str(),
        "error" | "warn" | "none"
    )
}

fn importlinter_ini_type_ok(value: &str) -> bool {
    matches!(
        importlinter_ini_bare(value),
        "layers" | "independence" | "forbidden" | "protected" | "acyclic_siblings"
    )
}

fn importlinter_module_token_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 128 {
        return false;
    }
    let bytes = tok.as_bytes();
    // Python dotted package / module path (or `*` wildcards import-linter
    // accepts in some list fields).
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_' || bytes[0] == b'*') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'.' | b'*'))
        && tok.contains(|c: char| c.is_ascii_alphanumeric() || c == '_')
}

fn importlinter_module_list_ok(value: &str) -> bool {
    let bare = importlinter_ini_bare(value);
    if bare.is_empty() || bare.len() > 512 {
        return false;
    }
    let mut any = false;
    for raw in bare.split([',', ' ']) {
        let tok = raw.trim();
        if tok.is_empty() {
            continue;
        }
        if !importlinter_module_token_ok(tok) {
            return false;
        }
        any = true;
    }
    any
}

fn importlinter_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    match key {
        "root_package" => importlinter_module_token_ok(importlinter_ini_bare(value)),
        "root_packages" | "forbidden_modules" | "protected_modules" | "allowed_importers"
        | "source_modules" | "exhaustive_ignores" => importlinter_module_list_ok(value),
        "include_external_packages"
        | "exclude_type_checking_imports"
        | "allow_indirect_imports"
        | "as_packages"
        | "exhaustive" => importlinter_ini_bool_ok(value),
        "unmatched_ignore_imports_alerting" => importlinter_ini_alerting_ok(value),
        "type" => importlinter_ini_type_ok(value),
        _ => false,
    }
}

/// darglint `setup.cfg` / `tox.ini` / `.darglint` `[darglint]` section
/// and fields: `[darglint]`, `docstring_style = google` / `sphinx` /
/// `numpy`, `strictness = short` / `long` / `full`,
/// `ignore = DAR101,DAR201` / `DAR1`, `enable = DAR103`,
/// `ignore_regex = ^test_`, `ignore_raise = ValueError,TypeError`,
/// `message_template = {path}:{line} {msg_id} {msg}`,
/// `indentation = 4`. Exact snake_case keys. INI `key = value` or
/// `key=value`. Optional quotes on values. Optional `#` / `;` comment.
/// `ignore` / `enable` need comma-separated `DAR` / `DAR0`…`DAR9` /
/// `DAR###` check ids (no flake8 `E`/`F`/`W` codes). Bare
/// `message_template` without `{…}` stays out. flake8 / mypy / pytest /
/// isort / coverage / pylint / pycodestyle / autopep8 / black / yapf /
/// pydocstyle / bandit / codespell / docformatter / vulture /
/// interrogate / check-manifest / bumpversion / versioneer /
/// setuptools_scm / towncrier / zest.releaser / cibuildwheel /
/// check-wheel-contents / Twine `.pypirc` / Commitizen /
/// python-semantic-release / scriv / import-linter / tox / setuptools /
/// Cargo / Pipfile / pyproject `[tool.darglint]` tables / Desktop Entry /
/// pip.conf stay out.
fn is_darglint_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return darglint_ini_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !darglint_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    darglint_ini_value_ok(key, value)
}

fn darglint_ini_section_ok(header: &str) -> bool {
    header == "darglint"
}

fn darglint_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "docstring_style"
            | "strictness"
            | "ignore"
            | "enable"
            | "ignore_regex"
            | "ignore_raise"
            | "message_template"
            | "indentation"
    )
}

fn darglint_ini_bare(value: &str) -> &str {
    value.trim_matches(|c| c == '"' || c == '\'')
}

fn darglint_ini_style_ok(value: &str) -> bool {
    matches!(
        darglint_ini_bare(value).to_ascii_lowercase().as_str(),
        "google" | "sphinx" | "numpy"
    )
}

fn darglint_ini_strictness_ok(value: &str) -> bool {
    matches!(
        darglint_ini_bare(value).to_ascii_lowercase().as_str(),
        "short" | "long" | "full"
    )
}

fn darglint_dar_token_ok(tok: &str) -> bool {
    // DAR / DAR0…DAR9 / DAR101 / DAR201 / DAR402 …
    let bytes = tok.as_bytes();
    if bytes.len() < 3 || bytes.len() > 6 {
        return false;
    }
    if !tok.starts_with("DAR") {
        return false;
    }
    if bytes.len() == 3 {
        return true;
    }
    bytes[3..].iter().all(|b| b.is_ascii_digit())
}

fn darglint_dar_list_ok(value: &str) -> bool {
    let bare = darglint_ini_bare(value);
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    let mut any = false;
    for raw in bare.split([',', ' ']) {
        let tok = raw.trim();
        if tok.is_empty() {
            continue;
        }
        if !darglint_dar_token_ok(tok) {
            return false;
        }
        any = true;
    }
    any
}

fn darglint_ignore_raise_ok(value: &str) -> bool {
    let bare = darglint_ini_bare(value);
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    let mut any = false;
    for raw in bare.split([',', ' ']) {
        let tok = raw.trim();
        if tok.is_empty() {
            continue;
        }
        let bytes = tok.as_bytes();
        if bytes.is_empty() || bytes.len() > 64 {
            return false;
        }
        // Exception / dotted path: ValueError, builtins.ValueError
        if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
            return false;
        }
        if !bytes
            .iter()
            .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'.'))
        {
            return false;
        }
        any = true;
    }
    any
}

fn darglint_ignore_regex_ok(value: &str) -> bool {
    let bare = darglint_ini_bare(value);
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    // Keep ASCII / common regex punctuation; require at least one
    // regex-ish marker so prose stays out.
    let mut has_re = false;
    for b in bare.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if matches!(
            b,
            b'^' | b'$' | b'*' | b'+' | b'?' | b'.' | b'[' | b']' | b'(' | b')' | b'|' | b'\\'
        ) {
            has_re = true;
        }
    }
    has_re
}

fn darglint_message_template_ok(value: &str) -> bool {
    let bare = darglint_ini_bare(value);
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    if !bare.contains('{') || !bare.contains('}') {
        return false;
    }
    bare.bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
}

fn darglint_indentation_ok(value: &str) -> bool {
    let bare = darglint_ini_bare(value);
    if bare.is_empty() || bare.len() > 2 {
        return false;
    }
    if !bare.bytes().all(|b| b.is_ascii_digit()) {
        return false;
    }
    matches!(bare.parse::<u8>(), Ok(0..=16))
}

fn darglint_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        // Bare JSON/TOML blobs stay out; `{msg}` templates are handled
        // after stripping is not needed (template starts with letter).
        if key != "message_template" {
            return false;
        }
    }
    match key {
        "docstring_style" => darglint_ini_style_ok(value),
        "strictness" => darglint_ini_strictness_ok(value),
        "ignore" | "enable" => darglint_dar_list_ok(value),
        "ignore_regex" => darglint_ignore_regex_ok(value),
        "ignore_raise" => darglint_ignore_raise_ok(value),
        "message_template" => darglint_message_template_ok(value),
        "indentation" => darglint_indentation_ok(value),
        _ => false,
    }
}

