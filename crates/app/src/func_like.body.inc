        return false;
    };
    if !matches!(&rest[..end], "plurals" | "stopwords" | "compounds") {
        return false;
    }
    package_json_tail_ok(&rest[end + 1..])
}

/// Personalization / Insights `"eventType": "click"` / `"conversion"` / `"view"`.
fn algolia_crawler_json_event_type_and_tail_ok(after_colon: &str) -> bool {
    let rest = &after_colon[1..];
    let Some(end) = rest.find('"') else {
        return false;
    };
    if !matches!(&rest[..end], "click" | "conversion" | "view") {
        return false;
    }
    package_json_tail_ok(&rest[end + 1..])
}

/// Query Suggestions log `"level": "SKIP"` / `"INFO"` / `"ERROR"`.
fn algolia_crawler_json_qs_log_level_and_tail_ok(after_colon: &str) -> bool {
    let rest = &after_colon[1..];
    let Some(end) = rest.find('"') else {
        return false;
    };
    if !matches!(&rest[..end], "SKIP" | "INFO" | "ERROR") {
        return false;
    }
    package_json_tail_ok(&rest[end + 1..])
}

/// go.mod / go.work directives: `module example.com/foo`, `go 1.22`,
/// `toolchain go1.22.1`, `require (` / `require path v1.2.3`,
/// `exclude (` / single-line, `replace (` / `replace old => new`,
/// `retract (` / `retract v1.0.0` / `retract [v1.0.0, v1.0.1]`,
/// go.work `use (` / `use ./foo` / `use ../bar` / `use .` / `use foo`.
/// Optional trailing `//` / `/*` comment. Case-sensitive keywords.
/// JS `require('fs')`, bare keywords, prose (`module the team` /
/// `use the team`), and dependency / member lines inside a block stay out.
fn is_gomod_decl(s: &str) -> bool {
    let s = s.trim_start();
    gomod_module(s)
        || gomod_go_version(s)
        || gomod_toolchain(s)
        || gomod_require_or_exclude(s, "require")
        || gomod_require_or_exclude(s, "exclude")
        || gomod_replace(s)
        || gomod_retract(s)
        || gomod_use(s)
}

fn gomod_comment_or_end(rest: &str) -> bool {
    let t = rest.trim_start();
    t.is_empty() || t.starts_with("//") || t.starts_with("/*")
}

fn gomod_path_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('(') || s.starts_with('"') || s.starts_with('\'') {
        return None;
    }
    let end = s.find(|c: char| c.is_ascii_whitespace()).unwrap_or(s.len());
    let path = &s[..end];
    if path.is_empty() {
        return None;
    }
    // Domain-style or nested path; reject prose like `the`.
    if !(path.contains('.') || path.contains('/')) {
        return None;
    }
    if !path
        .bytes()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'/' | b'-' | b'_' | b'~' | b'+'))
    {
        return None;
    }
    Some((path, s[end..].trim_start()))
}

fn gomod_version_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() {
        return None;
    }
    let end = s.find(|c: char| c.is_ascii_whitespace()).unwrap_or(s.len());
    let ver = &s[..end];
    // `v1.2.3`, `v0.0.0-…`, or go language version `1.22` / `1.22.0`.
    let ok = if let Some(rest) = ver.strip_prefix('v') {
        rest.starts_with(|c: char| c.is_ascii_digit())
    } else {
        let mut parts = ver.split('.');
        matches!(parts.next(), Some(a) if !a.is_empty() && a.bytes().all(|b| b.is_ascii_digit()))
            && matches!(parts.next(), Some(b) if !b.is_empty() && b.bytes().all(|b| b.is_ascii_digit()))
            && match parts.next() {
                None => true,
                Some(c) => {
                    !c.is_empty() && c.bytes().all(|b| b.is_ascii_digit()) && parts.next().is_none()
                }
            }
    };
    if !ok {
        return None;
    }
    Some((ver, s[end..].trim_start()))
}

fn gomod_module(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("module") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_path, after)) = gomod_path_token(rest) else {
        return false;
    };
    gomod_comment_or_end(after)
}

fn gomod_go_version(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("go") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    // `go 1.22` / `go 1.22.0` — no leading `v` (that form is module versions).
    if rest.starts_with('v') {
        return false;
    }
    let Some((_ver, after)) = gomod_version_token(rest) else {
        return false;
    };
    gomod_comment_or_end(after)
}

fn gomod_toolchain(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("toolchain") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let end = rest
        .find(|c: char| c.is_ascii_whitespace())
        .unwrap_or(rest.len());
    let name = &rest[..end];
    // `go1.22.1` or `default`.
    let ok = name == "default"
        || (name.starts_with("go")
            && name.len() > 2
            && name.as_bytes()[2].is_ascii_digit()
            && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'.'));
    if !ok {
        return false;
    }
    gomod_comment_or_end(&rest[end..])
}

fn gomod_block_open(rest: &str) -> bool {
    let rest = rest.trim_start();
    let Some(after) = rest.strip_prefix('(') else {
        return false;
    };
    // JS `require('fs')` has a string immediately inside `(`.
    gomod_comment_or_end(after)
}

fn gomod_require_or_exclude(s: &str, key: &str) -> bool {
    let Some(rest) = s.strip_prefix(key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if gomod_block_open(rest) {
        return true;
    }
    let Some((_path, after_path)) = gomod_path_token(rest) else {
        return false;
    };
    let Some((_ver, after_ver)) = gomod_version_token(after_path) else {
        return false;
    };
    gomod_comment_or_end(after_ver)
}

fn gomod_replace(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("replace") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if gomod_block_open(rest) {
        return true;
    }
    let Some((_old, after_old)) = gomod_path_token(rest) else {
        return false;
    };
    // Optional old version before `=>`.
    let after_old = match gomod_version_token(after_old) {
        Some((_, rest)) => rest,
        None => after_old,
    };
    let Some(after_arrow) = after_old.strip_prefix("=>") else {
        return false;
    };
    if !after_arrow.is_empty() && !after_arrow.starts_with(char::is_whitespace) {
        return false;
    }
    let after_arrow = after_arrow.trim_start();
    // New side: module path or local `./…` / `../…`.
    let after_new = if after_arrow.starts_with("./") || after_arrow.starts_with("../") {
        let end = after_arrow
            .find(|c: char| c.is_ascii_whitespace())
            .unwrap_or(after_arrow.len());
        let path = &after_arrow[..end];
        if path.is_empty() {
            return false;
        }
        after_arrow[end..].trim_start()
    } else {
        let Some((_path, rest)) = gomod_path_token(after_arrow) else {
            return false;
        };
        rest
    };
    let after_new = match gomod_version_token(after_new) {
        Some((_, rest)) => rest,
        None => after_new,
    };
    gomod_comment_or_end(after_new)
}

fn gomod_retract(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("retract") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if gomod_block_open(rest) {
        return true;
    }
    if let Some(inner) = rest.strip_prefix('[') {
        // Interval: `[v1.0.0, v1.1.0]` — require a closing `]` then comment/end.
        let Some(close) = inner.find(']') else {
            return false;
        };
        let body = inner[..close].trim();
        if body.is_empty() {
            return false;
        }
        return gomod_comment_or_end(&inner[close + 1..]);
    }
    let Some((_ver, after)) = gomod_version_token(rest) else {
        return false;
    };
    gomod_comment_or_end(after)
}

/// go.work `use` path: `./foo`, `../bar`, `/abs`, `.`, or a single relative
/// segment (`foo`, `hello/world`). Rejects quotes and empty.
fn gowork_use_path(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('(') || s.starts_with('"') || s.starts_with('\'') {
        return None;
    }
    let end = s.find(|c: char| c.is_ascii_whitespace()).unwrap_or(s.len());
    let path = &s[..end];
    if path.is_empty() {
        return None;
    }
    let ok = if path == "." {
        true
    } else {
        !path.starts_with('-')
            && path.bytes().all(|b| {
                b.is_ascii_alphanumeric() || matches!(b, b'.' | b'/' | b'-' | b'_' | b'~' | b'+')
            })
    };
    if !ok {
        return None;
    }
    Some((path, s[end..].trim_start()))
}

/// go.work `use (` / `use ./foo` / `use ../bar` / `use .` / `use foo`.
/// Prose (`use the team`) and bare `use` stay out.
fn gomod_use(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("use") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if gomod_block_open(rest) {
        return true;
    }
    let Some((_path, after)) = gowork_use_path(rest) else {
        return false;
    };
    gomod_comment_or_end(after)
}

/// Bundler Gemfile directives: `source "…"`, `ruby "…"`, `gem "…"`,
/// `group :development do`, `gemspec`, `platforms :ruby do` /
/// `platform :jruby do`, `git_source(:github)`, `plugin "…"`,
/// `eval_gemfile "…"`. Optional trailing kwargs / version / `#` / `do`.
/// Bare keywords, prose (`gem the rails`, `source the gems`), and wrong
/// case stay out. Rake `task` / Ruby `attr_*` stay on their paths.
fn is_gemfile_decl(s: &str) -> bool {
    let s = s.trim_start();
    gemfile_quoted_kw(s, "source")
        || gemfile_quoted_kw(s, "ruby")
        || gemfile_quoted_kw(s, "gem")
        || gemfile_quoted_kw(s, "plugin")
        || gemfile_quoted_kw(s, "eval_gemfile")
        || gemfile_gemspec(s)
        || gemfile_group_or_platform(s, "group")
        || gemfile_group_or_platform(s, "platforms")
        || gemfile_group_or_platform(s, "platform")
        || gemfile_git_source(s)
}

fn gemfile_comment_or_end(rest: &str) -> bool {
    let t = rest.trim_start();
    t.is_empty() || t.starts_with('#')
}

fn gemfile_do_tail(rest: &str) -> bool {
    let Some(after) = rest.strip_prefix("do") else {
        return false;
    };
    after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('#')
}

/// After a quoted string: allow trailing kwargs / version / `do` / `#`.
fn gemfile_after_quoted_ok(after: &str) -> bool {
    let t = after.trim_start();
    if gemfile_comment_or_end(t) {
        return true;
    }
    if gemfile_do_tail(t) {
        let after_do = t[2..].trim_start();
        return gemfile_comment_or_end(after_do);
    }
    // Trailing args: `, …` (version string, kwargs, git:, require:, …).
    if let Some(rest) = t.strip_prefix(',') {
        let rest = rest.trim_start();
        return !rest.is_empty();
    }
    false
}

fn gemfile_quoted_string(s: &str) -> Option<(&str, &str)> {
    let bytes = s.as_bytes();
    let &q = bytes.first()?;
    if q != b'"' && q != b'\'' {
        return None;
    }
    let rest = &s[1..];
    let end = rest.find(q as char)?;
    let name = &rest[..end];
    if name.is_empty() {
        return None;
    }
    // Gem / source / plugin names: printable, no bare spaces (paths/URLs ok).
    if name.chars().any(|c| c == '\n' || c == '\r') {
        return None;
    }
    Some((name, rest[end + 1..].trim_start()))
}

fn gemfile_quoted_kw(s: &str, kw: &str) -> bool {
    let Some(rest) = s.strip_prefix(kw) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_name, after)) = gemfile_quoted_string(rest) else {
        return false;
    };
    gemfile_after_quoted_ok(after)
}

fn gemfile_gemspec(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("gemspec") else {
        return false;
    };
    // Bare `gemspec` or `gemspec path: "…"`, `gemspec name: "foo"`.
    if rest.is_empty() || rest.starts_with(char::is_whitespace) {
        let t = rest.trim_start();
        return gemfile_comment_or_end(t)
            || t.starts_with("path:")
            || t.starts_with("name:")
            || t.starts_with("development_group:");
    }
    false
}

fn gemfile_symbol_or_string(s: &str) -> Option<&str> {
    let s = s.trim_start();
    if let Some(rest) = s.strip_prefix(':') {
        let end = rest
            .find(|c: char| {
                !(c.is_ascii_alphanumeric() || c == '_' || c == '-' || c == '?' || c == '!')
            })
            .unwrap_or(rest.len());
        if end == 0 {
            return None;
        }
        return Some(rest[end..].trim_start());
    }
    if let Some((_name, after)) = gemfile_quoted_string(s) {
        return Some(after);
    }
    None
}

fn gemfile_group_or_platform(s: &str, kw: &str) -> bool {
    let Some(rest) = s.strip_prefix(kw) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    // At least one `:sym` or `"name"`, optional more via `,`.
    let Some(after_first) = gemfile_symbol_or_string(rest) else {
        return false;
    };
    rest = after_first;
    while let Some(after_comma) = rest.strip_prefix(',') {
        rest = after_comma.trim_start();
        let Some(after_next) = gemfile_symbol_or_string(rest) else {
            return false;
        };
        rest = after_next;
    }
    // Prefer `do` (Bundler block). Allow bare end / `#` for one-liners.
    if gemfile_do_tail(rest) {
        let after_do = rest[2..].trim_start();
        return gemfile_comment_or_end(after_do);
    }
    gemfile_comment_or_end(rest)
}

fn gemfile_git_source(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("git_source") else {
        return false;
    };
    let rest = rest.trim_start();
    let Some(inner) = rest.strip_prefix('(') else {
        return false;
    };
    let inner = inner.trim_start();
    // `:github` or `"github"`.
    let after_name = if let Some(r) = inner.strip_prefix(':') {
        let end = r
            .find(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
            .unwrap_or(r.len());
        if end == 0 {
            return false;
        }
        r[end..].trim_start()
    } else if let Some((_n, after)) = gemfile_quoted_string(inner) {
        after
    } else {
        return false;
    };
    let Some(after_paren) = after_name.strip_prefix(')') else {
        return false;
    };
    let after_paren = after_paren.trim_start();
    gemfile_comment_or_end(after_paren)
        || gemfile_do_tail(after_paren)
        || after_paren.starts_with('{')
}

/// Homebrew Brewfile directives: `tap "…"`, `brew "…"`, `cask "…"`,
/// `mas "…", id: 123`, `whalebrew "…"`, `vscode "…"`. Optional trailing
/// kwargs / `#` comment. Bare keywords, prose (`brew the package`),
/// `brew install …`, and wrong case stay out. Gemfile `gem` / Rake
/// `task` stay on their paths.
fn is_brewfile_decl(s: &str) -> bool {
    let s = s.trim_start();
    gemfile_quoted_kw(s, "tap")
        || gemfile_quoted_kw(s, "brew")
        || gemfile_quoted_kw(s, "cask")
        || gemfile_quoted_kw(s, "whalebrew")
        || gemfile_quoted_kw(s, "vscode")
        || brewfile_mas(s)
}

fn brewfile_mas(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("mas") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_name, after)) = gemfile_quoted_string(rest) else {
        return false;
    };
    // Prefer `mas "Name", id: 12345`. Also allow bare quoted + `#`.
    let t = after.trim_start();
    if gemfile_comment_or_end(t) {
        return true;
    }
    let Some(after_comma) = t.strip_prefix(',') else {
        return false;
    };
    let after_comma = after_comma.trim_start();
    let Some(after_id) = after_comma.strip_prefix("id:") else {
        return false;
    };
    let after_id = after_id.trim_start();
    let digits = after_id.chars().take_while(|c| c.is_ascii_digit()).count();
    if digits == 0 {
        return false;
    }
    gemfile_comment_or_end(after_id[digits..].trim_start())
}

/// CocoaPods Podfile directives: `pod "…"`, `target "…" do`,
/// `abstract_target "…" do`, `use_frameworks!`, `use_modular_headers!`,
/// `inhibit_all_warnings!`, `install! "cocoapods"`, and install hooks
/// (`pre_install` / `post_install` / `pre_integrate` / `post_integrate`).
/// Optional trailing kwargs / `#` / `|installer|`. Bare keywords, prose
/// (`pod the alamofire`), and wrong case stay out. xmake `target("…")`
/// stays on its path; Gemfile `gem` / Brewfile `brew` stay on theirs.
fn is_podfile_decl(s: &str) -> bool {
    let s = s.trim_start();
    gemfile_quoted_kw(s, "pod")
        || gemfile_quoted_kw(s, "target")
        || gemfile_quoted_kw(s, "abstract_target")
        || podfile_bang(s, "use_frameworks!")
        || podfile_bang(s, "use_modular_headers!")
        || podfile_bang(s, "inhibit_all_warnings!")
        || podfile_install(s)
        || podfile_hook(s, "pre_install")
        || podfile_hook(s, "post_install")
        || podfile_hook(s, "pre_integrate")
        || podfile_hook(s, "post_integrate")
}

fn podfile_bang(s: &str, kw: &str) -> bool {
    let Some(rest) = s.strip_prefix(kw) else {
        return false;
    };
    let t = rest.trim_start();
    // Bare bang, `#` comment, or kwargs (`:linkage => :static`).
    gemfile_comment_or_end(t) || t.starts_with(':') || t.starts_with(',')
}

fn podfile_install(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("install!") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_name, after)) = gemfile_quoted_string(rest) else {
        return false;
    };
    gemfile_after_quoted_ok(after)
}

fn podfile_hook(s: &str, kw: &str) -> bool {
    let Some(rest) = s.strip_prefix(kw) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if !gemfile_do_tail(rest) {
        return false;
    }
    let after_do = rest[2..].trim_start();
    if gemfile_comment_or_end(after_do) {
        return true;
    }
    // Optional `|installer|` block args.
    let Some(inner) = after_do.strip_prefix('|') else {
        return false;
    };
    let Some(end) = inner.find('|') else {
        return false;
    };
    gemfile_comment_or_end(inner[end + 1..].trim_start())
}

/// Pipfile (Pipenv) structural tables: `[[source]]`, `[packages]`,
/// `[dev-packages]`, `[requires]`, `[scripts]`, `[pipenv]`. Optional
/// trailing `#` comment. Package assignment lines (`requests = "*"`),
/// Cargo / pyproject tables, incomplete brackets, and prose stay out.
fn is_pipfile_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if !cargo_toml_tail_ok(after) {
        return false;
    }
    if array {
        header == "source"
    } else {
        matches!(
            header,
            "packages" | "dev-packages" | "requires" | "scripts" | "pipenv"
        )
    }
}

/// tox.ini sections: `[tox]`, `[testenv]`, `[testenv:py39]` /
/// `[testenv:lint]`, `[gh-actions]`, `[gh-actions:env]`. Optional
/// trailing `#` or `;` comment. Key lines (`envlist = py39`), Cargo /
/// Pipfile / pyproject / Desktop Entry tables, incomplete brackets, and
/// prose stay out.
fn is_tox_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if array || !tox_ini_tail_ok(after) {
        return false;
    }
    tox_ini_header_ok(header)
}

fn tox_ini_tail_ok(after: &str) -> bool {
    let t = after.trim_start();
    t.is_empty() || t.starts_with('#') || t.starts_with(';')
}

fn tox_ini_header_ok(header: &str) -> bool {
    if matches!(header, "tox" | "testenv" | "gh-actions") {
        return true;
    }
    if let Some(name) = header.strip_prefix("testenv:") {
        return tox_ini_segment_ok(name);
    }
    if let Some(name) = header.strip_prefix("gh-actions:") {
        return tox_ini_segment_ok(name);
    }
    false
}

fn tox_ini_segment_ok(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.'))
}

/// setuptools `setup.cfg`: `[metadata]` / `[options]` /
/// `[options.packages.find]` / `[options.package_data]` /
/// `[options.exclude_package_data]` / `[options.extras_require]` /
/// `[options.entry_points]` / `[options.data_files]` / `[sdist]` /
/// `[bdist_wheel]` / `[egg_info]` / `[aliases]` / `[build_ext]`,
/// `python_requires = >=3.8`, `long_description_content_type = text/markdown`,
/// `long_description = file: README.md`, `install_requires = requests`,
/// `setup_requires = …`, `tests_require = …`, `include_package_data = True`,
/// `namespace_packages = …`,
/// `zip_safe = False`, `package_dir = src`, `py_modules = foo`,
/// `packages = find:`, `license_files = LICENSE`, `license_file = LICENSE`,
/// `project_urls = …`, `download_url = …`, `author_email = …`,
/// `maintainer_email = …`, `provides_extras = …`, `universal = 1`,
/// `py-limited-api = cp38`, `tag_build = …`, `tag_date = false`. Exact
/// setuptools keys (snake_case; `py-limited-api` kebab). INI `key = value`
/// or `key=value`. Optional `#` / `;` comment. Free-form `name` / `version` /
/// `author` / `url` / `license` / `description` / `classifiers` / `keywords` /
/// `where` / `include` / `exclude` / `scripts`, flake8 / mypy / tool:pytest /
/// tox / Cargo / Pipfile / pyproject / Desktop Entry / pip.conf tables,
/// incomplete brackets, and prose stay out.
fn is_setup_cfg_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return setup_cfg_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !setup_cfg_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    setup_cfg_value_ok(key, value)
}

fn setup_cfg_section_ok(header: &str) -> bool {
    matches!(
        header,
        "metadata"
            | "options"
            | "options.packages.find"
            | "options.package_data"
            | "options.exclude_package_data"
