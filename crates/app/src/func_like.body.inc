fn angular_json_path_ok(value: &str) -> bool {
    let bytes = value.as_bytes();
    if bytes.is_empty() || bytes.len() > 512 {
        return false;
    }
    if value.contains('\n') || value.chars().all(|c| c.is_ascii_whitespace()) {
        return false;
    }
    // Relative / absolute path-ish tokens used in angular.json.
    if !(bytes[0].is_ascii_alphanumeric() || matches!(bytes[0], b'.' | b'/' | b'\\' | b'@' | b'~'))
    {
        return false;
    }
    bytes.iter().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                *b,
                b'.' | b'/'
                    | b'\\'
                    | b'-'
                    | b'_'
                    | b'@'
                    | b':'
                    | b'~'
                    | b'+'
                    | b'%'
                    | b'?'
                    | b'='
                    | b'&'
            )
    })
}

fn angular_json_prefix_ok(value: &str) -> bool {
    let bytes = value.as_bytes();
    if bytes.is_empty() || bytes.len() > 64 {
        return false;
    }
    if !bytes[0].is_ascii_alphabetic() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'))
}

fn angular_json_builder_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 || value.contains('\n') {
        return false;
    }
    // `@scope/pkg:target` or `pkg:target`.
    let Some((left, right)) = value.split_once(':') else {
        return false;
    };
    if left.is_empty() || right.is_empty() {
        return false;
    }
    if !left
        .bytes()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'@' | b'/' | b'-' | b'_' | b'.'))
    {
        return false;
    }
    right
        .bytes()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b'/'))
}

fn angular_json_target_ref_ok(value: &str) -> bool {
    // `project:target` / `project:target:configuration`
    let bytes = value.as_bytes();
    if bytes.is_empty() || bytes.len() > 256 || value.contains('\n') {
        return false;
    }
    if !value.contains(':') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b':' | b'-' | b'_' | b'.'))
        && !value.starts_with(':')
        && !value.ends_with(':')
        && !value.contains("::")
}

fn angular_json_string_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 || value.contains('\n') {
        return false;
    }
    if value.chars().all(|c| c.is_ascii_whitespace()) {
        return false;
    }
    match key {
        "projectType" => matches!(value, "application" | "library"),
        "outputHashing" => matches!(value, "all" | "media" | "bundles" | "none"),
        "inlineStyleLanguage" => matches!(value, "css" | "scss" | "sass" | "less"),
        "crossOrigin" => matches!(value, "anonymous" | "use-credentials" | "none"),
        "builder" => angular_json_builder_ok(value),
        "browserTarget" | "buildTarget" => angular_json_target_ref_ok(value),
        "prefix" | "defaultProject" | "defaultConfiguration" => angular_json_prefix_ok(value),
        "main" => {
            // Keep package.json `"main": "index.js"` out of the shared scanner.
            angular_json_path_ok(value)
                && (value.contains('/') || value.contains('\\'))
                && (value.ends_with(".ts") || value.ends_with(".tsx"))
        }
        "newProjectRoot"
        | "sourceRoot"
        | "outputPath"
        | "index"
        | "polyfills"
        | "tsConfig"
        | "browser"
        | "servePath"
        | "publicHost"
        | "baseHref"
        | "deployUrl"
        | "resourcesOutputPath"
        | "ngswConfigPath"
        | "webWorkerTsConfig"
        | "server"
        | "serviceWorker" => angular_json_path_ok(value),
        _ => false,
    }
}

/// NestJS `nest-cli.json` JSON keys:
/// `"collection": "@nestjs/…"`, `"entryFile": "main"`,
/// `"generateOptions": {`, `"monorepo": true`,
/// `"deleteOutDir": true`, `"webpack": true`,
/// `"webpackConfigPath": "…"`, `"tsConfigPath": "…"`,
/// `"watchAssets": true`, `"manualRestart": true`,
/// `"typeCheck": true`, `"builder": "tsc"` / `"swc"` / `"webpack"`,
/// `"language": "ts"` / `"js"`, `"exec": "node"`.
/// Optional trailing `,` and `//` / `/*` comment. Incomplete quotes /
/// missing `:` stay out. Generic `"$schema"` / `"version"` / `"name"` /
/// `"projects"` / `"root"` / `"sourceRoot"` / `"compilerOptions"` /
/// `"plugins"` / `"assets"` / angular `"architect"` / `"schematics"` /
/// `"cli"` / `"projectType"` / `"newProjectRoot"` / `"prefix"` /
/// `"aot"` / `"assets": [` / eas `"submit"` / `"developmentClient"` /
/// `"distribution"` / expo `"expo"` / `"slug"` / ionic
/// `"integrations"` / `"hooks"` / capacitor `"appId"` / `"appName"` /
/// `"webDir"` / `"bundledWebRuntime"` / tauri `"productName"` /
/// `"identifier"` / `"withGlobalTauri"` / `"allowlist"` /
/// `"frontendDist"` / wails `"assetdir"` / `"frontend:dir"` /
/// `"wailsjsdir"` / `"outputfilename"` / `"debounceMS"` /
/// `"obfuscated"` / `"nsisType"` / `"preBuildHooks"` / `"bindings"` /
/// firebase `"hosting"` / `"firestore"` / `"emulators"` / `"auth"` /
/// vercel `"rewrites"` / `"redirects"` / `"headers"` / `"crons"` /
/// `"regions"` / `"framework"` / `"buildCommand"` / `"cleanUrls"` /
/// `"version": 2` / changesets `"baseBranch"` / rush `"rushVersion"` /
/// `"projects"` / lerna `"npmClient"` / `"useWorkspaces"` /
/// `"packages": [` / turbo `"tasks"` / `"pipeline"` /
/// `"globalDependencies"` / `"cacheDir"` / `"envMode"` / nx
/// `"namedInputs"` / `"targetDefaults"` / `"cacheDirectory"` / Parcel
/// `"transformers"` / babel `"presets"` / SWC `"jsc"` / eslint `"root"` /
/// `"rules"` / stylelint `"ignoreFiles"` / prettier `"printWidth"` /
/// biome `"linter"` / dprint `"includes"` / tsconfig `"compilerOptions"` /
/// package.json `"scripts": {` stay out. Nest `"builder": "tsc"` /
/// `"swc"` / `"webpack"` (no `@scope:target`) is listed; Angular
/// `"builder": "@angular…:…"` stays on the angular path.
fn is_nest_cli_json_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('"') else {
        return false;
    };
    let Some(end) = rest.find('"') else {
        return false;
    };
    let key = &rest[..end];
    if !nest_cli_json_key_ok(key) {
        return false;
    }
    let after_key = rest[end + 1..].trim_start();
    let Some(after_colon) = after_key.strip_prefix(':') else {
        return false;
    };
    let after_colon = after_colon.trim_start();
    nest_cli_json_value_and_tail_ok(key, after_colon)
}

fn nest_cli_json_key_ok(key: &str) -> bool {
    matches!(
        key,
        "collection"
            | "entryFile"
            | "generateOptions"
            | "monorepo"
            | "deleteOutDir"
            | "webpack"
            | "webpackConfigPath"
            | "tsConfigPath"
            | "watchAssets"
            | "manualRestart"
            | "typeCheck"
            | "builder"
            | "language"
            | "exec"
    )
}

fn nest_cli_json_value_and_tail_ok(key: &str, after_colon: &str) -> bool {
    let bytes = after_colon.as_bytes();
    let Some(first) = bytes.first().copied() else {
        return false;
    };
    match first {
        b'{' => {
            if !nest_cli_json_object_key_ok(key) {
                return false;
            }
            package_json_tail_ok(&after_colon[1..])
        }
        b'"' => {
            if !nest_cli_json_string_key_ok(key) {
                return false;
            }
            let rest = &after_colon[1..];
            let Some(end) = rest.find('"') else {
                return false;
            };
            let value = &rest[..end];
            if !nest_cli_json_string_ok(key, value) {
                return false;
            }
            package_json_tail_ok(&rest[end + 1..])
        }
        b't' | b'f' => {
            let rest = if let Some(rest) = after_colon.strip_prefix("true") {
                rest
            } else if let Some(rest) = after_colon.strip_prefix("false") {
                rest
            } else {
                return false;
            };
            if !nest_cli_json_bool_key_ok(key) {
                return false;
            }
            package_json_tail_ok(rest)
        }
        _ => false,
    }
}

fn nest_cli_json_object_key_ok(key: &str) -> bool {
    matches!(key, "generateOptions")
}

fn nest_cli_json_string_key_ok(key: &str) -> bool {
    matches!(
        key,
        "collection"
            | "entryFile"
            | "webpackConfigPath"
            | "tsConfigPath"
            | "builder"
            | "language"
            | "exec"
    )
}

fn nest_cli_json_bool_key_ok(key: &str) -> bool {
    matches!(
        key,
        "monorepo" | "deleteOutDir" | "webpack" | "watchAssets" | "manualRestart" | "typeCheck"
    )
}

fn nest_cli_json_ident_ok(value: &str) -> bool {
    let bytes = value.as_bytes();
    if bytes.is_empty() || bytes.len() > 128 {
        return false;
    }
    if !bytes[0].is_ascii_alphabetic() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'))
}

fn nest_cli_json_collection_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 || value.contains('\n') {
        return false;
    }
    // `@scope/pkg` or bare package name.
    let bytes = value.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'@') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'@' | b'/' | b'-' | b'_' | b'.'))
}

fn nest_cli_json_string_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 || value.contains('\n') {
        return false;
    }
    if value.chars().all(|c| c.is_ascii_whitespace()) {
        return false;
    }
    match key {
        "builder" => matches!(value, "tsc" | "swc" | "webpack"),
        "language" => matches!(value, "ts" | "js"),
        "collection" => nest_cli_json_collection_ok(value),
        "entryFile" | "exec" => nest_cli_json_ident_ok(value),
        "webpackConfigPath" | "tsConfigPath" => angular_json_path_ok(value),
        _ => false,
    }
}

