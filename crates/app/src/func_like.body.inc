fn fly_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (processes = […], args = {…}, …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "force_https" | "auto_start_machines" | "tls_skip_verify" | "auto_rollback"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "auto_stop_machines" {
        return bare.eq_ignore_ascii_case("true")
            || bare.eq_ignore_ascii_case("false")
            || matches!(bare, "stop" | "suspend" | "off");
    }
    if matches!(
        key,
        "swap_size_mb"
            | "max_unavailable"
            | "internal_port"
            | "min_machines_running"
            | "hard_limit"
            | "soft_limit"
            | "cpus"
            | "memory_mb"
            | "gpus"
    ) {
        // Non-negative integer (min_machines_running may be 0).
        if key == "internal_port" || key == "cpus" || key == "gpus" {
            return bare.len() <= 5 && bare.bytes().all(|b| b.is_ascii_digit()) && bare != "0";
        }
        return bare.len() <= 6 && bare.bytes().all(|b| b.is_ascii_digit());
    }
    if key == "strategy" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "rolling" | "bluegreen" | "canary" | "immediate");
    }
    if key == "type" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "requests" | "connections");
    }
    if key == "protocol" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "tcp" | "udp" | "http" | "https");
    }
    if key == "method" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(
            bare,
            "GET" | "HEAD" | "POST" | "PUT" | "PATCH" | "DELETE" | "OPTIONS"
        );
    }
    if key == "app" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return fly_toml_app_name_ok(bare);
    }
    if key == "primary_region" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        // Fly region codes: 3–4 lowercase letters (iad, ord, sjc, …).
        return (3..=4).contains(&bare.len()) && bare.bytes().all(|b| b.is_ascii_lowercase());
    }
    if matches!(
        key,
        "kill_signal"
            | "kill_timeout"
            | "console_command"
            | "dockerfile"
            | "ignorefile"
            | "image"
            | "builder"
            | "build-target"
            | "release_command"
            | "wait_timeout"
            | "idle_timeout"
            | "interval"
            | "timeout"
            | "grace_period"
            | "path"
            | "cpu_kind"
            | "memory"
            | "size"
            | "gpu_kind"
            | "source"
            | "destination"
            | "initial_size"
            | "guest_path"
            | "url_prefix"
            | "local_path"
            | "raw_value"
            | "secret_name"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 512 {
            return false;
        }
        if !bare
            .bytes()
            .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
        {
            return false;
        }
        if key == "kill_signal" {
            return bare.starts_with("SIG")
                && bare.len() >= 4
                && bare.bytes().all(|b| b.is_ascii_uppercase());
        }
        if matches!(
            key,
            "kill_timeout"
                | "wait_timeout"
                | "idle_timeout"
                | "interval"
                | "timeout"
                | "grace_period"
        ) {
            return fly_toml_duration_ok(bare);
        }
        if matches!(key, "path" | "url_prefix" | "guest_path" | "destination") {
            return bare.starts_with('/') || bare.contains('*');
        }
        if matches!(key, "dockerfile" | "ignorefile" | "local_path") {
            return bare.contains('/')
                || bare.contains('.')
                || bare
                    .bytes()
                    .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
        }
        if key == "source" {
            return bare
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
        }
        if key == "cpu_kind" {
            return matches!(bare, "shared" | "performance");
        }
        if matches!(key, "memory" | "initial_size" | "size") {
            // `1gb` / `256mb` / `shared-cpu-1x` style sizes.
            return bare
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
        }
        if key == "gpu_kind" {
            return bare
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
        }
        // console_command / image / builder / build-target / release_command /
        // raw_value / secret_name: quoted graphic string.
        return true;
    }
    false
}

fn fly_toml_app_name_ok(s: &str) -> bool {
    if s.is_empty() || s.len() > 63 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| s.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = s.as_bytes();
    // Fly apps: lowercase alphanumeric + dashes; no leading/trailing dash.
    if !bytes[0].is_ascii_lowercase() && !bytes[0].is_ascii_digit() {
        return false;
    }
    if bytes[0] == b'-' || bytes[bytes.len() - 1] == b'-' {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || *b == b'-')
}

fn fly_toml_duration_ok(s: &str) -> bool {
    // `5s` / `15s` / `2m` / `1h` / bare digits (seconds).
    if s.is_empty() || s.len() > 8 {
        return false;
    }
    let bytes = s.as_bytes();
    if bytes.iter().all(|b| b.is_ascii_digit()) {
        return !s.is_empty() && s != "0";
    }
    if bytes.len() < 2 {
        return false;
    }
    let (num, unit) = bytes.split_at(bytes.len() - 1);
    if num.is_empty() || !num.iter().all(|b| b.is_ascii_digit()) {
        return false;
    }
    matches!(unit, b"s" | b"m" | b"h")
}

/// Railway `railway.toml`: `[build]` / `[deploy]` /
/// `[environments.name]` / `[environments.name.build]` /
/// `[environments.name.deploy]`, `builder = "RAILPACK"` /
/// `"DOCKERFILE"` / `"NIXPACKS"` / `"HEROKU"` / `"PAKETO"`,
/// `buildCommand = "npm run build"`, `dockerfilePath = "Dockerfile"`,
/// `nixpacksConfigPath = "nixpacks.toml"`, `nixpacksVersion = "1.21.3"`,
/// `railpackVersion = "0.7.0"`, `buildEnvironment = "V2"` / `"V3"`,
/// `startCommand = "node index.js"`, `preDeployCommand = "…"`,
/// `preDeployTimeoutSeconds = 300`, `numReplicas = 1`,
/// `healthcheckPath = "/health"`, `healthcheckTimeout = 100`,
/// `sleepApplication = false`, `runtime = "V2"` / `"LEGACY"` /
/// `"UNSPECIFIED"`, `restartPolicyType = "ON_FAILURE"` / `"ALWAYS"` /
/// `"NEVER"`, `restartPolicyMaxRetries = 10`, `cronSchedule = "0 * * * *"`,
/// `region = "us-west2"`, `requiredMountPath = "/data"`,
/// `overlapSeconds = 0`, `drainingSeconds = 10`,
/// `ipv6EgressEnabled = false`. Exact Railway keys (camelCase). TOML
/// `key = value` with spaces around `=`. Optional `#` comment.
/// Arrays (`watchPatterns = […]`, `preDeployCommand = […]`) / nested
/// maps (`nixpacksPlan = {…}`, `multiRegionConfig = {…}`,
/// `limitOverride = {…}`, `registryCredentials = {…}`) / `$schema` /
/// prose / wrong case / nixpacks / fly / netlify / wrangler / dioxus /
/// uniffi / cbindgen / trunk / mutants / audit / cliff / cargo-make /
/// release.toml / Dist.toml / mdBook / taplo / typos / bacon / Cross /
/// rust-toolchain / cargo config / nextest / deny / clippy / rustfmt /
/// ruff / uv / bunfig / yarn / npmrc / pip / Cargo.toml stay out.
fn is_railway_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        // Railway has no `[[…]]` array-of-tables sections.
        if array {
            return false;
        }
        return railway_toml_section_ok(header);
    }
    // Quote-aware `#` / `;` strip so path / cron strings keep `#` out.
    let body = railway_toml_strip_comment(s);
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    // Nested dotted free-form keys stay out.
    if key.contains('.') {
        return false;
    }
    if !railway_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    railway_toml_value_ok(key, value)
}

fn railway_toml_strip_comment(s: &str) -> &str {
    let mut in_single = false;
    let mut in_double = false;
    for (i, b) in s.bytes().enumerate() {
        match b {
            b'\'' if !in_double => in_single = !in_single,
            b'"' if !in_single => in_double = !in_double,
            b'#' | b';' if !in_single && !in_double => {
                return s[..i].trim_end();
            }
            _ => {}
        }
    }
    s.trim()
}

fn railway_toml_section_ok(header: &str) -> bool {
    if matches!(header, "build" | "deploy") {
        return true;
    }
    if let Some(rest) = header.strip_prefix("environments.") {
        return railway_toml_environments_ok(rest);
    }
    false
}

fn railway_toml_environments_ok(rest: &str) -> bool {
    let (name, suffix) = match rest.split_once('.') {
        Some((n, s)) => (n, Some(s)),
        None => (rest, None),
    };
    if !railway_toml_env_name_ok(name) {
        return false;
    }
    match suffix {
        None => true,
        Some(s) => matches!(s, "build" | "deploy"),
    }
}

fn railway_toml_env_name_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    if name.is_empty() || name.len() > 128 {
        return false;
    }
    let bytes = name.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'-' | b'_'))
}

fn railway_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        "builder"
            | "buildCommand"
            | "dockerfilePath"
            | "nixpacksConfigPath"
            | "nixpacksVersion"
            | "railpackVersion"
            | "buildEnvironment"
            | "startCommand"
            | "preDeployCommand"
            | "preDeployTimeoutSeconds"
            | "numReplicas"
            | "healthcheckPath"
            | "healthcheckTimeout"
            | "sleepApplication"
            | "runtime"
            | "restartPolicyType"
            | "restartPolicyMaxRetries"
            | "cronSchedule"
            | "region"
            | "requiredMountPath"
            | "overlapSeconds"
            | "drainingSeconds"
            | "ipv6EgressEnabled"
            | "useLegacyStacker"
    )
}

fn railway_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (watchPatterns = […], …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "sleepApplication" | "ipv6EgressEnabled" | "useLegacyStacker"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(
        key,
        "preDeployTimeoutSeconds"
            | "numReplicas"
            | "healthcheckTimeout"
            | "restartPolicyMaxRetries"
            | "overlapSeconds"
            | "drainingSeconds"
    ) {
        if !bare.bytes().all(|b| b.is_ascii_digit()) || bare.len() > 6 {
            return false;
        }
        if matches!(
            key,
            "preDeployTimeoutSeconds" | "numReplicas" | "restartPolicyMaxRetries"
        ) {
            return bare != "0";
        }
        return true;
    }
    if key == "builder" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare.eq_ignore_ascii_case("RAILPACK")
            || bare.eq_ignore_ascii_case("DOCKERFILE")
            || bare.eq_ignore_ascii_case("NIXPACKS")
            || bare.eq_ignore_ascii_case("HEROKU")
            || bare.eq_ignore_ascii_case("PAKETO");
    }
    if key == "restartPolicyType" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare.eq_ignore_ascii_case("ON_FAILURE")
            || bare.eq_ignore_ascii_case("ALWAYS")
            || bare.eq_ignore_ascii_case("NEVER");
    }
    if key == "runtime" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare.eq_ignore_ascii_case("UNSPECIFIED")
            || bare.eq_ignore_ascii_case("LEGACY")
            || bare.eq_ignore_ascii_case("V2");
    }
    if key == "buildEnvironment" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare.eq_ignore_ascii_case("V2") || bare.eq_ignore_ascii_case("V3");
    }
    if matches!(
        key,
        "buildCommand"
            | "dockerfilePath"
            | "nixpacksConfigPath"
            | "nixpacksVersion"
            | "railpackVersion"
            | "startCommand"
            | "preDeployCommand"
            | "healthcheckPath"
            | "cronSchedule"
            | "region"
            | "requiredMountPath"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 512 {
            return false;
        }
        if !bare
            .bytes()
            .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
        {
            return false;
        }
        if key == "healthcheckPath" || key == "requiredMountPath" {
            return bare.starts_with('/');
        }
        if key == "dockerfilePath" || key == "nixpacksConfigPath" {
            return bare.contains('/')
                || bare.contains('.')
                || bare
                    .bytes()
                    .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
        }
        if key == "region" {
            return bare
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
        }
        if key == "cronSchedule" {
            // Five-field cron cue (spaces) or @alias.
            return bare.starts_with('@') || bare.split_whitespace().count() >= 5;
        }
        if matches!(key, "nixpacksVersion" | "railpackVersion") {
            return bare
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_'));
        }
        // buildCommand / startCommand / preDeployCommand: quoted graphic.
        return true;
    }
    false
}

