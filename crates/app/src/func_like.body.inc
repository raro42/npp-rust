/// Coq `Theorem app_nil_r :`, `Definition length :=`, `Inductive nat : Type :=`,
/// `Fixpoint map {A} (…)`, `CoInductive stream`, … Optional `Local` / `Global`.
/// Names may include `'`. Prose and bare keywords stay out. `Record` /
/// `Module` / `Class` stay on the generic prefix keys.
fn is_coq_decl(s: &str) -> bool {
    let s = coq_strip_scope(s);
    let Some(rest) = coq_keyword_rest(s) else {
        return false;
    };
    coq_decl_name(rest)
}

fn coq_strip_scope(s: &str) -> &str {
    for key in ["local", "global"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return rest.trim_start();
        }
    }
    s
}

fn coq_keyword_rest(s: &str) -> Option<&str> {
    // Longer keys first so CoInductive / CoFixpoint win over Inductive / Fixpoint.
    for key in [
        "coinductive",
        "proposition",
        "definition",
        "cofixpoint",
        "corollary",
        "inductive",
        "fixpoint",
        "theorem",
        "example",
        "remark",
        "lemma",
        "fact",
    ] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return Some(rest.trim_start());
        }
    }
    None
}

fn coq_decl_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'\'')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    // `:` also covers `:=`. `(*` is a Coq comment.
    let stopped = rest.is_empty()
        || rest.starts_with(':')
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with('.')
        || rest.starts_with("(*")
        || rest.starts_with("//")
        || rest.starts_with("/*")
        || rest.starts_with('#');
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
        return rest.starts_with(':') || rest.starts_with('{') || rest.starts_with('(');
    }
    true
}

/// Lean 4 `theorem add_comm (…) :`, `structure Point where`,
/// `inductive List where`, `axiom em :`, `abbrev Id :=`, `opaque mystery :`,
/// `instance : Add Nat where`, `instance [Monad m] : …`, `example : 1 + 1 =
/// 2 :=`. Optional `noncomputable` / `partial` / `private` / `protected` /
/// `public` / `unsafe`. Names may include `'`. Prose and bare keywords stay
/// out. `def` / `class` stay on the generic prefix keys (also after a Lean
/// mod strip).
fn is_lean_decl(s: &str) -> bool {
    let stripped = lean_strip_mods(s);
    if is_lean_instance(stripped) {
        return true;
    }
    if let Some(rest) = lean_keyword_rest(stripped) {
        // Anonymous `example : …` / `axiom : …`.
        if rest.starts_with(':') || rest.starts_with('(') || rest.starts_with('[') {
            return true;
        }
        return lean_decl_name(rest);
    }
    // `noncomputable def` / `private class` after mod strip.
    if stripped.len() != s.len() {
        let lower = stripped.to_ascii_lowercase();
        return FUNC_LIKE_KEYS.iter().any(|k| lower.starts_with(k));
    }
    false
}

fn lean_strip_mods(s: &str) -> &str {
    let mut s = s;
    for _ in 0..6 {
        let mut stripped = false;
        for key in [
            "noncomputable",
            "protected",
            "private",
            "partial",
            "public",
            "unsafe",
        ] {
            let Some(rest) = sql_word(s, key) else {
                continue;
            };
            if rest.starts_with(char::is_whitespace) {
                s = rest.trim_start();
                stripped = true;
                break;
            }
        }
        if !stripped {
            break;
        }
    }
    s
}

fn lean_keyword_rest(s: &str) -> Option<&str> {
    // Longer keys first so structure / inductive / theorem win over shorter.
    for key in [
        "structure",
        "inductive",
        "theorem",
        "example",
        "abbrev",
        "opaque",
        "axiom",
        "lemma",
    ] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return Some(rest.trim_start());
        }
    }
    None
}

fn is_lean_instance(s: &str) -> bool {
    let Some(rest) = sql_word(s, "instance") else {
        return false;
    };
    if !(rest.starts_with(char::is_whitespace)
        || rest.starts_with(':')
        || rest.starts_with('[')
        || rest.starts_with('('))
    {
        return false;
    }
    let rest = rest.trim_start();
    if rest.starts_with(':') || rest.starts_with('[') || rest.starts_with('(') {
        return true;
    }
    lean_decl_name(rest)
}

fn lean_decl_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'\'')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with(':')
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with('[')
        || rest.starts_with("where")
        || rest.starts_with('.')
        || rest.starts_with("--")
        || rest.starts_with("/-")
        || rest.starts_with("//")
        || rest.starts_with("/*")
        || rest.starts_with('#');
    if !stopped {
        return false;
    }
    // `where` must be a word boundary (`wherever` stays out).
    let where_ok = if let Some(after) = rest.strip_prefix("where") {
        after.is_empty()
            || after.starts_with(char::is_whitespace)
            || after.starts_with(':')
            || after.starts_with('{')
            || after.starts_with('(')
            || after.starts_with('[')
            || after.starts_with('.')
            || after.starts_with("--")
            || after.starts_with("/-")
            || after.starts_with("//")
            || after.starts_with("/*")
            || after.starts_with('#')
    } else {
        false
    };
    if rest.starts_with("where") && !where_ok {
        return false;
    }
    if first.is_ascii_lowercase() {
        return rest.starts_with(':')
            || rest.starts_with('{')
            || rest.starts_with('(')
            || rest.starts_with('[')
            || where_ok;
    }
    true
}

/// Alloy `sig Person {`, `pred connected[p: Person] {`, `fact Acyclic {`,
/// `assert NoOrphans {`. Optional `abstract` / `lone` / `one` / `some` /
/// `var` before `sig`. Anonymous `fact {` / `fact [` count. Lowercase names
/// need `{` / `[` / `(` / `extends` / `,`. Prose and bare keywords stay out.
/// `fun` / `enum` stay on the generic prefix keys.
fn is_alloy_decl(s: &str) -> bool {
    let s = alloy_strip_sig_mods(s);
    if is_alloy_sig(s) {
        return true;
    }
    if is_alloy_named(s, "pred") || is_alloy_named(s, "assert") {
        return true;
    }
    is_alloy_fact(s)
}

fn alloy_strip_sig_mods(s: &str) -> &str {
    let mut s = s;
    for _ in 0..4 {
        let mut stripped = false;
        for key in ["abstract", "lone", "one", "some", "var"] {
            let Some(rest) = sql_word(s, key) else {
                continue;
            };
            if !rest.starts_with(char::is_whitespace) {
                continue;
            }
            let next = rest.trim_start();
            if alloy_is_sig_mod_or_sig(next) {
                s = next;
                stripped = true;
                break;
            }
        }
        if !stripped {
            break;
        }
    }
    s
}

fn alloy_is_sig_mod_or_sig(s: &str) -> bool {
    for key in ["abstract", "lone", "one", "some", "var", "sig"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.is_empty() || rest.starts_with(char::is_whitespace) {
            return true;
        }
    }
    false
}

fn is_alloy_sig(s: &str) -> bool {
    let Some(rest) = sql_word(s, "sig") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    alloy_sig_name(rest.trim_start())
}

fn is_alloy_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    alloy_pred_name(rest.trim_start())
}

fn is_alloy_fact(s: &str) -> bool {
    let Some(rest) = sql_word(s, "fact") else {
        return false;
    };
    if rest.starts_with('{') || rest.starts_with('[') {
        return true;
    }
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.starts_with('{') || rest.starts_with('[') {
        return true;
    }
    alloy_pred_name(rest)
}

fn alloy_sig_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    let extends_ok = if let Some(after) = rest.strip_prefix("extends") {
        after.is_empty()
            || after.starts_with(char::is_whitespace)
            || after.starts_with('{')
            || after.starts_with(',')
            || after.starts_with("//")
            || after.starts_with("/*")
    } else {
        false
    };
    let stopped = rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with(',')
        || extends_ok
        || rest.starts_with("//")
        || rest.starts_with("/*");
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
        return rest.starts_with('{') || rest.starts_with(',') || extends_ok;
    }
    true
}

fn alloy_pred_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('[')
        || rest.starts_with('(')
        || rest.starts_with("//")
        || rest.starts_with("/*");
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
        return rest.starts_with('{') || rest.starts_with('[') || rest.starts_with('(');
    }
    true
}

/// TLA+ `---- MODULE Spec ----`, `MODULE Spec`, `THEOREM TypeOK ==`,
/// `LEMMA Inv ==`, `ASSUME N \\in Nat`. Dashed module banners strip leading
/// `-`. Lowercase names need `==` / `=>` / `\` / a non-identifier start.
/// Prose and bare keywords stay out. Plain `module Name` still matches the
/// generic prefix key.
fn is_tla_decl(s: &str) -> bool {
    if is_tla_module(s) {
        return true;
    }
    for key in ["theorem", "lemma", "assume", "corollary"] {
        if is_tla_named(s, key) {
            return true;
        }
    }
    false
}

fn is_tla_module(s: &str) -> bool {
    let s = s.trim_start_matches(|c: char| c == '-' || c.is_ascii_whitespace());
    let Some(rest) = sql_word(s, "module") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    tla_module_name(rest.trim_start())
}

fn tla_module_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    let after_dashes = rest.trim_start_matches(|c: char| c == '-' || c.is_ascii_whitespace());
    let stopped = after_dashes.is_empty()
        || after_dashes.starts_with("\\*")
        || after_dashes.starts_with("(*")
        || after_dashes.starts_with("//")
        || after_dashes.starts_with("/*")
        || after_dashes.starts_with('#');
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
        return after_dashes.is_empty()
            || rest.starts_with('-')
            || after_dashes.starts_with("\\*")
            || after_dashes.starts_with("(*");
    }
    true
}

fn is_tla_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    tla_theorem_name(rest.trim_start())
}

fn tla_theorem_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    let op_stop = rest
        .chars()
        .next()
        .is_some_and(|c| !c.is_ascii_alphanumeric() && c != '_');
    let stopped = rest.is_empty()
        || rest.starts_with("==")
        || rest.starts_with("=>")
        || rest.starts_with('\\')
        || rest.starts_with("\\*")
        || rest.starts_with("(*")
        || rest.starts_with("//")
        || rest.starts_with("/*")
        || rest.starts_with('#')
        || op_stop;
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
        return rest.starts_with("==")
            || rest.starts_with("=>")
            || rest.starts_with('\\')
            || op_stop;
    }
    true
}

/// Isabelle/HOL `locale Group =`, `abbreviation id where`, `primrec fact where`,
/// `typedef name =`, `axiomatization where`, `interpretation L =`,
/// `theorem app_nil[simp]:`, `definition id where`, `datatype 'a list =`,
/// `inductive even where`. Lowercase names need `where` / `::` / `=` / `[` /
/// `:`. Prose and bare keywords stay out. `fun` / `function` / `record` stay
/// on the generic prefix keys.
fn is_isabelle_decl(s: &str) -> bool {
    if is_isabelle_axiomatization(s) {
        return true;
    }
    if is_isabelle_datatype(s) {
        return true;
    }
    for key in [
        "interpretation",
        "abbreviation",
        "proposition",
        "coinductive",
        "definition",
        "corollary",
        "inductive",
        "primrec",
        "typedef",
        "theorem",
        "locale",
        "lemma",
    ] {
        if is_isabelle_named(s, key) {
            return true;
        }
    }
    false
}

fn is_isabelle_axiomatization(s: &str) -> bool {
    let Some(rest) = sql_word(s, "axiomatization") else {
        return false;
    };
    if rest.starts_with(char::is_whitespace) {
        let rest = rest.trim_start();
        if let Some(after) = rest.strip_prefix("where") {
            return after.is_empty()
                || after.starts_with(char::is_whitespace)
                || after.starts_with(':')
                || after.starts_with('[')
                || after.starts_with("(*")
                || after.starts_with("//")
                || after.starts_with("/*")
                || after.starts_with('#');
        }
        return isabelle_decl_name(rest);
    }
    false
}

fn is_isabelle_datatype(s: &str) -> bool {
    let Some(rest) = sql_word(s, "datatype") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    // `datatype 'a list =` / `datatype ('a, 'b) foo =`
    let rest = isabelle_skip_type_vars(rest);
    isabelle_decl_name(rest)
}

fn isabelle_skip_type_vars(s: &str) -> &str {
    let mut s = s;
    for _ in 0..6 {
        if let Some(rest) = s.strip_prefix('(') {
            // `('a, 'b)` — require a closing `)` then continue.
            let Some(end) = rest.find(')') else {
                return s;
            };
            s = rest[end + 1..].trim_start();
            continue;
        }
        if let Some(rest) = s.strip_prefix('\'') {
            let n = rest
                .bytes()
                .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
                .count();
            if n == 0 {
                return s;
            }
            s = rest[n..].trim_start();
            continue;
        }
        break;
    }
    s
}

fn is_isabelle_named(s: &str, key: &str) -> bool {
    let Some(rest) = sql_word(s, key) else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    isabelle_decl_name(rest.trim_start())
}

fn isabelle_decl_name(s: &str) -> bool {
    let n = s
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'\'')
        .count();
    if n == 0 {
        return false;
    }
    let first = s.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let rest = s[n..].trim_start();
    let where_ok = rest.strip_prefix("where").is_some_and(|after| {
        after.is_empty()
            || after.starts_with(char::is_whitespace)
            || after.starts_with(':')
            || after.starts_with('[')
            || after.starts_with("(*")
            || after.starts_with("//")
            || after.starts_with("/*")
            || after.starts_with('#')
    });
    let stopped = rest.is_empty()
        || rest.starts_with("::")
        || rest.starts_with(':')
        || rest.starts_with('=')
        || rest.starts_with('[')
        || where_ok
        || rest.starts_with("(*")
        || rest.starts_with("//")
        || rest.starts_with("/*")
        || rest.starts_with('#');
    if !stopped {
        return false;
    }
    if first.is_ascii_lowercase() {
        return rest.starts_with("::")
            || rest.starts_with(':')
            || rest.starts_with('=')
            || rest.starts_with('[')
            || where_ok;
    }
    true
}

/// Agda `postulate foo : Nat`, `primitive primFloat`, `variable A : Set`,
/// `infix 4 _≡_`, `infixl 6 _+_`, `infixr 5 _∷_`, and Agda-style
/// `data nat : Set where` / `data _≡_ {A : Set} (x : A) : A → Set where`
/// (names Haskell `data` misses). `module` / `record` / `macro` stay on the
/// generic prefix keys. Prose and bare keywords stay out.
fn is_agda_decl(s: &str) -> bool {
    is_agda_postulate(s)
        || is_agda_primitive(s)
        || is_agda_variable(s)
        || is_agda_infix(s)
        || is_agda_data(s)
}

fn is_agda_postulate(s: &str) -> bool {
    let Some(rest) = sql_word(s, "postulate") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after)) = agda_name(rest) else {
        return false;
    };
    let rest = after.trim_start();
    rest.starts_with(':')
}

fn is_agda_primitive(s: &str) -> bool {
    let Some(rest) = sql_word(s, "primitive") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_, after)) = agda_name(rest) else {
        return false;
    };
    let rest = after.trim_start();
    rest.is_empty() || rest.starts_with(':') || rest.starts_with("--") || rest.starts_with("{-")
}

fn is_agda_variable(s: &str) -> bool {
    let Some(rest) = sql_word(s, "variable") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.starts_with('{') || rest.starts_with('(') {
        return true;
    }
    let Some((_, after)) = agda_name(rest) else {
        return false;
    };
    after.trim_start().starts_with(':')
}

fn is_agda_infix(s: &str) -> bool {
    for key in ["infixl", "infixr", "infix"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let prec = rest.bytes().take_while(|b| b.is_ascii_digit()).count();
        if prec == 0 {
            continue;
        }
        let rest = rest[prec..].trim_start();
        if agda_name(rest).is_some() {
            return true;
        }
    }
    false
}

fn is_agda_data(s: &str) -> bool {
    let Some(rest) = sql_word(s, "data") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    // Do not steal Kotlin/Scala `data class …`.
    if sql_word(rest, "class").is_some_and(|after| {
        after.is_empty()
            || after.starts_with(char::is_whitespace)
            || matches!(after.as_bytes().first(), Some(b'(' | b'[' | b'{'))
    }) {
        return false;
    }
    let Some((_, after)) = agda_name(rest) else {
        return false;
    };
    let mut rest = after.trim_start();
    // Optional telescopes: `{A : Set}` / `(A : Set)`.
    for _ in 0..8 {
        if rest.starts_with('{') || rest.starts_with('(') {
            let Some(after_tel) = after_balanced_paren_or_brace(rest) else {
                return false;
            };
            rest = after_tel.trim_start();
            continue;
        }
        break;
    }
    if let Some(after) = rest.strip_prefix(':') {
        return agda_has_where_word(after);
    }
    // Immediate `where` after name / telescopes (`data Foo where`).
    let Some(after) = rest.strip_prefix("where") else {
        return false;
    };
    after.is_empty()
        || after.starts_with(char::is_whitespace)
        || after.starts_with("--")
        || after.starts_with("{-")
}

fn agda_has_where_word(s: &str) -> bool {
    let bytes = s.as_bytes();
    let mut i = 0usize;
    while i + 5 <= bytes.len() {
        if &bytes[i..i + 5] == b"where" {
            let before_ok = i == 0 || !bytes[i - 1].is_ascii_alphanumeric();
            let after_i = i + 5;
            let after_ok = after_i == bytes.len() || !bytes[after_i].is_ascii_alphanumeric();
            if before_ok && after_ok {
                return true;
            }
        }
        i += 1;
    }
    false
}

fn agda_name(s: &str) -> Option<(&str, &str)> {
    let mut chars = s.char_indices();
    let Some((0, first)) = chars.next() else {
        return None;
    };
    // Mixfix operators: `_≡_`, `_∷_`, `_+_`.
    if first == '_' {
        let mut end = first.len_utf8();
        for (i, c) in chars {
            if c.is_whitespace() || c == ':' || c == '{' || c == '(' || c == '=' {
                break;
            }
            end = i + c.len_utf8();
        }
        if end <= first.len_utf8() {
            return None;
        }
        return Some((&s[..end], &s[end..]));
    }
    // Unicode symbol names: `∞`.
    if !first.is_alphabetic() && first != '_' {
        if first.is_ascii() || first.is_whitespace() {
            return None;
        }
        let mut end = first.len_utf8();
        for (i, c) in chars {
            if c.is_whitespace() || c == ':' || c == '{' || c == '(' || c.is_ascii() {
                break;
            }
            end = i + c.len_utf8();
        }
        return Some((&s[..end], &s[end..]));
    }
    let mut end = first.len_utf8();
    for (i, c) in chars {
        if c.is_alphanumeric() || c == '_' || c == '\'' {
            end = i + c.len_utf8();
        } else {
            break;
        }
    }
    Some((&s[..end], &s[end..]))
}

/// Idris `implementation Show Nat where`, `implementation [myShow] Show Nat
/// where`, `parameters (n : Nat)`, `parameters {n : Nat}`, and optional
/// `public export` / `export` / `private` before those or a generic key
/// (`export implementation Show Nat where`, `public export interface Eq a
/// where`). Lowercase interface names need `where` / `(` / `{` / `[` soon, or
/// a single-letter / uppercase next token (`implementation eq a where`).
/// Prose and bare keywords stay out. `interface` / `data` / `record` /
/// `namespace` stay on the generic prefix keys (also after a vis strip).
fn is_idris_decl(s: &str) -> bool {
    let stripped = idris_strip_vis(s);
    if is_idris_implementation(stripped) || is_idris_parameters(stripped) {
        return true;
    }
    if stripped.len() != s.len() {
        let lower = stripped.to_ascii_lowercase();
        if FUNC_LIKE_KEYS.iter().any(|k| lower.starts_with(k)) {
            return true;
        }
        if is_agda_decl(stripped) || is_haskell_decl(stripped) {
            return true;
        }
    }
    false
}

fn idris_strip_vis(s: &str) -> &str {
    if let Some(after_public) = sql_word(s, "public") {
        if after_public.starts_with(char::is_whitespace) {
            let after_public = after_public.trim_start();
            if let Some(after_export) = sql_word(after_public, "export") {
                if after_export.starts_with(char::is_whitespace) {
                    return after_export.trim_start();
                }
            }
        }
    }
    for key in ["export", "private"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return rest.trim_start();
        }
    }
    s
}

fn is_idris_implementation(s: &str) -> bool {
    let Some(rest) = sql_word(s, "implementation") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    if rest.starts_with('[') {
        let Some(after) = after_balanced_paren_or_brace(rest) else {
            return false;
        };
        rest = after.trim_start();
    }
    if rest.is_empty() || !agda_has_where_word(rest) {
        return false;
    }
    if rest.starts_with('(') || rest.starts_with('{') {
        return true;
    }
    let n = rest
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'\'')
        .count();
    if n == 0 {
        return false;
    }
    let first = rest.as_bytes()[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    if !first.is_ascii_lowercase() {
        return true;
    }
    let after = rest[n..].trim_start();
    if let Some(after_where) = after.strip_prefix("where") {
        return after_where.is_empty()
            || after_where.starts_with(char::is_whitespace)
            || after_where.starts_with("--")
            || after_where.starts_with("{-");
    }
    if after.starts_with('(') || after.starts_with('{') || after.starts_with('[') {
        return true;
    }
    let n2 = after
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'\'')
        .count();
    if n2 == 0 {
        return false;
    }
    let next = after.as_bytes()[0];
    // `implementation eq a where` / `implementation eq Nat where`.
    n2 == 1 || next.is_ascii_uppercase() || next == b'_'
}

fn is_idris_parameters(s: &str) -> bool {
    let Some(rest) = sql_word(s, "parameters") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    rest.starts_with('(') || rest.starts_with('{')
}

/// Mercury / Prolog `:-` directives: `:- module foo.`, `:- module(foo, […]).`,
/// `:- interface.`, `:- implementation.`, `:- type …`, `:- pred …`,
/// `:- func …`, `:- mode …`, `:- inst …`, `:- pragma …`, `:- import_module …`,
/// `:- use_module …`, `:- include_module …`, `:- typeclass …`, `:- instance …`,
/// `:- initialise …` / `:- initialize …`, `:- finalise …` / `:- finalize …`,
/// `:- mutable …`, and Prolog `:- dynamic …` / `:- multifile …` /
/// `:- discontiguous …` / `:- meta_predicate …`.
/// Lowercase names need `.` / `(` / `=` / `-` / `:` / `%` / `--` soon after.
/// Bare `:-`, unknown words after `:-`, and clause bodies (`foo(X) :- …`) stay out.
fn is_mercury_decl(s: &str) -> bool {
    let Some(rest) = s.strip_prefix(":-") else {
        return false;
    };
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace)) {
        return false;
    }
    let rest = rest.trim_start();
    if rest.is_empty() {
        return false;
    }
    // Longer keys first so typeclass / import_module / meta_predicate win.
    for key in [
        "meta_predicate",
        "discontiguous",
        "import_module",
        "include_module",
        "implementation",
        "initialise",
        "initialize",
        "finalise",
        "finalize",
        "use_module",
        "typeclass",
        "interface",
        "multifile",
        "instance",
        "mutable",
        "dynamic",
        "pragma",
        "module",
        "mode",
        "inst",
        "type",
        "pred",
        "func",
    ] {
        let Some(after) = sql_word(rest, key) else {
            continue;
        };
        if key == "interface" || key == "implementation" {
            if mercury_section_end(after) {
                return true;
            }
            continue;
        }
        if mercury_directive_body(after) {
            return true;
        }
    }
    false
}

fn mercury_section_end(after: &str) -> bool {
    let after = after.trim_start();
    after.is_empty() || after.starts_with('.') || after.starts_with('%') || after.starts_with("--")
}

fn mercury_directive_body(after: &str) -> bool {
    if !(after.starts_with(char::is_whitespace) || after.starts_with('(')) {
        return false;
    }
    let after = after.trim_start();
    if after.is_empty() {
        return false;
    }
    if after.starts_with('(') {
        return true;
    }
    let n = after
        .bytes()
        .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
        .count();
    if n == 0 {
        return false;
    }
    let first = after.as_bytes()[0];
    if !(first.is_ascii_alphabetic() || first == b'_') {
        return false;
    }
    let rest = after[n..].trim_start();
    if !first.is_ascii_lowercase() {
        return true;
    }
    // `:- type the list` stays out; `:- type foo.`, `:- pred append(` count.
    rest.is_empty()
        || rest.starts_with('.')
        || rest.starts_with('(')
        || rest.starts_with('=')
        || rest.starts_with('-')
        || rest.starts_with(':')
        || rest.starts_with('%')
        || rest.starts_with("--")
        || rest.starts_with('/')
}

/// Gleam `opaque type User {`, `pub opaque type Id {`, `opaque type Queue(a) {`.
/// `pub` is stripped by the outer prefix loop. Lowercase names need `{` / `(` soon.
/// Prose and bare `opaque` / `opaque type` stay out. Zig `const O = opaque {}`
/// stays on the Zig path. Plain `type` / `pub type` stay on the generic keys.
fn is_gleam_decl(s: &str) -> bool {
    let Some(rest) = sql_word(s, "opaque") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(after_type) = sql_word(rest, "type") else {
        return false;
    };
    if !after_type.starts_with(char::is_whitespace) {
        return false;
    }
    gleam_opaque_type_name(after_type.trim_start())
}

fn gleam_opaque_type_name(s: &str) -> bool {
    let Some((name, after)) = graphql_ident(s) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('{')
        || rest.starts_with('(')
        || rest.starts_with("//")
        || rest.starts_with("/*");
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.starts_with('{') || rest.starts_with('(');
    }
    true
}

/// Elm `port sendMessage : …`, `port module Main exposing (…)`,
/// `effect module WebSocket where { … }`. Module names must be Cap.Word
/// (dots ok). Port names need `:` soon. Prose and bare `port` / `effect`
/// stay out. Plain `module Name` stays on the generic prefix keys.
fn is_elm_decl(s: &str) -> bool {
    if let Some(rest) = sql_word(s, "port") {
        if !rest.starts_with(char::is_whitespace) {
            return false;
        }
        let rest = rest.trim_start();
        if let Some(after_mod) = sql_word(rest, "module") {
            if after_mod.starts_with(char::is_whitespace) {
                return elm_module_name(after_mod.trim_start());
            }
        }
        return elm_port_name(rest);
    }
    let Some(rest) = sql_word(s, "effect") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(after_mod) = sql_word(rest, "module") else {
        return false;
    };
    if !after_mod.starts_with(char::is_whitespace) {
        return false;
    }
    elm_module_name(after_mod.trim_start())
}

fn elm_port_name(s: &str) -> bool {
    let Some((_name, after)) = graphql_ident(s) else {
        return false;
    };
    after.trim_start().starts_with(':')
}

fn elm_module_name(s: &str) -> bool {
    let mut rest = s;
    loop {
        let bytes = rest.as_bytes();
        if bytes.is_empty() || !bytes[0].is_ascii_uppercase() {
            return false;
        }
        let n = rest
            .bytes()
            .take_while(|b| b.is_ascii_alphanumeric() || *b == b'_')
            .count();
        if n == 0 {
            return false;
        }
        rest = &rest[n..];
        if rest.starts_with('.') {
            rest = &rest[1..];
            continue;
        }
        break;
    }
    let tail = rest.trim_start();
    tail.is_empty()
        || tail.starts_with("exposing")
        || tail.starts_with("where")
        || tail.starts_with('{')
        || tail.starts_with("//")
        || tail.starts_with("/*")
}

/// Crystal `annotation JSON::Field`, `lib LibC`, `alias Callback = Int32 -> String`.
/// Path names may use `::`. Shell-style `alias ls='…'` stays out. Prose and bare
/// keywords stay out. `macro` / `fun` / `class` / `module` / `struct` / `enum`
/// stay on the generic prefix keys.
fn is_crystal_decl(s: &str) -> bool {
    is_crystal_annotation(s) || is_crystal_lib(s) || is_crystal_alias(s)
}

fn is_crystal_annotation(s: &str) -> bool {
    let Some(rest) = sql_word(s, "annotation") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    crystal_named_tail(rest.trim_start())
}

fn is_crystal_lib(s: &str) -> bool {
    let Some(rest) = sql_word(s, "lib") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    crystal_named_tail(rest.trim_start())
}

fn is_crystal_alias(s: &str) -> bool {
    let Some(rest) = sql_word(s, "alias") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = crystal_path(rest) else {
        return false;
    };
    let after = after.trim_start();
    let Some(rhs) = after.strip_prefix('=') else {
        return false;
    };
    let rhs = rhs.trim_start();
    if rhs.is_empty() || rhs.starts_with('\'') || rhs.starts_with('"') {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        let b = rhs.as_bytes()[0];
        return b.is_ascii_uppercase() || b == b'(' || b == b'_' || rhs.contains("->");
    }
    true
}

fn crystal_named_tail(s: &str) -> bool {
    let Some((name, after)) = crystal_path(s) else {
        return false;
    };
    let rest = after.trim_start();
    let stopped = rest.is_empty()
        || rest.starts_with('#')
        || rest.starts_with("//")
        || sql_word(rest, "end").is_some_and(|after| {
            after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('#')
        });
    if !stopped {
        return false;
    }
    if name.as_bytes()[0].is_ascii_lowercase() {
        return rest.is_empty()
            || rest.starts_with('#')
            || rest.starts_with("//")
            || sql_word(rest, "end").is_some();
    }
    true
}

/// Crystal path: `Foo`, `JSON::Field`, `A::B::C`.
fn crystal_path(s: &str) -> Option<(&str, &str)> {
    let mut rest = s;
    loop {
        let (_, after) = graphql_ident(rest)?;
        rest = after;
        if rest.starts_with("::") {
            rest = &rest[2..];
            continue;
        }
        let path = &s[..s.len() - rest.len()];
        return Some((path, rest));
    }
}

/// Apache Thrift `exception Boom {`, `senum Color {`,
/// `const i32 MAX = 1`, `const list<i32> XS = [1]`. Builtin / container
/// types only so C `const int x =` stays out. `struct` / `enum` / `union` /
/// `service` / `typedef` / `namespace` stay on the generic prefix keys.
fn is_thrift_decl(s: &str) -> bool {
    is_thrift_exception_or_senum(s) || is_thrift_const(s)
}

fn is_thrift_exception_or_senum(s: &str) -> bool {
    for key in ["exception", "senum"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return flatbuffers_decl_name(rest.trim_start());
        }
    }
    false
}

fn is_thrift_const(s: &str) -> bool {
    let Some(rest) = sql_word(s, "const") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some(after_ty) = thrift_type_prefix(rest.trim_start()) else {
        return false;
    };
    let Some((_name, after_name)) = graphql_ident(after_ty) else {
        return false;
    };
    let Some(rhs) = after_name.trim_start().strip_prefix('=') else {
        return false;
    };
    let rhs = rhs.trim_start();
    !rhs.is_empty()
}

/// Thrift field type then rest: builtins, or `list</set</map<…>`.
fn thrift_type_prefix(s: &str) -> Option<&str> {
    for key in ["list", "set", "map"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with('<') {
            let after = after_balanced_angles(rest)?;
            return Some(after.trim_start());
        }
    }
    for key in [
        "bool", "byte", "i8", "i16", "i32", "i64", "double", "string", "binary", "slist",
    ] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.starts_with(char::is_whitespace) {
            return Some(rest.trim_start());
        }
    }
    None
}

/// Odin `main :: proc()`, `Person :: struct {`, `Color :: enum u8 {`,
/// `Flags :: bit_set[Color]`, `MyInt :: distinct int`. Optional leading
/// `@(export)` / `@(private)` attrs. Value consts (`FOO :: 123`) and path
/// uses (`std::vector`, `JSON::Field`) stay out. `package` stays on the
/// generic prefix key.
fn is_odin_decl(s: &str) -> bool {
    is_odin_colon_decl(strip_odin_attrs(s))
}

fn strip_odin_attrs(s: &str) -> &str {
    let mut rest = s;
    while let Some(after_at) = rest.strip_prefix('@') {
        if !after_at.starts_with('(') {
            break;
        }
        let Some(after) = after_balanced_paren_or_brace(after_at) else {
            break;
        };
        rest = after.trim_start();
    }
    rest
}

fn is_odin_colon_decl(s: &str) -> bool {
    let Some((_name, after)) = graphql_ident(s) else {
        return false;
    };
    let after = after.trim_start();
    let Some(rest) = after.strip_prefix("::") else {
        return false;
    };
    odin_rhs_kind(rest.trim_start())
}

fn odin_rhs_kind(s: &str) -> bool {
    for key in [
        "proc",
        "struct",
        "enum",
        "union",
        "bit_set",
        "bit_field",
        "distinct",
    ] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if rest.is_empty()
            || rest.starts_with(char::is_whitespace)
            || rest.starts_with('(')
            || rest.starts_with('{')
            || rest.starts_with('[')
            || rest.starts_with('#')
            || rest.starts_with("//")
            || rest.starts_with("/*")
        {
            return true;
        }
    }
    false
}

/// Azure Bicep `param name string`, `resource stg 'Type@ver' = {`,
/// `resource stg 'Type@ver' existing = {`, `output id string = …`,
/// `targetScope = '…'`, `metadata description = '…'`. Optional leading
/// `@description(…)` / `@secure()` decorators (via annot strip). Prose and
/// bare keywords stay out. HCL `resource "aws_instance"` stays on the HCL
/// path. `module` / `type` / `func` stay on the generic prefix keys.
fn is_bicep_decl(s: &str) -> bool {
    is_bicep_target_scope(s)
        || is_bicep_param(s)
        || is_bicep_resource(s)
        || is_bicep_output(s)
        || is_bicep_metadata(s)
}

fn is_bicep_target_scope(s: &str) -> bool {
    let Some(rest) = sql_word(s, "targetScope") else {
        return false;
    };
    let rest = rest.trim_start();
    let Some(rhs) = rest.strip_prefix('=') else {
        return false;
    };
    !rhs.trim_start().is_empty()
}

fn is_bicep_param(s: &str) -> bool {
    let Some(rest) = sql_word(s, "param") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    bicep_param_type_ok(name, after.trim_start())
}

fn bicep_param_type_ok(name: &str, after: &str) -> bool {
    if after.is_empty() {
        return false;
    }
    if after.starts_with('\'') || after.starts_with('{') || after.starts_with('(') {
        return true;
    }
    let Some((ty, _)) = graphql_ident(after) else {
        return false;
    };
    matches!(ty, "string" | "int" | "bool" | "object" | "array")
        || bicep_name_not_prose(name)
        || bicep_name_not_prose(ty)
}

fn bicep_name_not_prose(name: &str) -> bool {
    name.bytes()
        .any(|b| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'_')
}

fn is_bicep_resource(s: &str) -> bool {
    let Some(rest) = sql_word(s, "resource") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    let Some(after_type) = bicep_single_quoted(after.trim_start()) else {
        return false;
    };
    let mut after_type = after_type.trim_start();
    if let Some(rest) = sql_word(after_type, "existing") {
        if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('=')) {
            return false;
        }
        after_type = rest.trim_start();
    }
    after_type.starts_with('=')
}

fn bicep_single_quoted(s: &str) -> Option<&str> {
    let body = s.strip_prefix('\'')?;
    let end = body.find('\'')?;
    if end == 0 {
        return None;
    }
    Some(&body[end + 1..])
}

fn is_bicep_output(s: &str) -> bool {
    let Some(rest) = sql_word(s, "output") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    let after = after.trim_start();
    if !bicep_param_type_ok(name, after) {
        return false;
    }
    // Require `=` somewhere after the type (output always assigns).
    after.contains('=')
}

fn is_bicep_metadata(s: &str) -> bool {
    let Some(rest) = sql_word(s, "metadata") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    let after = after.trim_start();
    let Some(rhs) = after.strip_prefix('=') else {
        return false;
    };
    !rhs.trim_start().is_empty()
}

/// WebGPU Shading Language (WGSL) `var<private> counter: i32`,
/// `var tex: texture_2d<f32>`, `const PI: f32 = 3.14`,
/// `override wg: u32 = 64`, `enable f16;`, `requires subgroups;`,
/// `diagnostic(off, derivative_uniformity);`. Optional leading `@group` /
/// `@binding` / `@fragment` via annot strip. JS `var x = 1` / `const x = 1`
/// stay out (need `:` or `<`). Zig `const Name = struct` stays on the Zig
/// path. Thrift typed `const i32 X =` stays on the Thrift path. `fn` /
/// `struct` stay on the generic prefix keys; Crystal `alias` stays on Crystal.
fn is_wgsl_decl(s: &str) -> bool {
    is_wgsl_var(s)
        || is_wgsl_const(s)
        || is_wgsl_override(s)
        || is_wgsl_enable_or_requires(s)
        || is_wgsl_diagnostic(s)
}

fn is_wgsl_var(s: &str) -> bool {
    let Some(rest) = sql_word(s, "var") else {
        return false;
    };
    let rest = if rest.starts_with('<') {
        let Some(after) = after_balanced_angles(rest) else {
            return false;
        };
        after
    } else if rest.starts_with(char::is_whitespace) {
        rest
    } else {
        return false;
    };
    let rest = rest.trim_start();
    let Some((_name, after)) = graphql_ident(rest) else {
        return false;
    };
    wgsl_type_annot(after)
}

fn is_wgsl_const(s: &str) -> bool {
    let Some(rest) = sql_word(s, "const") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    wgsl_type_annot(after)
}

fn is_wgsl_override(s: &str) -> bool {
    let Some(rest) = sql_word(s, "override") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_name, after)) = graphql_ident(rest.trim_start()) else {
        return false;
    };
    let after = after.trim_start();
    wgsl_type_annot(after) || after.starts_with('=')
}

/// WGSL `name: Type` — a single colon, not C++ `name::path`.
fn wgsl_type_annot(after: &str) -> bool {
    let after = after.trim_start();
    after.starts_with(':') && !after.starts_with("::")
}

fn is_wgsl_enable_or_requires(s: &str) -> bool {
    for key in ["enable", "requires"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let Some((_name, after)) = graphql_ident(rest.trim_start()) else {
            return false;
        };
        let after = after.trim_start();
        return after.is_empty()
            || after.starts_with(';')
            || after.starts_with(',')
            || after.starts_with("//")
            || after.starts_with("/*");
    }
    false
}

fn is_wgsl_diagnostic(s: &str) -> bool {
    let Some(rest) = sql_word(s, "diagnostic") else {
        return false;
    };
    let rest = rest.trim_start();
    rest.starts_with('(')
}

/// HLSL `cbuffer PerFrame : register(b0) {`, `tbuffer Skin {`,
/// `Texture2D albedo : register(t0);`, `Texture2D<float4> color;`,
/// `RWStructuredBuffer<Particle> particles : register(u0);`,
/// `SamplerState linearSamp;`, `groupshared float sData[64];`.
/// Optional `<T>` on resource types. Prose and bare keywords stay out.
/// `struct` / `float4 main(` stay on the generic / typed-fn paths. WGSL
/// `var` / `const` stay on the WGSL path.
fn is_hlsl_decl(s: &str) -> bool {
    is_hlsl_cbuffer(s) || is_hlsl_resource(s) || is_hlsl_groupshared(s)
}

fn is_hlsl_cbuffer(s: &str) -> bool {
    for key in ["cbuffer", "tbuffer"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let Some((_name, after)) = graphql_ident(rest.trim_start()) else {
            return false;
        };
        let after = after.trim_start();
        return after.starts_with('{')
            || after.starts_with(':')
            || after.starts_with("//")
            || after.starts_with("/*");
    }
    false
}

const HLSL_RESOURCE_TYPES: &[&str] = &[
    "RasterizerOrderedStructuredBuffer",
    "RasterizerOrderedByteAddressBuffer",
    "RasterizerOrderedTexture2D",
    "RasterizerOrderedBuffer",
    "AppendStructuredBuffer",
    "ConsumeStructuredBuffer",
    "RWByteAddressBuffer",
    "ByteAddressBuffer",
    "RWStructuredBuffer",
    "StructuredBuffer",
    "SamplerComparisonState",
    "ConstantBuffer",
    "TextureCubeArray",
    "Texture2DMSArray",
    "Texture2DArray",
    "Texture1DArray",
    "RWTexture2DArray",
    "RWTexture1DArray",
    "TextureCube",
    "Texture2DMS",
    "Texture3D",
    "Texture2D",
    "Texture1D",
    "RWTexture3D",
    "RWTexture2D",
    "RWTexture1D",
    "SamplerState",
    "RWBuffer",
    "Buffer",
];

fn is_hlsl_resource(s: &str) -> bool {
    for key in HLSL_RESOURCE_TYPES {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        let rest = if rest.starts_with('<') {
            let Some(after) = after_balanced_angles(rest) else {
                return false;
            };
            after
        } else if rest.starts_with(char::is_whitespace) {
            rest
        } else {
            continue;
        };
        let rest = rest.trim_start();
        let Some((_name, after)) = graphql_ident(rest) else {
            return false;
        };
        let after = after.trim_start();
        return after.is_empty()
            || after.starts_with(';')
            || after.starts_with(':')
            || after.starts_with('[')
            || after.starts_with('=')
            || after.starts_with("//")
            || after.starts_with("/*");
    }
    false
}

fn is_hlsl_groupshared(s: &str) -> bool {
    let Some(rest) = sql_word(s, "groupshared") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((ty, after_ty)) = graphql_ident(rest) else {
        return false;
    };
    if !hlsl_type_name_ok(ty) {
        return false;
    }
    let after_ty = if after_ty.starts_with('<') {
        let Some(after) = after_balanced_angles(after_ty) else {
            return false;
        };
        after
    } else {
        after_ty
    };
    if !after_ty.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((_name, after)) = graphql_ident(after_ty.trim_start()) else {
        return false;
    };
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with(';')
        || after.starts_with('[')
        || after.starts_with('=')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// HLSL scalar/vector builtins, or a Capitalized / `_`-prefixed user type.
/// Rejects prose like `groupshared the memory`.
fn hlsl_type_name_ok(ty: &str) -> bool {
    if ty.is_empty() {
        return false;
    }
    let b0 = ty.as_bytes()[0];
    if b0 == b'_' || b0.is_ascii_uppercase() {
        return true;
    }
    matches!(
        ty.to_ascii_lowercase().as_str(),
        "bool"
            | "bool1"
            | "bool2"
            | "bool3"
            | "bool4"
            | "int"
            | "int1"
            | "int2"
            | "int3"
            | "int4"
            | "uint"
            | "uint1"
            | "uint2"
            | "uint3"
            | "uint4"
            | "dword"
            | "half"
            | "half1"
            | "half2"
            | "half3"
            | "half4"
            | "float"
            | "float1"
            | "float2"
            | "float3"
            | "float4"
            | "double"
            | "double1"
            | "double2"
            | "double3"
            | "double4"
            | "min16float"
            | "min10float"
            | "min16int"
            | "min12int"
            | "min16uint"
            | "float1x1"
            | "float2x2"
            | "float3x3"
            | "float4x4"
            | "float3x4"
            | "float4x3"
            | "matrix"
    )
}

/// GLSL `layout(location = 0) in vec3 position;`, `uniform mat4 mvp;`,
/// `out vec4 fragColor;`, `attribute vec3 pos;`, `varying vec2 uv;`,
/// `shared float s[64];`, `buffer Particles {`, `precision mediump float;`.
/// Optional interpolation / memory / precision qualifiers before storage.
/// `layout(...) in;` (compute) counts. Prose and bare keywords stay out.
/// `struct` / `void main(` stay on the generic / typed-fn paths. HLSL
/// `cbuffer` / WGSL `var` stay on their paths.
fn is_glsl_decl(s: &str) -> bool {
    is_glsl_layout(s) || is_glsl_precision(s) || is_glsl_storage(s)
}

fn is_glsl_layout(s: &str) -> bool {
    let Some(rest) = sql_word(s, "layout") else {
        return false;
    };
    let rest = rest.trim_start();
    if !rest.starts_with('(') {
        return false;
    }
    let Some(after) = after_balanced_paren(rest, 0) else {
        return false;
    };
    let after = strip_glsl_qualifiers(after.trim_start());
    if after.is_empty() {
        return false;
    }
    // `layout(local_size_x = 8) in;` / `layout(...) out;`
    for key in ["inout", "in", "out"] {
        let Some(tail) = sql_word(after, key) else {
            continue;
        };
        let tail = tail.trim_start();
        if tail.starts_with(';') || tail.starts_with("//") || tail.starts_with("/*") {
            return true;
        }
    }
    is_glsl_storage(after)
}

fn is_glsl_precision(s: &str) -> bool {
    let Some(rest) = sql_word(s, "precision") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((qual, after_qual)) = graphql_ident(rest) else {
        return false;
    };
    if !matches!(
        qual.to_ascii_lowercase().as_str(),
        "highp" | "mediump" | "lowp"
    ) {
        return false;
    }
    if !after_qual.starts_with(char::is_whitespace) {
        return false;
    }
    let Some((ty, after_ty)) = graphql_ident(after_qual.trim_start()) else {
        return false;
    };
    if !matches!(ty.to_ascii_lowercase().as_str(), "float" | "int") {
        return false;
    }
    let after_ty = after_ty.trim_start();
    after_ty.is_empty()
        || after_ty.starts_with(';')
        || after_ty.starts_with("//")
        || after_ty.starts_with("/*")
}

fn is_glsl_storage(s: &str) -> bool {
    let s = strip_glsl_qualifiers(s);
    for key in [
        "uniform",
        "attribute",
        "varying",
        "shared",
        "buffer",
        "inout",
        "in",
        "out",
    ] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        // `uniform Matrices {` / `buffer Particles {`
        if matches!(key, "uniform" | "buffer") {
            if let Some((name, after)) = graphql_ident(rest) {
                let after = after.trim_start();
                if after.starts_with('{') && glsl_block_name_ok(name) {
                    return true;
                }
            }
        }
        let Some((ty, after_ty)) = graphql_ident(rest) else {
            return false;
        };
        if !glsl_type_name_ok(ty) {
            return false;
        }
        let after_ty = if after_ty.starts_with('<') {
            let Some(after) = after_balanced_angles(after_ty) else {
                return false;
            };
            after
        } else {
            after_ty
        };
        // `uniform sampler2D;` alone is incomplete.
        if !after_ty.starts_with(char::is_whitespace) {
            // `in vec3;` incomplete — need a name (or array on type for buffer).
            if after_ty.starts_with('[') {
                // rare: `buffer float data[]` needs a name before `[` usually;
                // `shared float[64]` is invalid GLSL anyway.
                return false;
            }
            return false;
        }
        let Some((_name, after)) = graphql_ident(after_ty.trim_start()) else {
            return false;
        };
        let after = after.trim_start();
        return after.is_empty()
            || after.starts_with(';')
            || after.starts_with('[')
            || after.starts_with('=')
            || after.starts_with(':')
            || after.starts_with("//")
            || after.starts_with("/*");
    }
    false
}

/// Strip common GLSL interpolation / memory / precision qualifiers.
fn strip_glsl_qualifiers(mut s: &str) -> &str {
    for _ in 0..8 {
        let rest = s.trim_start();
        let mut stripped = false;
        for q in [
            "noperspective",
            "centroid",
            "sample",
            "flat",
            "smooth",
            "patch",
            "precise",
            "invariant",
            "coherent",
            "volatile",
            "restrict",
            "readonly",
            "writeonly",
            "highp",
            "mediump",
            "lowp",
        ] {
            let Some(after) = sql_word(rest, q) else {
                continue;
            };
            if after.is_empty() || after.starts_with(char::is_whitespace) {
                s = after.trim_start();
                stripped = true;
                break;
            }
        }
        if !stripped {
            return rest;
        }
    }
    s.trim_start()
}

fn glsl_block_name_ok(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    let b0 = name.as_bytes()[0];
    b0 == b'_' || b0.is_ascii_alphabetic()
}

