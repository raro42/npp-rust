/// deny / clippy / rustfmt / ruff / uv / bunfig / yarn / npmrc / pip /
/// Cargo.toml / pyproject `[tool.pdm]` stay out.
fn is_pdm_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
