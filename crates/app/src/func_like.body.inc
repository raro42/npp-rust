        }
        return bare.bytes().all(|b| b.is_ascii_digit()) && bare.len() <= 8;
    }
    if key == "backend" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "virtualenv" | "venv" | "conda");
    }
    if key == "cache_method" {
