    let bytes = t.as_bytes();
    if bytes[0] != b'L' && bytes[0] != b'l' {
        return false;
    }
    let digits = &bytes[1..];
    !digits.is_empty() && digits.iter().all(|b| b.is_ascii_digit())
}

fn sqlfluff_templater_ok_token(name: &str) -> bool {
    matches!(name, "raw" | "jinja" | "python" | "placeholder" | "dbt")
