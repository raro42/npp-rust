/// nginx config block openers: `events {`, `http {`, `server {`, `mail {`,
/// `stream {`, `types {`, `upstream backend {`, `location / {` /
/// `location = /uri {` / `location ~ pattern {` / `location ~* … {` /
/// `location ^~ /prefix {` / `location @name {`, `map $a $b {`,
/// `geo $out {` / `geo $addr $out {`, `split_clients … $out {`,
/// `limit_except GET HEAD {`. Optional `#` comment after `{`. Exact
/// lowercase keywords. Directives without `{` (`listen 80;`,
/// `server_name example.com;`), wrong case (`Server {`), prose
/// (`location the team {`), and HCL / other brace forms stay out.
fn is_nginx_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    nginx_bare_block(s)
        || nginx_upstream(s)
        || nginx_location(s)
        || nginx_map(s)
        || nginx_geo(s)
        || nginx_split_clients(s)
        || nginx_limit_except(s)
}

fn nginx_brace_tail(rest: &str) -> bool {
    let rest = rest.trim_start();
    let Some(after) = rest.strip_prefix('{') else {
        return false;
    };
    let after = after.trim_start();
    after.is_empty() || after.starts_with('#')
}

fn nginx_bare_block(s: &str) -> bool {
    for key in ["events", "http", "server", "mail", "stream", "types"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Not `http2` / `server_name` / `streaming` / `mailman`.
        if rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{') {
            return nginx_brace_tail(rest);
        }
    }
    false
}

fn nginx_ident(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() {
        return None;
    }
    let bytes = s.as_bytes();
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return None;
    }
    let n = bytes
        .iter()
        .take_while(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.'))
        .count();
    if n == 0 {
        return None;
    }
    Some((&s[..n], &s[n..]))
}

fn nginx_upstream(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("upstream") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((name, after)) = nginx_ident(rest) else {
        return false;
    };
    if matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our") {
        return false;
    }
    nginx_brace_tail(after)
}

fn nginx_location_uri(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('{') || s.starts_with('#') {
        return None;
    }
    if let Some(q) = s.as_bytes().first().copied() {
        if q == b'"' || q == b'\'' {
            let inner = &s[1..];
            let end = inner.find(q as char)?;
            if end == 0 {
                return None;
            }
            return Some((&inner[..end], &inner[end + 1..]));
        }
    }
    let end = s
        .find(|c: char| c.is_ascii_whitespace() || c == '{' || c == '#')
        .unwrap_or(s.len());
    if end == 0 {
        return None;
    }
    let uri = &s[..end];
    if matches!(uri, "the" | "a" | "an" | "this" | "that" | "my" | "our") {
        return None;
    }
    // Path, named location, or regex-looking pattern.
    if !(uri.starts_with('/')
        || uri.starts_with('@')
        || uri.starts_with('^')
        || uri.starts_with('.')
        || uri.starts_with('\\')
        || uri.starts_with('(')
        || uri.contains('*')
        || uri.contains('?')
        || uri.contains('[')
        || uri.contains('$')
        || uri.contains('+')
        || uri.contains('|'))
    {
        return None;
    }
    Some((uri, &s[end..]))
}

fn nginx_location(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("location") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    // Optional modifier: `=`, `~`, `~*`, `^~`.
    if let Some(r) = rest.strip_prefix("^~") {
        if r.starts_with(char::is_whitespace) {
            rest = r.trim_start();
        } else {
            return false;
        }
    } else if let Some(r) = rest.strip_prefix("~*") {
        if r.starts_with(char::is_whitespace) {
            rest = r.trim_start();
        } else {
            return false;
        }
    } else if let Some(r) = rest.strip_prefix('~') {
        if r.starts_with(char::is_whitespace) {
            rest = r.trim_start();
        } else {
            return false;
        }
    } else if let Some(r) = rest.strip_prefix('=') {
        if r.starts_with(char::is_whitespace) {
            rest = r.trim_start();
        } else {
            return false;
        }
    }
    let Some((_uri, after)) = nginx_location_uri(rest) else {
        return false;
    };
    nginx_brace_tail(after)
}

fn nginx_dollar_or_quoted(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() {
        return None;
    }
    if let Some(q) = s.as_bytes().first().copied() {
        if q == b'"' || q == b'\'' {
            let inner = &s[1..];
            let end = inner.find(q as char)?;
            if end == 0 {
                return None;
            }
            return Some((&inner[..end], &inner[end + 1..]));
        }
    }
    let rest = s.strip_prefix('$')?;
    let bytes = rest.as_bytes();
    if bytes.is_empty() || !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return None;
    }
    let n = bytes
        .iter()
        .take_while(|b| b.is_ascii_alphanumeric() || **b == b'_')
        .count();
    // Include leading `$` in the token span for callers that ignore it.
    Some((&s[..n + 1], &rest[n..]))
}

fn nginx_map(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("map") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_src, after)) = nginx_dollar_or_quoted(rest) else {
        return false;
    };
    let after = after.trim_start();
    let Some((_dst, after)) = nginx_dollar_or_quoted(after) else {
        return false;
    };
    nginx_brace_tail(after)
}

fn nginx_geo(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("geo") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_first, after)) = nginx_dollar_or_quoted(rest) else {
        return false;
    };
    let after_t = after.trim_start();
    // `geo $out {` or `geo $addr $out {`.
    if after_t.starts_with('{') {
        return nginx_brace_tail(after);
    }
    let Some((_second, after2)) = nginx_dollar_or_quoted(after_t) else {
        return false;
    };
    nginx_brace_tail(after2)
}

fn nginx_split_clients(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("split_clients") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_src, after)) = nginx_dollar_or_quoted(rest) else {
        return false;
    };
    let after = after.trim_start();
    let Some((_dst, after)) = nginx_dollar_or_quoted(after) else {
        return false;
    };
    nginx_brace_tail(after)
}

fn nginx_limit_except(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("limit_except") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let mut rest = rest.trim_start();
    let mut saw = false;
    while let Some((meth, after)) = nginx_ident(rest) {
        // HTTP methods in nginx `limit_except` are uppercase.
        if !(meth.chars().all(|c| c.is_ascii_uppercase())
            && matches!(
                meth,
                "GET"
                    | "HEAD"
                    | "POST"
                    | "PUT"
                    | "DELETE"
                    | "MKCOL"
                    | "COPY"
                    | "MOVE"
                    | "OPTIONS"
                    | "PROPFIND"
                    | "PROPPATCH"
                    | "LOCK"
                    | "UNLOCK"
                    | "PATCH"
                    | "TRACE"
                    | "CONNECT"
            ))
        {
            return false;
        }
        saw = true;
        rest = after.trim_start();
        if rest.starts_with('{') {
            break;
        }
    }
    saw && nginx_brace_tail(rest)
}

/// Apache httpd section containers: `<VirtualHost *:80>`,
/// `<Directory /var/www/html>`, `<DirectoryMatch "^/var/www">`,
/// `<Files "*.php">`, `<FilesMatch "\.php$">`, `<Location /api>`,
/// `<LocationMatch "^/api">`, `<IfModule mod_ssl.c>`, `<IfDefine SSL>`,
/// `<If "%{REQUEST_URI} =~ m#^/admin#">`, `<ElseIf "…">`, `<Else>`,
/// `<Proxy *>`, `<ProxyMatch "^http://">`, `<RequireAll>`, `<RequireAny>`,
/// `<RequireNone>`, `<Limit GET POST>`, `<LimitExcept GET>`,
/// `<AuthnProviderAlias ldap myldap>`, `<Macro VHost $domain>`.
/// Optional `#` comment after `>`. Tag name case-insensitive. Closing
/// tags (`</VirtualHost>`), HTML (`<div>`), Ant / MSBuild (`<target name>`),
/// unknown tags, bare containers that need args (`<Directory>`), and prose
/// (`<Directory the team>`) stay out.
fn is_apache_httpd_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('<') else {
        return false;
    };
    let rest = rest.trim_start();
    if rest.starts_with('/') || rest.starts_with('!') || rest.starts_with('?') {
        return false;
    }
    let bytes = rest.as_bytes();
    if bytes.is_empty() || !bytes[0].is_ascii_alphabetic() {
        return false;
    }
    let n = bytes
        .iter()
        .take_while(|b| b.is_ascii_alphanumeric())
        .count();
    if n == 0 {
        return false;
    }
    let tag = &rest[..n];
    let after = &rest[n..];
    let (need_args, known) = match tag.to_ascii_lowercase().as_str() {
        "else" | "requireall" | "requireany" | "requirenone" => (false, true),
        "virtualhost" | "directory" | "directorymatch" | "files" | "filesmatch" | "location"
        | "locationmatch" | "ifmodule" | "ifdefine" | "if" | "elseif" | "proxy" | "proxymatch"
        | "limit" | "limitexcept" | "authnprovideralias" | "macro" => (true, true),
        _ => (false, false),
    };
    if !known {
        return false;
    }
    // Tag must end (whitespace, `>`, or `/` for empty-element — we reject `/`).
    if !(after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('>')) {
        return false;
    }
    apache_httpd_tail(after, need_args)
}

fn apache_httpd_tail(s: &str, need_args: bool) -> bool {
    let s = s.trim_start();
    let Some(gt) = s.find('>') else {
        return false;
    };
    let before = s[..gt].trim();
    // No nested `<` in args; no self-close `/` at end of empty-element form
    // for section openers (Apache sections are not `<Foo />`).
    if before.contains('<') || before.ends_with('/') {
        return false;
    }
    let after = s[gt + 1..].trim_start();
    if !(after.is_empty() || after.starts_with('#')) {
        return false;
    }
    if !need_args {
        return before.is_empty();
    }
    if before.is_empty() {
        return false;
    }
    // First token must not be bare prose stop-words.
    let first = before.split_whitespace().next().unwrap_or("");
    let unquoted = first.trim_matches(|c| c == '"' || c == '\'');
    let lower = unquoted.to_ascii_lowercase();
    !matches!(
        lower.as_str(),
        "the" | "a" | "an" | "this" | "that" | "my" | "our"
    )
}

/// HAProxy section headers: `global`, `defaults` / `defaults name`,
/// `traces`, `frontend name`, `backend name`, `listen name`,
/// `resolvers name`, `cache name`, `peers name`, `mailers name`,
/// `userlist name`, `http-errors name`, `ring name`, `program name`,
/// `fcgi-app name`. Optional `#` comment. Exact lowercase keywords.
/// nginx `server {` / `listen 80;`, wrong case (`Frontend www`),
/// prose (`frontend the team`), and in-section directives
/// (`bind *:80`, `server s1 127.0.0.1:80`, `default_backend app`) stay out.
fn is_haproxy_decl(s: &str) -> bool {
    let s = s.trim_start();
    haproxy_optional_name(s) || haproxy_named(s)
}

fn haproxy_tail(rest: &str) -> bool {
    let rest = rest.trim_start();
    rest.is_empty() || rest.starts_with('#')
}

fn haproxy_stop_word(name: &str) -> bool {
    matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our")
}

/// Bare or optionally named: `global`, `traces`, `defaults` / `defaults http`.
fn haproxy_optional_name(s: &str) -> bool {
    for key in ["global", "traces", "defaults"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Not `globalized` / `default_backend` / `tracespace`.
        if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('#')) {
            continue;
        }
        if key == "global" || key == "traces" {
            return haproxy_tail(rest);
        }
        // `defaults` may take an optional section name.
        let rest = rest.trim_start();
        if rest.is_empty() || rest.starts_with('#') {
            return true;
        }
        let Some((name, after)) = nginx_ident(rest) else {
            return false;
        };
        if haproxy_stop_word(name) {
            return false;
        }
        return haproxy_tail(after);
    }
    false
}

fn haproxy_named(s: &str) -> bool {
    // Longer multi-word keys first so `http-errors` / `fcgi-app` win.
    for key in [
        "http-errors",
        "fcgi-app",
        "frontend",
        "backend",
        "resolvers",
        "userlist",
        "mailers",
        "listen",
        "cache",
        "peers",
        "ring",
        "program",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let Some((name, after)) = nginx_ident(rest) else {
            return false;
        };
        if haproxy_stop_word(name) {
            return false;
        }
        return haproxy_tail(after);
    }
    false
}

/// Fluent Bit classic config sections: `[SERVICE]`, `[INPUT]`, `[FILTER]`,
/// `[OUTPUT]`, `[PARSER]`, `[MULTILINE_PARSER]`, `[CUSTOM]`,
/// `[PROCESSOR]`, `[CHECK]`. Exact uppercase as in stock `.conf`.
/// Optional trailing `#` / `;` comment. Key lines (`Name cpu`,
/// `Flush 1`, `Match *`), wrong case (`[input]`, `[Service]`), PHP /
/// MySQL / WireGuard / AWS / git / systemd / Desktop Entry / tox /
/// Cargo / EditorConfig tables, incomplete brackets, and prose stay out.
fn is_fluent_bit_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if array || header.is_empty() || !tox_ini_tail_ok(after) {
        return false;
    }
    fluent_bit_header_ok(header)
}

fn fluent_bit_header_ok(header: &str) -> bool {
    matches!(
        header,
        "SERVICE"
            | "INPUT"
            | "FILTER"
            | "OUTPUT"
            | "PARSER"
            | "MULTILINE_PARSER"
            | "CUSTOM"
            | "PROCESSOR"
            | "CHECK"
    )
}

/// Vector.toml component tables: `[sources.in]`, `[transforms.parse]`,
/// `[sinks.out]`, `[enrichment_tables.geo]`, `[tests.case]`,
/// `[secrets.vault]`, bare `[api]`. Exact lowercase kind prefixes as in
/// stock Vector configs. Optional trailing `#` comment. Key lines
/// (`type = "stdin"`, `inputs = ["in"]`), wrong case (`[Sources.in]`,
/// `[API]`), Fluent Bit / PHP / MySQL / WireGuard / Cargo / tox tables,
/// incomplete brackets, bare `[sources]` / `[transforms]` without a
/// name, and prose stay out.
fn is_vector_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if array || header.is_empty() || !cargo_toml_tail_ok(after) {
        return false;
    }
    vector_toml_header_ok(header)
}

fn vector_toml_header_ok(header: &str) -> bool {
    if header == "api" {
        return true;
    }
    for kind in [
        "enrichment_tables",
        "transforms",
        "sources",
        "secrets",
        "sinks",
        "tests",
    ] {
        let Some(rest) = header.strip_prefix(kind) else {
            continue;
        };
        let Some(name) = rest.strip_prefix('.') else {
            return false;
        };
        return vector_toml_name_ok(name);
    }
    false
}

fn vector_toml_name_ok(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    if matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our") {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.'))
}

/// Telegraf.conf plugin / agent tables: `[[inputs.cpu]]`,
/// `[[outputs.influxdb]]`, `[[processors.regex]]`,
/// `[[aggregators.basicstats]]`, `[[secretstores.jose]]`, bare
/// `[agent]` / `[global_tags]`. Exact lowercase kinds. Optional `#`
/// comment. Key lines (`interval = "10s"`, `percpu = true`), wrong case
/// (`[[Inputs.cpu]]`, `[Agent]`), Vector single-bracket tables, Fluent
/// Bit / Cargo `[[bin]]` / Pipfile `[[source]]`, incomplete brackets,
/// bare `[[inputs]]` without a plugin name, and prose stay out.
fn is_telegraf_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some((header, array, after)) = cargo_toml_header(s) else {
        return false;
    };
    if header.is_empty() || !cargo_toml_tail_ok(after) {
        return false;
    }
    if array {
        telegraf_plugin_header_ok(header)
    } else {
        matches!(header, "agent" | "global_tags")
    }
}

fn telegraf_plugin_header_ok(header: &str) -> bool {
    for kind in [
        "secretstores",
        "aggregators",
        "processors",
        "outputs",
        "inputs",
    ] {
        let Some(rest) = header.strip_prefix(kind) else {
            continue;
        };
        let Some(name) = rest.strip_prefix('.') else {
            return false;
        };
        return telegraf_plugin_name_ok(name);
    }
    false
}

fn telegraf_plugin_name_ok(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    if matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our") {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.'))
}

