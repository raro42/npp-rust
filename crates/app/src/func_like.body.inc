        return false;
    }
    // Include `,` so globs like `**/petstore.{json,yaml}` work.
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'-'
                    | b'_'
                    | b'/'
                    | b'\\'
                    | b':'
                    | b'?'
                    | b'='
                    | b'&'
                    | b'%'
                    | b'#'
                    | b'{'
                    | b'}'
                    | b'@'
                    | b'+'
                    | b' '
                    | b'~'
                    | b'*'
                    | b'('
                    | b')'
                    | b'['
                    | b']'
