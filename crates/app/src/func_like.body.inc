}

fn stork_json_value_and_tail_ok(key: &str, after_colon: &str) -> bool {
    let bytes = after_colon.as_bytes();
    let Some(first) = bytes.first().copied() else {
        return false;
    };
    match first {
        b'{' => {
            if !matches!(
                key,
                "srt_config"
                    | "resultNoun"
                    | "onQueryUpdate"
                    | "onResultSelected"
                    | "onResultsHidden"
                    | "onInputCleared"
                    | "transformResultUrl"
                    | "strings"
                    | "generateMessage"
            ) {
                return false;
            }
            package_json_tail_ok(&after_colon[1..])
        }
        b'"' => stork_json_string_or_enum_and_tail_ok(key, after_colon),
        b't' | b'f' => stork_json_bool_and_tail_ok(key, after_colon),
        b'0'..=b'9' => stork_json_uint_and_tail_ok(key, after_colon),
        _ => false,
    }
}

fn stork_json_string_or_enum_and_tail_ok(key: &str, after_colon: &str) -> bool {
    let rest = &after_colon[1..];
    let Some(end) = rest.find('"') else {
        return false;
    };
    let value = &rest[..end];
    if value.is_empty() || value.contains('\n') {
        return false;
    }
    match key {
        "exclude_html_selector"
        | "exclude_html_selector_override"
        | "html_selector_override"
        | "stemming_override"
        | "timestamp_template_string"
        | "queryTooShort"
        | "attribution"
        | "closeButtonSvg" => {}
        "frontmatter_handling" | "frontmatter_handling_override" => {
            if !matches!(value, "Ignore" | "Omit" | "Parse") {
                return false;
            }
        }
        "title_boost" => {
            if !matches!(value, "Minimal" | "Moderate" | "Large" | "Ridiculous") {
                return false;
            }
        }
        "filetype" => {
            if !matches!(value, "PlainText" | "SRTSubtitle" | "HTML" | "Markdown") {
                return false;
            }
        }
        "timestamp_format" => {
            if !matches!(value, "NumberOfSeconds" | "MinutesAndSeconds") {
                return false;
            }
        }
        _ => return false,
    }
    package_json_tail_ok(&rest[end + 1..])
}

fn stork_json_bool_and_tail_ok(key: &str, after_colon: &str) -> bool {
    if !matches!(
        key,
        "save_nearest_node_json"
            | "break_on_file_error"
            | "timestamp_linking"
            | "save_nearest_html_id"
            | "showProgress"
            | "printIndexInfo"
            | "showScores"
            | "showCloseButton"
            | "forceOverwrite"
            | "forceRefreshIndex"
    ) {
        return false;
    }
    let rest = if let Some(rest) = after_colon.strip_prefix("true") {
        rest
    } else if let Some(rest) = after_colon.strip_prefix("false") {
        rest
    } else {
        return false;
    };
    package_json_tail_ok(rest)
}

fn stork_json_uint_and_tail_ok(key: &str, after_colon: &str) -> bool {
    if !matches!(
        key,
        "excerpts_per_result"
            | "displayed_results_count"
            | "excerpt_buffer"
            | "minimum_indexed_substring_length"
            | "minimum_index_ideographic_substring_length"
            | "minimumQueryLength"
            | "numberOfExcerpts"
    ) {
        return false;
    }
    let bytes = after_colon.as_bytes();
    let mut i = 0usize;
    if i >= bytes.len() || !bytes[i].is_ascii_digit() {
        return false;
    }
    if bytes[i] == b'0' {
        i += 1;
        if i < bytes.len() && bytes[i].is_ascii_digit() {
            return false;
        }
    } else {
        while i < bytes.len() && bytes[i].is_ascii_digit() {
            i += 1;
        }
    }
    package_json_tail_ok(&after_colon[i..])
}

