fn lerna_json_version_ok(value: &str) -> bool {
    if value == "independent" {
        return true;
    }
    // Simple semver: MAJOR.MINOR.PATCH with optional -prerelease / +build.
    let bytes = value.as_bytes();
    let mut i = 0;
    let mut parts = 0;
    while parts < 3 {
        let start = i;
        while i < bytes.len() && bytes[i].is_ascii_digit() {
            i += 1;
        }
        if i == start || i - start > 6 {
            return false;
        }
        if parts == 0 && i - start > 1 && bytes[start] == b'0' {
            return false;
        }
        parts += 1;
        if parts < 3 {
            if i >= bytes.len() || bytes[i] != b'.' {
                return false;
            }
            i += 1;
        }
    }
    if i == bytes.len() {
        return true;
    }
    if bytes[i] == b'-' || bytes[i] == b'+' {
        i += 1;
        if i == bytes.len() {
            return false;
        }
        return value[i..]
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || b == b'.' || b == b'-' || b == b'_');
    }
    false
}

