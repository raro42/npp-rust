    )
}

fn pylint_ini_int_ok(value: &str) -> bool {
    if value.is_empty() {
        return false;
    }
    let bytes = value.as_bytes();
    let start = if bytes[0] == b'-' { 1 } else { 0 };
    if start >= bytes.len() {
        return false;
    }
    bytes[start..].iter().all(|b| b.is_ascii_digit())
}

fn pylint_ini_float_ok(value: &str) -> bool {
    if value.is_empty() {
        return false;
    }
    let mut seen_dot = false;
    let mut digits = 0usize;
    let bytes = value.as_bytes();
    let start = if bytes[0] == b'-' { 1 } else { 0 };
    if start >= bytes.len() {
        return false;
    }
    for b in &bytes[start..] {
        if *b == b'.' {
            if seen_dot {
                return false;
            }
            seen_dot = true;
            continue;
        }
        if !b.is_ascii_digit() {
            return false;
        }
        digits += 1;
    }
    digits > 0
}

fn pylint_ini_value_ok(key: &str, value: &str) -> bool {
    // Empty ok for a few "unset" options (line ending, spelling-dict).
    if matches!(key, "expected-line-ending-format" | "spelling-dict") && value.is_empty() {
        return true;
    }
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if matches!(
        key,
        "persistent"
            | "suggestion-mode"
            | "unsafe-load-any-extension"
            | "reports"
            | "score"
            | "include-naming-hint"
            | "single-line-if-stmt"
            | "single-line-class-stmt"
            | "check-protected-access-in-special-methods"
            | "ignore-none"
            | "ignore-on-opaque-inference"
            | "ignore-mixin-members"
            | "ignore-imports"
            | "ignore-comments"
            | "ignore-docstrings"
            | "ignore-signatures"
            | "init-import"
            | "allow-wildcard-with-all"
            | "allow-reexport-from-package"
            | "allow-global-unused-variables"
            | "check-quote-consistency"
            | "check-str-concat-over-line-jumps"
            | "analyse-fallback-blocks"
            | "clear-cache-post-run"
            | "recursive"
            | "missing-member-hint"
    ) {
        return pylint_ini_bool_ok(value);
    }
    if matches!(
        key,
        "fail-under"
            | "jobs"
            | "max-line-length"
            | "max-module-lines"
            | "indent-after-paren"
            | "max-args"
            | "max-locals"
            | "max-returns"
            | "max-branches"
            | "max-statements"
            | "max-parents"
            | "max-attributes"
            | "min-public-methods"
            | "max-public-methods"
            | "max-bool-expr"
            | "max-nested-blocks"
            | "docstring-min-length"
            | "min-similarity-lines"
            | "max-spelling-suggestions"
            | "missing-member-hint-distance"
            | "missing-member-max-choices"
            | "limit-inference-results"
            | "max-string-length"
            | "timeout"
    ) {
        if key == "fail-under" || key == "timeout" {
            return pylint_ini_float_ok(value);
        }
        return pylint_ini_int_ok(value);
    }
    if key == "output-format" {
        return matches!(
            value,
            "text" | "colorized" | "json" | "parseable" | "msvs" | "github"
        );
    }
    if key == "logging-format-style" {
        return matches!(value, "old" | "new");
    }
    if key == "expected-line-ending-format" {
        return matches!(value, "LF" | "CR" | "CRLF" | "lf" | "cr" | "crlf");
    }
    if matches!(
        key,
        "argument-naming-style"
            | "attr-naming-style"
            | "class-naming-style"
            | "class-attribute-naming-style"
            | "class-const-naming-style"
            | "const-naming-style"
            | "function-naming-style"
            | "inlinevar-naming-style"
            | "method-naming-style"
            | "module-naming-style"
            | "variable-naming-style"
    ) {
        return pylint_ini_naming_style_ok(value);
    }
    if key == "confidence" {
        return value.split(',').all(|part| {
            let p = part.trim();
            !p.is_empty()
                && matches!(
                    p,
                    "HIGH" | "CONTROL_FLOW" | "INFERENCE" | "INFERENCE_FAILURE" | "UNDEFINED"
                )
        });
    }
    if key == "py-version" {
        // 3 / 3.11 / 3.11.0
        let mut parts = 0usize;
        for part in value.split('.') {
            if part.is_empty() || !part.bytes().all(|b| b.is_ascii_digit()) {
                return false;
            }
            parts += 1;
            if parts > 3 {
                return false;
            }
        }
        return parts > 0;
    }
    if key == "indent-string" {
        // Quoted spaces/tabs, or `\t` / `\\t`.
        if matches!(value, r"\t" | "'\\t'" | "\"\\t\"") {
            return true;
        }
        let bytes = value.as_bytes();
        if bytes.len() >= 3 {
            let q = bytes[0];
            if (q == b'\'' || q == b'"') && bytes[bytes.len() - 1] == q {
                let inner = &bytes[1..bytes.len() - 1];
                return !inner.is_empty() && inner.iter().all(|b| *b == b' ' || *b == b'\t');
            }
        }
        return false;
    }
    // Message ids, names, paths, regexes, templates. Need an ident char.
    let mut has_ident = false;
    for b in value.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if b.is_ascii_alphanumeric() || b == b'_' {
            has_ident = true;
        }
    }
    has_ident
}

/// pycodestyle `.pycodestyle` / `setup.cfg` / `tox.ini` `[pycodestyle]`
/// / legacy `[pep8]`: `[pycodestyle]`, `[pep8]`,
/// `max-line-length = 88`, `max-doc-length = 72`, `indent-size = 4`,
/// `ignore = E203,W503`, `select = E,F,W`,
/// `exclude = .git,.venv,build,dist`, `filename = *.py`,
/// `format = default` / `pylint` / custom `%(path)s:…`,
/// `hang-closing = true`, `statistics = true`, `count = true`,
/// `show-source = true`, `show-pep8 = true`, `first = true`,
/// `diff = true`, `benchmark = true`, `quiet = 1`, `verbose = 1`.
/// Exact pycodestyle keys (kebab-case). INI `key = value` or
/// `key=value`. Optional `#` / `;` comment. flake8 / mypy / pytest /
/// isort / coverage / pylint / tox / setuptools / Cargo / Pipfile /
/// pyproject `[tool.pycodestyle]` / Desktop Entry / pip.conf tables,
/// incomplete brackets, wrong case, and prose stay out.
fn is_pycodestyle_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return pycodestyle_ini_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !pycodestyle_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    pycodestyle_ini_value_ok(key, value)
}

