/// `"autofiltering"` / `"consequence"` / `"condition"` / `"params"` /
/// `"query"` / `"key"`
/// accept `{`.
/// `"eventSources"` / `"banners"` / `"hide"` / `"keywords"` / `"authors"` /
/// `"hierarchy_camel"` / `"appliedRules"` / `"hierarchyPath"` /
/// `"optionalFilters"` / `"matchedWords"` / `"ruleContexts"` /
