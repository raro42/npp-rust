/// Linux `audit.rules` / auditctl lines: `-w /etc/passwd -p wa -k identity`,
/// `-a always,exit -F arch=b64 -S open -k access`, `-A never,task …`,
/// controls `-D` / `-b 8192` / `-f 1` / `-e 1` / `-r 0` / `-i` /
/// `--loginuid-immutable`. Exact leading `-` option letter (or the long
/// `--loginuid-immutable`). Optional `#` comment. Bare flags, prose,
/// wrong-case letters, and non-audit lines stay out.
fn is_audit_rules_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    if let Some(rest) = s.strip_prefix("--loginuid-immutable") {
        return audit_rules_tail(rest);
    }
    let Some(rest) = s.strip_prefix('-') else {
        return false;
    };
    let bytes = rest.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    let opt = bytes[0];
    // Lowercase option letters, plus uppercase `-D` / `-A` (auditctl).
    if !(opt.is_ascii_lowercase() || opt == b'D' || opt == b'A') {
        return false;
    }
    let after_opt = &rest[1..];
    match opt {
        b'D' | b'i' | b'c' => audit_rules_tail(after_opt),
        b'b' | b'f' | b'e' | b'r' => {
            if !after_opt.starts_with(char::is_whitespace) {
                return false;
            }
            let rest = after_opt.trim_start();
            let end = rest
                .find(|c: char| c.is_whitespace() || c == '#')
                .unwrap_or(rest.len());
            if end == 0 {
                return false;
            }
            let num = &rest[..end];
            if !num.bytes().all(|b| b.is_ascii_digit()) {
                return false;
            }
            audit_rules_tail(&rest[end..])
        }
        b'w' => {
            if !after_opt.starts_with(char::is_whitespace) {
                return false;
            }
            let rest = after_opt.trim_start();
            let end = rest
                .find(|c: char| c.is_whitespace() || c == '#')
                .unwrap_or(rest.len());
            if end == 0 {
                return false;
            }
            let path = &rest[..end];
            // Path-like watch target.
            if !(path.starts_with('/')
                || path.starts_with('.')
                || path.contains('/')
                || path.contains('*'))
            {
                return false;
            }
            // Remainder may hold `-p` / `-k` / …; just require non-prose start.
            let after = rest[end..].trim_start();
            after.is_empty() || after.starts_with('#') || after.starts_with('-')
        }
        b'a' | b'A' => {
            if !after_opt.starts_with(char::is_whitespace) {
                return false;
            }
            let rest = after_opt.trim_start();
            let end = rest
                .find(|c: char| c.is_whitespace() || c == '#')
                .unwrap_or(rest.len());
            if end == 0 {
                return false;
            }
            let pair = &rest[..end];
            if !audit_rules_list_action(pair) {
                return false;
            }
            let after = rest[end..].trim_start();
            after.is_empty() || after.starts_with('#') || after.starts_with('-')
        }
        _ => false,
    }
}

fn audit_rules_tail(rest: &str) -> bool {
    let rest = rest.trim_start();
    rest.is_empty() || rest.starts_with('#')
}

fn audit_rules_list_action(pair: &str) -> bool {
    let Some((a, b)) = pair.split_once(',') else {
        return false;
    };
    if a.is_empty() || b.is_empty() {
        return false;
    }
    const LISTS: &[&str] = &["task", "exit", "user", "exclude", "filesystem", "io_uring"];
    const ACTIONS: &[&str] = &["always", "never"];
    let a_list = LISTS.contains(&a);
    let b_list = LISTS.contains(&b);
    let a_act = ACTIONS.contains(&a);
    let b_act = ACTIONS.contains(&b);
    (a_list && b_act) || (a_act && b_list)
}

/// Linux-PAM `pam.conf` / `pam.d` rules: `auth required pam_unix.so`,
/// `account requisite pam_unix.so`, `-password optional pam_gnome_keyring.so`,
/// `session [success=1 default=ignore] pam_succeed_if.so …`,
/// `login auth required pam_unix.so` (pam.conf with service),
/// `auth include system-auth`, `auth substack password-auth`,
/// `@include common-auth`. Type/control case-insensitive; optional leading
/// `-` on type (quiet missing module). Optional `#` comment. Bare types,
/// prose (`auth the unix`), incomplete, and non-PAM lines stay out.
fn is_pam_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    // Debian/Ubuntu include: `@include common-auth`
    if let Some(rest) = s.strip_prefix("@include") {
        if !rest.starts_with(char::is_whitespace) {
            return false;
        }
        let rest = rest.trim_start();
        let end = rest
            .find(|c: char| c.is_whitespace() || c == '#')
            .unwrap_or(rest.len());
        if end == 0 {
            return false;
        }
        let name = &rest[..end];
        // Debian/Ubuntu `@include common-auth` — not Sass `@include mixin`.
        if !pam_at_include_name_ok(name) {
            return false;
        }
        let after = rest[end..].trim_start();
        return after.is_empty() || after.starts_with('#');
    }

    // Optional service (pam.conf) then type control module-path …
    let (first, after_first) = match pam_next_token(s) {
        Some(pair) => pair,
        None => return false,
    };
    let after_type = if pam_type_ok(first) {
        after_first
    } else {
        // pam.conf: service type …
        if !pam_service_ok(first) {
            return false;
        }
        match pam_next_token(after_first) {
            Some((t, a)) if pam_type_ok(t) => a,
            _ => return false,
        }
    };

    let Some((control, after_control)) = pam_parse_control(after_type) else {
        return false;
    };
    let include_like = matches!(
        control.to_ascii_lowercase().as_str(),
        "include" | "substack"
    );
    let Some((module, after_module)) = pam_next_token(after_control) else {
        return false;
    };
    if !pam_module_ok(module, include_like) {
        return false;
    }
    // Remainder may hold module arguments; accept anything (or comment).
    let _ = after_module;
    true
}

fn pam_next_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return None;
    }
    let end = s
        .find(|c: char| c.is_whitespace() || c == '#')
        .unwrap_or(s.len());
    if end == 0 {
        return None;
    }
    Some((&s[..end], &s[end..]))
}

fn pam_type_ok(tok: &str) -> bool {
    let t = tok.strip_prefix('-').unwrap_or(tok);
    matches!(
        t.to_ascii_lowercase().as_str(),
        "auth" | "account" | "password" | "session"
    )
}

fn pam_service_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.starts_with('-') {
        return false;
    }
    // Service names are lowercase identifiers (login, su, other, sshd…).
    let bytes = tok.as_bytes();
    if !bytes[0].is_ascii_lowercase() {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-' || b == b'_')
}

fn pam_parse_control(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return None;
    }
    if s.starts_with('[') {
        let end = s.find(']')?;
        let control = &s[..=end];
        let inner = &control[1..control.len() - 1];
        if inner.is_empty() {
            return None;
        }
        // Every space-separated token must be `value=action`.
        if !inner.split_whitespace().all(|pair| {
            let Some((v, a)) = pair.split_once('=') else {
                return false;
            };
            !v.is_empty() && !a.is_empty()
        }) {
            return None;
        }
        return Some((control, &s[end + 1..]));
    }
    let (tok, rest) = pam_next_token(s)?;
    const SIMPLE: &[&str] = &[
        "required",
        "requisite",
        "sufficient",
        "optional",
        "include",
        "substack",
    ];
    if !SIMPLE.iter().any(|k| tok.eq_ignore_ascii_case(k)) {
        return None;
    }
    Some((tok, rest))
}

fn pam_module_ok(tok: &str, include_like: bool) -> bool {
    if tok.is_empty() {
        return false;
    }
    // Prose guards.
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    if include_like {
        return pam_include_name_ok(tok);
    }
    // Module path: `pam_unix.so`, `/lib/security/pam_unix.so`, relative path.
    if tok.ends_with(".so") {
        return tok.len() > 3
            && tok
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'));
    }
    if tok.starts_with('/') {
        return tok.len() > 1
            && tok
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'));
    }
    false
}

fn pam_include_name_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // pam.d include / substack target: `system-auth`, `password-auth`.
    let bytes = tok.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric()
        || bytes[0] == b'_'
        || bytes[0] == b'.'
        || bytes[0] == b'/')
    {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'))
}

/// `@include` must look like a PAM drop-in (`common-auth`), not Sass `@include mixin`.
fn pam_at_include_name_ok(tok: &str) -> bool {
    if !pam_include_name_ok(tok) || tok.contains('(') {
        return false;
    }
    let lower = tok.to_ascii_lowercase();
    const MARKERS: &[&str] = &["auth", "account", "session", "password"];
    MARKERS.iter().any(|m| {
        lower == *m
            || lower.starts_with(&format!("{m}-"))
            || lower.ends_with(&format!("-{m}"))
            || lower.contains(&format!("-{m}-"))
    })
}

/// sudoers: `#include /etc/sudoers.local`, `#includedir /etc/sudoers.d`,
/// `@include …` / `@includedir …`, `Defaults env_reset`,
/// `Defaults:alice !requiretty`, `Defaults@host timestamp_timeout=15`,
/// `Defaults!/usr/bin/sudoedit !authenticate`, `User_Alias ADMINS = jsmith`,
/// `Runas_Alias` / `Host_Alias` / `Cmnd_Alias`, privilege lines
/// `root ALL=(ALL:ALL) ALL`, `%sudo ALL=(ALL) ALL`,
/// `alice ALL=(ALL) NOPASSWD: /usr/bin/systemctl`. Optional `#` comment after
/// a rule. Bare keywords, prose (`root the ALL`), C `#include <stdio.h>`,
/// Sass `@include mixin`, PAM rules, and incomplete lines stay out.
fn is_sudoers_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() {
        return false;
    }
    // Include directives (before generic `#` comment reject).
    if let Some(rest) = sudoers_strip_include_kw(s) {
        return sudoers_include_path_ok(rest);
    }
    if s.starts_with('#') {
        return false;
    }

    // Defaults / Defaults:user / Defaults@host / Defaults!cmnd …
    if let Some(rest) = sudoers_strip_defaults(s) {
        return sudoers_defaults_body_ok(rest);
    }

    // User_Alias / Runas_Alias / Host_Alias / Cmnd_Alias NAME = …
    if let Some(rest) = sudoers_strip_alias_kw(s) {
        return sudoers_alias_body_ok(rest);
    }

    // Privilege: user host = [(runas)] [tags:] commands
    sudoers_privilege_ok(s)
}

fn sudoers_strip_include_kw(s: &str) -> Option<&str> {
    for kw in ["#includedir", "#include", "@includedir", "@include"] {
        if let Some(rest) = s.strip_prefix(kw) {
            if rest.starts_with(char::is_whitespace) {
                return Some(rest.trim_start());
            }
        }
    }
    None
}

fn sudoers_include_path_ok(rest: &str) -> bool {
    let end = rest
        .find(|c: char| c.is_whitespace() || c == '#')
        .unwrap_or(rest.len());
    if end == 0 {
        return false;
    }
    let path = &rest[..end];
    // Filesystem-ish path; reject C `#include <stdio.h>` / `"foo.h"` and Sass
    // `@include mixin` prose.
    if path.starts_with('<') || path.starts_with('"') || path.starts_with('\'') {
        return false;
    }
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| path.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = path.as_bytes();
    if !(bytes[0] == b'/'
        || bytes[0] == b'.'
        || bytes[0].is_ascii_alphanumeric()
        || bytes[0] == b'_'
        || bytes[0] == b'~')
    {
        return false;
    }
    if !bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/' | b'~' | b'*'))
    {
        return false;
    }
    // Prefer paths that look like files/dirs (slash, dot, or tilde), not bare words.
    if !(path.contains('/') || path.contains('.') || path.starts_with('~') || path.starts_with('*'))
    {
        return false;
    }
    let after = rest[end..].trim_start();
    after.is_empty() || after.starts_with('#')
}

fn sudoers_strip_defaults(s: &str) -> Option<&str> {
    let lower = s.as_bytes();
    const KW: &[u8] = b"Defaults";
    if lower.len() < KW.len() {
        return None;
    }
    if !s[..KW.len()].eq_ignore_ascii_case("Defaults") {
        return None;
    }
    let rest = &s[KW.len()..];
    // `Defaults …` or `Defaults:…` / `Defaults@…` / `Defaults!…` / `Defaults>…`
    if rest.is_empty() {
        return None;
    }
    let c = rest.as_bytes()[0];
    if c.is_ascii_whitespace() || matches!(c, b':' | b'@' | b'!' | b'>') {
        return Some(rest.trim_start());
    }
    None
}

fn sudoers_defaults_body_ok(rest: &str) -> bool {
    // Optional qualifier glued or spaced already trimmed: `:alice !requiretty`
    // or `env_reset` or `@host timestamp_timeout=15`.
    let rest = rest.trim_start();
    if rest.is_empty() || rest.starts_with('#') {
        return false;
    }
    // Qualifier forms start with : @ ! >
    let after_qual = if matches!(rest.as_bytes()[0], b':' | b'@' | b'!' | b'>') {
        let q = &rest[1..];
        let end = q
            .find(|c: char| c.is_whitespace() || c == '#')
            .unwrap_or(q.len());
        if end == 0 {
            return false;
        }
        let qual = &q[..end];
        if !sudoers_name_or_path_ok(qual) {
            return false;
        }
        q[end..].trim_start()
    } else {
        rest
    };
    if after_qual.is_empty() || after_qual.starts_with('#') {
        return false;
    }
    // At least one option token (not prose filler alone).
    let end = after_qual
        .find(|c: char| c.is_whitespace() || c == '#')
        .unwrap_or(after_qual.len());
    if end == 0 {
        return false;
    }
    let opt = &after_qual[..end];
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| opt.eq_ignore_ascii_case(w)) {
        return false;
    }
    // Options are identifiers, often `!flag` or `key=value`.
    let body = opt.strip_prefix('!').unwrap_or(opt);
    if body.is_empty() {
        return false;
    }
    body.bytes().all(|b| {
        b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'=' | b'+' | b':' | b'/')
    })
}

fn sudoers_strip_alias_kw(s: &str) -> Option<&str> {
    for kw in ["User_Alias", "Runas_Alias", "Host_Alias", "Cmnd_Alias"] {
        if let Some(rest) = s.strip_prefix(kw) {
            if rest.starts_with(char::is_whitespace) {
                return Some(rest.trim_start());
            }
        }
    }
    None
}

fn sudoers_alias_body_ok(rest: &str) -> bool {
    // NAME = member[, member…]
    let end = rest
        .find(|c: char| c.is_whitespace() || c == '=' || c == '#')
        .unwrap_or(rest.len());
    if end == 0 {
        return false;
    }
    let name = &rest[..end];
    if !sudoers_alias_name_ok(name) {
        return false;
    }
    let after = rest[end..].trim_start();
    let Some(after_eq) = after.strip_prefix('=') else {
        return false;
    };
    let after_eq = after_eq.trim_start();
    if after_eq.is_empty() || after_eq.starts_with('#') {
        return false;
    }
    let mend = after_eq
        .find(|c: char| c.is_whitespace() || c == ',' || c == '#')
        .unwrap_or(after_eq.len());
    if mend == 0 {
        return false;
    }
    let member = &after_eq[..mend];
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| member.eq_ignore_ascii_case(w)) {
        return false;
    }
    sudoers_name_or_path_ok(member)
}

fn sudoers_alias_name_ok(name: &str) -> bool {
    if name.is_empty() {
        return false;
    }
    let bytes = name.as_bytes();
    if !bytes[0].is_ascii_uppercase() {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'_')
}

fn sudoers_privilege_ok(s: &str) -> bool {
    let Some((user, after_user)) = sudoers_next_token(s) else {
        return false;
    };
    if !sudoers_user_spec_ok(user) {
        return false;
    }
    let Some((host, after_host)) = sudoers_next_token(after_user) else {
        return false;
    };
    if !sudoers_host_spec_ok(host) {
        return false;
    }
    let after_host = after_host.trim_start();
    let Some(after_eq) = after_host.strip_prefix('=') else {
        return false;
    };
    let mut rest = after_eq.trim_start();
    if rest.is_empty() || rest.starts_with('#') {
        return false;
    }
    // Optional (Runas_List). Real sudoers lines almost always have this or
    // host ALL + a path/ALL/tag command; require one of those shapes so
    // random `a b = c` source lines stay out.
    let mut has_runas = false;
    if rest.starts_with('(') {
        let Some(close) = rest.find(')') else {
            return false;
        };
        let inner = &rest[1..close];
        if inner.is_empty() {
            return false;
        }
        // Allow ALL, ALL:ALL, user:group, #uid, %group, …
        if !inner.chars().all(|c| {
            c.is_ascii_alphanumeric()
                || matches!(c, ':' | '%' | '#' | '+' | '_' | '-' | ',' | ' ' | '*' | '/')
        }) {
            return false;
        }
        has_runas = true;
        rest = rest[close + 1..].trim_start();
    }
    if rest.is_empty() || rest.starts_with('#') {
        return false;
    }
    // Tags (NOPASSWD: PASSWD: …) then command, or bare ALL / path.
    let (cmd, _) = match sudoers_next_token(rest) {
        Some(pair) => pair,
        None => return false,
    };
    if !sudoers_command_or_tag_ok(cmd) {
        return false;
    }
    // Without (runas), require host ALL and a clear sudoers command
    // (ALL / path / tag / Cmnd_Alias), not a generic word.
    if !has_runas {
        if !host.eq_ignore_ascii_case("ALL") {
            return false;
        }
        if !(cmd.eq_ignore_ascii_case("ALL")
            || cmd.starts_with('/')
            || cmd.ends_with(':')
            || cmd.starts_with('!')
            || sudoers_alias_name_ok(cmd.strip_prefix('!').unwrap_or(cmd)))
        {
            return false;
        }
    }
    true
}

fn sudoers_next_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return None;
    }
    let end = s
        .find(|c: char| c.is_whitespace() || c == '#' || c == '=')
        .unwrap_or(s.len());
    if end == 0 {
        return None;
    }
    Some((&s[..end], &s[end..]))
}

fn sudoers_user_spec_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    // Reject keywords that belong to other families / prose / common source.
    const BLOCK: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "auth", "account", "password", "session",
        "include", "substack", "defaults", "alias", "const", "let", "var", "type", "class",
        "struct", "enum", "fn", "fun", "func", "def", "function", "target", "sig", "pred", "fact",
        "assert",
    ];
    if BLOCK.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // %group, +netgroup, #uid, %#gid, user, User_Alias ref
    let t = tok;
    if t.starts_with('%') || t.starts_with('+') || t.starts_with('#') {
        return t.len() > 1 && sudoers_name_or_path_ok(&t[1..]);
    }
    sudoers_name_or_path_ok(t)
}

fn sudoers_host_spec_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    if tok.eq_ignore_ascii_case("ALL") {
        return true;
    }
    if tok.starts_with('+') || tok.starts_with('%') {
        return tok.len() > 1 && sudoers_name_or_path_ok(&tok[1..]);
    }
    // Hostname, IPv4, or Host_Alias.
    tok.bytes()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_' | b'*' | b':'))
        && tok.as_bytes()[0].is_ascii_alphanumeric()
}

fn sudoers_command_or_tag_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // Tag: NOPASSWD: / PASSWD: / NOEXEC: / …
    if let Some(tag) = tok.strip_suffix(':') {
        const TAGS: &[&str] = &[
            "NOPASSWD",
            "PASSWD",
            "NOEXEC",
            "EXEC",
            "SETENV",
            "NOSETENV",
            "LOG_INPUT",
            "NOLOG_INPUT",
            "LOG_OUTPUT",
            "NOLOG_OUTPUT",
            "FOLLOW",
            "NOFOLLOW",
            "MAIL",
            "NOMAIL",
            "INTERCEPT",
            "NOINTERCEPT",
        ];
        return TAGS.iter().any(|t| tag.eq_ignore_ascii_case(t));
    }
    if tok.eq_ignore_ascii_case("ALL") {
        return true;
    }
    // Command path or Cmnd_Alias (UPPER) or quoted.
    if tok.starts_with('"') {
        return tok.len() > 2 && tok.ends_with('"');
    }
    if let Some(rest) = tok.strip_prefix('!') {
        return !rest.is_empty() && sudoers_command_or_tag_ok(rest);
    }
    if tok.starts_with('/') {
        return tok.len() > 1
            && tok.bytes().all(|b| {
                b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/' | b'*')
            });
    }
    // Cmnd_Alias reference only (UPPER_SNAKE); bare words stay out.
    sudoers_alias_name_ok(tok)
}

fn sudoers_name_or_path_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = tok.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric()
        || bytes[0] == b'_'
        || bytes[0] == b'.'
        || bytes[0] == b'/'
        || bytes[0] == b'~'
        || bytes[0] == b'*')
    {
        return false;
    }
    bytes.iter().all(|&b| {
        b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/' | b'~' | b'*' | b':')
    })
}

/// `/etc/security/limits.conf`: `* soft nofile 1024`, `* hard nofile 2048`,
/// `@student hard nproc 20`, `% hard maxlogins 4`, `%group soft maxlogins 2`,
/// `ftp hard nproc 0`, `alice - priority 10`. Domain = user / `@group` / `*` /
/// `%` / `%group`. Type = `soft` / `hard` / `-`. Item = stock ulimit names
/// (`core` / `nofile` / `nproc` / `maxlogins` / …). Value = number /
/// `unlimited` / `-`. Optional `#` comment. Bare / prose / incomplete /
/// neighbouring families stay out.
fn is_limits_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let Some((domain, after_domain)) = limits_next_token(s) else {
        return false;
    };
    if !limits_domain_ok(domain) {
        return false;
    }
    let Some((ty, after_type)) = limits_next_token(after_domain) else {
        return false;
    };
    if !limits_type_ok(ty) {
        return false;
    }
    let Some((item, after_item)) = limits_next_token(after_type) else {
        return false;
    };
    if !limits_item_ok(item) {
        return false;
    }
    let Some((value, after_value)) = limits_next_token(after_item) else {
        return false;
    };
    if !limits_value_ok(value) {
        return false;
    }
    let after = after_value.trim_start();
    after.is_empty() || after.starts_with('#')
}

fn limits_next_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() {
        return None;
    }
    let end = s
        .find(|c: char| c.is_whitespace() || c == '#')
        .unwrap_or(s.len());
    if end == 0 {
        return None;
    }
    Some((&s[..end], &s[end..]))
}

fn limits_domain_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or"];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    if tok == "*" || tok == "%" {
        return true;
    }
    // `@group` or `%group` (maxlogins group form).
    if let Some(rest) = tok.strip_prefix('@').or_else(|| tok.strip_prefix('%')) {
        return !rest.is_empty() && limits_name_ok(rest);
    }
    limits_name_ok(tok)
}

fn limits_name_ok(tok: &str) -> bool {
    let bytes = tok.as_bytes();
    if bytes.is_empty() || !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'))
}

fn limits_type_ok(tok: &str) -> bool {
    matches!(tok, "soft" | "hard" | "-")
}

fn limits_item_ok(tok: &str) -> bool {
    const ITEMS: &[&str] = &[
        "core",
        "data",
        "fsize",
        "memlock",
        "nofile",
        "rss",
        "stack",
        "cpu",
        "nproc",
        "as",
        "maxlogins",
        "maxsyslogins",
        "priority",
        "locks",
        "sigpending",
        "msgqueue",
        "nice",
        "rtprio",
        "chroot",
    ];
    ITEMS.iter().any(|i| tok.eq_ignore_ascii_case(i))
}

fn limits_value_ok(tok: &str) -> bool {
    if tok == "-" || tok.eq_ignore_ascii_case("unlimited") {
        return true;
    }
    // Integer (optional leading +); reject bare prose.
    let bytes = tok.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    let start = if bytes[0] == b'+' { 1 } else { 0 };
    if start >= bytes.len() {
        return false;
    }
    bytes[start..].iter().all(|b| b.is_ascii_digit())
}

/// `/etc/security/access.conf` (pam_access): `+ : root : LOCAL`,
/// `- : ALL EXCEPT wheel : ALL`, `+ : @admins : .example.com`,
/// `+ : (wheel) : ALL`, `+:root:LOCAL`. Permission `+` / `-`, then users,
/// then origins, colon-separated. Optional `#` comment. Bare / prose /
/// incomplete / neighbouring families stay out.
fn is_access_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let after_perm = match s.as_bytes().first() {
        Some(b'+' | b'-') => &s[1..],
        _ => return false,
    };
    let after_perm = after_perm.trim_start();
    let Some(after_first) = after_perm.strip_prefix(':') else {
        return false;
    };
    let Some(colon2) = after_first.find(':') else {
        return false;
    };
    let users = after_first[..colon2].trim();
    let after_users = &after_first[colon2 + 1..];
    let origins = if let Some(hash) = after_users.find('#') {
        after_users[..hash].trim()
    } else {
        after_users.trim()
    };
    if users.is_empty() || origins.is_empty() {
        return false;
    }
    // No further colon fields (three-field form only).
    if origins.contains(':') {
        return false;
    }
    access_conf_field_ok(users) && access_conf_field_ok(origins)
}

fn access_conf_field_ok(field: &str) -> bool {
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| field.eq_ignore_ascii_case(w)) {
        return false;
    }
    let mut saw = false;
    for tok in field.split_whitespace() {
        if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
            // `ALL EXCEPT …` / `EXCEPT` are stock; lone prose stays out.
            if !tok.eq_ignore_ascii_case("except") {
                return false;
            }
            continue;
        }
        if !access_conf_token_ok(tok) {
            return false;
        }
        saw = true;
    }
    saw
}

fn access_conf_token_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    if tok.eq_ignore_ascii_case("ALL")
        || tok.eq_ignore_ascii_case("LOCAL")
        || tok.eq_ignore_ascii_case("EXCEPT")
    {
        return true;
    }
    // `(group)` or bare group/user / @netgroup / .domain / host / IP / CIDR.
    let inner = if tok.starts_with('(') && tok.ends_with(')') && tok.len() >= 3 {
        &tok[1..tok.len() - 1]
    } else {
        tok
    };
    let bytes = inner.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    // Leading `@` (netgroup) or `.` (domain) ok.
    let start = if matches!(bytes[0], b'@' | b'.') {
        1
    } else {
        0
    };
    if start >= bytes.len() {
        return false;
    }
    if !(bytes[start].is_ascii_alphanumeric() || bytes[start] == b'_') {
        return false;
    }
    bytes[start..].iter().all(|&b| {
        b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/' | b'*' | b'+' | b'%')
    })
}

/// `/etc/hosts.allow` / `/etc/hosts.deny` (tcp_wrappers): `ALL: LOCAL`,
/// `sshd: 192.168.1.0/24`, `ALL: .example.com EXCEPT bad.example.com`,
/// `in.ftpd: ALL: spawn /bin/echo …`, `sshd,vsftpd: ALL`. Daemon list then
/// client list, colon-separated; optional third field = shell command.
/// Optional `#` comment. pam_access `+/- : …` stays on access.conf. Bare /
/// prose / incomplete / neighbouring families stay out.
fn is_hosts_access_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    // Leave pam_access (`+ : …` / `- : …` / `+:…`) to is_access_conf_decl.
    if matches!(s.as_bytes().first(), Some(b'+' | b'-')) {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(colon1) = body.find(':') else {
        return false;
    };
    let daemons = body[..colon1].trim();
    let after_daemons = body[colon1 + 1..].trim();
    if daemons.is_empty() || after_daemons.is_empty() {
        return false;
    }
    let (clients, shell) = if let Some(colon2) = after_daemons.find(':') {
        (
            after_daemons[..colon2].trim(),
            Some(after_daemons[colon2 + 1..].trim()),
        )
    } else {
        (after_daemons, None)
    };
    if clients.is_empty() {
        return false;
    }
    if let Some(cmd) = shell {
        if cmd.is_empty() {
            return false;
        }
    }
    // Two-field client must not contain another colon (IPv6 bracket forms later).
    if shell.is_none() && clients.contains(':') {
        return false;
    }
    hosts_access_list_ok(daemons, false)
        && hosts_access_list_ok(clients, true)
        && hosts_access_client_distinctive(clients)
}

fn hosts_access_list_ok(field: &str, clients: bool) -> bool {
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| field.eq_ignore_ascii_case(w)) {
        return false;
    }
    let mut saw = false;
    for raw in field.split(|c: char| c.is_whitespace() || c == ',') {
        let tok = raw.trim();
        if tok.is_empty() {
            continue;
        }
        if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
            if tok != "EXCEPT" {
                return false;
            }
            continue;
        }
        if !hosts_access_token_ok(tok, clients) {
            return false;
        }
        saw = true;
    }
    saw
}

/// Reject bare `Name: foo` / `color: red` / `all: foo.o` / `foo.o: foo.c`:
/// client side must look like tcp_wrappers (uppercase keyword, IP/CIDR,
/// `.domain`, `@netgroup`, `/file`, or hostname with ≥2 dots).
fn hosts_access_client_distinctive(clients: &str) -> bool {
    for raw in clients.split(|c: char| c.is_whitespace() || c == ',') {
        let tok = raw.trim();
        if tok.is_empty() || tok == "EXCEPT" {
            continue;
        }
        // Stock wildcards are uppercase in hosts_access(5); lowercase `all:`
        // is a common Makefile target.
        if matches!(tok, "ALL" | "LOCAL" | "KNOWN" | "UNKNOWN" | "PARANOID") {
            return true;
        }
        let bytes = tok.as_bytes();
        if matches!(bytes.first(), Some(b'.' | b'@' | b'/')) {
            return true;
        }
        // IPv4 / CIDR: digit start; need ≥2 dots or a `/` (avoid `22.04` tags).
        if bytes[0].is_ascii_digit() {
            let dots = tok.bytes().filter(|&b| b == b'.').count();
            if dots >= 2 || tok.contains('/') {
                return true;
            }
        }
        // Multi-label hostname (`host.example.com`); one-dot `foo.o` stays out.
        let dots = tok.bytes().filter(|&b| b == b'.').count();
        if dots >= 2
            && bytes.iter().any(|b| b.is_ascii_alphabetic())
            && bytes
                .iter()
                .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'*'))
        {
            return true;
        }
    }
    false
}

fn hosts_access_token_ok(tok: &str, clients: bool) -> bool {
    if tok.is_empty() {
        return false;
    }
    // Case-sensitive stock words (see hosts_access_client_distinctive).
    if matches!(
        tok,
        "ALL" | "LOCAL" | "EXCEPT" | "KNOWN" | "UNKNOWN" | "PARANOID"
    ) {
        return true;
    }
    // `/file/name` pattern file, `@netgroup`, `.domain` — clients only.
    let bytes = tok.as_bytes();
    if bytes[0] == b'/' {
        return clients
            && bytes.len() > 1
            && bytes[1..].iter().all(|&b| {
                b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/' | b'*')
            });
    }
    let start = if matches!(bytes[0], b'@' | b'.') {
        if !clients {
            return false;
        }
        1
    } else {
        0
    };
    if start >= bytes.len() {
        return false;
    }
    if !(bytes[start].is_ascii_alphanumeric() || bytes[start] == b'_') {
        return false;
    }
    bytes[start..]
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/' | b'*'))
}

/// `/etc/fstab`: `UUID=… / ext4 defaults 0 1`, `/dev/sda1 /boot ext4 defaults 0 2`,
/// `tmpfs /tmp tmpfs defaults 0 0`, `LABEL=home /home xfs defaults 0 2`,
/// `//server/share /mnt cifs credentials=/etc/creds 0 0`,
/// `server:/export /mnt nfs defaults 0 0`. Spec, mount point, type, options,
/// optional dump + pass. Optional `#` comment. Bare / prose / incomplete /
/// neighbouring families stay out.
fn is_fstab_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let mut fields = Vec::with_capacity(6);
    let mut rest = body;
    while fields.len() < 6 {
        let Some((tok, after)) = fstab_next_token(rest) else {
            break;
        };
        fields.push(tok);
        rest = after;
    }
    if !rest.trim_start().is_empty() {
        return false;
    }
    if fields.len() < 4 || fields.len() > 6 {
        return false;
    }
    let spec = fields[0];
    let mnt = fields[1];
    let fstype = fields[2];
    let opts = fields[3];
    if !fstab_spec_ok(spec)
        || !fstab_mount_ok(mnt)
        || !fstab_type_ok(fstype)
        || !fstab_opts_ok(opts)
    {
        return false;
    }
    if fields.len() >= 5 && !fstab_number_ok(fields[4]) {
        return false;
    }
    if fields.len() == 6 && !fstab_number_ok(fields[5]) {
        return false;
    }
    true
}

fn fstab_next_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() {
        return None;
    }
    let end = s.find(char::is_whitespace).unwrap_or(s.len());
    if end == 0 {
        return None;
    }
    Some((&s[..end], &s[end..]))
}

fn fstab_spec_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // UUID= / LABEL= / PARTUUID= / PARTLABEL= / …
    if let Some((key, val)) = tok.split_once('=') {
        if key.is_empty() || val.is_empty() {
            return false;
        }
        if !key.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_') {
            return false;
        }
        return val
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b':' | b'.' | b'/'));
    }
    // Device / bind path.
    if tok.starts_with('/') {
        return tok.len() > 1
            && tok.as_bytes()[1..]
                .iter()
                .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'));
    }
    // CIFS `//server/share`.
    if let Some(rest) = tok.strip_prefix("//") {
        return !rest.is_empty()
            && rest
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'));
    }
    // NFS `host:/export` (host may be dotted; path after first `:/`).
    if let Some((host, path)) = tok.split_once(":/") {
        if host.is_empty() || path.is_empty() {
            return false;
        }
        let host_ok = host
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'));
        let path_ok = path
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'));
        return host_ok && path_ok;
    }
    // Pseudo / special sources: tmpfs, proc, none, swap, …
    fstab_special_source(tok)
}

fn fstab_special_source(tok: &str) -> bool {
    matches!(
        tok,
        "tmpfs"
            | "proc"
            | "sysfs"
            | "devtmpfs"
            | "devpts"
            | "cgroup"
            | "cgroup2"
            | "securityfs"
            | "debugfs"
            | "pstore"
            | "efivarfs"
            | "hugetlbfs"
            | "mqueue"
            | "overlay"
            | "configfs"
            | "binfmt_misc"
            | "autofs"
            | "fusectl"
            | "none"
            | "swap"
            | "ramfs"
            | "bpf"
            | "tracefs"
    )
}

fn fstab_mount_ok(tok: &str) -> bool {
    if tok == "none" || tok == "swap" {
        return true;
    }
    if tok == "/" {
        return true;
    }
    if !tok.starts_with('/') || tok.len() < 2 {
        return false;
    }
    tok.as_bytes()[1..]
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/'))
}

fn fstab_type_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 32 {
        return false;
    }
    const PROSE: &[&str] = &["the", "a", "an", "to", "of", "for", "and", "or", "is"];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // Stock / common types (case-sensitive as in fstab).
    const TYPES: &[&str] = &[
        "ext2",
        "ext3",
        "ext4",
        "xfs",
        "btrfs",
        "f2fs",
        "vfat",
        "fat",
        "msdos",
        "ntfs",
        "ntfs3",
        "exfat",
        "swap",
        "tmpfs",
        "proc",
        "sysfs",
        "devtmpfs",
        "devpts",
        "cgroup",
        "cgroup2",
        "nfs",
        "nfs4",
        "cifs",
        "smb3",
        "smbfs",
        "iso9660",
        "udf",
        "squashfs",
        "overlay",
        "fuse",
        "fuseblk",
        "fusectl",
        "auto",
        "none",
        "bind",
        "ramfs",
        "zfs",
        "jfs",
        "reiserfs",
        "hfsplus",
        "apfs",
        "erofs",
        "ubifs",
        "jffs2",
        "minix",
        "romfs",
        "bpf",
        "tracefs",
        "securityfs",
        "debugfs",
        "pstore",
        "efivarfs",
        "hugetlbfs",
        "mqueue",
        "configfs",
        "binfmt_misc",
        "autofs",
    ];
    if TYPES.contains(&tok) {
        return true;
    }
    // Fuse helpers: `fuse.sshfs`, `fuse.rclone`.
    if let Some(rest) = tok.strip_prefix("fuse.") {
        return !rest.is_empty()
            && rest
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'));
    }
    false
}

fn fstab_opts_ok(tok: &str) -> bool {
    if tok.is_empty() {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team",
    ];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // Distinctive: comma list, `=` kv, or stock single option.
    if tok.contains(',') || tok.contains('=') {
        return tok.bytes().all(|b| {
            b.is_ascii_alphanumeric()
                || matches!(
                    b,
                    b'_' | b'-' | b'.' | b'/' | b',' | b'=' | b':' | b'@' | b'+' | b'%'
                )
        });
    }
    matches!(
        tok,
        "defaults"
            | "ro"
            | "rw"
            | "sw"
            | "noatime"
            | "relatime"
            | "nodiratime"
            | "nosuid"
            | "nodev"
            | "noexec"
            | "sync"
            | "async"
            | "user"
            | "users"
            | "owner"
            | "auto"
            | "noauto"
            | "exec"
            | "suid"
            | "dev"
            | "bind"
            | "rbind"
            | "nofail"
            | "discard"
            | "compress"
    ) || (tok
        .bytes()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'))
        && tok.len() >= 2
        && tok.len() <= 40
        && tok.bytes().any(|b| b.is_ascii_alphabetic()))
}

fn fstab_number_ok(tok: &str) -> bool {
    !tok.is_empty() && tok.bytes().all(|b| b.is_ascii_digit()) && tok.len() <= 3
}

/// `/etc/hosts`: `127.0.0.1 localhost`, `::1 localhost ip6-localhost`,
/// `192.168.1.10 server.example.com server`, `ff02::1 ip6-allnodes`,
/// `0.0.0.0 ads.example.com`. Address then one or more hostnames. Optional
/// `#` comment. Bare / prose / incomplete / neighbouring families
/// (hosts.allow, fstab, crypttab, …) stay out.
fn is_hosts_file_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let mut fields = Vec::with_capacity(8);
    let mut rest = body;
    while fields.len() < 16 {
        let Some((tok, after)) = fstab_next_token(rest) else {
            break;
        };
        fields.push(tok);
        rest = after;
    }
    if !rest.trim_start().is_empty() {
        return false;
    }
    if fields.len() < 2 {
        return false;
    }
    if !hosts_file_addr_ok(fields[0]) {
        return false;
    }
    fields[1..].iter().all(|h| hosts_file_name_ok(h))
}

fn hosts_file_addr_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 64 {
        return false;
    }
    // IPv4 dotted decimal (no CIDR — that is hosts.allow shape).
    if tok.contains('.') && !tok.contains(':') {
        let parts: Vec<&str> = tok.split('.').collect();
        if parts.len() != 4 {
            return false;
        }
        return parts.iter().all(|p| {
            if p.is_empty() || p.len() > 3 || !p.bytes().all(|b| b.is_ascii_digit()) {
                return false;
            }
            if p.len() > 1 && p.starts_with('0') {
                return false;
            }
            p.parse::<u16>().map(|n| n <= 255).unwrap_or(false)
        });
    }
    // IPv6 (must contain `:`). Allow `::`, hex groups, optional zone `%iface`.
    if !tok.contains(':') {
        return false;
    }
    let (addr, zone) = match tok.split_once('%') {
        Some((a, z)) => (a, Some(z)),
        None => (tok, None),
    };
    if let Some(z) = zone {
        if z.is_empty()
            || !z
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'))
        {
            return false;
        }
    }
    if addr == "::" {
        return true;
    }
    let has_double = addr.contains("::");
    if has_double && addr.matches("::").count() != 1 {
        return false;
    }
    let parts: Vec<&str> = if has_double {
        addr.split("::").flat_map(|side| side.split(':')).collect()
    } else {
        addr.split(':').collect()
    };
    if parts.iter().filter(|p| !p.is_empty()).count() > 8 {
        return false;
    }
    if !has_double && parts.len() != 8 {
        return false;
    }
    parts.iter().all(|p| {
        if p.is_empty() {
            return has_double;
        }
        // Last group may be dotted IPv4 in IPv4-mapped form.
        if p.contains('.') {
            return hosts_file_addr_ok(p);
        }
        p.len() <= 4 && p.bytes().all(|b| b.is_ascii_hexdigit())
    })
}

fn hosts_file_name_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 253 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // No path / device / options shapes (fstab / crypttab / hosts.allow).
    if tok.contains('/') || tok.contains('=') || tok.contains(',') || tok.contains(':') {
        return false;
    }
    let bytes = tok.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    if !bytes[bytes.len() - 1].is_ascii_alphanumeric() {
        return false;
    }
    // DNS labels: alnum / `-` / `.` (dot-separated).
    let mut prev_dot = false;
    for &b in bytes {
        if b == b'.' {
            if prev_dot {
                return false;
            }
            prev_dot = true;
            continue;
        }
        prev_dot = false;
        if !(b.is_ascii_alphanumeric() || b == b'-' || b == b'_') {
            return false;
        }
    }
    true
}

/// `/etc/resolv.conf`: `nameserver 192.168.1.1`, `nameserver 2001:db8::1`,
/// `search example.com corp.example.com`, `domain example.com`,
/// `options timeout:2 attempts:3 rotate`, `options edns0 trust-ad`,
/// `sortlist 130.155.160.0/255.255.240.0 130.155.0.0`. Optional `#` or `;`
/// comment. Bare / prose / incomplete / neighbouring families (hosts,
/// named `options {`, syslog-ng `options {`, …) stay out.
fn is_resolv_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    let cut = s
        .find('#')
        .into_iter()
        .chain(s.find(';'))
        .min()
        .unwrap_or(s.len());
    let body = s[..cut].trim();
    if body.is_empty() {
        return false;
    }
    let mut fields = Vec::with_capacity(8);
    let mut rest = body;
    while fields.len() < 16 {
        let Some((tok, after)) = fstab_next_token(rest) else {
            break;
        };
        fields.push(tok);
        rest = after;
    }
    if !rest.trim_start().is_empty() {
        return false;
    }
    if fields.len() < 2 {
        return false;
    }
    let key = fields[0];
    let args = &fields[1..];
    match key {
        "nameserver" => args.len() == 1 && hosts_file_addr_ok(args[0]),
        "domain" => args.len() == 1 && hosts_file_name_ok(args[0]),
        "search" => !args.is_empty() && args.iter().all(|a| hosts_file_name_ok(a)),
        "options" => !args.is_empty() && args.iter().all(|a| resolv_option_ok(a)),
        "sortlist" => !args.is_empty() && args.iter().all(|a| resolv_sortlist_ok(a)),
        _ => false,
    }
}

fn resolv_option_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 64 {
        return false;
    }
    // named / syslog-ng brace openers stay out.
    if tok.contains('{') || tok.contains('}') || tok.contains('/') || tok.contains('=') {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    // `timeout:2`, `ndots:1`, `attempts:3`, `rotate`, `edns0`, `trust-ad`, …
    let (name, value) = match tok.split_once(':') {
        Some((n, v)) => (n, Some(v)),
        None => (tok, None),
    };
    if name.is_empty()
        || !name.as_bytes()[0].is_ascii_lowercase()
        || !name
            .bytes()
            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
    {
        return false;
    }
    if let Some(v) = value {
        if v.is_empty() || v.len() > 8 || !v.bytes().all(|b| b.is_ascii_digit()) {
            return false;
        }
    }
    true
}

fn resolv_sortlist_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 80 {
        return false;
    }
    let (addr, mask) = match tok.split_once('/') {
        Some((a, m)) => (a, Some(m)),
        None => (tok, None),
    };
    // sortlist is IPv4-oriented in resolv.conf.
    if !hosts_file_addr_ok(addr) || addr.contains(':') {
        return false;
    }
    match mask {
        None => true,
        Some(m) => {
            if m.is_empty() {
                return false;
            }
            // CIDR prefix length.
            if m.bytes().all(|b| b.is_ascii_digit()) {
                return m.parse::<u8>().map(|n| n <= 32).unwrap_or(false);
            }
            // Dotted netmask.
            hosts_file_addr_ok(m) && !m.contains(':')
        }
    }
}

/// `/etc/nsswitch.conf`: `passwd: files systemd`, `group: files systemd`,
/// `shadow: files`, `hosts: files dns`,
/// `hosts: mymachines resolve [!UNAVAIL=return] files myhostname dns`,
/// `networks: files`, `protocols: files`, `services: files`, `ethers: files`,
/// `rpc: files`, `netgroup: files`, `sudoers: files`. Optional `#` comment.
/// Bare / prose / incomplete / neighbouring families (hosts.allow `ALL:`,
/// access.conf, resolv.conf, …) stay out.
fn is_nsswitch_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((db, rest)) = body.split_once(':') else {
        return false;
    };
    let db = db.trim();
    if !nsswitch_database_ok(db) {
        return false;
    }
    let rest = rest.trim();
    if rest.is_empty() {
        return false;
    }
    let mut saw = false;
    let mut rem = rest;
    while let Some((tok, after)) = fstab_next_token(rem) {
        if tok.starts_with('[') {
            if !nsswitch_action_ok(tok) {
                return false;
            }
        } else if !nsswitch_service_ok(tok) {
            return false;
        }
        saw = true;
        rem = after;
    }
    saw && rem.trim_start().is_empty()
}

fn nsswitch_database_ok(db: &str) -> bool {
    matches!(
        db,
        "passwd"
            | "group"
            | "shadow"
            | "gshadow"
            | "hosts"
            | "networks"
            | "protocols"
            | "services"
            | "ethers"
            | "rpc"
            | "netgroup"
            | "aliases"
            | "automount"
            | "publickey"
            | "sudoers"
            | "initgroups"
    )
}

fn nsswitch_service_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 48 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| tok.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = tok.as_bytes();
    if !bytes[0].is_ascii_lowercase() {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'_' || b == b'-')
}

fn nsswitch_action_ok(tok: &str) -> bool {
    // `[SUCCESS=return]`, `[!UNAVAIL=return]`, `[NOTFOUND=continue]`, …
    if tok.len() < 5 || tok.len() > 40 || !tok.starts_with('[') || !tok.ends_with(']') {
        return false;
    }
    let inner = &tok[1..tok.len() - 1];
    let (status, action) = match inner.split_once('=') {
        Some((s, a)) => (s, a),
        None => return false,
    };
    let status = status.strip_prefix('!').unwrap_or(status);
    matches!(status, "SUCCESS" | "NOTFOUND" | "UNAVAIL" | "TRYAGAIN")
        && matches!(action, "return" | "continue" | "merge")
}

/// `/etc/passwd` / `/etc/group` / `/etc/shadow` / `/etc/gshadow`:
/// `root:x:0:0:root:/root:/bin/bash`,
/// `alice:x:1000:1000:Alice User,,,:/home/alice:/bin/zsh`,
/// `nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin`,
/// `sudo:x:27:alice,bob`, `docker:x:999:`, `root:x:0:`,
/// `root:$6$rounds=5000$saltsalt$…:19000:0:99999:7:::`,
/// `daemon:*:19000:0:99999:7:::`, `alice:!:19000:0:99999:7:::`,
/// `sudo:!:alice,bob:alice,bob`, `docker:!:alice:alice`, `root:*::`.
/// Optional `#` comment. Bare / prose / incomplete / neighbouring families
/// (nsswitch `passwd: files`, hosts.allow, …) stay out.
fn is_passwd_group_file_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // Colon fields only (passwd = 7, group/gshadow = 4, shadow = 9).
    // Do not use whitespace split.
    let parts: Vec<&str> = body.split(':').collect();
    match parts.len() {
        7 => {
            // name:password:UID:GID:GECOS:home:shell
            passwd_account_name_ok(parts[0])
                && passwd_password_ok(parts[1])
                && passwd_id_ok(parts[2])
                && passwd_id_ok(parts[3])
                && passwd_gecos_ok(parts[4])
                && passwd_path_field_ok(parts[5])
                && passwd_path_field_ok(parts[6])
        }
        9 => {
            // name:password:lastchg:min:max:warn:inactive:expire:flag
            passwd_account_name_ok(parts[0])
                && passwd_password_ok(parts[1])
                && passwd_shadow_num_ok(parts[2])
                && passwd_shadow_num_ok(parts[3])
                && passwd_shadow_num_ok(parts[4])
                && passwd_shadow_num_ok(parts[5])
                && passwd_shadow_num_ok(parts[6])
                && passwd_shadow_num_ok(parts[7])
                && passwd_shadow_num_ok(parts[8])
        }
        4 => {
            // group: name:password:GID:member,list
            // gshadow: name:password:admins:members
            if !(passwd_account_name_ok(parts[0])
                && passwd_password_ok(parts[1])
                && passwd_member_list_ok(parts[3]))
            {
                return false;
            }
            if passwd_id_ok(parts[2]) {
                true
            } else {
                passwd_member_list_ok(parts[2])
            }
        }
        _ => false,
    }
}

fn passwd_account_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 32 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| name.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = name.as_bytes();
    // POSIX-ish: start letter or `_`; then alnum / `_` / `-`.
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
}

fn passwd_password_ok(pw: &str) -> bool {
    // Common: `x`, `*`, `!`, `!!`, empty, or `$id$…` hash (shadow). No spaces / colons.
    pw.len() <= 256 && !pw.contains(' ') && !pw.contains(':')
}

fn passwd_id_ok(id: &str) -> bool {
    if id.is_empty() || id.len() > 10 {
        return false;
    }
    id.bytes().all(|b| b.is_ascii_digit())
}

fn passwd_shadow_num_ok(n: &str) -> bool {
    // Empty = default; else non-negative decimal (lastchg/min/max/warn/…).
    n.is_empty() || passwd_id_ok(n)
}

fn passwd_gecos_ok(gecos: &str) -> bool {
    // Free text without `:`; empty OK. Cap length.
    gecos.len() <= 256 && !gecos.contains(':')
}

fn passwd_path_field_ok(path: &str) -> bool {
    // Empty, `-`, or absolute path (home / shell).
    if path.is_empty() || path == "-" {
        return true;
    }
    if path.len() > 256 || !path.starts_with('/') || path.contains(' ') {
        return false;
    }
    path.bytes()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'/' | b'_' | b'-' | b'.' | b'+'))
}

fn passwd_member_list_ok(list: &str) -> bool {
    if list.is_empty() {
        return true;
    }
    if list.len() > 512 || list.contains(' ') {
        return false;
    }
    list.split(',').all(|m| {
        if m.is_empty() {
            return false;
        }
        passwd_account_name_ok(m)
    })
}

/// `/etc/subuid` / `/etc/subgid`: `alice:100000:65536`, `root:165536:65536`,
/// `user1:100000:65536`. Three colon fields: login name, subordinate UID/GID
/// start, count. Optional `#` comment. Bare / prose / incomplete /
/// neighbouring families (passwd / group / shadow / gshadow, …) stay out.
fn is_subuid_subgid_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let parts: Vec<&str> = body.split(':').collect();
    if parts.len() != 3 {
        return false;
    }
    passwd_account_name_ok(parts[0]) && passwd_id_ok(parts[1]) && passwd_id_ok(parts[2])
}

/// `/etc/sysctl.conf` / `sysctl.d/*.conf`: `net.ipv4.ip_forward = 1`,
/// `vm.swappiness=10`, `kernel.printk = 3 4 1 3`,
/// `fs.inotify.max_user_watches = 524288`, `user.max_user_namespaces = 15000`,
/// `-net.ipv4.conf.all.rp_filter = 1` (leading `-` = ignore missing key,
/// systemd.sysctl). Stock `/proc/sys` roots only (`abi` / `crypto` / `debug` /
/// `dev` / `fs` / `kernel` / `net` / `sunrpc` / `user.max_*` / `vm`). Optional
/// `#` comment. Bare / prose / undotted / git-style `user.name` /
/// neighbouring families (`PATH=…`, fstab, nsswitch, …) stay out.
fn is_sysctl_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let body = body.strip_prefix('-').unwrap_or(body).trim_start();
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    let value = body[eq + 1..].trim();
    if key.is_empty() || value.is_empty() {
        return false;
    }
    if !sysctl_key_ok(key) {
        return false;
    }
    sysctl_value_ok(value)
}

fn sysctl_key_ok(key: &str) -> bool {
    if key.len() > 128 || !key.contains('.') {
        return false;
    }
    let mut saw_dot = false;
    let mut seg_start = true;
    for b in key.bytes() {
        match b {
            b'.' => {
                if seg_start {
                    return false; // `..` or leading `.`
                }
                saw_dot = true;
                seg_start = true;
            }
            b if b.is_ascii_alphanumeric() || b == b'_' || b == b'-' => {
                seg_start = false;
            }
            _ => return false,
        }
    }
    if !saw_dot || seg_start {
        return false;
    }
    // Stock /proc/sys roots only. `user.*` is real (user.max_*), but keep
    // git-style `user.name` / `user.email` out.
    let mut parts = key.split('.');
    let Some(root) = parts.next() else {
        return false;
    };
    match root {
        "abi" | "crypto" | "debug" | "dev" | "fs" | "kernel" | "net" | "sunrpc" | "vm" => true,
        "user" => parts.next().is_some_and(|p| p.starts_with("max")),
        _ => false,
    }
}

fn sysctl_value_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 {
        return false;
    }
    // Numbers, tokens, paths, hostnames; no `#` (already stripped) / `=`.
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b' ' | b'.' | b'_' | b'-' | b'/' | b':' | b'+' | b'%' | b'@' | b',' | b'*'
            )
    })
}

/// `/etc/modprobe.d` / `modprobe.conf`: `alias char-major-10-175 thinkpad_acpi`,
/// `alias scsi_hostadapter aic7xxx`, `options snd_hda_intel index=0`,
/// `blacklist nouveau`, `blacklist usb_storage`,
/// `install snd-emu10k1 /sbin/modprobe --ignore-install snd-emu10k1 && …`,
/// `remove snd-emu10k1 /sbin/modprobe -r …`,
/// `softdep mlx4_core post: mlx4_en`, `softdep cifs pre: sha512`. Exact
/// lowercase commands (`alias` / `blacklist` / `install` / `remove` /
/// `options` / `softdep`). Optional `#` comment. Bare / prose / shell
/// `alias ls=…` / Crystal `alias Name =` / sysctl / neighbouring families
/// stay out.
fn is_modprobe_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((cmd, rest)) = fstab_next_token(body) else {
        return false;
    };
    match cmd {
        "alias" => modprobe_alias_ok(rest),
        "blacklist" => modprobe_blacklist_ok(rest),
        "options" => modprobe_options_ok(rest),
        "install" | "remove" => modprobe_install_remove_ok(rest),
        "softdep" => modprobe_softdep_ok(rest),
        _ => false,
    }
}

fn modprobe_module_ok(name: &str) -> bool {
    if name.len() < 2 || name.len() > 64 {
        return false;
    }
    // Reject English stopwords used in prose tests (`alias the team`).
    match name {
        "the" | "a" | "an" | "of" | "to" | "for" | "in" | "on" | "is" | "and" | "or" | "team"
        | "name" | "module" => return false,
        _ => {}
    }
    let bytes = name.as_bytes();
    if !bytes[0].is_ascii_alphabetic() && bytes[0] != b'_' {
        return false;
    }
    bytes[1..]
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
}

fn modprobe_alias_pattern_ok(pat: &str) -> bool {
    if pat.len() < 2 || pat.len() > 64 {
        return false;
    }
    match pat {
        "the" | "a" | "an" | "of" | "to" | "for" | "in" | "on" | "is" | "and" | "or" | "team" => {
            return false;
        }
        _ => {}
    }
    let bytes = pat.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() && bytes[0] != b'_' && bytes[0] != b'*' {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'*' | b'+' | b'?' | b'.'))
}

fn modprobe_alias_ok(rest: &str) -> bool {
    let Some((pat, after)) = fstab_next_token(rest) else {
        return false;
    };
    let Some((module, after2)) = fstab_next_token(after) else {
        return false;
    };
    if !after2.trim_start().is_empty() {
        return false;
    }
    // Shell `alias ls=…` / Crystal `alias Name = Type` stay out (`=` / quotes).
    if pat.contains('=') || module.contains('=') {
        return false;
    }
    modprobe_alias_pattern_ok(pat) && modprobe_module_ok(module)
}

fn modprobe_blacklist_ok(rest: &str) -> bool {
    let Some((module, after)) = fstab_next_token(rest) else {
        return false;
    };
    if !after.trim_start().is_empty() {
        return false;
    }
    modprobe_module_ok(module)
}

fn modprobe_options_ok(rest: &str) -> bool {
    let Some((module, after)) = fstab_next_token(rest) else {
        return false;
    };
    if !modprobe_module_ok(module) {
        return false;
    }
    // At least one option token (`index=0`, `debug`, …).
    let Some((opt, mut rem)) = fstab_next_token(after) else {
        return false;
    };
    if !modprobe_option_tok_ok(opt) {
        return false;
    }
    while let Some((tok, next)) = fstab_next_token(rem) {
        if !modprobe_option_tok_ok(tok) {
            return false;
        }
        rem = next;
    }
    true
}

fn modprobe_option_tok_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 128 {
        return false;
    }
    // `key=value`, bare flags, numbers; no shell metachar spam.
    tok.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'=' | b'_' | b'-' | b'.' | b':' | b',' | b'+' | b'/' | b'*' | b'%' | b'@'
            )
    })
}

fn modprobe_install_remove_ok(rest: &str) -> bool {
    let Some((module, after)) = fstab_next_token(rest) else {
        return false;
    };
    if !modprobe_module_ok(module) {
        return false;
    }
    // Need a command body (at least one more token).
    let Some((cmd0, mut rem)) = fstab_next_token(after) else {
        return false;
    };
    if !modprobe_cmd_tok_ok(cmd0) {
        return false;
    }
    while let Some((tok, next)) = fstab_next_token(rem) {
        if !modprobe_cmd_tok_ok(tok) {
            return false;
        }
        rem = next;
    }
    true
}

fn modprobe_cmd_tok_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 256 {
        return false;
    }
    // Paths, flags, `&&`, module names; keep `#` out (already stripped).
    tok.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'/' | b'-'
                    | b'_'
                    | b'.'
                    | b'='
                    | b':'
                    | b','
                    | b'+'
                    | b'*'
                    | b'%'
                    | b'@'
                    | b'&'
                    | b'|'
                    | b';'
                    | b'\''
                    | b'"'
                    | b'('
                    | b')'
                    | b'['
                    | b']'
                    | b'{'
                    | b'}'
                    | b'$'
                    | b'!'
                    | b'?'
                    | b'~'
            )
    })
}

fn modprobe_softdep_ok(rest: &str) -> bool {
    let Some((module, after)) = fstab_next_token(rest) else {
        return false;
    };
    if !modprobe_module_ok(module) {
        return false;
    }
    let mut rem = after;
    let mut saw_dep = false;
    while let Some((tok, next)) = fstab_next_token(rem) {
        if tok == "pre:" || tok == "post:" {
            saw_dep = true;
            rem = next;
            // At least one module after pre:/post:.
            let Some((dep, after_dep)) = fstab_next_token(rem) else {
                return false;
            };
            if !modprobe_module_ok(dep) {
                return false;
            }
            rem = after_dep;
            while let Some((more, after_more)) = fstab_next_token(rem) {
                if more == "pre:" || more == "post:" {
                    break;
                }
                if !modprobe_module_ok(more) {
                    return false;
                }
                rem = after_more;
            }
            continue;
        }
        return false;
    }
    saw_dep
}

/// systemd `tmpfiles.d` / `tmpfiles.d/*.conf`: `d /run/user 0755 root root -`,
/// `f /etc/hostname - - - -`, `L /etc/os-release - - - - /usr/lib/os-release`,
/// `L+ /run/lock - - - -`, `C /etc/pam.d - - - -`, `z /home 0755 - - -`,
/// `Z /var/lib/machines 0700 - - -`, `e /var/cache - - - -`,
/// `x /tmp/.X11-unix - - - -`, `X /dev - - - -`, `r! /tmp/foo - - - -`,
/// `R /tmp/bar - - - -`, `w /etc/motd - - - - Hello`, `p /run/fifo 0660 root root -`,
/// `c /dev/mynode 0660 root root - 1:2`, `b /dev/myblock 0660 root root - 8:0`,
/// `v /var/lib/machines/foo - - - -`, `q /var/lib/machines/bar - - - -`,
/// `Q /var/lib/machines/baz - - - -`, `a+ /home/user - - - - u::rwx`,
/// `h /srv/www - - - - +i`, `t /var/lib/foo - - - - security.selinux=…`.
/// Type letter (+ optional `+` / `-` / `=` / `~` / `^` / `!` modifiers) then
/// absolute path; Mode/User/Group/Age/Argument optional. Optional `#` / `;`
/// comment. Bare / prose / incomplete / neighbouring families (modprobe,
/// fstab, …) stay out.
fn is_tmpfiles_d_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else if let Some(semi) = s.find(';') {
        // Trailing `; comment` only when preceded by whitespace (paths rarely
        // embed `;`; keep simple).
        let before = &s[..semi];
        if before.ends_with(|c: char| c.is_whitespace()) {
            before.trim()
        } else {
            s.trim()
        }
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((ty, rest)) = fstab_next_token(body) else {
        return false;
    };
    if !tmpfiles_type_ok(ty) {
        return false;
    }
    let Some((path, after_path)) = fstab_next_token(rest) else {
        return false;
    };
    if !tmpfiles_path_ok(path) {
        return false;
    }
    // Optional Mode User Group Age Argument (0–5 more tokens).
    let mut rem = after_path;
    let mut n = 0usize;
    while let Some((tok, next)) = fstab_next_token(rem) {
        n += 1;
        if n > 5 {
            return false;
        }
        if !tmpfiles_field_ok(tok, n) {
            return false;
        }
        rem = next;
    }
    true
}

fn tmpfiles_type_ok(ty: &str) -> bool {
    if ty.is_empty() || ty.len() > 8 {
        return false;
    }
    let bytes = ty.as_bytes();
    let letter = bytes[0];
    // Stock type letters (systemd.tmpfiles).
    if !matches!(
        letter,
        b'f' | b'F'
            | b'w'
            | b'd'
            | b'D'
            | b'e'
            | b'v'
            | b'q'
            | b'Q'
            | b'p'
            | b'L'
            | b'c'
            | b'b'
            | b'C'
            | b'x'
            | b'X'
            | b'r'
            | b'R'
            | b'z'
            | b'Z'
            | b't'
            | b'h'
            | b'a'
            | b'A'
    ) {
        return false;
    }
    bytes[1..]
        .iter()
        .all(|b| matches!(b, b'+' | b'-' | b'=' | b'~' | b'^' | b'!'))
}

fn tmpfiles_path_ok(path: &str) -> bool {
    if path.len() < 2 || path.len() > 512 {
        return false;
    }
    // Absolute path only (`/run/user`, `/tmp/.X11-unix`).
    if !path.starts_with('/') {
        return false;
    }
    // Reject prose stopwords as a lone path segment.
    if path == "/the" || path == "/a" || path == "/an" || path == "/of" || path == "/to" {
        return false;
    }
    path.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'/' | b'.' | b'_' | b'-' | b'+' | b'%' | b'@' | b',' | b'~' | b':' | b'='
            )
    })
}

fn tmpfiles_field_ok(tok: &str, field_n: usize) -> bool {
    if tok.is_empty() || tok.len() > 512 {
        return false;
    }
    // Mode (1): octal or `-`.
    if field_n == 1 {
        if tok == "-" {
            return true;
        }
        return tok.len() <= 5 && tok.bytes().all(|b| matches!(b, b'0'..=b'7')) && !tok.is_empty();
    }
    // User / Group (2 / 3): name, numeric id, or `-`.
    if field_n == 2 || field_n == 3 {
        if tok == "-" {
            return true;
        }
        if tok.bytes().all(|b| b.is_ascii_digit()) && tok.len() <= 10 {
            return true;
        }
        let bytes = tok.as_bytes();
        if bytes.is_empty() {
            return false;
        }
        if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
            return false;
        }
        return bytes[1..]
            .iter()
            .all(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-');
    }
    // Age (4): `-`, `10d`, `1h`, `30s`, `…`.
    if field_n == 4 {
        if tok == "-" {
            return true;
        }
        return tok
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b':' | b'+'));
    }
    // Argument (5): path, content, major:minor, ACL, attr, …
    tok.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'/' | b'.'
                    | b'_'
                    | b'-'
                    | b'+'
                    | b'%'
                    | b'@'
                    | b','
                    | b'~'
                    | b':'
                    | b'='
                    | b'"'
                    | b'\''
                    | b'\\'
                    | b'*'
                    | b'?'
                    | b'!'
                    | b'^'
                    | b'('
                    | b')'
                    | b'['
                    | b']'
                    | b'{'
                    | b'}'
                    | b';'
                    | b'|'
                    | b'&'
                    | b'$'
                    | b'#'
                    | b' '
            )
    })
}

/// systemd `sysusers.d` / `sysusers.d/*.conf`: `u httpd 404 "HTTP User"`,
/// `u! alpm - "Arch Linux Package Management" -`, `u root 0:0 "Super User" /root`,
/// `g input - - -`, `m cups lp`, `r - 500-999`. Types `u` / `u!` / `g` / `m` / `r`;
/// Name + ID required; optional GECOS (quoted ok) / Home / Shell. Optional `#` /
/// `;` comment. Bare / prose / incomplete / neighbouring families (tmpfiles,
/// passwd, …) stay out.
fn is_sysusers_d_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else if let Some(semi) = s.find(';') {
        let before = &s[..semi];
        if before.ends_with(|c: char| c.is_whitespace()) {
            before.trim()
        } else {
            s.trim()
        }
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((ty, rest)) = sysusers_next_token(body) else {
        return false;
    };
    if !sysusers_type_ok(ty) {
        return false;
    }
    let Some((name, rest)) = sysusers_next_token(rest) else {
        return false;
    };
    if !sysusers_name_ok(ty, name) {
        return false;
    }
    let Some((id, rest)) = sysusers_next_token(rest) else {
        return false;
    };
    if !sysusers_id_ok(ty, id) {
        return false;
    }
    // Optional GECOS Home Shell (0–3 more tokens).
    let mut rem = rest;
    let mut n = 0usize;
    while let Some((tok, next)) = sysusers_next_token(rem) {
        n += 1;
        if n > 3 {
            return false;
        }
        if !sysusers_tail_ok(tok, n) {
            return false;
        }
        rem = next;
    }
    true
}

fn sysusers_next_token(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() {
        return None;
    }
    if s.as_bytes()[0] == b'"' {
        let rest = &s[1..];
        let end = rest.find('"')?;
        // Include surrounding quotes in the token.
        let tok = &s[..end + 2];
        return Some((tok, &s[end + 2..]));
    }
    fstab_next_token(s)
}

fn sysusers_type_ok(ty: &str) -> bool {
    matches!(ty, "u" | "u!" | "g" | "m" | "r")
}

fn sysusers_name_ok(ty: &str, name: &str) -> bool {
    if ty == "r" {
        return name == "-";
    }
    if name == "-" {
        // `u` / `g` / `m` need a real name.
        return false;
    }
    sysusers_ident_ok(name)
}

fn sysusers_ident_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note", "user",
    ];
    if PROSE.iter().any(|w| name.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphabetic() || bytes[0] == b'_') {
        return false;
    }
    bytes[1..]
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
}

fn sysusers_id_ok(ty: &str, id: &str) -> bool {
    if id.is_empty() || id.len() > 256 {
        return false;
    }
    match ty {
        "m" => sysusers_ident_ok(id),
        "r" => sysusers_range_ok(id),
        // u / u! / g: `-`, numeric, `uid:gid`, or absolute binary path.
        _ => {
            if id == "-" {
                return true;
            }
            if id.starts_with('/') {
                return tmpfiles_path_ok(id);
            }
            if let Some((a, b)) = id.split_once(':') {
                return sysusers_num_ok(a) && sysusers_num_ok(b);
            }
            sysusers_num_ok(id)
        }
    }
}

fn sysusers_num_ok(s: &str) -> bool {
    !s.is_empty() && s.len() <= 10 && s.bytes().all(|b| b.is_ascii_digit())
}

fn sysusers_range_ok(s: &str) -> bool {
    // `500-999` or `500-` (open-ended).
    let Some((a, b)) = s.split_once('-') else {
        return false;
    };
    if !sysusers_num_ok(a) {
        return false;
    }
    if b.is_empty() {
        return true;
    }
    sysusers_num_ok(b)
}

fn sysusers_tail_ok(tok: &str, field_n: usize) -> bool {
    if tok.is_empty() || tok.len() > 512 {
        return false;
    }
    // GECOS (1): `-`, quoted string, or single unquoted word.
    if field_n == 1 {
        if tok == "-" {
            return true;
        }
        if tok.starts_with('"') && tok.ends_with('"') && tok.len() >= 2 {
            let inner = &tok[1..tok.len() - 1];
            return inner.bytes().all(|b| {
                b.is_ascii() && b != b'"' && b != 0 && (b.is_ascii_graphic() || b == b' ')
            });
        }
        // Unquoted single-word GECOS (`-` already handled).
        return tok
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'+' | b'@'));
    }
    // Home (2) / Shell (3): `-`, `/`, or absolute path.
    if tok == "-" || tok == "/" {
        return true;
    }
    tmpfiles_path_ok(tok)
}

/// systemd `binfmt.d` / `binfmt.d/*.conf` register lines:
/// `:DOSWin:M::MZ::/usr/bin/wine:`, `:Python:E::py::/usr/bin/python:`,
/// `:qemu-i386:M::\x7fELF…:\xff…:/usr/bin/qemu-i386-static:OC`.
/// Format `:name:type:offset:magic:mask:interpreter:flags` (`type` = `M` /
/// `E`; offset/mask/flags may be empty; magic required; interpreter absolute).
/// Optional `#` / `;` comment. Bare / prose / incomplete / neighbouring
/// families (sysusers, tmpfiles, …) stay out.
fn is_binfmt_d_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else if let Some(semi) = s.find(';') {
        let before = &s[..semi];
        if before.ends_with(|c: char| c.is_whitespace()) {
            before.trim()
        } else {
            // `;` mid-token (unusual) — keep whole line.
            s.trim()
        }
    } else {
        s.trim()
    };
    if body.is_empty() || !body.starts_with(':') {
        return false;
    }
    // `:name:type:offset:magic:mask:interpreter[:flags]`
    let parts: Vec<&str> = body[1..].split(':').collect();
    if parts.len() < 6 || parts.len() > 7 {
        return false;
    }
    let name = parts[0];
    let ty = parts[1];
    let offset = parts[2];
    let magic = parts[3];
    let mask = parts[4];
    let interpreter = parts[5];
    let flags = if parts.len() == 7 { parts[6] } else { "" };

    if !binfmt_name_ok(name) {
        return false;
    }
    if ty != "M" && ty != "E" {
        return false;
    }
    if !binfmt_offset_ok(offset) {
        return false;
    }
    if !binfmt_magic_ok(magic) {
        return false;
    }
    if !mask.is_empty() && !binfmt_magic_ok(mask) {
        return false;
    }
    if !tmpfiles_path_ok(interpreter) {
        return false;
    }
    binfmt_flags_ok(flags)
}

fn binfmt_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note", "user",
    ];
    if PROSE.iter().any(|w| name.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = name.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || *b == b'_' || *b == b'-')
}

fn binfmt_offset_ok(offset: &str) -> bool {
    if offset.is_empty() {
        return true;
    }
    offset.len() <= 10 && offset.bytes().all(|b| b.is_ascii_digit())
}

fn binfmt_magic_ok(magic: &str) -> bool {
    if magic.is_empty() || magic.len() > 512 {
        return false;
    }
    // Printable ASCII / common escapes; no raw colon (field separator).
    magic
        .bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
        && !magic.contains(':')
}

fn binfmt_flags_ok(flags: &str) -> bool {
    if flags.is_empty() {
        return true;
    }
    if flags.len() > 4 {
        return false;
    }
    flags
        .bytes()
        .all(|b| matches!(b, b'P' | b'O' | b'C' | b'F'))
}

/// `/etc/services`: `ssh 22/tcp`, `http 80/tcp www www-http`, `domain 53/udp`,
/// `https 443/tcp`, `syslog 514/udp`. Name, `port/protocol` (`tcp` / `udp` /
/// `sctp` / `dccp`), optional aliases. Optional `#` comment. Bare / prose /
/// incomplete / neighbouring families (hosts, resolv, nsswitch, …) stay out.
fn is_services_file_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((name, rest)) = fstab_next_token(body) else {
        return false;
    };
    if !services_name_ok(name) {
        return false;
    }
    let Some((port_proto, rest)) = fstab_next_token(rest) else {
        return false;
    };
    if !services_port_proto_ok(port_proto) {
        return false;
    }
    // Optional aliases (same shape as service name).
    let mut rem = rest;
    while let Some((alias, next)) = fstab_next_token(rem) {
        if !services_name_ok(alias) {
            return false;
        }
        rem = next;
    }
    true
}

fn services_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note", "user",
    ];
    if PROSE.iter().any(|w| name.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = name.as_bytes();
    // IANA / services(5): start alnum; then alnum / `_` / `-` / `+`.
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'+'))
}

fn services_port_proto_ok(tok: &str) -> bool {
    let Some((port, proto)) = tok.split_once('/') else {
        return false;
    };
    if port.is_empty() || port.len() > 5 || !port.bytes().all(|b| b.is_ascii_digit()) {
        return false;
    }
    // Port 0–65535 (reject leading zeros of length >1 only loosely: 00080 ok as
    // numeric parse; keep digit-only and range check).
    let Ok(n) = port.parse::<u32>() else {
        return false;
    };
    if n > 65535 {
        return false;
    }
    matches!(
        proto.to_ascii_lowercase().as_str(),
        "tcp" | "udp" | "sctp" | "dccp"
    )
}

/// `/etc/protocols`: `ip 0 IP`, `icmp 1 ICMP`, `tcp 6 TCP`, `udp 17 UDP`,
/// `ipv6 41 IPv6`, `sctp 132 SCTP`, `ax.25 93 AX.25`. Name, protocol number
/// 0–255, optional aliases. Optional `#` comment. Bare / prose / incomplete /
/// neighbouring families (`/etc/services`, hosts, nsswitch, …) stay out.
fn is_protocols_file_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((name, rest)) = fstab_next_token(body) else {
        return false;
    };
    if !protocols_name_ok(name) {
        return false;
    }
    let Some((number, rest)) = fstab_next_token(rest) else {
        return false;
    };
    if !protocols_number_ok(number) {
        return false;
    }
    // Optional aliases (same shape as protocol name).
    let mut rem = rest;
    while let Some((alias, next)) = fstab_next_token(rem) {
        if !protocols_name_ok(alias) {
            return false;
        }
        rem = next;
    }
    true
}

fn protocols_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note", "user",
        // Agda fixity: `infix 4` must not look like protocols(5) `name number`.
        "infix", "infixl", "infixr",
    ];
    if PROSE.iter().any(|w| name.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = name.as_bytes();
    // protocols(5) / IANA: start alnum; then alnum / `_` / `-` / `+` / `.`
    // (`ax.25`, `ipv6-icmp`, `IP-ENCAP`).
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'+' | b'.'))
}

fn protocols_number_ok(tok: &str) -> bool {
    if tok.is_empty() || tok.len() > 3 || !tok.bytes().all(|b| b.is_ascii_digit()) {
        return false;
    }
    let Ok(n) = tok.parse::<u32>() else {
        return false;
    };
    n <= 255
}

/// `/etc/rpc`: `portmapper 100000 portmap sunrpc`, `nfs 100003 nfsprog`,
/// `ypbind 100007`, `x25.inr 100022`, `3270_mapper 100013`. Name, ONC RPC
/// program number **≥ 100000** (so `/etc/protocols` 0–255 stays on that path),
/// optional aliases. Optional `#` comment. Bare / prose / incomplete /
/// neighbouring families (`/etc/protocols`, `/etc/services`, hosts, nsswitch, …)
/// stay out.
fn is_rpc_file_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((name, rest)) = fstab_next_token(body) else {
        return false;
    };
    if !rpc_name_ok(name) {
        return false;
    }
    let Some((number, rest)) = fstab_next_token(rest) else {
        return false;
    };
    if !rpc_number_ok(number) {
        return false;
    }
    // Optional aliases (same shape as RPC name).
    let mut rem = rest;
    while let Some((alias, next)) = fstab_next_token(rem) {
        if !rpc_name_ok(alias) {
            return false;
        }
        rem = next;
    }
    true
}

fn rpc_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note", "user",
        // Agda fixity: `infix 4` must not look like rpc(5) `name number`.
        "infix", "infixl", "infixr",
    ];
    if PROSE.iter().any(|w| name.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = name.as_bytes();
    // rpc(5): start alnum; then alnum / `_` / `-` / `+` / `.` (`x25.inr`, `3270_mapper`).
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'+' | b'.'))
}

fn rpc_number_ok(tok: &str) -> bool {
    // Distinct from protocols(5) 0–255: classic `/etc/rpc` ONC numbers are
    // `100000`…. Cap at 10 digits / u32.
    if tok.is_empty() || tok.len() > 10 || !tok.bytes().all(|b| b.is_ascii_digit()) {
        return false;
    }
    let Ok(n) = tok.parse::<u32>() else {
        return false;
    };
    n >= 100_000
}

/// `/etc/ethers`: `08:00:20:0a:8c:6d basil`, `00-11-22-33-44-55 host`,
/// `aa:bb:cc:dd:ee:ff host.example.com alias`. Ethernet MAC (six hex octets,
/// `:` or `-` separator), then hostname (+ optional aliases). Optional `#`
/// comment. Bare / prose / incomplete / neighbouring families (`/etc/hosts`,
/// `/etc/rpc`, nsswitch, …) stay out. Distinct from hosts(5): MAC is 6 groups
/// (IPv6 needs 8 or `::`).
fn is_ethers_file_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((mac, rest)) = fstab_next_token(body) else {
        return false;
    };
    if !ethers_mac_ok(mac) {
        return false;
    }
    let Some((name, rest)) = fstab_next_token(rest) else {
        return false;
    };
    if !hosts_file_name_ok(name) {
        return false;
    }
    // Optional aliases (same hostname shape as hosts(5)).
    let mut rem = rest;
    while let Some((alias, next)) = fstab_next_token(rem) {
        if !hosts_file_name_ok(alias) {
            return false;
        }
        rem = next;
    }
    true
}

fn ethers_mac_ok(tok: &str) -> bool {
    // ethers(5): six hexadecimal numbers separated by `:`. Also accept `-`
    // (common on some hosts). Exactly one separator style; no mix. Length
    // 11–17 (`a:b:c:d:e:f` … `aa:bb:cc:dd:ee:ff`).
    if tok.is_empty() || tok.len() < 11 || tok.len() > 17 {
        return false;
    }
    let has_colon = tok.contains(':');
    let has_hyphen = tok.contains('-');
    if has_colon == has_hyphen {
        // Neither, or mixed.
        return false;
    }
    let sep = if has_colon { ':' } else { '-' };
    let parts: Vec<&str> = tok.split(sep).collect();
    if parts.len() != 6 {
        return false;
    }
    parts
        .iter()
        .all(|p| (1..=2).contains(&p.len()) && p.bytes().all(|b| b.is_ascii_hexdigit()))
}

/// `/etc/networks`: `default 0.0.0.0`, `loopback 127.0.0.0`,
/// `link-local 169.254.0.0`, `localnet 10.0.0.0 local`,
/// `mynet 192.168.1.0/24`. Name, dotted network number (optional `/prefix`
/// 0–32), optional aliases. Requires at least one `.` in the number so
/// `/etc/protocols` `name 0–255` stays on that path. Optional `#` comment.
/// Bare / prose / incomplete / neighbouring families stay out.
fn is_networks_file_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') {
        return false;
    }
    let body = if let Some(hash) = s.find('#') {
        s[..hash].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some((name, rest)) = fstab_next_token(body) else {
        return false;
    };
    if !networks_name_ok(name) {
        return false;
    }
    let Some((number, rest)) = fstab_next_token(rest) else {
        return false;
    };
    if !networks_number_ok(number) {
        return false;
    }
    // Optional aliases (same shape as network name).
    let mut rem = rest;
    while let Some((alias, next)) = fstab_next_token(rem) {
        if !networks_name_ok(alias) {
            return false;
        }
        rem = next;
    }
    true
}

fn networks_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the",
        "a",
        "an",
        "to",
        "of",
        "for",
        "and",
        "or",
        "is",
        "team",
        "note",
        "user",
        // Agda fixity / protocols-style prose guards.
        "infix",
        "infixl",
        "infixr",
        // resolv.conf keywords that look like `name dotted-addr`.
        "nameserver",
        "search",
        "domain",
        "options",
        "sortlist",
    ];
    if PROSE.iter().any(|w| name.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = name.as_bytes();
    // networks(5): start letter (not digit-led host/IP shapes); then alnum /
    // `_` / `-` / `+` / `.` (`link-local`, `localnet`).
    if !bytes[0].is_ascii_alphabetic() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'+' | b'.'))
}

fn networks_number_ok(tok: &str) -> bool {
    // Dotted network address, optional CIDR. Must contain `.` so plain
    // `loopback 127` stays on protocols(5) / classic simple-number path.
    if tok.is_empty() || tok.len() > 48 || !tok.contains('.') || tok.contains(':') {
        return false;
    }
    let (addr, prefix) = match tok.split_once('/') {
        Some((a, p)) => (a, Some(p)),
        None => (tok, None),
    };
    if addr.is_empty() || !addr.contains('.') {
        return false;
    }
    if let Some(p) = prefix {
        if p.is_empty() || p.len() > 2 || !p.bytes().all(|b| b.is_ascii_digit()) {
            return false;
        }
        let Ok(n) = p.parse::<u8>() else {
            return false;
        };
        if n > 32 {
            return false;
        }
    }
    let parts: Vec<&str> = addr.split('.').collect();
    // 2–4 dotted octets (Debian uses 4; allow shorter network forms).
    if !(2..=4).contains(&parts.len()) {
        return false;
    }
    parts.iter().all(|p| {
        if p.is_empty() || p.len() > 3 || !p.bytes().all(|b| b.is_ascii_digit()) {
            return false;
        }
        if p.len() > 1 && p.starts_with('0') {
            return false;
        }
        p.parse::<u16>().map(|n| n <= 255).unwrap_or(false)
    })
}

