            | "find_additional_modules"
            | "preserve_file_names"
            | "keep_names"
            | "logpush"
            | "keep_vars"
            | "send_metrics"
            | "jsx_factory"
            | "jsx_fragment"
            | "usage_model"
            | "base_dir"
            | "tsconfig"
            | "route"
    )
