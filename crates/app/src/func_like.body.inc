fn mise_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out.
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "experimental_monorepo_root"
            | "monorepo_root"
            | "not_found_auto_install"
            | "not_found_system_fallback"
            | "asdf_compat"
            | "always_keep_download"
            | "always_keep_install"
            | "activate_shims"
            | "activate_aggressive"
            | "legacy_version_file"
            | "use_versions_host"
            | "use_versions_host_track"
            | "use_file_shell_for_executable_tasks"
            | "windows_powershell_no_profile"
            | "exec_auto_install"
            | "env_shell_expand"
            | "env_cache"
            | "auto_update"
            | "auto_install"
            | "terminal_progress"
            | "tera_v1"
            | "lockfile"
            | "lockfile_auto_prune"
            | "idiomatic_version_file"
            | "github_attestations"
            | "gix"
            | "libgit2"
            | "netrc"
            | "offline"
            | "prefer_offline"
            | "paranoid"
            | "prereleases"
            | "slsa"
            | "auto_prune"
            | "binstall"
            | "binstall_only"
            | "binstall_quickinstall"
            | "uv_venv_auto"
            | "show_env"
            | "show_tools"
            | "baked_registry"
            | "cosign"
            | "minisign"
            | "deny_all"
            | "rust_cache"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(
        key,
        "allow_env"
            | "allow_net"
            | "allow_read"
            | "allow_write"
            | "deny_env"
            | "deny_net"
            | "deny_read"
            | "deny_write"
            | "pass_through_env"
            | "depends_post"
    ) {
        // Arrays stay out; a single quoted string is ok.
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare.len() <= 256
            && bare
                .bytes()
                .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t');
    }
    // Remaining keys: quoted strings (versions, durations, paths, task refs).
    if !(value.starts_with('"') || value.starts_with('\'')) {
        return false;
    }
    if bare.len() > 512 {
        return false;
    }
    if !bare
        .bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
    {
        return false;
    }
    if key == "system_deps" {
        return matches!(bare, "prompt" | "auto" | "never" | "yes" | "no")
            || bare.eq_ignore_ascii_case("true")
            || bare.eq_ignore_ascii_case("false");
    }
    if key == "missing_tools" {
        return matches!(
            bare,
            "if_other_versions_installed" | "always" | "never" | "true" | "false"
        );
    }
    if key == "lockfile_mode" {
        return matches!(bare, "auto" | "strict" | "off" | "soft" | "hard");
    }
    if key == "windows_shim_mode" {
        return matches!(bare, "exe" | "bat" | "symlink" | "hardlink");
    }
    true
}

/// Pixi `pixi.toml` (and `[tool.pixi.…]` in pyproject): `[workspace]` /
/// `[workspace.build-variants]` / `[workspace.conda-pypi-map]` /
/// `[workspace.exclude-newer]` / `[workspace.exclude-newer.exemptions]` /
/// `[workspace.dependencies]` / `[workspace.target.linux-64.build-variants]`,
/// `[activation]` / `[activation.env]`, `[pypi-dependencies]` /
/// `[pypi-options]`, `[system-requirements]`, `[constraints]`,
/// `[environments]` / `[environments.dev]` /
/// `[environments.dev.dependencies]`, `[feature.cuda]` /
/// `[feature.cuda.dependencies]` / `[feature.cuda.pypi-dependencies]` /
/// `[feature.cuda.tasks]` / `[feature.cuda.activation]` /
/// `[feature.cuda.pypi-options]` /
/// `[feature.cuda.target.osx-arm64.dependencies]`,
/// `[target.linux-64.dependencies]` / `[target.win-64.activation]` /
/// `[target.win-64.tasks]` / `[target.linux-64.activation.env]` /
/// `[target.win-64.constraints]` / `[target.win-64.build-dependencies]`,
/// `[package]` / `[package.build]` / `[package.build.config]` /
/// `[package.build.target.linux-64.config]` / `[package.run-exports]`,
/// `[tasks]` / `[dev]`, `[build-dependencies]` / `[host-dependencies]` /
/// `[run-dependencies]` / `[extra-dependencies]` / `[run-constraints]` /
/// `[run-exports]`, `channel-priority = "strict"` / `"flexible"` /
/// `"disabled"`, `solve-strategy = "highest"` / `"lowest"` /
/// `"lowest-direct"`, `requires-pixi = ">=0.40.0"`,
/// `exclude-newer = "2024-01-01"`, `index-strategy = "first-index"` /
/// `"unsafe-best-match"` / `"unsafe-first-match"`,
/// `prerelease-mode = "disallow"` / `"allow"` / `"if-necessary"` /
/// `"explicit"` / `"if-necessary-or-explicit"`,
/// `skip-wheel-filename-check = true`, `index-url = "https://…"`,
/// `pypi-exclude-newer = "7 days"`, `no-build = true`, `no-binary = true`,
/// `no-build-isolation = true`, `build-variants-files = "variants.yaml"`.
/// Exact Pixi keys (kebab-case). TOML `key = value` with spaces around `=`.
/// Optional `#` comment (quote-aware). Arrays (`channels = […]`,
/// `platforms = […]`, `extra-index-urls = […]`, `find-links = […]`,
/// `preview = […]`) / nested maps / free-form `[dependencies]` /
/// `[tasks]` / `[pypi-dependencies]` package entries (`python = "3.12"`,
/// `start = "python main.py"`) / `port = …` / prose / wrong case / mise /
/// supabase / samconfig / nixpacks / railway / fly / netlify / wrangler /
/// dioxus / uniffi / cbindgen / trunk / mutants / audit / cliff /
/// cargo-make / release.toml / Dist.toml / mdBook / taplo / typos /
/// bacon / Cross / rust-toolchain / cargo config / nextest / deny /
/// clippy / rustfmt / ruff / uv / bunfig / yarn / npmrc / pip /
/// Cargo.toml stay out.
fn is_pixi_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        // Stock pixi.toml has no `[[…]]` array-of-tables sections.
        if array {
            return false;
        }
        return pixi_toml_section_ok(header);
    }
    let body = pixi_toml_strip_comment(s);
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    if key.contains('.') {
        return false;
    }
    if !pixi_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    pixi_toml_value_ok(key, value)
}

fn pixi_toml_strip_comment(s: &str) -> &str {
    let mut in_single = false;
    let mut in_double = false;
    for (i, b) in s.bytes().enumerate() {
        match b {
            b'\'' if !in_double => in_single = !in_single,
            b'"' if !in_single => in_double = !in_double,
            b'#' | b';' if !in_single && !in_double => {
                return s[..i].trim_end();
            }
            _ => {}
        }
    }
    s.trim()
}

fn pixi_toml_section_ok(header: &str) -> bool {
    let parts: Vec<&str> = header.split('.').collect();
    if parts.is_empty() || parts.len() > 5 {
        return false;
    }
    match parts[0] {
        "activation" => match parts.len() {
            1 => true,
            2 => parts[1] == "env",
            _ => false,
        },
        "pypi-dependencies"
        | "pypi-options"
        | "system-requirements"
        | "constraints"
        | "tasks"
        | "dev"
        | "build-dependencies"
        | "host-dependencies"
        | "run-dependencies"
        | "extra-dependencies"
        | "run-constraints"
        | "run-exports" => parts.len() == 1,
        "environments" => match parts.len() {
            1 => true,
            2 => pixi_toml_name_ok(parts[1]),
            3 => pixi_toml_name_ok(parts[1]) && pixi_toml_env_leaf_ok(parts[2]),
            _ => false,
        },
        "feature" => match parts.len() {
            2 => pixi_toml_name_ok(parts[1]),
            3 => pixi_toml_name_ok(parts[1]) && pixi_toml_feature_leaf_ok(parts[2]),
            4 => {
                pixi_toml_name_ok(parts[1])
                    && parts[2] == "target"
                    && pixi_toml_platform_ok(parts[3])
            }
            5 => {
                pixi_toml_name_ok(parts[1])
                    && parts[2] == "target"
                    && pixi_toml_platform_ok(parts[3])
                    && pixi_toml_target_leaf_ok(parts[4])
            }
            _ => false,
        },
        "target" => match parts.len() {
            2 => pixi_toml_platform_ok(parts[1]),
            3 => pixi_toml_platform_ok(parts[1]) && pixi_toml_target_leaf_ok(parts[2]),
            4 => pixi_toml_platform_ok(parts[1]) && parts[2] == "activation" && parts[3] == "env",
            _ => false,
        },
        "workspace" => match parts.len() {
            1 => true,
            2 => matches!(
                parts[1],
                "build-variants"
                    | "conda-pypi-map"
                    | "exclude-newer"
                    | "dependencies"
                    | "pypi-dependencies"
                    | "pypi-options"
                    | "activation"
                    | "tasks"
                    | "system-requirements"
                    | "constraints"
            ),
            3 => match parts[1] {
                "exclude-newer" => parts[2] == "exemptions",
                "target" => pixi_toml_platform_ok(parts[2]),
                "activation" => parts[2] == "env",
                _ => false,
            },
            4 => {
                parts[1] == "target"
                    && pixi_toml_platform_ok(parts[2])
                    && matches!(parts[3], "build-variants" | "dependencies" | "activation")
            }
            _ => false,
        },
        "package" => match parts.len() {
            1 => true,
            2 => matches!(
                parts[1],
                "build"
                    | "run-exports"
                    | "build-dependencies"
                    | "host-dependencies"
                    | "run-dependencies"
                    | "run-constraints"
                    | "extra-dependencies"
            ),
            3 => parts[1] == "build" && matches!(parts[2], "config" | "target"),
            4 => parts[1] == "build" && parts[2] == "target" && pixi_toml_platform_ok(parts[3]),
            5 => {
                parts[1] == "build"
                    && parts[2] == "target"
                    && pixi_toml_platform_ok(parts[3])
                    && parts[4] == "config"
            }
            _ => false,
        },
        _ => false,
    }
}

fn pixi_toml_env_leaf_ok(name: &str) -> bool {
    matches!(
        name,
        "dependencies"
            | "pypi-dependencies"
            | "pypi-options"
            | "tasks"
            | "activation"
            | "system-requirements"
            | "constraints"
            | "features"
    )
}

fn pixi_toml_feature_leaf_ok(name: &str) -> bool {
    matches!(
        name,
        "dependencies"
            | "pypi-dependencies"
            | "pypi-options"
            | "tasks"
            | "activation"
            | "system-requirements"
            | "constraints"
            | "platforms"
            | "channels"
            | "target"
    )
}

fn pixi_toml_target_leaf_ok(name: &str) -> bool {
    matches!(
        name,
        "dependencies"
            | "pypi-dependencies"
            | "pypi-options"
            | "tasks"
            | "activation"
            | "system-requirements"
            | "constraints"
            | "build-dependencies"
            | "host-dependencies"
            | "run-dependencies"
            | "run-constraints"
            | "extra-dependencies"
            | "build-variants"
    )
}

fn pixi_toml_platform_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    matches!(
        name,
        "linux-64"
            | "linux-aarch64"
            | "linux-ppc64le"
            | "linux-armv7l"
            | "linux-s390x"
            | "osx-64"
            | "osx-arm64"
            | "win-64"
            | "win-arm64"
            | "linux"
            | "osx"
            | "win"
            | "unix"
            | "noarch"
            | "emscripten-wasm32"
            | "wasi-wasm32"
    ) || pixi_toml_name_ok(name)
}

fn pixi_toml_name_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    // Feature / environment names are lowercase kebab-case in stock pixi.toml.
    if !(bytes[0].is_ascii_lowercase() || bytes[0].is_ascii_digit() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(*b, b'-' | b'_'))
}

fn pixi_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        // Distinctive workspace / pypi-options / build keys (kebab-case).
        "channel-priority"
            | "solve-strategy"
            | "requires-pixi"
            | "exclude-newer"
            | "pypi-exclude-newer"
            | "index-strategy"
            | "prerelease-mode"
            | "skip-wheel-filename-check"
            | "index-url"
            | "no-build"
            | "no-binary"
            | "no-build-isolation"
            | "build-variants-files"
            // system-requirements scalars
            | "macos"
            | "linux"
            | "cuda"
            | "cudnn"
            | "libc"
            | "archspec"
    )
}

fn pixi_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out.
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "skip-wheel-filename-check" | "no-build" | "no-binary" | "no-build-isolation"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "channel-priority" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "strict" | "flexible" | "disabled");
    }
    if key == "solve-strategy" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "highest" | "lowest" | "lowest-direct");
    }
    if key == "index-strategy" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(
            bare,
            "first-index" | "unsafe-best-match" | "unsafe-first-match"
        );
    }
    if key == "prerelease-mode" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(
            bare,
            "disallow" | "allow" | "if-necessary" | "explicit" | "if-necessary-or-explicit"
        );
    }
    // Remaining keys: quoted strings (versions, URLs, timestamps, paths).
    if !(value.starts_with('"') || value.starts_with('\'')) {
        return false;
    }
    if bare.len() > 512 {
        return false;
    }
    bare.bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
}

/// Hatch `hatch.toml` (and `[tool.hatch.…]` in pyproject stripped to the
/// same shape when pasted as `envs.…` / `build.…`): `[envs.default]` /
/// `[envs.hatch-test]` / `[envs.coverage]` / `[envs.docs]` /
/// `[envs.default.scripts]` / `[envs.docs.env-vars]` /
/// `[envs.types.extra-scripts]` / `[envs.test.overrides]` /
/// `[[envs.test.matrix]]`, `[build]` / `[build.targets.wheel]` /
/// `[build.targets.sdist]` / `[build.targets.wheel.force-include]` /
/// `[build.targets.wheel.sources]` / `[build.hooks.custom]` /
/// `[build.targets.wheel.hooks.custom]`, `[version]`, `[publish.index]`,
/// `detached = true`, `skip-install = true`, `dev-mode = false`,
/// `locked = true`, `lock-envs = true`, `installer = "uv"` / `"pip"`,
/// `locker = "uv"` / `"pip"`, `lock-filename = "locks/test.lock"`,
/// `template = "default"`, `type = "virtual"` / `"container"`,
/// `config-path = "ruff_defaults.toml"`, `uv-path = "uv"`,
/// `system-packages = false`, `matrix-name-format = "{variable}_{value}"`,
/// `ignore-vcs = true`, `only-packages = true`, `dev-mode-exact = true`.
/// Exact Hatch keys (kebab-case). TOML `key = value` with spaces around `=`.
/// Optional `#` comment (quote-aware). Arrays (`dependencies = […]`,
/// `extra-dependencies = […]`, `features = […]`, `platforms = […]`,
/// `env-include = […]`) / nested maps / free-form `[envs.x.scripts]` /
/// `[envs.x.env-vars]` entries (`run = "pytest"`, `FOO = "bar"`) /
/// `python = "3.12"` / `path = "…"` / prose / wrong case / poetry / pixi /
/// mise / supabase / samconfig / nixpacks / railway / fly / netlify /
/// wrangler / dioxus / uniffi / cbindgen / trunk / mutants / audit /
/// cliff / cargo-make / release.toml / Dist.toml / mdBook / taplo /
/// typos / bacon / Cross / rust-toolchain / cargo config / nextest /
/// deny / clippy / rustfmt / ruff / uv / bunfig / yarn / npmrc / pip /
/// Cargo.toml stay out.
fn is_hatch_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        // Only `[[envs.name.matrix]]` uses array-of-tables in stock hatch.toml.
        if array {
            return hatch_toml_matrix_header_ok(header);
        }
        return hatch_toml_section_ok(header);
    }
    let body = hatch_toml_strip_comment(s);
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    if key.contains('.') {
        return false;
    }
    if !hatch_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    hatch_toml_value_ok(key, value)
}

fn hatch_toml_strip_comment(s: &str) -> &str {
    let mut in_single = false;
    let mut in_double = false;
    for (i, b) in s.bytes().enumerate() {
        match b {
            b'\'' if !in_double => in_single = !in_single,
            b'"' if !in_single => in_double = !in_double,
            b'#' | b';' if !in_single && !in_double => {
                return s[..i].trim_end();
            }
            _ => {}
        }
    }
    s.trim()
}

fn hatch_toml_matrix_header_ok(header: &str) -> bool {
    let parts: Vec<&str> = header.split('.').collect();
    parts.len() == 3 && parts[0] == "envs" && hatch_toml_name_ok(parts[1]) && parts[2] == "matrix"
}

fn hatch_toml_section_ok(header: &str) -> bool {
    let parts: Vec<&str> = header.split('.').collect();
    if parts.is_empty() || parts.len() > 5 {
        return false;
    }
    match parts[0] {
        "envs" => match parts.len() {
            2 => hatch_toml_name_ok(parts[1]),
            3 => {
                hatch_toml_name_ok(parts[1])
                    && matches!(
                        parts[2],
                        "scripts" | "env-vars" | "extra-scripts" | "overrides" | "matrix"
                    )
            }
            _ => false,
        },
        "build" => match parts.len() {
            1 => true,
            2 => matches!(parts[1], "targets" | "hooks"),
            3 => match parts[1] {
                "targets" => hatch_toml_target_ok(parts[2]),
                "hooks" => hatch_toml_name_ok(parts[2]),
                _ => false,
            },
            4 => {
                parts[1] == "targets"
                    && hatch_toml_target_ok(parts[2])
                    && matches!(parts[3], "force-include" | "sources" | "hooks")
            }
            5 => {
                parts[1] == "targets"
                    && hatch_toml_target_ok(parts[2])
                    && parts[3] == "hooks"
                    && hatch_toml_name_ok(parts[4])
            }
            _ => false,
        },
        "version" => parts.len() == 1,
        "publish" => match parts.len() {
            1 => true,
            2 => matches!(parts[1], "index" | "repo"),
            _ => false,
        },
        _ => false,
    }
}

fn hatch_toml_target_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    matches!(name, "wheel" | "sdist" | "app" | "zipapp") || hatch_toml_name_ok(name)
}

fn hatch_toml_name_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    // Env / hook / target names are lowercase kebab-case in stock hatch.toml.
    if !(bytes[0].is_ascii_lowercase() || bytes[0].is_ascii_digit() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(*b, b'-' | b'_'))
}

fn hatch_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        // Distinctive environment / build scalars (kebab-case).
        "detached"
            | "skip-install"
            | "dev-mode"
            | "locked"
            | "lock-envs"
            | "installer"
            | "locker"
            | "lock-filename"
            | "template"
            | "type"
            | "config-path"
            | "uv-path"
            | "system-packages"
            | "matrix-name-format"
            | "ignore-vcs"
            | "only-packages"
            | "dev-mode-exact"
    )
}

fn hatch_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out.
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "detached"
            | "skip-install"
            | "dev-mode"
            | "locked"
            | "lock-envs"
            | "system-packages"
            | "ignore-vcs"
            | "only-packages"
            | "dev-mode-exact"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "installer" || key == "locker" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "uv" | "pip");
    }
    if key == "type" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "virtual" | "container") || hatch_toml_name_ok(bare);
    }
    // Remaining keys: quoted strings (paths, templates, formats).
    if !(value.starts_with('"') || value.starts_with('\'')) {
        return false;
    }
    if bare.len() > 512 {
        return false;
    }
    bare.bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
}

/// Poetry local `poetry.toml` (project config, not `[tool.poetry]` in
/// pyproject): `[virtualenvs]` / `[virtualenvs.options]`, `[installer]`,
/// `[solver]`, `[experimental]`, `[warnings]`, `[keyring]`,
/// `[repositories.name]` / `[certificates.name]` / `[http-basic.name]`,
/// `in-project = true`, `prefer-active-python = true`,
/// `use-poetry-python = false`, `always-copy = false`,
/// `system-site-packages = false`, `no-pip = false`, `max-workers = 4`,
/// `no-binary = ":none:"`, `re-resolve = true`,
/// `system-git-client = false`, `lazy-wheel = true`, `export = false`,
/// `prompt = "{project_name}-py{python_version}"`,
/// `cert = "path/to/ca.pem"`, `client-cert = "path/to/client.pem"`.
/// Exact Poetry keys (kebab-case). TOML `key = value` with spaces around `=`.
/// Optional `#` comment (quote-aware). Arrays / nested maps / free-form
/// `[repositories]` package urls as bare `url = "…"` / `username = "…"` /
/// `password = "…"` / `create = true` / `path = "…"` / `parallel = true` /
/// `enabled = true` / prose / wrong case / hatch / pixi / mise / supabase /
/// samconfig / nixpacks / railway / fly / netlify / wrangler / dioxus /
/// uniffi / cbindgen / trunk / mutants / audit / cliff / cargo-make /
/// release.toml / Dist.toml / mdBook / taplo / typos / bacon / Cross /
/// rust-toolchain / cargo config / nextest / deny / clippy / rustfmt /
/// ruff / uv / bunfig / yarn / npmrc / pip / Cargo.toml / pyproject
/// `[tool.poetry]` stay out.
fn is_poetry_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || array || !tox_ini_tail_ok(after) {
            return false;
        }
        return poetry_toml_section_ok(header);
    }
    let body = hatch_toml_strip_comment(s);
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    if key.contains('.') {
        return false;
    }
    if !poetry_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    poetry_toml_value_ok(key, value)
}

fn poetry_toml_section_ok(header: &str) -> bool {
    let parts: Vec<&str> = header.split('.').collect();
    if parts.is_empty() || parts.len() > 2 {
        return false;
    }
    match parts[0] {
        "virtualenvs" => match parts.len() {
            1 => true,
            2 => parts[1] == "options",
            _ => false,
        },
        "installer" | "solver" | "experimental" | "warnings" | "keyring" => parts.len() == 1,
        "repositories" | "certificates" | "http-basic" => {
            parts.len() == 2 && poetry_toml_name_ok(parts[1])
        }
        _ => false,
    }
}

fn poetry_toml_name_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    // Repo / cert / http-basic names are lowercase kebab/snake in stock poetry.toml.
    if !(bytes[0].is_ascii_lowercase() || bytes[0].is_ascii_digit() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(*b, b'-' | b'_'))
}

fn poetry_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        // Distinctive poetry.toml scalars (kebab-case). Skip generic
        // `create` / `path` / `url` / `parallel` / `enabled` / `username` /
        // `password` so neighbouring formats and secrets stay out.
        "in-project"
            | "prefer-active-python"
            | "use-poetry-python"
            | "always-copy"
            | "system-site-packages"
            | "no-pip"
            | "max-workers"
            | "no-binary"
            | "re-resolve"
            | "system-git-client"
            | "lazy-wheel"
            | "export"
            | "prompt"
            | "cert"
            | "client-cert"
    )
}

fn poetry_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out.
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "in-project"
            | "prefer-active-python"
            | "use-poetry-python"
            | "always-copy"
            | "system-site-packages"
            | "no-pip"
            | "re-resolve"
            | "system-git-client"
            | "lazy-wheel"
            | "export"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "max-workers" {
        // Bare unsigned integer only (not quoted).
        if value.starts_with('"') || value.starts_with('\'') {
            return false;
        }
        return bare.bytes().all(|b| b.is_ascii_digit()) && bare.len() <= 4;
    }
    // Remaining keys: quoted strings (paths, prompts, no-binary markers).
    if !(value.starts_with('"') || value.starts_with('\'')) {
        return false;
    }
    if bare.len() > 512 {
        return false;
    }
    bare.bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
}

