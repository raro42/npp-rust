/// CUDA `__global__ void saxpy(`, `__device__ float add(`,
/// `__host__ __device__ inline float clamp(`, `__shared__ float tile[64];`,
/// `__constant__ float coeffs[8];`, `__managed__ int counter;`,
/// `__device__ float *dev_ptr;`. Optional `__forceinline__` / `__noinline__`.
/// Prose and bare keywords stay out. Plain `void main(` / `struct` stay on
/// the generic / typed-fn paths. GLSL `shared` / HLSL `groupshared` stay on
/// their paths.
fn is_cuda_decl(s: &str) -> bool {
    is_cuda_storage(s) || is_cuda_exec(s)
}

fn is_cuda_storage(s: &str) -> bool {
    for key in ["__shared__", "__constant__", "__managed__"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        return is_cuda_typed_var(rest.trim_start());
    }
    false
}

fn is_cuda_exec(s: &str) -> bool {
    let mut rest = s;
    let mut saw_exec = false;
    let mut saw_device = false;
    let mut saw_global = false;
    for _ in 0..8 {
        let mut stripped = false;
        for q in [
            "__forceinline__",
            "__noinline__",
            "__global__",
            "__device__",
            "__host__",
        ] {
            let Some(after) = sql_word(rest, q) else {
                continue;
            };
            if !(after.is_empty() || after.starts_with(char::is_whitespace)) {
                continue;
            }
            rest = after.trim_start();
            match q {
                "__global__" => {
                    saw_exec = true;
                    saw_global = true;
                }
                "__device__" => {
                    saw_exec = true;
                    saw_device = true;
                }
                "__host__" => {
                    saw_exec = true;
                }
                _ => {}
            }
            stripped = true;
            break;
        }
        if !stripped {
            break;
        }
    }
    if !saw_exec || rest.is_empty() {
        return false;
    }
    if is_typed_fn_decl(rest) {
        return true;
    }
    // `__device__ float x;` device variables; not `__global__` / host-only.
    if saw_device && !saw_global {
        return is_cuda_typed_var(rest);
    }
    false
}

/// `float tile[64];`, `float *dev_ptr;`, `int counter;`. Rejects prose
/// (`float the tile`) via type-name rules and incomplete tails.
fn is_cuda_typed_var(s: &str) -> bool {
    let Some((ty, after_ty)) = graphql_ident(s) else {
        return false;
    };
    if !cuda_type_name_ok(ty) {
        return false;
    }
    let after_ty = if after_ty.starts_with('<') {
        let Some(after) = after_balanced_angles(after_ty) else {
            return false;
        };
        after
    } else {
        after_ty
    };
    // `float *dev;` / `float** ptr;` / `float * * ptr;`
    let name_src = after_ty
        .trim_start()
        .trim_start_matches(['*', '&'])
        .trim_start();
    if name_src.is_empty() {
        return false;
    }
    let Some((_name, after)) = graphql_ident(name_src) else {
        return false;
    };
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with(';')
        || after.starts_with('[')
        || after.starts_with('=')
        || after.starts_with(',')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// CUDA / C scalar builtins, or a Capitalized / `_`-prefixed user type.
/// Rejects prose like `__shared__ the memory`.
fn cuda_type_name_ok(ty: &str) -> bool {
    if ty.is_empty() {
        return false;
    }
    let b0 = ty.as_bytes()[0];
    if b0 == b'_' || b0.is_ascii_uppercase() {
        return true;
    }
    matches!(
        ty.to_ascii_lowercase().as_str(),
        "void"
            | "bool"
            | "char"
            | "short"
            | "int"
            | "long"
            | "float"
            | "double"
            | "size_t"
            | "ptrdiff_t"
            | "intptr_t"
            | "uintptr_t"
            | "int8_t"
            | "int16_t"
            | "int32_t"
            | "int64_t"
            | "uint8_t"
            | "uint16_t"
            | "uint32_t"
            | "uint64_t"
            | "uchar"
            | "ushort"
            | "uint"
            | "ulong"
            | "dim3"
            | "cudaError_t"
            | "cudaStream_t"
            | "cudaEvent_t"
    )
}

/// OpenCL `__kernel void add(`, `kernel void saxpy(`,
/// `__constant float coeffs[8];`, `__local float tile[64];`,
/// `__global float *buf;`, `__private int scratch;`.
/// Distinct from CUDA `__global__` / `__constant__` (reject trailing `_`).
/// Optional leading `static` / `inline`. Prose and bare keywords stay out.
fn is_opencl_decl(s: &str) -> bool {
    is_opencl_storage(s) || is_opencl_kernel(s)
}

fn is_opencl_storage(s: &str) -> bool {
    for key in ["__global", "__local", "__constant", "__private"] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        // CUDA uses `__global__` / `__constant__`; do not steal those.
        if rest.starts_with('_') {
            continue;
        }
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        // Optional C type qualifiers between address space and type.
        let rest = strip_opencl_type_quals(rest);
        return is_opencl_typed_var(rest);
    }
    false
}

fn is_opencl_kernel(s: &str) -> bool {
    let mut rest = s;
    for _ in 0..4 {
        let mut stripped = false;
        for q in ["static", "inline", "__inline__"] {
            let Some(after) = sql_word(rest, q) else {
                continue;
            };
            if !(after.is_empty() || after.starts_with(char::is_whitespace)) {
                continue;
            }
            rest = after.trim_start();
            stripped = true;
            break;
        }
        if !stripped {
            break;
        }
    }
    let after_kernel = if let Some(after) = sql_word(rest, "__kernel") {
        if after.starts_with('_') {
            return false;
        }
        if !(after.is_empty() || after.starts_with(char::is_whitespace)) {
            return false;
        }
        after.trim_start()
    } else if let Some(after) = sql_word(rest, "kernel") {
        // Bare OpenCL 2.0 / Metal-style `kernel`; need whitespace then typed fn.
        if !after.starts_with(char::is_whitespace) {
            return false;
        }
        after.trim_start()
    } else {
        return false;
    };
    if after_kernel.is_empty() {
        return false;
    }
    // Optional extra address-space / inline after kernel keyword.
    let mut rest = after_kernel;
    for _ in 0..4 {
        let mut stripped = false;
        for q in [
            "static",
            "inline",
            "__inline__",
            "__global",
            "__local",
            "__constant",
            "__private",
        ] {
            let Some(after) = sql_word(rest, q) else {
                continue;
            };
            if after.starts_with('_')
                && matches!(q, "__global" | "__local" | "__constant" | "__private")
            {
                continue;
            }
            if !(after.is_empty() || after.starts_with(char::is_whitespace)) {
                continue;
            }
            rest = after.trim_start();
            stripped = true;
            break;
        }
        if !stripped {
            break;
        }
    }
    is_typed_fn_decl(rest)
}

fn strip_opencl_type_quals(s: &str) -> &str {
    let mut rest = s;
    for _ in 0..4 {
        let mut stripped = false;
        for q in [
            "const",
            "volatile",
            "restrict",
            "read_only",
            "write_only",
            "read_write",
        ] {
            let Some(after) = sql_word(rest, q) else {
                continue;
            };
            if !after.starts_with(char::is_whitespace) {
                continue;
            }
            rest = after.trim_start();
            stripped = true;
            break;
        }
        if !stripped {
            break;
        }
    }
    rest
}

fn is_opencl_typed_var(s: &str) -> bool {
    let Some((ty, after_ty)) = graphql_ident(s) else {
        return false;
    };
    if !opencl_type_name_ok(ty) {
        return false;
    }
    let after_ty = if after_ty.starts_with('<') {
        let Some(after) = after_balanced_angles(after_ty) else {
            return false;
        };
        after
    } else {
        after_ty
    };
    let name_src = after_ty
        .trim_start()
        .trim_start_matches(['*', '&'])
        .trim_start();
    if name_src.is_empty() {
        return false;
    }
    let Some((_name, after)) = graphql_ident(name_src) else {
        return false;
    };
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with(';')
        || after.starts_with('[')
        || after.starts_with('=')
        || after.starts_with(',')
        || after.starts_with("//")
        || after.starts_with("/*")
}

/// OpenCL / C scalars, vector types (`float4`), image/sampler types, or a
/// Capitalized / `_`-prefixed user type. Rejects prose like `__local the tile`.
fn opencl_type_name_ok(ty: &str) -> bool {
    if cuda_type_name_ok(ty) {
        return true;
    }
    let lower = ty.to_ascii_lowercase();
    matches!(
        lower.as_str(),
        "half"
            | "image2d_t"
            | "image3d_t"
            | "image2d_array_t"
            | "image1d_t"
            | "image1d_buffer_t"
            | "image1d_array_t"
            | "image2d_depth_t"
            | "image2d_array_depth_t"
            | "sampler_t"
            | "event_t"
            | "queue_t"
            | "clk_event_t"
            | "ndrange_t"
            | "reserve_id_t"
            | "cl_mem"
    ) || opencl_vector_type(&lower)
}

fn opencl_vector_type(lower: &str) -> bool {
    for base in [
        "char", "uchar", "short", "ushort", "int", "uint", "long", "ulong", "float", "double",
        "half",
    ] {
        if let Some(n) = lower.strip_prefix(base) {
            if matches!(n, "2" | "3" | "4" | "8" | "16") {
                return true;
            }
        }
    }
    false
}

/// Metal Shading Language `vertex float4 main(`, `fragment half4 main(`,
/// `kernel void compute(`, plus address-space storage
/// (`device float *buf;`, `constant float coeffs[8];`,
/// `threadgroup float tile[64];`, `thread float scratch;`,
/// `threadgroup_imageblock float4 block;`) and texture / sampler
/// resources (`texture2d<float> color;`, `sampler samp;`,
/// `depth2d<float> depthTex;`). Optional leading `static` / `inline`.
/// Bare `kernel` also matches OpenCL. Prose and bare keywords stay out.
/// `[[vertex]] float4 main(` strips via annotations then typed-fn.
fn is_metal_decl(s: &str) -> bool {
    is_metal_stage(s) || is_metal_storage(s) || is_metal_resource(s)
}

fn is_metal_stage(s: &str) -> bool {
    let mut rest = s;
    for _ in 0..4 {
        let mut stripped = false;
        for q in ["static", "inline", "__inline__"] {
            let Some(after) = sql_word(rest, q) else {
                continue;
            };
            if !(after.is_empty() || after.starts_with(char::is_whitespace)) {
                continue;
            }
            rest = after.trim_start();
            stripped = true;
            break;
        }
        if !stripped {
            break;
        }
    }
    for stage in ["vertex", "fragment", "kernel"] {
        let Some(after) = sql_word(rest, stage) else {
            continue;
        };
        if !after.starts_with(char::is_whitespace) {
            continue;
        }
        let after = after.trim_start();
        if after.is_empty() {
            return false;
        }
        return is_typed_fn_decl(after);
    }
    false
}

fn is_metal_storage(s: &str) -> bool {
    for key in [
        "threadgroup_imageblock",
        "threadgroup",
        "device",
        "constant",
        "thread",
    ] {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = strip_metal_type_quals(rest.trim_start());
        return is_metal_typed_var(rest);
    }
    false
}

fn strip_metal_type_quals(s: &str) -> &str {
    let mut rest = s;
    for _ in 0..4 {
        let mut stripped = false;
        for q in ["const", "volatile", "restrict"] {
            let Some(after) = sql_word(rest, q) else {
                continue;
            };
            if !after.starts_with(char::is_whitespace) {
                continue;
            }
            rest = after.trim_start();
            stripped = true;
            break;
        }
        if !stripped {
            break;
        }
    }
    rest
}

fn is_metal_typed_var(s: &str) -> bool {
    let Some((ty, after_ty)) = graphql_ident(s) else {
        return false;
    };
    if !metal_type_name_ok(ty) {
        return false;
    }
    let after_ty = if after_ty.starts_with('<') {
        let Some(after) = after_balanced_angles(after_ty) else {
            return false;
        };
        after
    } else {
        after_ty
    };
    let name_src = after_ty
        .trim_start()
        .trim_start_matches(['*', '&'])
        .trim_start();
    if name_src.is_empty() {
        return false;
    }
    let Some((_name, after)) = graphql_ident(name_src) else {
        return false;
    };
    let after = after.trim_start();
    after.is_empty()
        || after.starts_with(';')
        || after.starts_with('[')
        || after.starts_with('=')
        || after.starts_with(',')
        || after.starts_with("//")
        || after.starts_with("/*")
}

const METAL_RESOURCE_TYPES: &[&str] = &[
    "texture2d_array",
    "texturecube_array",
    "texture1d_array",
    "texture2d_ms",
    "depth2d_array",
    "depthcube",
    "texture3d",
    "texture2d",
    "texture1d",
    "texturecube",
    "texturebuffer",
    "depth2d",
    "sampler",
];

fn is_metal_resource(s: &str) -> bool {
    for key in METAL_RESOURCE_TYPES {
        let Some(rest) = sql_word(s, key) else {
            continue;
        };
        let rest = if rest.starts_with('<') {
            let Some(after) = after_balanced_angles(rest) else {
                return false;
            };
            after
        } else if rest.starts_with(char::is_whitespace) {
            rest
        } else {
            continue;
        };
        let rest = rest.trim_start();
        let Some((_name, after)) = graphql_ident(rest) else {
            return false;
