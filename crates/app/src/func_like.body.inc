    }
    if key == "sort_by" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "Name" | "None");
    }
    if key == "args" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "auto" | "horizontal" | "vertical");
    }
    if matches!(
        key,
        "rename_args" | "rename_fields" | "rename_variants" | "rename_associated_constant"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(
            bare,
            "None"
                | "CamelCase"
                | "PascalCase"
                | "SnakeCase"
                | "ScreamingSnakeCase"
                | "GeckoCase"
                | "LowerCase"
                | "UpperCase"
                | "QualifiedScreamingSnakeCase"
        );
    }
    if matches!(
        key,
        "header"
            | "trailer"
            | "include_guard"
            | "autogen_warning"
            | "namespace"
            | "after_includes"
            | "prefix"
            | "packed"
            | "aligned_n"
            | "must_use"
            | "deprecated"
            | "deprecated_with_note"
            | "deprecated_variant"
            | "deprecated_variant_with_note"
            | "no_return"
            | "postfix"
