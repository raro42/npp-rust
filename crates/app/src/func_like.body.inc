fn wrangler_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (compatibility_flags = […], …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "workers_dev"
            | "preview_urls"
            | "no_bundle"
            | "find_additional_modules"
            | "preserve_file_names"
            | "keep_names"
            | "logpush"
            | "keep_vars"
            | "send_metrics"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "usage_model" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "bundled" | "unbound");
    }
    if key == "compatibility_date" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return wrangler_toml_compat_date_ok(bare);
    }
    if key == "name" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return wrangler_toml_worker_name_ok(bare);
    }
    if matches!(
        key,
        "main" | "account_id" | "jsx_factory" | "jsx_fragment" | "base_dir" | "tsconfig" | "route"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 512 {
            return false;
        }
        // Paths / ids / factories / routes: graphic ASCII + space/tab.
        if !bare
            .bytes()
            .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
        {
            return false;
        }
        if key == "main" {
            // Entrypoint path cue (slash and/or JS/TS suffix).
            let lower = bare.to_ascii_lowercase();
            return bare.contains('/')
                || lower.ends_with(".js")
                || lower.ends_with(".mjs")
                || lower.ends_with(".cjs")
                || lower.ends_with(".ts")
                || lower.ends_with(".tsx")
                || lower.ends_with(".jsx");
        }
        if key == "route" {
            // Pattern cue: slash, `*`, or a dotted hostname.
            return bare.contains('/') || bare.contains('*') || bare.contains('.');
        }
        if key == "account_id" {
            // Cloudflare account ids are hex-like; keep graphic ASCII.
            return bare.len() >= 8
                && bare
                    .bytes()
                    .all(|b| b.is_ascii_hexdigit() || b.is_ascii_alphanumeric());
        }
        return true;
    }
    false
}

fn wrangler_toml_compat_date_ok(s: &str) -> bool {
    // yyyy-mm-dd
    let bytes = s.as_bytes();
    if bytes.len() != 10 || bytes[4] != b'-' || bytes[7] != b'-' {
        return false;
    }
    bytes[0..4].iter().all(|b| b.is_ascii_digit())
        && bytes[5..7].iter().all(|b| b.is_ascii_digit())
        && bytes[8..10].iter().all(|b| b.is_ascii_digit())
}

fn wrangler_toml_worker_name_ok(s: &str) -> bool {
    if s.is_empty() || s.len() > 255 {
        return false;
    }
    const PROSE: &[&str] = &[
        "the", "a", "an", "to", "of", "for", "and", "or", "is", "team", "note",
    ];
    if PROSE.iter().any(|w| s.eq_ignore_ascii_case(w)) {
        return false;
    }
    let bytes = s.as_bytes();
    // Wrangler: alphanumeric + dashes; no underscores; no leading/trailing dash.
    if bytes[0] == b'-' || bytes[bytes.len() - 1] == b'-' {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || *b == b'-')
}

/// Netlify `netlify.toml`: `[build]` / `[build.environment]` /
/// `[build.processing]` / `[build.processing.css|js|html|images]`,
/// `[dev]` / `[functions]` / `[functions.name]`,
/// `[context.production]` / `[context.deploy-preview]` /
/// `[context.branch-deploy]` / `[context.name]` /
/// `[context.name.environment]` / `[context.name.processing…]`,
/// `[[redirects]]` / `[[headers]]` / `[[plugins]]` / `[[edge_functions]]`,
/// `command = "npm run build"`, `publish = "dist"`,
/// `functions = "netlify/functions"`, `edge_functions = "netlify/edge-functions"`,
/// `base = "."`, `ignore = "git diff …"`, `from = "/*"`, `to = "/index.html"`,
/// `status = 200`, `force = false`, `for = "/*"`,
/// `package = "@netlify/plugin-lighthouse"`, `directory = "netlify/functions"`,
/// `node_bundler = "esbuild"` / `"zisi"`, `skip_processing = false`,
/// `bundle = true`, `minify = true`, `pretty_urls = true`, `compress = true`,
/// `framework = "#custom"`, `targetPort = 3000`, `autoLaunch = false`,
/// `functionsPort = 34567`, `path = "/api/*"`, `function = "api"`. Exact
/// Netlify keys (snake_case + known camelCase). TOML `key = value` with
/// spaces around `=`. Optional `#` comment. Arrays
/// (`included_files = […]`, `external_node_modules = […]`) / nested maps /
/// `port = …` (MySQL option-file collision) / prose / wrong case / railway /
/// fly / wrangler / dioxus / uniffi / cbindgen / trunk / mutants / audit / cliff /
/// cargo-make / release.toml / Dist.toml / mdBook / taplo / typos / bacon /
/// Cross / rust-toolchain / cargo config / nextest / deny / clippy /
/// rustfmt / ruff / uv / bunfig / yarn / npmrc / pip / Cargo.toml stay out.
fn is_netlify_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        if array {
            return netlify_toml_array_section_ok(header);
        }
        return netlify_toml_section_ok(header);
    }
    // Quote-aware `#` / `;` strip so `framework = "#custom"` survives.
    let body = netlify_toml_strip_comment(s);
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    // Nested dotted free-form keys stay out.
    if key.contains('.') {
        return false;
    }
    if !netlify_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    netlify_toml_value_ok(key, value)
}

fn netlify_toml_strip_comment(s: &str) -> &str {
    let mut in_single = false;
    let mut in_double = false;
    for (i, b) in s.bytes().enumerate() {
        match b {
            b'\'' if !in_double => in_single = !in_single,
            b'"' if !in_single => in_double = !in_double,
            b'#' | b';' if !in_single && !in_double => {
                return s[..i].trim_end();
            }
            _ => {}
        }
    }
    s.trim()
}

fn netlify_toml_section_ok(header: &str) -> bool {
    if matches!(header, "build" | "dev" | "functions") {
        return true;
    }
    if matches!(
        header,
        "build.environment"
            | "build.processing"
            | "build.processing.css"
            | "build.processing.js"
            | "build.processing.html"
            | "build.processing.images"
    ) {
        return true;
    }
    if let Some(rest) = header.strip_prefix("functions.") {
        return netlify_toml_fn_name_ok(rest);
    }
    if let Some(rest) = header.strip_prefix("context.") {
        return netlify_toml_context_ok(rest);
    }
    false
}

fn netlify_toml_array_section_ok(header: &str) -> bool {
    matches!(
        header,
        "redirects" | "headers" | "plugins" | "edge_functions"
    )
}

fn netlify_toml_fn_name_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    if name.is_empty() || name.len() > 128 {
        return false;
    }
    let bytes = name.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'-' | b'_'))
}

fn netlify_toml_context_ok(rest: &str) -> bool {
    let (name, suffix) = match rest.split_once('.') {
        Some((n, s)) => (n, Some(s)),
        None => (rest, None),
    };
    if !netlify_toml_context_name_ok(name) {
        return false;
    }
    match suffix {
        None => true,
        Some(s) => matches!(
            s,
            "environment"
                | "processing"
                | "processing.css"
                | "processing.js"
                | "processing.html"
                | "processing.images"
        ),
    }
}

fn netlify_toml_context_name_ok(name: &str) -> bool {
    let name = name.trim_matches('"');
    if name.is_empty() || name.len() > 128 {
        return false;
    }
    if matches!(name, "production" | "deploy-preview" | "branch-deploy") {
        return true;
    }
    let bytes = name.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'-' | b'_' | b'/' | b'.'))
}

fn netlify_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        "command"
            | "publish"
            | "functions"
            | "edge_functions"
            | "base"
            | "ignore"
            | "from"
            | "to"
            | "status"
            | "force"
            | "for"
            | "package"
            | "directory"
            | "node_bundler"
            | "skip_processing"
            | "bundle"
            | "minify"
            | "pretty_urls"
            | "compress"
            | "framework"
            | "targetPort"
            | "autoLaunch"
            | "functionsPort"
            | "path"
            | "function"
    )
}

fn netlify_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (included_files = […], …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "force"
            | "skip_processing"
            | "bundle"
            | "minify"
            | "pretty_urls"
            | "compress"
            | "autoLaunch"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "status" {
        // HTTP status: unquoted or quoted 3-digit.
        return bare.len() == 3 && bare.bytes().all(|b| b.is_ascii_digit());
    }
    if matches!(key, "targetPort" | "functionsPort") {
        return bare.len() <= 5 && bare.bytes().all(|b| b.is_ascii_digit()) && bare != "0";
    }
    if key == "node_bundler" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "esbuild" | "zisi" | "nft");
    }
    if matches!(
        key,
        "command"
            | "publish"
            | "functions"
            | "edge_functions"
            | "base"
            | "ignore"
            | "from"
            | "to"
            | "for"
            | "package"
            | "directory"
            | "framework"
            | "path"
            | "function"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 512 {
            return false;
        }
        if !bare
            .bytes()
            .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
        {
            return false;
        }
        if key == "publish" || key == "base" || key == "directory" {
            // Path-ish cue: `.`, `/`, or a simple folder name.
            return bare == "."
                || bare.contains('/')
                || bare
                    .bytes()
                    .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'));
        }
        if key == "from" || key == "to" || key == "path" {
            // Redirect / edge path cue: slash, `*`, or scheme-ish.
            return bare.contains('/') || bare.contains('*');
        }
        if key == "package" {
            // npm package cue: `@scope/…` or dotted/slashed name.
            return bare.starts_with('@')
                || bare.contains('/')
                || bare.contains('-')
                || bare.contains('.');
        }
        if key == "function" {
            return netlify_toml_fn_name_ok(bare);
        }
        if key == "framework" {
            // `#custom` or a framework id.
            return bare.starts_with('#')
                || bare
                    .bytes()
                    .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
        }
        // command / functions / edge_functions / ignore: quoted graphic string.
        return true;
    }
    false
}

/// Fly.io `fly.toml`: `[build]` / `[deploy]` / `[http_service]` /
/// `[http_service.concurrency]` / `[vm]` / `[metrics]` / `[experimental]` /
