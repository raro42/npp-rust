/// keepalived.conf block openers: `global_defs {`, `static_ipaddress {`,
/// `static_routes {`, `static_rules {`, `vrrp_instance VI_1 {`,
/// `vrrp_script chk_http {`, `vrrp_sync_group VG1 {`,
/// `vrrp_track_file tf1 {`, `vrrp_track_process nginx {`,
/// `virtual_server 192.168.1.10 80 {`, `virtual_server fwmark 1 {`,
/// `virtual_server group G1 {`. Exact lowercase. Optional `#` after `{`.
/// Wrong case, prose (`vrrp_instance the {`), bare keywords, and
/// in-block statements stay out.
fn is_keepalived_decl(s: &str) -> bool {
    let s = s.trim_start();
    keepalived_bare_block(s) || keepalived_named_block(s) || keepalived_virtual_server(s)
}

fn keepalived_prose_name(name: &str) -> bool {
    matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our")
}

fn keepalived_bare_block(s: &str) -> bool {
    for key in [
        "global_defs",
        "static_ipaddress",
        "static_routes",
        "static_rules",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Not `global_defs_extra` / `static_ipaddress6`.
        if rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{') {
            return nginx_brace_tail(rest);
        }
    }
    false
}

fn keepalived_named_block(s: &str) -> bool {
    for key in [
        "vrrp_instance",
        "vrrp_script",
        "vrrp_sync_group",
        "vrrp_track_file",
        "vrrp_track_process",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let Some((name, after)) = nginx_ident(rest) else {
            return false;
        };
        if keepalived_prose_name(name) {
            return false;
        }
        return nginx_brace_tail(after);
    }
    false
}

fn keepalived_port(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    if s.is_empty() || !s.as_bytes()[0].is_ascii_digit() {
        return None;
    }
    let n = s
        .as_bytes()
        .iter()
        .take_while(|b| b.is_ascii_digit())
        .count();
    if n == 0 {
        return None;
    }
    let port = &s[..n];
    if port.parse::<u16>().is_err() {
        return None;
    }
    Some((port, &s[n..]))
}

fn keepalived_virtual_server(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("virtual_server") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    // `virtual_server fwmark N {`
    if let Some(after_fw) = rest.strip_prefix("fwmark") {
        if !after_fw.starts_with(char::is_whitespace) {
            return false;
        }
        let after_fw = after_fw.trim_start();
        let Some((_mark, after)) = keepalived_port(after_fw) else {
            return false;
        };
        return nginx_brace_tail(after);
    }
    // `virtual_server group NAME {`
    if let Some(after_grp) = rest.strip_prefix("group") {
        if !after_grp.starts_with(char::is_whitespace) {
            return false;
        }
        let after_grp = after_grp.trim_start();
        let Some((name, after)) = nginx_ident(after_grp) else {
            return false;
        };
        if keepalived_prose_name(name) {
            return false;
        }
        return nginx_brace_tail(after);
    }
    // `virtual_server IP PORT {`
    let Some((_addr, after)) = named_conf_ipv4_or_v6(rest) else {
        return false;
    };
    if !after.starts_with(char::is_whitespace) {
        return false;
    }
    let after = after.trim_start();
    let Some((_port, after)) = keepalived_port(after) else {
        return false;
    };
    nginx_brace_tail(after)
}

/// ISC dhcpd.conf block openers: `subnet 192.168.1.0 netmask 255.255.255.0 {`,
/// `subnet6 2001:db8:1::/64 {`, `host printer {`, `group {` / `group lab {`,
/// `shared-network office {`, `pool {`, `class "Vendor" {`,
/// `failover peer "dhcp-failover" {`, `on commit {` / `on expiry {` /
/// `on release {`. Exact lowercase. Optional `#` after `{`. Wrong case,
/// prose (`host the {`), bare keywords, and in-block statements stay out.
fn is_dhcpd_decl(s: &str) -> bool {
    let s = s.trim_start();
    dhcpd_subnet(s)
        || dhcpd_subnet6(s)
        || dhcpd_host(s)
        || dhcpd_group(s)
        || dhcpd_shared_network(s)
        || dhcpd_pool(s)
        || dhcpd_class(s)
        || dhcpd_failover_peer(s)
        || dhcpd_on_event(s)
}

fn dhcpd_prose_name(name: &str) -> bool {
    matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our")
}

/// IPv6 prefix with required `/bits` (e.g. `2001:db8::/64`).
fn dhcpd_v6_prefix(s: &str) -> Option<(&str, &str)> {
    let s = s.trim_start();
    let bytes = s.as_bytes();
    let n = bytes
        .iter()
        .take_while(|b| b.is_ascii_hexdigit() || matches!(**b, b':' | b'%'))
        .count();
    if n == 0 || !s[..n].contains(':') {
        return None;
    }
    let rest = &s[n..];
    let after_slash = rest.strip_prefix('/')?;
    let bits_n = after_slash
        .as_bytes()
        .iter()
        .take_while(|b| b.is_ascii_digit())
        .count();
    if bits_n == 0 {
        return None;
    }
    let bits = &after_slash[..bits_n];
    let Ok(v) = bits.parse::<u8>() else {
        return None;
    };
    if v > 128 {
        return None;
    }
    Some((&s[..n + 1 + bits_n], &after_slash[bits_n..]))
}

fn dhcpd_subnet(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("subnet") else {
        return false;
    };
    // Not `subnet6`.
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_net, after)) = named_conf_ipv4_or_v6(rest) else {
        return false;
    };
    // IPv4 subnet needs `netmask`; reject bare IPv6 here (use subnet6).
    if after.trim_start().starts_with('{') || !after.starts_with(char::is_whitespace) {
        return false;
    }
    let after = after.trim_start();
    let Some(after_nm) = after.strip_prefix("netmask") else {
        return false;
    };
    if !after_nm.starts_with(char::is_whitespace) {
        return false;
    }
    let after_nm = after_nm.trim_start();
    let Some((_mask, after)) = named_conf_ipv4_or_v6(after_nm) else {
        return false;
    };
    nginx_brace_tail(after)
}

fn dhcpd_subnet6(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("subnet6") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some((_pfx, after)) = dhcpd_v6_prefix(rest) else {
        return false;
    };
    nginx_brace_tail(after)
}

fn dhcpd_host(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("host") else {
        return false;
