fn sqlfluff_path_ok(value: &str) -> bool {
    let bare = sqlfluff_ini_bare(value);
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    let mut has_token = false;
    for b in bare.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.' | b'/') {
            has_token = true;
        }
    }
    has_token
}

fn sqlfluff_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    match key {
        "dialect" => sqlfluff_dialect_ok(value),
        "templater" => sqlfluff_templater_ok(value),
        "rules" | "exclude_rules" => sqlfluff_rule_list_ok(value),
        "max_line_length" | "output_line_length" => sqlfluff_u32_ok(value, 1, 10_000),
        "large_file_skip_byte_limit" | "large_file_skip_char_limit" => {
            sqlfluff_u32_ok(value, 0, 100_000_000)
        }
        "runaway_limit" => sqlfluff_u32_ok(value, 1, 10_000),
        "processes" => {
            let bare = sqlfluff_ini_bare(value);
            bare == "-1" || sqlfluff_u32_ok(value, 1, 512)
        }
        "tab_space_size" => sqlfluff_u32_ok(value, 1, 32),
        "disable_noqa"
        | "nocolor"
        | "fix_even_unparsable"
        | "warn_unused_ignores"
        | "indented_joins"
        | "indented_ctes"
        | "indented_using_on"
        | "indented_on_contents"
        | "indented_then"
        | "indented_then_contents"
        | "allow_implicit_indents"
        | "template_blocks_indent"
        | "allow_scalar"
        | "force_enable"
        | "apply_dbt_builtins" => sqlfluff_ini_bool_ok(value),
        "ignore" => sqlfluff_ignore_stages_ok(value),
        "sql_file_exts" => sqlfluff_exts_ok(value),
        "indent_unit" => sqlfluff_indent_unit_ok(value),
        "skip_indentation_in" => sqlfluff_skip_indentation_ok(value),
        "spacing_before" | "spacing_after" => sqlfluff_spacing_ok(value),
        "line_position" => sqlfluff_line_position_ok(value),
        "single_table_references" => sqlfluff_single_table_refs_ok(value),
        "unquoted_identifiers_policy" | "quoted_identifiers_policy" => {
            sqlfluff_identifiers_policy_ok(value)
        }
        "capitalisation_policy" | "extended_capitalisation_policy" => {
            sqlfluff_capitalisation_ok(value)
        }
        "preferred_quoted_literal_style" => sqlfluff_quoted_literal_ok(value),
        "group_by_and_order_by_style" => sqlfluff_group_by_style_ok(value),
        "load_macros_from_path" | "library_path" => sqlfluff_path_ok(value),
        _ => false,
    }
}

/// Hypothesis `pytest.ini` / `setup.cfg` / `tox.ini` `[hypothesis]` /
/// `[tool:hypothesis]` sections and distinctive keys: `[hypothesis]`,
/// `[tool:hypothesis]`, `max_examples = 100` / `1000`,
/// `derandomize = True` / `false`, `deadline = 500` / `none`,
/// `suppress_health_check = too_slow,filter_too_much` / `data_too_large`,
/// `phases = explicit,reuse,generate,target,shrink` / `explain`,
/// `verbosity = verbose` / `quiet` / `normal` / `debug`,
/// `database = .hypothesis/examples` / `none`,
/// `print_blob = True`, `report_multiple_bugs = false`,
/// `stateful_step_count = 50`, `backend = hypothesis.internal.conjecture`.
/// Exact snake_case keys. INI `key = value` or `key=value`. Optional
/// quotes on values. Optional `#` / `;` comment. Trailing commas on
/// lists ok. Bare `verbose` / `seed` / `timeout` stay out. flake8 /
/// mypy / pytest / isort / coverage / pylint / pycodestyle / autopep8 /
/// black / yapf / pydocstyle / bandit / codespell / docformatter /
/// vulture / interrogate / check-manifest / bumpversion / versioneer /
/// setuptools_scm / towncrier / zest.releaser / cibuildwheel /
/// check-wheel-contents / Twine `.pypirc` / Commitizen /
/// python-semantic-release / scriv / import-linter / darglint /
/// pydoclint / doc8 / rstcheck / sqlfluff / pylama / radon / tox /
/// setuptools / Cargo / Pipfile / pyproject `[tool.hypothesis]` tables /
/// Desktop Entry / pip.conf stay out.
fn is_hypothesis_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return hypothesis_ini_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !hypothesis_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    hypothesis_ini_value_ok(key, value)
}

fn hypothesis_ini_section_ok(header: &str) -> bool {
    matches!(header, "hypothesis" | "tool:hypothesis")
}

fn hypothesis_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "max_examples"
            | "derandomize"
            | "database"
            | "verbosity"
            | "phases"
            | "stateful_step_count"
            | "report_multiple_bugs"
            | "suppress_health_check"
            | "deadline"
            | "print_blob"
            | "backend"
    )
}

fn hypothesis_ini_bare(value: &str) -> &str {
