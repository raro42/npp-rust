fn pylama_linters_ok(value: &str) -> bool {
    let bare = pylama_ini_bare(value);
    if bare.is_empty() {
        return false;
    }
    let mut any = false;
    for part in bare.split(',') {
        let t = part.trim();
        if t.is_empty() {
            continue;
        }
        if !pylama_linter_ok(t) {
            return false;
        }
