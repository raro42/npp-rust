fn cargo_make_env_key_ok(key: &str) -> bool {
    if !key.starts_with("CARGO_MAKE_") || key.len() > 96 {
        return false;
    }
    let rest = &key["CARGO_MAKE_".len()..];
    if rest.is_empty() {
        return false;
    }
    rest.bytes()
        .all(|b| b.is_ascii_uppercase() || b.is_ascii_digit() || b == b'_')
}

fn cargo_make_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (args = […], dependencies = […], …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "skip_core_tasks"
            | "default_to_workspace"
            | "time_summary"
            | "reduce_input_verbosity"
            | "skip_git_env_info"
            | "skip_rust_env_info"
            | "skip_crate_env_info"
            | "load_cargo_aliases"
            | "skip_tools_install"
            | "disable_color"
            | "ignore_errors"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(
        key,
        "load_script"
            | "init_task"
            | "end_task"
            | "on_error_task"
            | "main_project_member"
            | "min_version"
            | "script_runner"
            | "script_extension"
            | "install_crate"
            | "install_script"
            | "condition_script"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 256 {
            return false;
        }
        // Paths / @runners / task names: graphic ASCII + space/tab.
        return bare
            .bytes()
            .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t');
    }
    false
}

fn cargo_make_env_value_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() || bare.len() > 256 {
        return false;
    }
    if bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false") {
        return true;
    }
    // Quoted or bare graphic values (paths, flags, numbers).
    bare.bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
}

