    // Path-ish: relative, absolute, or env.
    if matches!(
        key,
        "yarnPath" | "cacheFolder" | "globalFolder" | "installStatePath" | "pnpUnpluggedFolder"
    ) && !(bare.starts_with('.')
        || bare.starts_with('/')
