            | "build-local-artifacts"
            | "dispatch-releases"
            | "merge-tasks"
            | "force-latest"
            | "publish-prereleases"
            | "msvc-crt-static"
            | "npm-shrinkwrap"
            | "npm-scope"
            | "npm-package"
            | "tap"
            | "formula"
            | "install-path"
            | "install-success-msg"
            | "tag-namespace"
            | "github-releases-repo"
            | "github-releases-branch"
            | "simple-download-url"
    )
}

fn dist_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (targets = […], hosting = […]).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "install-updater"
            | "github-attestations"
            | "create-release"
            | "dist"
            | "source-tarball"
            | "recursive-tarball"
            | "auto-includes"
            | "precise-builds"
            | "cache-builds"
            | "build-local-artifacts"
            | "dispatch-releases"
            | "merge-tasks"
            | "force-latest"
            | "publish-prereleases"
            | "msvc-crt-static"
            | "npm-shrinkwrap"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "ci" {
        return matches!(bare, "github");
    }
    if key == "pr-run-mode" {
        return matches!(bare, "plan" | "upload" | "skip");
    }
    if key == "hosting" {
        return matches!(bare, "github" | "simple");
    }
    if key == "checksum" {
        return matches!(
            bare,
            "sha256" | "sha512" | "sha3-256" | "sha3-512" | "blake2s" | "blake2b" | "false"
        );
    }
    if key == "ssldotcom-windows-sign" {
        return matches!(bare, "prod" | "test");
    }
    if matches!(key, "unix-archive" | "windows-archive") {
        return matches!(
            bare,
            ".zip" | ".tar.gz" | ".tar.xz" | ".tar.zst" | ".tar.zstd"
        );
    }
    if key == "npm-scope" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare.starts_with('@')
            && bare.len() >= 2
            && bare.len() <= 64
            && bare.as_bytes()[1].is_ascii_alphanumeric()
            && bare[1..]
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
    }
    if key == "tap" || key == "github-releases-repo" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        // owner/repo
        let Some((owner, repo)) = bare.split_once('/') else {
            return false;
        };
        return dist_toml_github_name_ok(owner) && dist_toml_github_name_ok(repo);
    }
    if key == "install-path" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(bare, "CARGO_HOME")
            || bare.starts_with("~/")
            || bare.starts_with('$')
            || bare.ends_with('/');
    }
    if key == "cargo-dist-version" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        // Cargo SemVer Version (not VersionReq): digits and `.` `-` optional pre.
        return dist_toml_semver_ok(bare);
    }
    if key == "simple-download-url" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return (bare.starts_with("https://") || bare.starts_with("http://"))
            && bare.len() <= 512
            && bare
                .bytes()
                .all(|b| b.is_ascii_graphic() || b == b' ' || matches!(b, b'\t'));
    }
    if matches!(
        key,
        "npm-package"
            | "formula"
            | "install-success-msg"
            | "tag-namespace"
            | "github-releases-branch"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 256 {
            return false;
        }
        return bare
            .bytes()
            .all(|b| b.is_ascii_graphic() || b == b' ' || matches!(b, b'\t'));
    }
    false
}

fn dist_toml_github_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'))
}

fn dist_toml_semver_ok(v: &str) -> bool {
    if v.is_empty() || v.len() > 64 {
        return false;
    }
    // e.g. 0.32.0 / 0.32.0-rc.1 — reject VersionReq ops.
    if v.bytes()
        .any(|b| matches!(b, b'^' | b'~' | b'>' | b'<' | b'=' | b'*' | b' '))
    {
        return false;
    }
    let mut parts = v.split('-');
    let Some(core) = parts.next() else {
        return false;
    };
    let nums: Vec<&str> = core.split('.').collect();
    if nums.len() < 2 || nums.len() > 4 {
        return false;
    }
    if !nums
        .iter()
        .all(|n| !n.is_empty() && n.bytes().all(|b| b.is_ascii_digit()))
    {
        return false;
    }
    // optional pre-release / build after first `-` (join remaining)
    for part in parts {
        if part.is_empty() {
            return false;
        }
        if !part
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_'))
        {
            return false;
        }
    }
    true
}

/// cargo-release `release.toml` / `.release.toml`: `[rate-limit]`,
/// `sign-commit = false`, `sign-tag = false`, `release = true`,
/// `shared-version = false` / `"group"`, `dependent-version = "upgrade"`,
/// `metadata = "optional"`, `consolidate-commits = true`,
/// `pre-release-commit-message = "chore: Release"`, `tag = true`,
/// `tag-message` / `tag-name` / `tag-prefix`, `push = true`,
/// `push-remote = "origin"`, `publish = true`, `registry = "…"`,
/// `rate-limit.new-packages = 5`, `rate-limit.existing-packages = 30`,
/// `certs-source = "webpki"`, `verify = true`, `enable-all-features = false`,
/// `target = "…"`. Exact kebab-case cargo-release keys. TOML `key = value`
/// with spaces around `=`. Optional `#` comment. Arrays
/// (`allow-branch = […]`, `pre-release-hook = […]`, `owners = […]`,
/// `enable-features = […]`, `push-options = […]`,
/// `pre-release-replacements = […]`) / prose / wrong case / Dist.toml /
/// mdBook / taplo / typos / bacon / Cross / rust-toolchain / cargo config /
/// nextest / deny / clippy / rustfmt / ruff / uv / bunfig / yarn / npmrc /
/// pip / Cargo.toml stay out.
fn is_release_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        // No `[[…]]` tables in stock release.toml.
        if array {
            return false;
        }
        return release_toml_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    // Allow dotted rate-limit keys; reject other dotted free-form keys.
    if key.contains('.')
        && !matches!(
            key,
            "rate-limit.new-packages" | "rate-limit.existing-packages"
        )
    {
        return false;
    }
    if !release_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    release_toml_value_ok(key, value)
}

fn release_toml_section_ok(header: &str) -> bool {
    matches!(header, "rate-limit")
}

fn release_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        "sign-commit"
            | "sign-tag"
            | "release"
            | "shared-version"
            | "dependent-version"
            | "metadata"
            | "consolidate-commits"
            | "pre-release-commit-message"
            | "tag"
            | "tag-message"
            | "tag-name"
            | "tag-prefix"
            | "push"
            | "push-remote"
            | "publish"
            | "registry"
            | "certs-source"
            | "verify"
            | "enable-all-features"
            | "target"
            | "rate-limit.new-packages"
            | "rate-limit.existing-packages"
            | "new-packages"
            | "existing-packages"
    )
}

fn release_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (allow-branch = […], …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "sign-commit"
            | "sign-tag"
            | "release"
            | "consolidate-commits"
            | "tag"
            | "push"
            | "publish"
            | "verify"
            | "enable-all-features"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "shared-version" {
        if bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false") {
            return true;
        }
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return release_toml_shared_name_ok(bare);
    }
    if key == "dependent-version" {
        return matches!(bare, "upgrade" | "fix" | "error" | "warn" | "ignore");
    }
    if key == "metadata" {
        return matches!(bare, "optional" | "required" | "ignore" | "persistent");
    }
    if key == "certs-source" {
        return matches!(bare, "webpki" | "native");
    }
    if matches!(
        key,
        "rate-limit.new-packages"
            | "rate-limit.existing-packages"
            | "new-packages"
            | "existing-packages"
    ) {
        return !bare.is_empty() && bare.bytes().all(|b| b.is_ascii_digit());
    }
    if key == "target" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return dist_toml_target_triple_ok(bare);
    }
    if matches!(
        key,
        "pre-release-commit-message"
            | "tag-message"
            | "tag-name"
            | "tag-prefix"
            | "push-remote"
            | "registry"
    ) {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 256 {
            return false;
        }
        // Placeholders like `{{prefix}}v{{version}}` are graphic ASCII.
        return bare
            .bytes()
            .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t');
    }
    false
}

fn release_toml_shared_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    if !bytes[0].is_ascii_alphanumeric() {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'))
}

/// cargo-make `Makefile.toml`: `[config]` / `[config.modify_core_tasks]` /
/// `[tasks.build]` / `[tasks.ci-flow]`, `skip_core_tasks = true`,
/// `default_to_workspace = false`, `time_summary = true`,
/// `reduce_input_verbosity = true`, `skip_git_env_info = true`,
/// `skip_rust_env_info = true`, `skip_crate_env_info = true`,
/// `load_cargo_aliases = true`, `load_script = "…"`, `init_task = "…"`,
/// `end_task = "…"`, `on_error_task = "…"`, `main_project_member = "…"`,
/// `skip_tools_install = true`, `disable_color = true`,
/// `min_version = "0.37.0"`, `script_runner = "@duckscript"`,
/// `script_extension = "sh"`, `install_crate = "cargo-outdated"`,
/// `install_script = "…"`, `ignore_errors = true`,
/// `condition_script = "…"`, `CARGO_MAKE_EXTEND_WORKSPACE_MAKEFILE = "true"`.
/// Exact snake_case cargo-make keys (and `CARGO_MAKE_*` env keys). TOML
/// `key = value` with spaces around `=`. Optional `#` comment. Nested maps /
/// arrays (`args = […]`, `dependencies = […]`, `env = {…}`, `run_task = {…}`,
/// `condition = {…}`) / prose / wrong case / release.toml / Dist.toml /
/// mdBook / taplo / typos / bacon / Cross / rust-toolchain / cargo config /
/// nextest / deny / clippy / rustfmt / ruff / uv / bunfig / yarn / npmrc /
/// pip / Cargo.toml stay out.
fn is_cargo_make_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        // No `[[…]]` tables in stock Makefile.toml config / tasks headers.
        if array {
            return false;
        }
        return cargo_make_toml_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    // Nested dotted free-form keys stay out (env.FOO under tasks is nested).
    if key.contains('.') {
        return false;
    }
    let value = body[eq + 1..].trim();
    if cargo_make_toml_key_ok(key) {
        return cargo_make_toml_value_ok(key, value);
    }
    if cargo_make_env_key_ok(key) {
        return cargo_make_env_value_ok(value);
    }
    false
}

fn cargo_make_toml_section_ok(header: &str) -> bool {
    if matches!(header, "config" | "config.modify_core_tasks") {
        return true;
    }
    if let Some(name) = header.strip_prefix("tasks.") {
        return cargo_make_task_name_ok(name);
    }
    false
}

fn cargo_make_task_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
