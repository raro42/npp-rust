/// underscore). INI `key = value` or `key=value`. Optional `#` / `;`
/// comment. Bool values accept yes/true/on/1 / no/false/off/0
/// (case-insensitive). `tag-format` / `tag-message` need `{version}` or
/// `%(version)s`; `date-format` needs `%`; `history-file` needs a
/// changelog-ish path; `history_format` is `md` / `rst`;
/// `version-levels` is 0–10; `development-marker` needs a leading `.`
/// or `dev`. Bare `name` / `version` stay out. flake8 / mypy / pytest /
/// isort / coverage / pylint / pycodestyle / autopep8 / black / yapf /
/// pydocstyle / bandit / codespell / docformatter / vulture /
/// interrogate / check-manifest / bumpversion / versioneer /
/// setuptools_scm / towncrier / tox / setuptools / Cargo / Pipfile /
/// pyproject `[tool.zest-releaser]` / Desktop Entry / pip.conf stay out.
fn is_zest_releaser_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return header == "zest.releaser";
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !zest_releaser_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    zest_releaser_ini_value_ok(key, value)
}

fn zest_releaser_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "release"
            | "upload-pypi"
            | "create-wheel"
            | "extra-message"
            | "prefix-message"
            | "no-input"
            | "register"
            | "push-changes"
            | "less-zeroes"
            | "version-levels"
            | "development-marker"
            | "tag-format"
            | "tag-message"
            | "tag-signing"
            | "date-format"
            | "history-file"
            | "history_format"
            | "run-pre-commit"
    )
}

fn zest_releaser_ini_bool_ok(value: &str) -> bool {
    matches!(
        value.to_ascii_lowercase().as_str(),
        "true" | "false" | "yes" | "no" | "on" | "off" | "1" | "0"
    )
}

fn zest_releaser_ini_message_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 {
        return false;
    }
    value.chars().all(|c| c.is_ascii_graphic() || c == ' ')
}

fn zest_releaser_ini_marker_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 64 {
        return false;
    }
    let lower = value.to_ascii_lowercase();
    (value.starts_with('.') || lower.contains("dev"))
        && value
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'))
}

fn zest_releaser_ini_version_token_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 {
        return false;
    }
    value.contains("{version}") || value.contains("%(version)s")
}

fn zest_releaser_ini_date_format_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 64 {
        return false;
    }
    value.contains('%')
        && value.bytes().all(|b| {
            b.is_ascii_alphanumeric() || matches!(b, b'%' | b'-' | b'_' | b'/' | b' ' | b'.')
        })
}

fn zest_releaser_ini_history_file_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 {
        return false;
    }
    let bytes = value.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_' || bytes[0] == b'.') {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
    {
        return false;
    }
    let lower = value.to_ascii_lowercase();
    let base = lower.rsplit('/').next().unwrap_or(lower.as_str());
    base.starts_with("news")
        || base.starts_with("changes")
        || base.starts_with("changelog")
        || base.starts_with("history")
        || lower.ends_with(".rst")
        || lower.ends_with(".md")
        || lower.ends_with(".txt")
}

fn zest_releaser_ini_history_format_ok(value: &str) -> bool {
    matches!(value, "md" | "rst" | "MD" | "RST")
}

fn zest_releaser_ini_version_levels_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 2 {
        return false;
    }
    value.parse::<u8>().is_ok_and(|n| n <= 10)
}

fn zest_releaser_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    match key {
        "release" | "upload-pypi" | "create-wheel" | "no-input" | "register" | "push-changes"
        | "less-zeroes" | "tag-signing" | "run-pre-commit" => zest_releaser_ini_bool_ok(value),
        "extra-message" | "prefix-message" => zest_releaser_ini_message_ok(value),
        "development-marker" => zest_releaser_ini_marker_ok(value),
        "tag-format" | "tag-message" => zest_releaser_ini_version_token_ok(value),
        "date-format" => zest_releaser_ini_date_format_ok(value),
        "history-file" => zest_releaser_ini_history_file_ok(value),
        "history_format" => zest_releaser_ini_history_format_ok(value),
        "version-levels" => zest_releaser_ini_version_levels_ok(value),
        _ => false,
    }
}

/// cibuildwheel `setup.cfg` / `tox.ini` `[tool:cibuildwheel]` /
/// `[cibuildwheel]` / platform or selector overrides
/// (`[tool:cibuildwheel:linux]`, `[tool:cibuildwheel:cp39-manylinux_x86_64]`)
/// and distinctive keys (`before-all`, `before-build`, `before-test`,
/// `repair-wheel-command`, `test-command`, `test-requires`, `test-extras`,
/// `test-groups`, `test-skip`, `build-frontend`, `build-verbosity`,
/// `environment-pass`, `container-engine`, `dependency-versions`,
/// `config-settings`, `pyodide-version`, `xbuild-tools`,
/// `manylinux-*-image`, `musllinux-*-image`). Exact kebab-case keys.
/// INI `key = value` or `key=value`. Optional `#` / `;` comment.
/// Bare `build` / `skip` / `archs` / `environment` / `enable` stay out
/// (too generic without the section header). flake8 / mypy / pytest /
/// isort / coverage / pylint / pycodestyle / autopep8 / black / yapf /
/// pydocstyle / bandit / codespell / docformatter / vulture /
/// interrogate / check-manifest / bumpversion / versioneer /
/// setuptools_scm / towncrier / zest.releaser / tox / setuptools /
/// Cargo / Pipfile / pyproject `[tool.cibuildwheel]` / Desktop Entry /
/// pip.conf stay out.
fn is_cibuildwheel_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return cibuildwheel_ini_header_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !cibuildwheel_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    cibuildwheel_ini_value_ok(key, value)
}

fn cibuildwheel_ini_header_ok(header: &str) -> bool {
    if header == "tool:cibuildwheel" || header == "cibuildwheel" {
        return true;
    }
    let rest = if let Some(r) = header.strip_prefix("tool:cibuildwheel:") {
        r
    } else if let Some(r) = header.strip_prefix("cibuildwheel:") {
        r
    } else {
        return false;
    };
    cibuildwheel_ini_override_ok(rest)
}

fn cibuildwheel_ini_override_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 96 {
        return false;
    }
    matches!(
        name,
        "linux" | "windows" | "macos" | "pyodide" | "ios" | "android"
    ) || cibuildwheel_ini_selector_ok(name)
}

fn cibuildwheel_ini_selector_ok(name: &str) -> bool {
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_lowercase()) {
        return false;
    }
    if !bytes
        .iter()
        .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'*'))
    {
        return false;
    }
    // Build ids look like cp39-manylinux_x86_64 / pp310-* / gp24_*.
    let has_digit = bytes.iter().any(u8::is_ascii_digit);
    let has_sep = bytes.iter().any(|b| matches!(*b, b'_' | b'-' | b'*'));
    has_digit && has_sep
}

fn cibuildwheel_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "before-all"
            | "before-build"
            | "before-test"
            | "repair-wheel-command"
            | "test-command"
            | "test-requires"
            | "test-extras"
            | "test-groups"
            | "test-skip"
            | "build-frontend"
            | "build-verbosity"
            | "environment-pass"
            | "container-engine"
            | "dependency-versions"
            | "config-settings"
            | "pyodide-version"
            | "xbuild-tools"
    ) || cibuildwheel_ini_image_key_ok(key)
}

fn cibuildwheel_ini_image_key_ok(key: &str) -> bool {
    let Some(rest) = key
        .strip_prefix("manylinux-")
        .or_else(|| key.strip_prefix("musllinux-"))
    else {
        return false;
    };
    let Some(arch) = rest.strip_suffix("-image") else {
        return false;
    };
    !arch.is_empty()
        && arch.len() <= 48
        && arch
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'))
}

fn cibuildwheel_ini_text_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    value.chars().all(|c| c.is_ascii_graphic() || c == ' ')
}

fn cibuildwheel_ini_build_frontend_ok(value: &str) -> bool {
    if !cibuildwheel_ini_text_ok(value) {
        return false;
    }
    let lower = value.to_ascii_lowercase();
    lower.starts_with("build")
        || lower.starts_with("pip")
        || lower.contains("uv")
        || lower.contains(';')
}

fn cibuildwheel_ini_verbosity_ok(value: &str) -> bool {
    matches!(value, "0" | "1" | "2" | "3" | "-1")
}

fn cibuildwheel_ini_container_engine_ok(value: &str) -> bool {
    matches!(value.to_ascii_lowercase().as_str(), "docker" | "podman")
}

fn cibuildwheel_ini_dependency_versions_ok(value: &str) -> bool {
    if !cibuildwheel_ini_text_ok(value) {
        return false;
    }
    let lower = value.to_ascii_lowercase();
    lower == "pinned"
        || lower == "latest"
        || lower.starts_with("file:")
        || lower.contains('.')
        || lower.contains('/')
}

fn cibuildwheel_ini_image_value_ok(value: &str) -> bool {
    if !cibuildwheel_ini_text_ok(value) {
        return false;
    }
    let lower = value.to_ascii_lowercase();
    lower.starts_with("manylinux")
        || lower.starts_with("musllinux")
        || lower.contains('/')
        || lower.contains(':')
        || lower == "off"
        || lower == "none"
}

fn cibuildwheel_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    if cibuildwheel_ini_image_key_ok(key) {
        return cibuildwheel_ini_image_value_ok(value);
    }
    match key {
        "before-all"
        | "before-build"
        | "before-test"
        | "repair-wheel-command"
        | "test-command"
        | "test-requires"
        | "test-extras"
        | "test-groups"
        | "test-skip"
        | "environment-pass"
        | "config-settings"
        | "xbuild-tools"
        | "pyodide-version" => cibuildwheel_ini_text_ok(value),
        "build-frontend" => cibuildwheel_ini_build_frontend_ok(value),
        "build-verbosity" => cibuildwheel_ini_verbosity_ok(value),
        "container-engine" => cibuildwheel_ini_container_engine_ok(value),
        "dependency-versions" => cibuildwheel_ini_dependency_versions_ok(value),
        _ => false,
    }
}

/// check-wheel-contents `setup.cfg` / `tox.ini` /
/// `check-wheel-contents.cfg` / `.check-wheel-contents.cfg`
/// `[tool:check-wheel-contents]` / `[check-wheel-contents]` sections
/// and distinctive keys (`select`, `ignore`, `toplevel`, `package`,
/// `src_dir`, `package_omit`). Optional `#` / `;` comment. Key lines
/// may use `=` with or without spaces. Exact check-wheel-contents keys
/// (`src_dir` / `package_omit` keep underscores; setup.cfg uses the
/// `tool:` section prefix). `select` / `ignore` need comma-separated
/// `W` / `W0`…`W2` / `W###` check ids (no flake8 `E`/`F` codes).
/// `package` needs a path-ish value (`/` / `.` / trailing `/` /
/// comma list) so towncrier `package = myproject` stays out; `src_dir`
/// accepts a plain directory name.
/// Bare `select` / `ignore` without values stay out. flake8 / mypy /
/// pytest / isort / coverage / pylint / pycodestyle / autopep8 /
/// black / yapf / pydocstyle / bandit / codespell / docformatter /
/// vulture / interrogate / check-manifest / bumpversion / versioneer /
/// setuptools_scm / towncrier / zest.releaser / cibuildwheel / tox /
/// setuptools / Cargo / Pipfile / pyproject
/// `[tool.check-wheel-contents]` / Desktop Entry / pip.conf stay out.
fn is_check_wheel_contents_ini_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return check_wheel_contents_ini_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    let key = body[..eq].trim();
    if key.is_empty() || key.contains('.') || key.contains(' ') {
        return false;
    }
    if !check_wheel_contents_ini_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    check_wheel_contents_ini_value_ok(key, value)
}

fn check_wheel_contents_ini_section_ok(header: &str) -> bool {
    header == "tool:check-wheel-contents" || header == "check-wheel-contents"
}

fn check_wheel_contents_ini_key_ok(key: &str) -> bool {
    matches!(
        key,
        "select" | "ignore" | "toplevel" | "package" | "src_dir" | "package_omit"
    )
}

fn check_wheel_contents_ini_checks_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 {
        return false;
    }
    let mut any = false;
    for raw in value.split(',') {
        let tok = raw.trim();
        if tok.is_empty() {
            return false;
        }
        let bytes = tok.as_bytes();
        if bytes[0] != b'W' {
            return false;
        }
        let digits = &bytes[1..];
        if digits.len() > 3 || !digits.iter().all(u8::is_ascii_digit) {
            return false;
        }
        any = true;
    }
    any
}

fn check_wheel_contents_ini_toplevel_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 256 {
        return false;
    }
    let mut any = false;
    for raw in value.split(',') {
        let tok = raw.trim();
        if tok.is_empty() {
            return false;
        }
        let bytes = tok.as_bytes();
        if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
            return false;
        }
        if !bytes
            .iter()
            .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
        {
            return false;
        }
        any = true;
    }
    any
}

fn check_wheel_contents_ini_path_list_ok(value: &str, require_pathish: bool) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    // For `package`, require path-ish cues so towncrier
    // `package = myproject` stays out. `src_dir = src` is fine alone.
    if require_pathish {
        let pathish = value.contains('/')
            || value.contains('.')
            || value.contains(',')
            || value.ends_with('/');
        if !pathish {
            return false;
        }
    }
    let mut any = false;
    for raw in value.split(',') {
        let tok = raw.trim();
        if tok.is_empty() {
            return false;
        }
        let bytes = tok.as_bytes();
        if !(bytes[0].is_ascii_alphanumeric() || matches!(bytes[0], b'_' | b'.')) {
            return false;
        }
        if !bytes
            .iter()
            .all(|b| b.is_ascii_alphanumeric() || matches!(*b, b'_' | b'-' | b'.' | b'/'))
        {
            return false;
        }
        any = true;
    }
    any
}

fn check_wheel_contents_ini_omit_ok(value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    let mut has_globish = false;
    for b in value.bytes() {
        if !(b.is_ascii_graphic() || b == b' ' || b == b'\t') {
            return false;
        }
        if matches!(b, b'*' | b'?' | b'.' | b'/' | b',') {
            has_globish = true;
        }
    }
    has_globish
}

fn check_wheel_contents_ini_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 512 {
        return false;
    }
    match key {
        "select" | "ignore" => check_wheel_contents_ini_checks_ok(value),
        "toplevel" => check_wheel_contents_ini_toplevel_ok(value),
        "package" => check_wheel_contents_ini_path_list_ok(value, true),
        "src_dir" => check_wheel_contents_ini_path_list_ok(value, false),
        "package_omit" => check_wheel_contents_ini_omit_ok(value),
        _ => false,
    }
}

