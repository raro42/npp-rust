        return false;
    }
    // Nested tables / arrays stay out (pre-build = […], image = { … }, …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(key, "xargo" | "build-std") {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "zig" {
        if bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false") {
            return true;
        }
        // Version string cue: digits with optional dots (`2.17`, `0.11.0`).
        return bare.len() <= 32
            && bare.chars().next().is_some_and(|c| c.is_ascii_digit())
            && bare
                .chars()
                .all(|c| c.is_ascii_digit() || c == '.' || c == '-' || c == '_');
    }
    if key == "runner" {
        return matches!(bare, "qemu-user" | "qemu-system" | "native");
    }
    if key == "default-target" {
        if bare.len() > 256 || !bare.contains('-') {
            return false;
        }
        return bare
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.'));
    }
    if matches!(key, "dockerfile" | "file" | "context") {
        // Path cue: relative / absolute / bare filename with extension.
        let pathish = bare.starts_with('.')
            || bare.starts_with('/')
            || bare.starts_with('~')
            || bare.contains('/')
            || bare.contains('\\')
            || bare.contains('.');
        if !pathish {
            return false;
        }
    }
    if key == "image" {
        // Docker image cue: `/` name, `:tag`, `@digest`, leading `-` subtarget,
        // or bare registry-less name with alphanumeric/_/-.
        let imageish = bare.starts_with(':')
            || bare.starts_with('@')
            || bare.starts_with('-')
            || bare.contains('/')
            || bare.contains(':')
            || bare.contains('@')
            || (bare.len() <= 128
                && bare
                    .bytes()
                    .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-' | b'.')));
        if !imageish {
            return false;
        }
    }
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'_'
                    | b'-'
                    | b':'
                    | b'@'
                    | b'+'
                    | b','
                    | b'/'
                    | b'\\'
                    | b' '
                    | b'\t'
                    | b'='
                    | b'$'
                    | b'%'
                    | b'?'
                    | b'&'
                    | b'~'
                    | b'('
                    | b')'
                    | b'"'
                    | b'\''
            )
    })
}

/// rust-toolchain.toml: `[toolchain]`, `channel = "stable"` / `"1.70.0"` /
/// `"nightly-2024-01-01"`, `profile = "minimal"` / `"default"` / `"complete"`,
/// `path = "./custom-toolchain"`. Exact lowercase keys. TOML `key = value`
/// with spaces around `=`. Optional `#` comment. Nested maps / arrays
/// (`components = […]`, `targets = […]`) / prose / wrong case / Cross /
/// cargo config / nextest / deny / clippy / rustfmt / ruff / uv / bunfig /
/// yarn / npmrc / pip / Cargo.toml stay out.
fn is_rust_toolchain_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return header == "toolchain";
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    if !rust_toolchain_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    rust_toolchain_toml_value_ok(key, value)
}

fn rust_toolchain_toml_key_ok(key: &str) -> bool {
    matches!(key, "channel" | "profile" | "path")
}

fn rust_toolchain_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (components = […], targets = […]).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if key == "profile" {
        return matches!(bare, "minimal" | "default" | "complete");
    }
    if key == "channel" {
        // Channel cue: stable/beta/nightly, version `1.70.0`, or dated
        // `nightly-2024-01-01` / `stable-2024-01-01`.
        if matches!(bare, "stable" | "beta" | "nightly") {
            return true;
        }
        if let Some(rest) = bare
            .strip_prefix("nightly-")
            .or_else(|| bare.strip_prefix("stable-"))
            .or_else(|| bare.strip_prefix("beta-"))
        {
            // Date YYYY-MM-DD.
            return rest.len() == 10
                && rest.as_bytes().get(4) == Some(&b'-')
                && rest.as_bytes().get(7) == Some(&b'-')
                && rest
                    .bytes()
                    .enumerate()
                    .all(|(i, b)| matches!(i, 4 | 7) || b.is_ascii_digit());
        }
        // Semver-ish version: starts with digit, digits/dots only.
        return bare.len() <= 32
            && bare.chars().next().is_some_and(|c| c.is_ascii_digit())
            && bare.chars().all(|c| c.is_ascii_digit() || c == '.');
    }
    if key == "path" {
        // Path cue: relative / absolute / bare dirname.
        let pathish = bare.starts_with('.')
            || bare.starts_with('/')
            || bare.starts_with('~')
            || bare.contains('/')
            || bare.contains('\\');
        if !pathish {
            return false;
        }
    }
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'_'
                    | b'-'
                    | b':'
                    | b'@'
                    | b'+'
                    | b','
                    | b'/'
                    | b'\\'
                    | b' '
                    | b'\t'
                    | b'='
                    | b'$'
                    | b'%'
                    | b'?'
                    | b'&'
                    | b'~'
                    | b'('
                    | b')'
                    | b'"'
                    | b'\''
            )
    })
}

/// bacon `bacon.toml` / prefs: `[jobs.check]` / `[jobs.clippy-all]` /
/// `[keybindings]` / `[exports]` / `[exports.name]` / `[skin]`,
/// `default_job = "check"`, `need_stdout = false`, `analyzer = "cargo_json"`,
/// `on_success = "back"`, `allow_warnings = true`, `allow_failures = false`,
/// `kill_before_restart = false`, `hide_scrollbar = true`,
/// `show_help_panel = false`, `on_change_strategy = "wait_then_restart"`,
/// `scrollback_len = 10000`, `apply_gitignore = true`, `workdir = "."`,
/// `summary = true`, `wrap = false`, `reverse = false`, `listen = false`,
/// `background = false`, `notifications = true`, `help_line = true`,
/// `show_system_info = false`, keybinding `c = "job:clippy-all"`. Exact
/// snake_case bacon keys (and chord keys under `[keybindings]`). TOML
/// `key = value` with spaces around `=`. Optional `#` comment. Nested maps /
/// arrays (`command = […]`, `watch = […]`, `env.FOO = …`, `sound.enabled`) /
/// prose / wrong case / Cross / rust-toolchain / cargo config / nextest /
/// deny / clippy / rustfmt / ruff / uv / bunfig / yarn / npmrc / pip /
/// Cargo.toml stay out.
fn is_bacon_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return bacon_toml_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    // Nested `env.FOO` / `sound.enabled` stay out.
    if key.contains('.') {
        return false;
    }
    let value = body[eq + 1..].trim();
    if bacon_toml_key_ok(key) {
        return bacon_toml_value_ok(key, value);
    }
    // Keybinding chord = action (under [keybindings] in real files).
    bacon_toml_keybinding_ok(key, value)
}

fn bacon_toml_section_ok(header: &str) -> bool {
    if matches!(header, "keybindings" | "exports" | "skin") {
        return true;
    }
    if let Some(name) = header.strip_prefix("jobs.") {
        return bacon_toml_job_name_ok(name);
    }
    if let Some(name) = header.strip_prefix("exports.") {
        return bacon_toml_job_name_ok(name);
    }
    false
}

fn bacon_toml_job_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
}

fn bacon_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        "default_job"
            | "need_stdout"
            | "analyzer"
            | "on_success"
            | "on_failure"
            | "allow_warnings"
            | "allow_failures"
            | "kill_before_restart"
            | "hide_scrollbar"
            | "show_help_panel"
            | "on_change_strategy"
            | "scrollback_len"
            | "apply_gitignore"
            | "workdir"
            | "summary"
            | "wrap"
            | "reverse"
            | "listen"
            | "background"
            | "notifications"
            | "help_line"
            | "show_system_info"
    )
}

fn bacon_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (command = […], watch = […]).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "need_stdout"
            | "allow_warnings"
            | "allow_failures"
            | "kill_before_restart"
            | "hide_scrollbar"
            | "show_help_panel"
            | "apply_gitignore"
            | "summary"
            | "wrap"
            | "reverse"
            | "listen"
            | "background"
            | "notifications"
            | "help_line"
            | "show_system_info"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "scrollback_len" {
        return !bare.is_empty() && bare.len() <= 10 && bare.bytes().all(|b| b.is_ascii_digit());
    }
    if key == "on_change_strategy" {
        return matches!(
            bare,
            "wait_then_restart" | "kill_then_restart" | "wait" | "kill"
        );
    }
    if key == "analyzer" {
        return matches!(
            bare,
            "cargo_json"
                | "cargo_json_nextest"
                | "nextest"
                | "python_pytest"
                | "standard"
                | "rustc"
        ) || (bare.len() <= 64
            && bare
                .bytes()
                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-')));
    }
    if matches!(key, "default_job") {
        return bacon_toml_job_name_ok(bare);
    }
    if matches!(key, "on_success" | "on_failure") {
        return bacon_toml_action_ok(bare);
    }
    if key == "workdir" {
        let pathish = bare.starts_with('.')
            || bare.starts_with('/')
            || bare.starts_with('~')
            || bare.contains('/')
            || bare.contains('\\')
            || bare == ".";
        if !pathish {
            return false;
        }
    }
    bacon_toml_value_chars_ok(value)
}

fn bacon_toml_keybinding_ok(key: &str, value: &str) -> bool {
    if !bacon_toml_chord_ok(key) {
        return false;
    }
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    bacon_toml_action_ok(bare) && bacon_toml_value_chars_ok(value)
}

fn bacon_toml_chord_ok(key: &str) -> bool {
    if key.is_empty() || key.len() > 32 {
        return false;
    }
    // Single printable key, or mod-key (`ctrl-c`, `alt-w`, `shift-g`, `cmd-e`,
    // `shift-F9`). Reject stock config keys from neighbouring families.
    if matches!(
        key,
        "channel"
            | "profile"
            | "path"
            | "jobs"
            | "xargo"
            | "dockerfile"
            | "image"
            | "runner"
            | "context"
            | "file"
            | "msrv"
            | "dir"
            | "retries"
    ) {
        return false;
    }
    let bytes = key.as_bytes();
    if key.contains('-') {
        // mod-key: at least one ascii letter/digit segment separated by `-`.
        return bytes
            .iter()
            .all(|&b| b.is_ascii_alphanumeric() || b == b'-')
            && key.split('-').all(|p| !p.is_empty())
            && key.split('-').count() >= 2;
    }
    // Single key: letter, digit, or a few named keys.
    matches!(
        key,
        "esc"
            | "tab"
            | "backtab"
            | "enter"
            | "space"
            | "home"
            | "end"
            | "up"
            | "down"
            | "left"
            | "right"
            | "?"
            | "/"
    ) || (key.len() == 1 && bytes[0].is_ascii_alphanumeric())
}

fn bacon_toml_action_ok(bare: &str) -> bool {
    if bare.len() > 256 {
        return false;
    }
    if matches!(
        bare,
        "back"
            | "back-or-quit"
            | "quit"
            | "help"
            | "refresh"
            | "rerun"
            | "pause"
            | "no-op"
            | "toggle-raw-output"
            | "toggle-summary"
            | "toggle-wrap"
            | "toggle-backtrace"
            | "toggle-ignore"
            | "toggle-watch"
            | "scope-to-failures"
            | "focus-search"
            | "next-match"
            | "previous-match"
            | "next-item"
            | "previous-item"
            | "scroll-to-top"
            | "scroll-to-bottom"
            | "copy-unstyled-output"
            | "reload-config"
            | "play-sound"
            | "open-jobs-menu"
            | "open-undismiss-menu"
            | "dismiss-top"
            | "dismiss-top-item"
            | "dismiss-top-item-type"
    ) {
        return true;
    }
    if let Some(rest) = bare.strip_prefix("job:") {
        return bacon_toml_job_name_ok(rest);
    }
    if let Some(rest) = bare.strip_prefix("export:") {
        return bacon_toml_job_name_ok(rest);
    }
    // Parameterized actions: toggle-backtrace(1), scroll-lines(-1), …
    // Only known bacon action names (not arbitrary `funky(y)`).
    if let Some((name, args)) = bare.split_once('(') {
        if !args.ends_with(')') {
            return false;
        }
        if !matches!(
            name,
            "toggle-backtrace"
                | "scroll-lines"
                | "scroll-pages"
                | "play-sound"
                | "focus-file"
                | "show-item"
                | "open-menu"
                | "job"
                | "export"
        ) {
            return false;
        }
        let inner = &args[..args.len() - 1];
        return inner.bytes().all(|b| {
            b.is_ascii_alphanumeric()
                || matches!(
                    b,
                    b'_' | b'-' | b'=' | b',' | b'.' | b'%' | b' ' | b'+' | b'[' | b']' | b':'
                )
        });
    }
    false
}

fn bacon_toml_value_chars_ok(value: &str) -> bool {
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'_'
                    | b'-'
                    | b':'
                    | b'@'
                    | b'+'
                    | b','
                    | b'/'
                    | b'\\'
                    | b' '
                    | b'\t'
                    | b'='
                    | b'$'
                    | b'%'
                    | b'?'
                    | b'&'
                    | b'~'
                    | b'('
                    | b')'
                    | b'['
                    | b']'
                    | b'"'
                    | b'\''
            )
    })
}

/// crate-ci typos `typos.toml` / `_typos.toml` / `.typos.toml`:
/// `[files]` / `[default]` / `[default.extend-words]` /
/// `[default.extend-identifiers]` / `[type.rust]` / `[type.py]`,
/// `ignore-hidden = true`, `ignore-files = true`, `ignore-dot = true`,
/// `ignore-vcs = true`, `ignore-global = true`, `ignore-parent = true`,
/// `check-filename = true`, `check-file = true`, `locale = "en"` /
/// `"en-us"` / `"en-gb"` / `"en-ca"` / `"en-au"`. Exact kebab-case typos
/// keys. TOML `key = value` with spaces around `=`. Optional `#` comment.
/// Nested maps / arrays (`extend-exclude = […]`, `extend-ignore-re = […]`,
/// free-form `teh = "teh"` under extend-words) / prose / wrong case /
/// `unicode` / `binary` (cargo config / generic) / bacon / Cross /
/// rust-toolchain / cargo config / nextest / deny / clippy / rustfmt /
/// ruff / uv / bunfig / yarn / npmrc / pip / Cargo.toml stay out.
fn is_typos_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if array || header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        return typos_toml_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    // Nested `default.extend-words` keys stay as section headers only.
    if key.contains('.') {
        return false;
    }
    if !typos_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    typos_toml_value_ok(key, value)
}

fn typos_toml_section_ok(header: &str) -> bool {
    if matches!(
        header,
        "files" | "default" | "default.extend-words" | "default.extend-identifiers"
    ) {
        return true;
    }
    if let Some(name) = header.strip_prefix("type.") {
        return typos_toml_type_name_ok(name);
    }
    false
}

fn typos_toml_type_name_ok(name: &str) -> bool {
    if name.is_empty() || name.len() > 64 {
        return false;
    }
    let bytes = name.as_bytes();
    if !(bytes[0].is_ascii_alphanumeric() || bytes[0] == b'_') {
        return false;
    }
    bytes
        .iter()
        .all(|&b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
}

fn typos_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        "ignore-hidden"
            | "ignore-files"
            | "ignore-dot"
            | "ignore-vcs"
            | "ignore-global"
            | "ignore-parent"
            | "check-filename"
            | "check-file"
            | "locale"
    )
}

fn typos_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (extend-exclude = […], …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "ignore-hidden"
            | "ignore-files"
            | "ignore-dot"
            | "ignore-vcs"
            | "ignore-global"
            | "ignore-parent"
            | "check-filename"
            | "check-file"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if key == "locale" {
        return matches!(bare, "en" | "en-us" | "en-gb" | "en-ca" | "en-au");
    }
    false
}

/// Taplo `taplo.toml` / `.taplo.toml`: `[formatting]` / `[schema]` /
/// `[[rule]]` / `[rule.formatting]` / `[rule.schema]`, `align_entries = true`,
/// `align_comments = true`, `align_single_comments = true`,
/// `array_trailing_comma = true`, `array_auto_expand = true`,
/// `array_auto_collapse = true`, `compact_arrays = true`,
/// `compact_inline_tables = false`, `inline_table_expand = true`,
/// `compact_entries = false`, `column_width = 80`, `indent_tables = false`,
/// `indent_entries = false`, `indent_string = "  "`, `trailing_newline = true`,
/// `reorder_keys = false`, `reorder_arrays = false`,
/// `reorder_inline_tables = false`, `allowed_blank_lines = 2`, `crlf = false`,
/// `enabled = true`, `path = "taplo://taplo.toml"` / `"./schema.json"` /
/// `"https://…"`. Exact snake_case Taplo keys. TOML `key = value` with spaces
/// around `=`. Optional `#` comment. Nested maps / arrays (`include = […]`,
/// `exclude = […]`, `keys = […]`) / prose / wrong case / typos / bacon /
/// Cross / rust-toolchain / cargo config / nextest / deny / clippy / rustfmt /
/// ruff / uv / bunfig / yarn / npmrc / pip / Cargo.toml stay out.
fn is_taplo_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        if array {
            return header == "rule";
        }
        return taplo_toml_section_ok(header);
    }
    let body = if let Some(idx) = s.find(['#', ';']) {
        s[..idx].trim()
    } else {
        s.trim()
    };
    if body.is_empty() {
        return false;
    }
    // TOML `key = value` with spaces around `=` (not npmrc `key=value`,
    // and not Yarn YAML `key: value`).
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    if key.contains('.') {
        return false;
    }
    if !taplo_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    taplo_toml_value_ok(key, value)
}

fn taplo_toml_section_ok(header: &str) -> bool {
    matches!(
        header,
        "formatting" | "schema" | "rule.formatting" | "rule.schema"
    )
}

fn taplo_toml_key_ok(key: &str) -> bool {
    matches!(
        key,
        "align_entries"
            | "align_comments"
            | "align_single_comments"
            | "array_trailing_comma"
            | "array_auto_expand"
            | "array_auto_collapse"
            | "compact_arrays"
            | "compact_inline_tables"
            | "inline_table_expand"
            | "compact_entries"
            | "column_width"
            | "indent_tables"
            | "indent_entries"
            | "indent_string"
            | "trailing_newline"
            | "reorder_keys"
            | "reorder_arrays"
            | "reorder_inline_tables"
            | "allowed_blank_lines"
            | "crlf"
            | "enabled"
            | "path"
    )
}

fn taplo_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (include = […], exclude = […], …).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "align_entries"
            | "align_comments"
            | "align_single_comments"
            | "array_trailing_comma"
            | "array_auto_expand"
            | "array_auto_collapse"
            | "compact_arrays"
            | "compact_inline_tables"
            | "inline_table_expand"
            | "compact_entries"
            | "indent_tables"
            | "indent_entries"
            | "trailing_newline"
            | "reorder_keys"
            | "reorder_arrays"
            | "reorder_inline_tables"
            | "crlf"
            | "enabled"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(key, "column_width" | "allowed_blank_lines") {
        return bare.len() <= 8 && bare.bytes().all(|b| b.is_ascii_digit());
    }
    if key == "indent_string" {
        // Quoted whitespace / tabs only (default two spaces). Bare words stay out.
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare.bytes().all(|b| matches!(b, b' ' | b'\t'));
    }
    if key == "path" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        if bare.len() > 512 {
            return false;
        }
        return bare.starts_with("taplo://")
            || bare.starts_with("http://")
            || bare.starts_with("https://")
            || bare.starts_with("file://")
            || bare.starts_with("./")
            || bare.starts_with("../")
            || (bare.starts_with('/') && bare.len() > 1);
    }
    false
}

