fn stryker_json_value_and_tail_ok(key: &str, after_colon: &str) -> bool {
    let bytes = after_colon.as_bytes();
    let Some(first) = bytes.first().copied() else {
        return false;
    };
    match first {
        b'{' => {
            if !stryker_json_object_key_ok(key) {
                return false;
