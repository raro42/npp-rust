        return false;
    }
    let after_peer = after_peer.trim_start();
    let Some((_name, after)) = dhcpd_quoted_name(after_peer) else {
        return false;
    };
    nginx_brace_tail(after)
}

fn dhcpd_on_event(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("on") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    for ev in ["commit", "expiry", "release"] {
        let Some(after) = rest.strip_prefix(ev) else {
            continue;
        };
        if after.is_empty() || after.starts_with(char::is_whitespace) || after.starts_with('{') {
            return nginx_brace_tail(after);
        }
    }
    false
}

/// syslog-ng.conf block openers: `source s_sys {`, `destination d_mesg {`,
/// `filter f_kernel {`, `parser p_json {`, `rewrite r_set {`,
/// `template t_demo {`, `log {`, `options {`,
/// `block source s_tcp(…) {` / `block destination d_file {`. Exact lowercase.
/// Optional `(…)` params after the name. Optional `#` after `{`. Wrong case,
/// prose (`source the {`), bare keywords, Nim `template`, named.conf-only
/// statements, and in-block drivers stay out.
fn is_syslog_ng_decl(s: &str) -> bool {
    let s = s.trim_start();
    syslog_ng_bare_block(s) || syslog_ng_named_block(s) || syslog_ng_block_def(s)
}

fn syslog_ng_prose_name(name: &str) -> bool {
    matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our")
}

/// Skip an optional `(…)` parameter list (depth-counted; no string awareness).
fn syslog_ng_skip_params(s: &str) -> Option<&str> {
    let s = s.trim_start();
    if !s.starts_with('(') {
        return Some(s);
    }
    let bytes = s.as_bytes();
    let mut depth = 0i32;
    for (i, &b) in bytes.iter().enumerate() {
        match b {
            b'(' => depth += 1,
            b')' => {
                depth -= 1;
                if depth == 0 {
                    return Some(&s[i + 1..]);
                }
            }
            _ => {}
        }
    }
    None
}

fn syslog_ng_after_name(after_name: &str) -> bool {
    let Some(rest) = syslog_ng_skip_params(after_name) else {
        return false;
    };
    nginx_brace_tail(rest)
}

fn syslog_ng_bare_block(s: &str) -> bool {
    for key in ["options", "log"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Not `logging` / `logical` / `options_extra`.
        if rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{') {
            return nginx_brace_tail(rest);
        }
    }
    false
}

fn syslog_ng_named_block(s: &str) -> bool {
    for key in [
        "source",
        "destination",
        "filter",
        "parser",
        "rewrite",
        "template",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let Some((name, after)) = nginx_ident(rest) else {
            return false;
        };
        if syslog_ng_prose_name(name) {
            return false;
        }
        return syslog_ng_after_name(after);
    }
    false
}

fn syslog_ng_block_def(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("block") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    for kind in [
        "source",
        "destination",
        "filter",
        "parser",
        "rewrite",
        "template",
    ] {
        let Some(after_kind) = rest.strip_prefix(kind) else {
            continue;
        };
        if !after_kind.starts_with(char::is_whitespace) {
            continue;
        }
        let after_kind = after_kind.trim_start();
        let Some((name, after)) = nginx_ident(after_kind) else {
            return false;
        };
        if syslog_ng_prose_name(name) {
            return false;
        }
        return syslog_ng_after_name(after);
    }
    false
}

/// dovecot.conf block openers: `protocol imap {`, `service auth {`,
/// `passdb {`, `userdb {`, `namespace inbox {`, `mailbox Drafts {`,
/// `plugin {`, `dict {`, `local_name mail.example.com {`,
/// `inet_listener imap {` / `unix_listener auth {` / `fifo_listener x {`,
/// `metric auth_success {`, `local {` / `local 192.168.0.0/24 {`,
/// `remote {` / `remote 10.0.0.0/8 {`. Exact lowercase keywords.
/// Optional `#` after `{`. Wrong case, prose (`protocol the {`), bare
/// keywords, protobuf `service Greeter {` still counts via that path,
/// and in-block settings stay out.
fn is_dovecot_decl(s: &str) -> bool {
    let s = s.trim_start();
    dovecot_bare_block(s) || dovecot_named_block(s) || dovecot_local_remote(s)
}

fn dovecot_prose_name(name: &str) -> bool {
    matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our")
}

fn dovecot_bare_block(s: &str) -> bool {
    for key in ["passdb", "userdb", "plugin", "dict"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Not `plugins` / `dictionary` / `passdb_extra`.
        if rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{') {
            return nginx_brace_tail(rest);
        }
    }
    false
}

fn dovecot_named_block(s: &str) -> bool {
    for key in [
        "protocol",
        "service",
        "namespace",
        "mailbox",
        "local_name",
        "inet_listener",
        "unix_listener",
        "fifo_listener",
        "metric",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let Some((name, after)) = named_conf_quoted_or_ident(rest) else {
            return false;
        };
        if dovecot_prose_name(name) {
            return false;
        }
        return nginx_brace_tail(after);
    }
    false
}

/// Optional IPv4/IPv6 with optional `/bits` CIDR; returns rest after the addr.
fn dovecot_addr_prefix(s: &str) -> Option<&str> {
    let (_addr, after) = named_conf_ipv4_or_v6(s)?;
    let after = after.trim_start();
    if let Some(rest) = after.strip_prefix('/') {
        let bits_n = rest
            .as_bytes()
            .iter()
            .take_while(|b| b.is_ascii_digit())
            .count();
        if bits_n == 0 {
            return None;
        }
        Some(&rest[bits_n..])
    } else {
        Some(after)
    }
}

fn dovecot_local_remote(s: &str) -> bool {
    for key in ["local", "remote"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Not `local_name` / `localization` / `remotes` / `localfoo`.
        if !rest.is_empty() && !rest.starts_with(char::is_whitespace) && !rest.starts_with('{') {
            continue;
        }
        let rest = rest.trim_start();
        if rest.starts_with('{') {
            return nginx_brace_tail(rest);
        }
        let Some(after) = dovecot_addr_prefix(rest) else {
            return false;
        };
        return nginx_brace_tail(after);
    }
    false
}

/// FreeRADIUS config block openers: `client localhost {`,
/// `client 192.168.0.0/24 {`, `client "nas-1" {`,
/// `home_server localhost {`, `home_server_pool my_auth_failover {`,
/// `realm example.com {`, `server default {`, `modules {`,
/// `instantiate {`, `listen {`, `policy {`, `files {`,
/// `authorize {`, `authenticate {`, `preacct {`, `accounting {`,
/// `session {`, `post-auth {`, `pre-proxy {`, `post-proxy {`,
/// `recv-coa {`, `send-coa {`. Exact lowercase. Optional `#` after `{`.
/// Wrong case, prose (`client the {`), bare keywords, nginx bare
/// `server {`, HAProxy `listen name`, and in-block settings stay out.
fn is_freeradius_decl(s: &str) -> bool {
    let s = s.trim_start();
    freeradius_bare_block(s) || freeradius_named_block(s)
}

fn freeradius_prose_name(name: &str) -> bool {
    matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our")
}

fn freeradius_bare_block(s: &str) -> bool {
    // Longer hyphenated keys first.
    for key in [
        "authenticate",
        "instantiate",
        "accounting",
        "post-proxy",
        "pre-proxy",
        "post-auth",
        "recv-coa",
        "send-coa",
        "authorize",
        "preacct",
        "session",
        "modules",
        "policy",
        "listen",
        "files",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        // Not `modules_extra` / `filespace` / `listening`.
        if rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('{') {
            return nginx_brace_tail(rest);
        }
    }
    false
}

/// Name after `client` / `home_server` / …: quoted, ident (dots ok),
/// or IPv4/IPv6 with optional `/bits` CIDR.
fn freeradius_name_rest(s: &str) -> Option<&str> {
    let s = s.trim_start();
    if let Some((name, after)) = named_conf_quoted_or_ident(s) {
        if freeradius_prose_name(name) {
            return None;
        }
        return Some(after);
    }
    dovecot_addr_prefix(s)
}

fn freeradius_named_block(s: &str) -> bool {
    // Longer keys first so `home_server_pool` wins over `home_server`.
    for key in [
        "home_server_pool",
        "home_server",
        "client",
        "realm",
        "server",
    ] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let Some(after) = freeradius_name_rest(rest) else {
            return false;
        };
        return nginx_brace_tail(after);
    }
    false
}

/// strongSwan / Libreswan `ipsec.conf` section headers: `config setup`,
/// `conn %default`, `conn vpn`, `ca rootca`. Exact lowercase. Optional
/// `#` comment after the name. Names may be `%default` / `%any`-style
/// magics, idents, or quoted. Wrong case, prose (`conn the`), bare
/// `conn` / `ca` / `config`, HAProxy `listen`, and in-section settings
/// (`left=…`, `auto=add`) stay out.
fn is_ipsec_conf_decl(s: &str) -> bool {
    let s = s.trim_start();
    ipsec_conf_setup(s) || ipsec_conf_named(s)
}

fn ipsec_conf_tail(rest: &str) -> bool {
    let rest = rest.trim_start();
    rest.is_empty() || rest.starts_with('#')
}

fn ipsec_conf_prose_name(name: &str) -> bool {
    matches!(name, "the" | "a" | "an" | "this" | "that" | "my" | "our")
}

/// `config setup` (exact two-word header).
fn ipsec_conf_setup(s: &str) -> bool {
    let Some(rest) = s.strip_prefix("config") else {
        return false;
    };
    if !rest.starts_with(char::is_whitespace) {
        return false;
    }
    let rest = rest.trim_start();
    let Some(rest) = rest.strip_prefix("setup") else {
        return false;
    };
    // Not `setups` / `setup_extra`.
    if !(rest.is_empty() || rest.starts_with(char::is_whitespace) || rest.starts_with('#')) {
        return false;
    }
    ipsec_conf_tail(rest)
}

/// `%default` / `%any` magics, or quoted / ident names.
fn ipsec_conf_name_rest(s: &str) -> Option<&str> {
    let s = s.trim_start();
    if s.starts_with('%') {
        let bytes = s.as_bytes();
        let n = bytes
            .iter()
            .take_while(|b| b.is_ascii_alphanumeric() || matches!(*b, b'%' | b'_' | b'-' | b'.'))
            .count();
        // Need at least `%` + one more char.
        if n < 2 {
            return None;
        }
        return Some(&s[n..]);
    }
    let (name, after) = named_conf_quoted_or_ident(s)?;
    if ipsec_conf_prose_name(name) {
        return None;
    }
    Some(after)
}

fn ipsec_conf_named(s: &str) -> bool {
    for key in ["conn", "ca"] {
        let Some(rest) = s.strip_prefix(key) else {
            continue;
        };
        if !rest.starts_with(char::is_whitespace) {
            continue;
        }
        let rest = rest.trim_start();
        let Some(after) = ipsec_conf_name_rest(rest) else {
            return false;
        };
        return ipsec_conf_tail(after);
    }
    false
}

/// OpenVPN inline files and `<connection>` blocks: `<ca>`, `<cert>`,
/// `<key>`, `<dh>`, `<pkcs12>`, `<extra-certs>`, `<crl-verify>`,
/// `<tls-auth>`, `<tls-crypt>`, `<tls-crypt-v2>`, `<auth-user-pass>`,
/// `<http-proxy-user-pass>`, `<auth-gen-token-secret>`,
/// `<peer-fingerprint>`, `<verify-hash>`, `<connection>`. Exact
/// lowercase, tag then `>`. Optional `#` or `;` comment. Closing tags,
/// wrong case, plist `<key>name</key>`, and trailing payload stay out.
fn is_openvpn_decl(s: &str) -> bool {
    let s = s.trim_start();
    let Some(rest) = s.strip_prefix('<') else {
        return false;
    };
    if rest.starts_with('/') {
        return false;
    }
    const TAGS: &[&str] = &[
        "auth-gen-token-secret",
        "http-proxy-user-pass",
        "peer-fingerprint",
        "tls-crypt-v2",
        "auth-user-pass",
        "extra-certs",
        "crl-verify",
        "verify-hash",
        "connection",
        "tls-crypt",
        "tls-auth",
        "pkcs12",
        "cert",
        "key",
        "dh",
        "ca",
    ];
    for tag in TAGS {
        let Some(after) = rest.strip_prefix(tag) else {
            continue;
        };
        let Some(after) = after.strip_prefix('>') else {
            continue;
        };
        return openvpn_tail(after);
    }
    false
}

fn openvpn_tail(rest: &str) -> bool {
    let rest = rest.trim_start();
    rest.is_empty() || rest.starts_with('#') || rest.starts_with(';')
}

