fn supabase_toml_value_ok(key: &str, value: &str) -> bool {
    if value.is_empty() || value.len() > 1024 {
        return false;
    }
    // Nested tables / arrays stay out (schemas / redirect URLs / seed paths).
    if value.starts_with('{') || value.starts_with('[') {
        return false;
    }
    let bare = value.trim_matches(|c| c == '"' || c == '\'');
    if bare.is_empty() {
        return false;
    }
    if matches!(
        key,
        "enable_signup"
            | "enable_anonymous_sign_ins"
            | "enable_manual_linking"
            | "enable_refresh_token_rotation"
            | "double_confirm_changes"
            | "enable_confirmations"
            | "verify_jwt"
            | "enable_log_query"
            | "skip_nonce_check"
            | "email_optional"
            | "enroll_enabled"
            | "verify_enabled"
            | "enable_phone_confirmations"
            | "enabled"
            | "test_otp"
    ) {
        return bare.eq_ignore_ascii_case("true") || bare.eq_ignore_ascii_case("false");
    }
    if matches!(
        key,
        "shadow_port"
            | "major_version"
            | "max_rows"
            | "default_pool_size"
            | "max_client_conn"
            | "jwt_expiry"
            | "refresh_token_reuse_interval"
            | "smtp_port"
            | "pop3_port"
            | "inspector_port"
            | "otp_length"
            | "otp_expiry"
            | "max_enrolled_factors"
            | "max_header_length"
            | "minimum_password_length"
            | "max_message_length"
            | "db_max_clients"
    ) {
        return bare.bytes().all(|b| b.is_ascii_digit()) && bare.len() <= 8 && bare != "0";
    }
    if key == "pool_mode" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare == "transaction" || bare == "session";
    }
    if key == "backend" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare == "postgres" || bare == "bigquery";
    }
    if key == "s3_protocol" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare == "https" || bare == "http";
    }
    if key == "password_requirements" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return matches!(
            bare,
            "lower_upper_letters_digits" | "lower_upper_letters_digits_symbols" | "letters_digits"
        ) || bare.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_');
    }
    if key == "policy" {
        if !(value.starts_with('"') || value.starts_with('\'')) {
            return false;
        }
        return bare == "oneshot" || bare == "per_worker" || bare == "hot_reload";
    }
    // Remaining keys: quoted strings (or env(...) form).
    if !(value.starts_with('"') || value.starts_with('\'')) {
        return false;
    }
    if bare.len() > 512 {
        return false;
    }
    if !bare
        .bytes()
        .all(|b| b.is_ascii_graphic() || b == b' ' || b == b'\t')
    {
        return false;
    }
    if key == "project_id" || key == "tenant_id" || key == "s3_region" {
        return bare
            .bytes()
            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'));
    }
    if matches!(
        key,
        "site_url" | "api_url" | "external_url" | "webserver_url" | "redirect_uri" | "s3_host"
    ) {
        return bare.starts_with("http://")
            || bare.starts_with("https://")
            || bare.starts_with("env(")
            || bare.bytes().all(|b| {
                b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_' | b':' | b'/')
            });
    }
    true
}

/// mise `mise.toml` / `.mise.toml` / `mise/config.toml`: `[tools]` /
/// `[tasks]` / `[tasks.build]` / `[settings]` / `[settings.upgrade]` /
/// `[settings.cargo]` / `[settings.python]` / `[settings.status]` /
/// `[settings.aqua]` / `[settings.node]` / `[settings.rust]` /
/// `[alias]` / `[plugins]` / `[vars]` / `[hooks]` / `[shell_alias]` /
/// `[tool_alias]` / `[task_config]` / `[deps]` / `[oci]` / `[bootstrap]` /
/// `[history]` / `[secrets]` / `[wrappers]` / `[monorepo]` / `[dotfiles]`,
/// `min_version = "2024.1.1"`, `experimental_monorepo_root = true`,
/// `monorepo_root = true`, `env_file = ".env"`, `dotenv = ".env"`,
/// `not_found_auto_install = true`, `asdf_compat = false`,
/// `always_keep_download = false`, `activate_shims = true`,
/// `legacy_version_file = true`, `plugin_autoupdate_last_check_duration = "7d"`,
/// `default_config_filename = "mise.toml"`, `use_versions_host = true`,
/// `auto_prune = false`, `binstall = true`, `uv_venv_auto = true`,
/// `missing_tools = "if_other_versions_installed"`, `wait_for = "build"`,
/// `run_windows = "…"`, `depends_post = "lint"`. Exact mise keys
/// (snake_case). TOML `key = value` with spaces around `=`. Optional `#`
/// comment (quote-aware). Arrays (`depends = […]`,
/// `idiomatic_version_file_enable_tools = […]`) / nested maps / free-form
/// `[tools]` / `[env]` / `[tasks]` entries (`node = "20"`, `FOO = "bar"`,
/// `build = "cargo build"`) / `port = …` / prose / wrong case / supabase /
/// pixi / samconfig / nixpacks / railway / fly / netlify / wrangler /
/// dioxus / uniffi / cbindgen / trunk / mutants / audit / cliff /
/// cargo-make / release.toml / Dist.toml / mdBook / taplo / typos /
/// bacon / Cross / rust-toolchain / cargo config / nextest / deny /
/// clippy / rustfmt / ruff / uv / bunfig / yarn / npmrc / pip /
/// Cargo.toml stay out.
fn is_mise_toml_decl(s: &str) -> bool {
    let s = s.trim_start();
    if s.is_empty() || s.starts_with('#') || s.starts_with(';') {
        return false;
    }
    if let Some((header, array, after)) = cargo_toml_header(s) {
        if header.is_empty() || !tox_ini_tail_ok(after) {
            return false;
        }
        // Stock mise.toml has no `[[…]]` array-of-tables sections.
        if array {
            return false;
        }
        return mise_toml_section_ok(header);
    }
    let body = mise_toml_strip_comment(s);
    if body.is_empty() {
        return false;
    }
    let Some(eq) = body.find('=') else {
        return false;
    };
    if body[..eq].contains(':') {
        return false;
    }
    let bytes = body.as_bytes();
    if eq == 0
        || !bytes[eq - 1].is_ascii_whitespace()
        || eq + 1 >= bytes.len()
        || !bytes[eq + 1].is_ascii_whitespace()
    {
        return false;
    }
    let key = body[..eq].trim();
    if key.contains('.') {
        return false;
    }
    if !mise_toml_key_ok(key) {
        return false;
    }
    let value = body[eq + 1..].trim();
    mise_toml_value_ok(key, value)
}

fn mise_toml_strip_comment(s: &str) -> &str {
    let mut in_single = false;
    let mut in_double = false;
    for (i, b) in s.bytes().enumerate() {
        match b {
            b'\'' if !in_double => in_single = !in_single,
            b'"' if !in_single => in_double = !in_double,
            b'#' | b';' if !in_single && !in_double => {
                return s[..i].trim_end();
            }
            _ => {}
        }
    }
    s.trim()
}

fn mise_toml_section_ok(header: &str) -> bool {
    let parts: Vec<&str> = header.split('.').collect();
    if parts.is_empty() || parts.len() > 3 {
        return false;
    }
    match parts[0] {
        // Bare `[env]` stays out: other Function List negatives assert it is not a
        // hit, and free-form mise env entries are not listed anyway.
        "tools" | "alias" | "plugins" | "vars" | "hooks" | "shell_alias" | "tool_alias"
        | "tool_config" | "task_config" | "task_templates" | "deps" | "oci" | "bootstrap"
        | "history" | "secrets" | "wrappers" | "monorepo" | "dotfiles" | "dotfile_groups"
        | "watch_files" | "redactions" | "doctor" | "daemons" | "daemon_groups"
        | "daemon_providers" | "daemons_settings" | "include" => parts.len() == 1,
        "tasks" => match parts.len() {
            1 => true,
            2 | 3 => {
                mise_toml_name_ok(parts[1]) && (parts.len() == 2 || mise_toml_name_ok(parts[2]))
            }
            _ => false,
        },
        "settings" => match parts.len() {
            1 => true,
            2 => mise_toml_settings_group_ok(parts[1]),
            3 => mise_toml_settings_group_ok(parts[1]) && mise_toml_name_ok(parts[2]),
            _ => false,
        },
        _ => false,
    }
}

