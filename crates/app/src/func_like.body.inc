fn wit_decl_name(s: &str) -> bool {
    let bytes = s.as_bytes();
    if bytes.is_empty() {
        return false;
    }
    let first = bytes[0];
    if !(first == b'_' || first.is_ascii_alphabetic()) {
        return false;
    }
    let mut n = 1usize;
    while n < bytes.len() {
        let b = bytes[n];
        if b.is_ascii_alphanumeric() || b == b'_' || b == b'-' {
            n += 1;
        } else {
            break;
