            || value.eq_ignore_ascii_case("on")
            || value.eq_ignore_ascii_case("off")
            || value.chars().all(|c| c.is_ascii_digit());
        if !distinctive {
            return false;
        }
    }
    value.bytes().all(|b| {
        b.is_ascii_alphanumeric()
            || matches!(
                b,
                b'.' | b'_'
                    | b'-'
                    | b':'
                    | b'@'
